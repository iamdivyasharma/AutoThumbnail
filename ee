def choose_hparams_for_pages(pages: int) -> Dict[str, float]:
    if pages is None or pages <= 0:
        pages = 1

    # ---- k (top-k) ----
    if pages <= 5:
        k = 8
    elif pages <= 10:
        k = 12
    elif pages <= 20:
        k = 20
    elif pages <= 30:
        k = 28
    elif pages <= 40:
        k = 35   
    elif pages <= 60:
        k = 42
    else:
        k = 50

    # ---- max_tokens: fixed for all files ----
    max_tokens = 7500

    # ---- temperature: always deterministic ----
    temperature = 0.0

    return {
        "k": k,
        "max_tokens": max_tokens,
        "temperature": temperature,
    }



def main():
    if not FINANCE_ROOT.exists():
        raise SystemExit(f"Finance root does not exist: {FINANCE_ROOT}")

    overrides: Dict[str, Dict[str, float]] = {}

    # Scan ALL PDFs under ce/finance (recursively)
    for pdf_path in FINANCE_ROOT.rglob("*.pdf"):
        pages = get_pdf_page_count(pdf_path)
        hparams = choose_hparams_for_pages(pages)

        key = pdf_path.name  # used by indexer: path.name
        overrides[key] = {
            "pages": pages,
            "k": hparams["k"],
            "max_tokens": hparams["max_tokens"],
            "temperature": hparams["temperature"],
        }

        print(f"[CONFIG] {key}: pages={pages}, k={hparams['k']}, "
              f"max_tokens={hparams['max_tokens']}, temperature={hparams['temperature']}")

    # (Optional) include DOCX as 1-page approximations
    for docx_path in FINANCE_ROOT.rglob("*.docx"):
        key = docx_path.name
        if key in overrides:
            continue  # already added as PDF with same name (unlikely)

        pages = 1  # heuristic for DOCX
        hparams = choose_hparams_for_pages(pages)
        overrides[key] = {
            "pages": pages,
            "k": hparams["k"],
            "max_tokens": hparams["max_tokens"],
            "temperature": hparams["temperature"],
        }
        print(f"[CONFIG] {key}: (DOCX) pages={pages}, k={hparams['k']}, "
              f"max_tokens={hparams['max_tokens']}, temperature={hparams['temperature']}")

    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(overrides, indent=2), encoding="utf-8")

    print(f"\n[CONFIG] Saved {len(overrides)} entries to {CONFIG_PATH}")


if __name__ == "__main__":
    main()


