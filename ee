def get_pdf_page_count(pdf_path: Path) -> int:
    try:
        with fitz.open(str(pdf_path)) as doc:
            return doc.page_count or 0
    except Exception as e:
        print(f"[WARN] Could not read pages for {pdf_path}: {e}")
        return 0


