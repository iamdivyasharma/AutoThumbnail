import pandas as pd
import json
import ast
from pathlib import Path

INPUT_FILE = "input.xlsx"
OUTPUT_FILE = "output_processed.xlsx"

# columns you NEVER want to parse as dict (edit as needed)
DO_NOT_PARSE_COLS = {"client", "Client", "CLIENT"}

DELIM = ".\n\n"  # remove everything before first occurrence of this


def safe_parse_dict(cell):
    """
    Parses a cell that may contain:
      - JSON string
      - Python dict-like string with single quotes
      - already a dict
    Returns dict or None if not parseable.
    """
    if pd.isna(cell):
        return None

    if isinstance(cell, dict):
        return cell

    if not isinstance(cell, str):
        return None

    s = cell.strip()
    if not (s.startswith("{") and s.endswith("}")):
        return None

    # Try JSON
    try:
        return json.loads(s)
    except Exception:
        pass

    # Try Python literal (handles single quotes)
    try:
        return ast.literal_eval(s)
    except Exception:
        return None


def clean_content_extracted(text):
    """
    Removes everything before the first '.\\n\\n'
    Example:
      'ABC.\\n\\nHELLO WORLD' -> 'HELLO WORLD'
    If delimiter not found, returns original text.
    """
    if text is None:
        return ""

    if not isinstance(text, str):
        text = str(text)

    idx = text.find(DELIM)
    if idx == -1:
        return text.strip()

    return text[idx + len(DELIM):].lstrip()


def normalize_sources(src):
    """
    Keep only the 'value part' of sources.
    If sources is list/dict, convert to a readable string.
    """
    if src is None:
        return ""
    if isinstance(src, (dict, list)):
        return json.dumps(src, ensure_ascii=False)
    return str(src).strip()


def process_excel(input_file, output_file):
    df = pd.read_excel(input_file)

    # Content version + Sources version
    df_content = df.copy()
    df_sources = df.copy()

    for col in df.columns:
        if col in DO_NOT_PARSE_COLS:
            continue

        for i in range(len(df)):
            d = safe_parse_dict(df.loc[i, col])

            # If not the expected dict-format, leave as-is
            if not isinstance(d, dict):
                continue

            # Only process cells that contain expected keys
            if "content_extracted" not in d and "sources" not in d:
                continue

            content_val = clean_content_extracted(d.get("content_extracted", ""))
            source_val = normalize_sources(d.get("sources", ""))

            df_content.loc[i, col] = content_val
            df_sources.loc[i, col] = source_val

    # Make it "separate row": stack content + sources
    df_content.insert(1, "row_type", "content")
    df_sources.insert(1, "row_type", "sources")
    df_final = pd.concat([df_content, df_sources], ignore_index=True)

    # Save output (also keep separate sheets for convenience)
    with pd.ExcelWriter(output_file, engine="openpyxl") as writer:
        df_final.to_excel(writer, index=False, sheet_name="processed_rows")
        df_content.to_excel(writer, index=False, sheet_name="content_only")
        df_sources.to_excel(writer, index=False, sheet_name="sources_only")

    print(f"✅ Done! Saved: {output_file}")


if __name__ == "__main__":
    process_excel(INPUT_FILE, OUTPUT_FILE)
