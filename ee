from __future__ import annotations

import os
import re
import json
import time
from pathlib import Path, PurePosixPath
from typing import Dict, List, Tuple, Iterable, Optional
from urllib.parse import urlparse

import boto3
from langchain_community.document_loaders import AmazonTextractPDFLoader
from langchain_community.vectorstores import FAISS
from langchain.schema import Document
from langchain_aws import BedrockEmbeddings


# ========================= CONFIG =========================
REGION = os.environ.get("AWS_REGION", "us-east-1")

# Root S3 directory containing client folders
# Example:
#   s3://my-bucket/ALL_PDFS/
#       clientA/doc1.pdf
#       clientB/doc2.pdf
S3_ROOT_URI = os.environ.get("S3_ROOT_URI", "s3://YOUR_BUCKET/ALL_PDFS/")

# Where to store FAISS indexes
FAISS_INDEX_DIR = Path(os.environ.get("FAISS_INDEX_DIR", "/opt/ml/processing/faiss_indices")).resolve()

# Bedrock embedding model
EMBED_MODEL = os.environ.get("EMBED_MODEL", "amazon.titan-embed-text-v2:0")

# Chunking
CHUNK_SIZE = int(os.environ.get("CHUNK_SIZE", "1200"))
CHUNK_OVERLAP = int(os.environ.get("CHUNK_OVERLAP", "150"))

# Include S3 file metadata (LastModified/Size) in manifest (extra API calls)
INCLUDE_S3_STAT = os.environ.get("INCLUDE_S3_STAT", "1") == "1"
# ==========================================================


# ---------------------- S3 helpers ------------------------

def parse_s3_uri(s3_uri: str) -> tuple[str, str]:
    """Parse s3://bucket/prefix into (bucket, key_or_prefix)."""
    if not s3_uri.startswith("s3://"):
        raise ValueError(f"Not a valid S3 URI: {s3_uri}")

    parsed = urlparse(s3_uri)
    bucket = parsed.netloc
    key = parsed.path.lstrip("/")
    return bucket, key


def ensure_trailing_slash(prefix: str) -> str:
    return prefix if (not prefix or prefix.endswith("/")) else prefix + "/"


def list_pdf_s3_uris(s3_dir_uri: str, region: str) -> List[str]:
    """
    Recursively list ALL PDFs under an S3 prefix.
    Returns full s3://bucket/key URIs.
    """
    bucket, prefix = parse_s3_uri(s3_dir_uri)
    prefix = ensure_trailing_slash(prefix)

    s3 = boto3.client("s3", region_name=region)
    paginator = s3.get_paginator("list_objects_v2")

    pdfs: List[str] = []
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        for obj in page.get("Contents", []):
            key = obj["Key"]
            if key.endswith("/"):
                continue
            if key.lower().endswith(".pdf"):
                pdfs.append(f"s3://{bucket}/{key}")

    return sorted(pdfs)


def list_pdfs_grouped_by_client_folder(s3_root_uri: str, region: str) -> Dict[str, List[str]]:
    """
    Groups PDFs by the FIRST folder after the root prefix.

    Example:
      root: s3://bucket/ALL_PDFS/
      keys: ALL_PDFS/client1/a.pdf -> client_id = client1
            ALL_PDFS/client2/b.pdf -> client_id = client2
    """
    bucket, root_prefix = parse_s3_uri(s3_root_uri)
    root_prefix = ensure_trailing_slash(root_prefix)

    all_pdfs = list_pdf_s3_uris(s3_root_uri, region=region)

    grouped: Dict[str, List[str]] = {}
    root_path = PurePosixPath(root_prefix)

    for uri in all_pdfs:
        _, key = parse_s3_uri(uri)
        key_path = PurePosixPath(key)

        try:
            rel = key_path.relative_to(root_path)
        except ValueError:
            # If not under root, skip
            continue

        if not rel.parts:
            continue

        client_id = rel.parts[0].strip().lower()
        grouped.setdefault(client_id, []).append(uri)

    # Deterministic order
    for k in grouped:
        grouped[k] = sorted(grouped[k])

    return grouped


def s3_head_object(s3_uri: str, region: str) -> dict:
    """Fetch object metadata (LastModified, ContentLength, etc)."""
    bucket, key = parse_s3_uri(s3_uri)
    s3 = boto3.client("s3", region_name=region)
    return s3.head_object(Bucket=bucket, Key=key)


# -------------------- Text utilities ----------------------

def clean_text(t: str) -> str:
    t = t or ""
    t = re.sub(r"[ \t]+\n", "\n", t)  # trim spaces before newline
    return t.strip()


def chunk_text(text: str, chunk_size: int, overlap: int) -> List[Tuple[int, int, str]]:
    """
    Return list of (start_idx, end_idx, chunk_text).
    Character-based chunking.
    """
    text = text or ""
    n = len(text)

    if n <= chunk_size:
        return [(0, n, text)]

    out: List[Tuple[int, int, str]] = []
    start = 0

    while start < n:
        end = min(n, start + chunk_size)
        out.append((start, end, text[start:end]))

        if end == n:
            break

        start = end - overlap
        if start < 0:
            start = 0

    return out


# ---------------- Textract + embeddings -------------------

def get_embeddings(region: str) -> BedrockEmbeddings:
    """
    Bedrock embeddings using default AWS credential chain (IAM role on SageMaker).
    No keys, no boto3 Session.
    """
    bedrock_runtime = boto3.client("bedrock-runtime", region_name=region)
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=bedrock_runtime)


def textract_load_documents(s3_pdf_uri: str, region: str) -> List[Document]:
    """
    Load documents from Textract.
    We pass a region-scoped Textract client (still NO keys; uses IAM role).
    """
    textract_client = boto3.client("textract", region_name=region)
    loader = AmazonTextractPDFLoader(s3_pdf_uri, client=textract_client)
    docs = loader.load()  # list[Document], typically one per page
    return docs


def make_chunks_for_s3_pdf(s3_pdf_uri: str, client_id: str, region: str) -> Iterable[Document]:
    """
    Extract text with AmazonTextractPDFLoader ONLY,
    then chunk and yield LangChain Documents with metadata.
    """
    filename = s3_pdf_uri.split("/")[-1]

    docs = textract_load_documents(s3_pdf_uri, region=region)

    # If loader returns per-page docs, keep page numbers if present
    for d in docs:
        page_text = clean_text(d.page_content or "")
        page_num = None
        if isinstance(d.metadata, dict):
            page_num = d.metadata.get("page") or d.metadata.get("Page")  # some loaders vary

        # Chunk
        for _, _, chunk in chunk_text(page_text, CHUNK_SIZE, CHUNK_OVERLAP):
            meta = {
                "client_id": client_id,
                "policy_id": filename,
                "source_file": s3_pdf_uri,
                "extracted_by": "textract",
            }
            if page_num is not None:
                meta["page"] = int(page_num)
            yield Document(page_content=chunk, metadata=meta)


# ------------------- Index building -----------------------

def index_one_client(client_id: str, pdf_uris: List[str], embeddings: BedrockEmbeddings, region: str) -> None:
    client_dir = FAISS_INDEX_DIR / client_id
    client_dir.mkdir(parents=True, exist_ok=True)

    all_chunks: List[Document] = []
    manifest_docs: List[dict] = []

    for s3_uri in pdf_uris:
        print(f"[{client_id}] Textract loading: {s3_uri}")

        # Collect chunk docs
        pdf_chunk_count = 0
        pages_count = 0

        try:
            # Count pages quickly by loader output length
            page_docs = textract_load_documents(s3_uri, region=region)
            pages_count = len(page_docs)

            # Now chunk properly using our generator
            for chunk_doc in make_chunks_for_s3_pdf(s3_uri, client_id, region=region):
                all_chunks.append(chunk_doc)
                pdf_chunk_count += 1

        except Exception as e:
            print(f"[WARN] Failed Textract on {s3_uri}: {e}")
            continue

        # Manifest info
        entry = {
            "policy_id": s3_uri.split("/")[-1],
            "source_file": s3_uri,
            "pages": pages_count,
            "chunks_indexed": pdf_chunk_count,
        }

        if INCLUDE_S3_STAT:
            try:
                stat = s3_head_object(s3_uri, region=region)
                # Convert LastModified (datetime) to epoch
                lm = stat.get("LastModified")
                entry["modified_time"] = int(lm.timestamp()) if lm else None
                entry["size_bytes"] = int(stat.get("ContentLength", 0))
            except Exception:
                pass

        manifest_docs.append(entry)

    if not all_chunks:
        print(f"[{client_id}] No chunks created. Skipping FAISS index.")
        return

    print(f"[{client_id}] Building FAISS index with {len(all_chunks)} chunks ...")
    vs = FAISS.from_documents(all_chunks, embeddings)
    vs.save_local(str(client_dir))

    manifest = {
        "client_id": client_id,
        "root_s3_prefix": S3_ROOT_URI,
        "docs": manifest_docs,
        "generated_time": int(time.time()),
        "embedding_model": EMBED_MODEL,
        "region": region,
    }

    (client_dir / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    print(f"[{client_id}] ✅ Done. Index saved at: {client_dir}")


def main():
    if not S3_ROOT_URI.startswith("s3://"):
        raise SystemExit("S3_ROOT_URI must be an S3 URI like s3://bucket/prefix/")

    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)

    print(f"Listing PDFs under: {S3_ROOT_URI}")
    by_client = list_pdfs_grouped_by_client_folder(S3_ROOT_URI, region=REGION)

    if not by_client:
        print("No PDFs found in the given S3 root path.")
        return

    total = sum(len(v) for v in by_client.values())
    print(f"Found {total} PDFs across {len(by_client)} client folders.")

    embeddings = get_embeddings(region=REGION)

    for client_id, pdf_uris in by_client.items():
        print(f"\n=== Indexing client: {client_id} ({len(pdf_uris)} PDFs) ===")
        index_one_client(client_id, pdf_uris, embeddings, region=REGION)


if __name__ == "__main__":
    main()
