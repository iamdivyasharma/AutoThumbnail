# 1) RAG Search API
#    - Free-flowing Q/A on contract PDFs (legal/finance)
#    - Uses the same logic as /ask
@app.post("/api/rag-search", response_model=AskResponse)
def api_rag_search(payload: AskRequest):
    """
    RAG Search API

    Request body (AskRequest):
      {
        "question": "...",
        "category": "legal" | "finance" | null,
        "client_ids": ["finance/clientA/us", ...]  // optional
      }

    Response body (AskResponse):
      {
        "answer": "...",
        "used_clients": [...],
        "client_scopes": [...],
        "sources": [...]
      }
    """
    return ask(payload)


# 2) Metadata API
#    - Q/A over the METADATA Excel workbook only
#    - Internally uses Excel RAG in "metadata" mode
@app.post("/api/metadata-query", response_model=ExcelChatResponse)
def api_metadata_query(payload: ExcelChatRequest):
    """
    Metadata API

    Request body (ExcelChatRequest):
      {
        "question": "...",
        "session_id": "optional-session-id",
        "k": 6,
        "mode": "metadata",         // forced to metadata
        "category": "legal|finance" // optional filter hint
      }

    Response body (ExcelChatResponse):
      {
        "answer": "...",
        "sources": [...],
        "history": [...],
        "meta": {...},
        "mode": "metadata",
        "category": "legal|finance|null"
      }
    """
    # Force mode to "metadata" regardless of what caller sends
    payload.mode = "metadata"
    return excel_chat(payload)


# 3) Report Query API
#    - Q/A over the REPORT / WORKBOOK Excel
#    - e.g., summary of contracts, KPIs etc.
@app.post("/api/report-query", response_model=ExcelChatResponse)
def api_report_query(payload: ExcelChatRequest):
    """
    Report Query API

    Uses the Excel workbook (WORKBOOK_EXCEL_FILE) in 'workbook' mode.

    Request body (ExcelChatRequest):
      {
        "question": "...",
        "session_id": "optional-session-id",
        "k": 6,
        "mode": "workbook",         // forced to workbook
        "category": null            // typically not used here
      }
    """
    payload.mode = "workbook"
    # category usually not needed for report queries; leave as-is / ignore
    return excel_chat(payload)


# 4) Report Lookup API
#    - Field-level / record-level lookups in the same REPORT workbook
#    - For now, behavior is same as report-query but semantically used
#      for "lookup" style questions (specific contract, ID, etc.)
@app.post("/api/report-lookup", response_model=ExcelChatResponse)
def api_report_lookup(payload: ExcelChatRequest):
    """
    Report Lookup API

    Semantically meant for lookup-style questions (e.g., given contract
    ID, client name, country, return specific fields). Internally uses
    the same Excel RAG over the 'workbook' Excel.

    Request body (ExcelChatRequest):
      {
        "question": "...",
        "session_id": "optional-session-id",
        "k": 6,
        "mode": "workbook"          // forced to workbook
      }
    """
    # Also use the workbook mode for lookups
    payload.mode = "workbook"
    return excel_chat(payload)
