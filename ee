# ==================== Downstream MCP calls ====================


async def call_backend(target: str, query: str, extra: Optional[Dict[str, Any]]):
    svc = SERVICES[target]
    client = MCP_CLIENTS[target]

    # Build the tool arguments: required query field + pass-through extras
    args: Dict[str, Any] = {svc["field"]: query}
    if isinstance(extra, dict) and extra:
        # Merge everything from UI (identity, settings, etc.) directly
        args.update(extra)

    ckey = f"bot:{target}:{_h({'q':query,'x':extra})}"
    hit = cache_get(ckey)
    if hit is not None:
        return hit

    try:
        result = await client.tools_call(name=svc["tool"], arguments=args)
        # Normalize common result shapes
        if isinstance(result, dict):
            val = result.get("answer") or result.get("result") or result.get("output") or result.get("content") or result
        else:
            val = result
        cache_set(ckey, val)
        return val
    except Exception as e:
        return f"{type(e).__name__}: {e}"

