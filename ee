            "extra": extra,  # includes user_name & user_email
        }
        status, data = post(AGENT_URL, payload)
        st.subheader(f"🤖 Agentic AI • Status: {status}")
        if isinstance(data, dict):
            st.markdown("**Final Answer**")
            st.write(data.get("final_answer", ""))
            with st.expander("Details (observations)"):
                st.json(data)
        else:
            st.code(data)
    else:
        target = "air" if do_air else "hotel" if do_hotel else "tdna"

        payload = {
            "query": query.strip(),                      # form input
            "target": target,
            "extra": {"user_name": user_name.strip(), "user_email": user_email.strip()},
            # conversational memory per-bot
            "session_id": f"{session_id}::{target}",     # or f"{st.session_state['session_id']}::{target}"
        }
        status, data = post(ROUTE_URL, payload)

        
        label = {"air":"✈️ AIR", "hotel":"🏨 HOTEL", "tdna":"🧬 TDNA"}[target]
        st.subheader(f"{label} • Status: {status}")

        
        if isinstance(data, dict):
            if "answer" in data:
                st.markdown("**Answer**")
                st.write(data["answer"])
            abt = data.get("answers_by_target")
            if isinstance(abt, dict) and abt:
                st.markdown("**Per-target details**")
                for k, v in abt.items():
                    with st.expander(k):
                        st.write(v)
            if data.get("errors"):
                st.warning("Some targets returned errors:")
                st.json(data["errors"])
        else:
            st.code(data)

st.markdown("---")
st.caption("Bots are called via MCP; UI talks to the orchestrator’s HTTP endpoints. MCP server also available at /mcp.")
