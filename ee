import os
import boto3
from botocore.exceptions import ClientError

AWS_REGION = os.getenv("AWS_REGION", "us-east-1")
BUCKET = os.getenv("TEST_S3_BUCKET", "")
PREFIX = os.getenv("TEST_S3_PREFIX", "")          # example: "faiss_indices/"
TEST_KEY = os.getenv("TEST_S3_KEY", "")           # example: "faiss_indices/finance/.../index.faiss"

if not BUCKET:
    raise SystemExit("Set TEST_S3_BUCKET env var")
if not TEST_KEY:
    raise SystemExit("Set TEST_S3_KEY env var (must be an existing object key)")

s3 = boto3.client("s3", region_name=AWS_REGION)

def test_listbucket():
    print(f"\n[TEST] ListBucket: s3://{BUCKET}/{PREFIX}")
    try:
        s3.list_objects_v2(Bucket=BUCKET, Prefix=PREFIX, MaxKeys=1)
        print("✅ OK: list_objects_v2 worked (ListBucket allowed)")
    except ClientError as e:
        err = e.response.get("Error", {})
        print("❌ FAILED: list_objects_v2")
        print("   Code   :", err.get("Code"))
        print("   Message:", err.get("Message"))

def test_getobject():
    print(f"\n[TEST] GetObject: s3://{BUCKET}/{TEST_KEY}")
    try:
        obj = s3.get_object(Bucket=BUCKET, Key=TEST_KEY)
        chunk = obj["Body"].read(32)
        print(f"✅ OK: get_object worked (GetObject allowed). Read {len(chunk)} bytes.")
    except ClientError as e:
        err = e.response.get("Error", {})
        print("❌ FAILED: get_object")
        print("   Code   :", err.get("Code"))
        print("   Message:", err.get("Message"))

if __name__ == "__main__":
    test_listbucket()
    test_getobject()
