import json
import shutil
import re
from pathlib import Path

# === CONFIGURE THIS ===
# Point this directly to your finance folder which contains client1, client2, ...
# Example: r"R:\Data\finance" or r"C:\Users\you\finance"
SOURCE_ROOT = Path(r"/path/to/finance")

# Where to create the Account_name-based folders:
# This will create "output_by_account" next to the finance folder
DEST_ROOT = SOURCE_ROOT.parent / "output_by_account"
# ======================


def parse_metadata_file(meta_path: Path) -> dict:
    """
    Parse metadata as JSON (primary), with fallback to key=value lines.
    """
    text = meta_path.read_text(encoding="utf-8", errors="ignore").strip()

    # Try JSON
    try:
        data = json.loads(text)
        if isinstance(data, dict):
            return data
    except json.JSONDecodeError:
        print(f"[DEBUG] {meta_path} is not valid JSON, trying key=value format")

    # Fallback: key=value lines
    data = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, value = line.split("=", 1)
            data[key.strip()] = value.strip()
    return data


def get_meta_value(data: dict, *possible_keys, default=None):
    """
    Case-insensitive lookup for any of the possible keys.
    """
    lowered = {k.lower(): v for k, v in data.items()}
    for key in possible_keys:
        if key is None:
            continue
        v = lowered.get(key.lower())
        if v is not None:
            return v
    return default


def sanitize_folder_name(value: str) -> str:
    """
    Make a safe folder name:
    - keep spaces
    - remove illegal characters
    - trim and collapse multiple spaces
    """
    if value is None:
        return ""
    value = value.strip()
    value = re.sub(r"\s+", " ", value)              # collapse multiple spaces
    value = re.sub(r'[<>:"/\\|?*]', "_", value)     # remove invalid chars
    return value


def find_original_file_from_metadata(meta_path: Path) -> Path | None:
    """
    From:
      deal1.docx.metadata.json -> deal1.docx
      deal2.pdf.metadata.json  -> deal2.pdf
    """
    candidate = meta_path

    # Remove .json
    if candidate.suffix.lower() == ".json":
        candidate = candidate.with_suffix("")   # -> *.metadata

    # Remove .metadata
    if candidate.suffix.lower() == ".metadata":
        candidate = candidate.with_suffix("")   # -> *.docx / *.pdf

    return candidate if candidate.is_file() else None


def split_account_name(account_name: str):
    """
    Split 'Volvo Car - Sweden' into ('Volvo Car', 'Sweden').
    If no '-', return ('Volvo Car', None) so we only make one folder.
    """
    if not account_name:
        return None, None

    parts = account_name.split("-")
    if len(parts) >= 2:
        main = parts[0].strip()
        sub = "-".join(parts[1:]).strip()  # handle extra '-' safely
        return main, sub
    else:
        return account_name.strip(), None


def process_all_metadata(source_root: Path, dest_root: Path):
    print(f"[INFO] SOURCE_ROOT = {source_root}")
    print(f"[INFO] DEST_ROOT   = {dest_root}")
    dest_root.mkdir(parents=True, exist_ok=True)

    total_meta = 0
    total_processed = 0

    print("[INFO] Scanning for *.pdf.metadata.json and *.docx.metadata.json recursively...")
    for meta_path in source_root.rglob("*.metadata.json"):
        total_meta += 1
        print(f"\n[DEBUG] Found metadata file: {meta_path}")

        name_lower = meta_path.name.lower()
        if not (name_lower.endswith("pdf.metadata.json") or name_lower.endswith("docx.metadata.json")):
            print("[DEBUG] Skipping: not pdf.metadata.json or docx.metadata.json")
            continue

        # Find original .pdf or .docx file with same base name
        orig_file = find_original_file_from_metadata(meta_path)
        if not orig_file:
            print(f"[WARN] Original file for {meta_path} not found, skipping.")
            continue

        if orig_file.suffix.lower() not in [".pdf", ".docx"]:
            print(f"[DEBUG] Skipping: original file is not .pdf or .docx ({orig_file.suffix})")
            continue

        print(f"[DEBUG] Matched original file: {orig_file}")

        # Parse metadata JSON
        try:
            data = parse_metadata_file(meta_path)
        except Exception as e:
            print(f"[ERROR] Could not parse metadata {meta_path}: {e}")
            continue

        # Get Account_name or close variants
        account_name = get_meta_value(
            data,
            "Account_name",
            "Accountname",
            "AccountName",
            "account_name",
            "account",
        )

        print(f"[DEBUG] Account_name from metadata: {account_name}")

        if not account_name:
            print(f"[WARN] No Account_name in metadata {meta_path}, skipping.")
            continue

        main_name, sub_name = split_account_name(account_name)
        print(f"[DEBUG] Split account into main='{main_name}', sub='{sub_name}'")

        main_folder = sanitize_folder_name(main_name) if main_name else "UNKNOWN_ACCOUNT"
        dest_folder = dest_root / main_folder

        if sub_name:
            sub_folder = sanitize_folder_name(sub_name)
            dest_folder = dest_folder / sub_folder

        dest_folder.mkdir(parents=True, exist_ok=True)

        # Keep the original file name (deal1.docx, deal2.pdf, etc.)
        dest_file = dest_folder / orig_file.name

        # If that file already exists, add suffix _1, _2, ...
        if dest_file.exists():
            base = dest_file.stem
            ext = dest_file.suffix
            counter = 1
            print("[DEBUG] Destination file exists, adding numeric suffix...")
            while dest_file.exists():
                dest_file = dest_folder / f"{base}_{counter}{ext}"
                counter += 1

        try:
            shutil.copy2(orig_file, dest_file)
            total_processed += 1
            print(f"[OK] Copied {orig_file} -> {dest_file}")
        except Exception as e:
            print(f"[ERROR] Copy failed {orig_file} -> {dest_file}: {e}")

    print("\n========== SUMMARY ==========")
    print(f"Total metadata files seen:    {total_meta}")
    print(f"Total files processed/copied: {total_processed}")
    print("================================")


if __name__ == "__main__":
    process_all_metadata(SOURCE_ROOT, DEST_ROOT)
