CHUNK_SIZE    = 1200
CHUNK_OVERLAP = 150


def load_metadata_for_file(doc_path: Path) -> Optional[dict]:

    meta_candidates = [
        doc_path.with_name(doc_path.name + ".metadata.json"),
        doc_path.with_name(doc_path.name + ".metadata"),
    ]

    for meta_path in meta_candidates:
        if not meta_path.exists():
            continue

        try:
            text = meta_path.read_text(encoding="utf-8", errors="ignore").strip()
            data = json.loads(text)
        except Exception as e:
            print(f"Failed to read metadata for {doc_path} from {meta_path}: {e}")
            continue

        meta_block = (
            data.get("metadataAtrributes")    # exact key you mentioned
            or data.get("metadataAttributes") # fallback for spelling variant
            or data                          # fallback: whole dict
        )
        return meta_block

    return None


def clean_text(t: str) -> str:
   
    return re.sub(r"[ \t]+\n", "\n", t or "").strip()


def chunk_text(
    text: str,
    chunk_size: int = CHUNK_SIZE,
    overlap: int = CHUNK_OVERLAP
) -> List[Tuple[int, int, str]]:
 
    text = text or ""
    n = len(text)
    if n <= chunk_size:
        return [(0, n, text)]
    chunks = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        chunk = text[start:end]
        chunks.append((start, end, chunk))
        if end == n:
            break
        start = max(0, end - overlap)
    return chunks


@dataclass
class DocInfo:
    policy_id: str
    source_file: str
    pages: int
    modified_time: int
    metadata: Optional[dict] = None


def local_path_to_s3_key(path: Path) -> Optional[str]:
   
    try:
        rel = path.resolve().relative_to(LOCAL_DOC_ROOT.resolve())
    except ValueError:
        print(f"[WARN] Path {path} is not under LOCAL_DOC_ROOT {LOCAL_DOC_ROOT}; cannot map to S3 key.")
        return None

    rel_key = rel.as_posix()
    if S3_DOC_PREFIX:
        return f"{S3_DOC_PREFIX.rstrip('/')}/{rel_key}"
    else:
        return rel_key


def scan_category_client_files() -> Dict[str, Dict[str, List[Path]]]:
  
    out: Dict[str, Dict[str, List[Path]]] = {}

    for category, root in CATEGORY_ROOTS.items():
        if not root.exists():
            print(f"[WARN] Category root does not exist: {root}")
            continue

        cat_map: Dict[str, List[Path]] = {}

        for client_dir in root.iterdir():
            if not client_dir.is_dir():
                continue

            client_id = client_dir.name.strip().lower()

            pdfs  = list(client_dir.rglob("*.pdf"))
            docs  = list(client_dir.rglob("*.doc")) + list(client_dir.rglob("*.docx"))
            files = sorted(pdfs + docs, key=lambda p: p.name.lower())

            if not files:
                continue

            cat_map.setdefault(client_id, []).extend(files)

        if cat_map:
            out[category] = cat_map

    return out



def embedder():
    return BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=SESSION.client("bedrock-runtime")
    )



def is_scanned_pdf(pdf_path: Path, sample_pages: int = 3, char_threshold: int = 50) -> bool:

    try:
        with fitz.open(str(pdf_path)) as doc:
            n_pages = doc.page_count
            if n_pages == 0:
                return True
            to_sample = min(n_pages, sample_pages)
            total_chars = 0
            for i in range(to_sample):
                page = doc.load_page(i)
                txt = page.get_text("text") or ""
                total_chars += len(txt.strip())
            if total_chars < char_threshold * to_sample:
                return True
            return False
    except Exception as e:
        print(f"[WARN] Failed to inspect {pdf_path} for scanned detection: {e}")
        # If we can't read text at all, treat as scanned to push through Textract
        return True



def _yield_textract_chunks_with_loader(
    pdf_path: Path,
    category: str,
    client_id: str,
    policy_id: str,
) -> Iterable[Document]:
   
    s3_key = local_path_to_s3_key(pdf_path)
    if not s3_key:
        print(f"[WARN] Could not map {pdf_path} to S3 key; skipping Textract loader.")
        return

    s3_uri = f"s3://{S3_DOC_BUCKET}/{s3_key}"
    print(f"[TEXTRACT] Using AmazonTextractPDFLoader for {s3_uri}")

    try:
        loader = AmazonTextractPDFLoader(
            file_path=s3_uri,        # S3 URI
            client=TEXTRACT_CLIENT,  # existing boto3 textract client
        )
        tex_docs = loader.load()    # List[Document]
    except Exception as e:
        print(f"[WARN] AmazonTextractPDFLoader failed for {pdf_path}: {e}")
        return

    if not tex_docs:
        print(f"[WARN] AmazonTextractPDFLoader returned no docs for {pdf_path}")
        return

    concatenated = ""
    page_ranges: List[Tuple[int, int, int]] = []  # (start_char, end_char, page_num)
    cursor = 0

    for d in tex_docs:
        txt = clean_text(d.page_content or "")
        if not txt:
            continue

        # Try to get the real page number from loader metadata
        page_num = 1
        if isinstance(d.metadata, dict) and "page" in d.metadata:
            try:
                page_num = int(d.metadata["page"])
            except Exception:
                pass

        start = cursor
        concatenated += txt + "\n"
        cursor = len(concatenated)
        page_ranges.append((start, cursor, page_num))

    if not concatenated.strip():
        print(f"[WARN] Empty text after Textract loader for {pdf_path}")
        return

    # Chunk across pages & preserve page_start/page_end
    for c_start, c_end, chunk in chunk_text(concatenated):
        pages = sorted({
            page_num
            for p_start, p_end, page_num in page_ranges
            if not (p_end <= c_start or p_start >= c_end)
        })
        if not pages:
            continue

        meta = {
            "category": category,
            "client_id": client_id,
            "policy_id": policy_id,
            "page_start": pages[0],
            "page_end": pages[-1],
            "source_file": str(pdf_path.resolve()),
            "extracted_by": "amazon_textract_loader",
        }
        yield Document(page_content=chunk, metadata=meta)


def make_chunks_for_pdf(pdf_path: Path, category: str, client_id: str) -> Iterable[Document]:

    policy_id = pdf_path.name
    scanned = is_scanned_pdf(pdf_path)

    # CASE 1: scanned or unknown => Textract loader
    if scanned:
        yield from _yield_textract_chunks_with_loader(pdf_path, category, client_id, policy_id)
        return

    # CASE 2: non-scanned => PyMuPDF, with Textract fallback on error
    try:
        with fitz.open(str(pdf_path)) as doc:
            page_count = doc.page_count
            for pnum in range(page_count):
                try:
                    page = doc.load_page(pnum)
                    text = clean_text(page.get_text("text") or "")
                except Exception as e:
                    print(
                        f"[WARN] PyMuPDF failed on page {pnum+1}/{page_count} of {pdf_path}: {e}. "
                        f"Falling back to Textract loader for entire file."
                    )
                    # Fallback: Textract via S3 for the whole file
                    yield from _yield_textract_chunks_with_loader(pdf_path, category, client_id, policy_id)
                    return

                if not text.strip():
                    continue

                for _, _, chunk in chunk_text(text):
                    meta = {
                        "category": category,
                        "client_id": client_id,
                        "policy_id": policy_id,
                        "page": pnum + 1,
                        "source_file": str(pdf_path.resolve()),
                        "extracted_by": "pymupdf",
                    }
                    yield Document(page_content=chunk, metadata=meta)
    except Exception as e:
        print(
            f"yMuPDF could not open/process {pdf_path} at all: {e}. "
            f"Falling back to Textract loader."
        )
        yield from _yield_textract_chunks_with_loader(pdf_path, category, client_id, policy_id)



def make_chunks_for_docx(doc_path: Path, category: str, client_id: str) -> Iterable[Document]:
  
    if not _HAS_PYTHON_DOCX:
        print(f"[WARN] python-docx not available; skipping {doc_path}")
        return

    if doc_path.suffix.lower() != ".docx":
        print(f"[WARN] Skipping non-DOCX file in DOCX handler: {doc_path}")
        return

    policy_id = doc_path.name
    print(f"[DEBUG] Starting DOCX extraction (python-docx) for {doc_path}")

    try:
        doc = DocxDocument(str(doc_path))
    except Exception as e:
        print(f"[WARN] Failed to open DOCX {doc_path} with python-docx: {e}")
        return

    # Collect all paragraph texts
    texts = []
    for para in doc.paragraphs:
        t = (para.text or "").strip()
        if t:
            texts.append(t)

    full_text = "\n".join(texts).strip()
    if not full_text:
        print(f"[DEBUG] No text found in DOCX {doc_path}")
        return

    chunks = chunk_text(full_text)  # [(start, end, chunk_text), ...]
    print(f"[DEBUG] Generated {len(chunks)} chunks for DOCX {doc_path}")

    for logical_page, (_, _, chunk) in enumerate(chunks, start=1):
        meta = {
            "category": category,
            "client_id": client_id,
            "policy_id": policy_id,
            "page": logical_page,  # logical chunk index
            "source_file": str(doc_path.resolve()),
            "extracted_by": "python-docx",
        }
        yield Document(page_content=chunk, metadata=meta)


def make_chunks_for_file(path: Path, category: str, client_id: str) -> Iterable[Document]:
    suf = path.suffix.lower()
    if suf == ".pdf":
        yield from make_chunks_for_pdf(path, category, client_id)
    elif suf in (".doc", ".docx"):
        yield from make_chunks_for_docx(path, category, client_id)
    else:
        print(f"[INFO] Skipping unsupported file type: {path}")



def build_manifest_entry(path: Path) -> DocInfo:
    pages = 0
    if path.suffix.lower() == ".pdf":
        try:
            with fitz.open(str(path)) as doc:
                pages = doc.page_count
        except Exception:
            pages = 0

    stat = path.stat()
    meta = load_metadata_for_file(path)  # file-wise metadata (optional)

    return DocInfo(
        policy_id=path.name,
        source_file=str(path.resolve()),
        pages=pages,
        modified_time=int(stat.st_mtime),
        metadata=meta,
    )

def index_client(category: str, client_id: str, files: List[Path]) -> None:
    client_dir = FAISS_INDEX_DIR / category / client_id
    client_dir.mkdir(parents=True, exist_ok=True)

    docs: List[Document] = []
    manifest_rows: List[DocInfo] = []

    for path in files:
        print(f"[{category}/{client_id}] Processing {path}")
        manifest_rows.append(build_manifest_entry(path))
        for doc in make_chunks_for_file(path, category, client_id):
            docs.append(doc)

    if not docs:
        print(f"[{category}/{client_id}] No extractable text; skipping index.")
        return

    print(f"[{category}/{client_id}] Building FAISS with {len(docs)} chunks…")
    vs = FAISS.from_documents(docs, embedder())
    vs.save_local(str(client_dir))

    manifest = {
        "category": category,
        "client_id": client_id,
        "docs": [
            {
                "policy_id": m.policy_id,
                "source_file": m.source_file,
                "pages": m.pages,
                "modified_time": m.modified_time,
                "metadata": m.metadata,
            }
            for m in manifest_rows
        ],
        "generated_time": int(time.time()),
    }

    (client_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2), encoding="utf-8"
    )
    print(f"[{category}/{client_id}] Done. Index at {client_dir}")


def main():
    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)

    by_cat_client = scan_category_client_files()
    if not by_cat_client:
        print("No files (PDF/DOC/DOCX) found under any category root.")
        return

    for category, clients in by_cat_client.items():
        for client_id, files in clients.items():
            print(f"\n==== Indexing {category}/{client_id} with {len(files)} file(s) ====")
            index_client(category, client_id, files)

if __name__ == "__main__":
    main()
