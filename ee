import json
import shutil
import re
from pathlib import Path

# === CONFIGURE THIS ===
# Root that contains your folders (inside which there is e.g. "finance" and metadata files)
SOURCE_ROOT = Path(r"/path/to/root")
# Where you want the Account_name folders to be created:
DEST_ROOT = SOURCE_ROOT.parent / "output_by_account"

# Optional: only process metadata under a folder with this name (case-insensitive).
# Set to None to disable this filter.
FILTER_FOLDER_NAME = "finance"   # or None
# ======================


def parse_metadata_file(meta_path: Path) -> dict:
    """
    Try JSON first (most likely), fall back to simple key=value lines.
    """
    text = meta_path.read_text(encoding="utf-8", errors="ignore").strip()

    # Try JSON
    try:
        data = json.loads(text)
        if isinstance(data, dict):
            return data
    except json.JSONDecodeError:
        print(f"[DEBUG] {meta_path} is not valid JSON, trying key=value format")

    # Fallback: key=value format
    data = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, value = line.split("=", 1)
            data[key.strip()] = value.strip()
    return data


def get_meta_value(data: dict, *possible_keys, default=None):
    """
    Case-insensitive lookup for any of the possible keys.
    """
    lowered = {k.lower(): v for k, v in data.items()}
    for key in possible_keys:
        if key is None:
            continue
        v = lowered.get(key.lower())
        if v is not None:
            return v
    return default


def sanitize_for_path(value: str) -> str:
    """
    Make a safe folder name: spaces -> underscores, remove bad chars.
    """
    if value is None:
        return ""
    value = value.strip()
    value = re.sub(r"\s+", "_", value)              # spaces to underscores
    value = re.sub(r'[<>:"/\\|?*]', "_", value)     # remove invalid chars
    return value


def find_original_file_from_metadata(meta_path: Path) -> Path | None:
    """
    Given:
      - abcd.pdf.metadata
      - abcd.pdf.metadata.json
    return:
      - abcd.pdf
    (same logic for docx)
    """
    candidate = meta_path

    # Strip .json if present
    if candidate.suffix.lower() == ".json":
        candidate = candidate.with_suffix("")   # remove .json  -> *.metadata

    # Strip .metadata if present
    if candidate.suffix.lower() == ".metadata":
        candidate = candidate.with_suffix("")   # remove .metadata -> *.pdf / *.docx

    return candidate if candidate.is_file() else None


def process_all_metadata(source_root: Path, dest_root: Path):
    print(f"[INFO] SOURCE_ROOT = {source_root}")
    print(f"[INFO] DEST_ROOT   = {dest_root}")
    dest_root.mkdir(parents=True, exist_ok=True)

    total_meta = 0
    total_processed = 0

    # Look for *.metadata and *.metadata.json
    print("[INFO] Scanning for *.metadata and *.metadata.json files...")
    for meta_path in source_root.rglob("*.metadata*"):
        total_meta += 1
        print(f"\n[DEBUG] Found metadata candidate: {meta_path}")

        # Optional finance filter
        if FILTER_FOLDER_NAME:
            parts_lower = [p.lower() for p in meta_path.parts]
            if FILTER_FOLDER_NAME.lower() not in parts_lower:
                print(f"[DEBUG] Skipping: path does not contain '{FILTER_FOLDER_NAME}'")
                continue

        # Only if it looks like pdf/docx metadata
        name_lower = meta_path.name.lower()
        if not (
            ".pdf.metadata" in name_lower or ".docx.metadata" in name_lower
        ):
            print("[DEBUG] Skipping: not pdf/docx metadata (name doesn't contain .pdf.metadata or .docx.metadata)")
            continue

        orig_file = find_original_file_from_metadata(meta_path)
        if not orig_file:
            print(f"[WARN] Original file for {meta_path} not found, skipping.")
            continue

        if orig_file.suffix.lower() not in [".pdf", ".docx"]:
            print(f"[DEBUG] Skipping: original file is not .pdf or .docx ({orig_file.suffix})")
            continue

        print(f"[DEBUG] Matched original file: {orig_file}")

        # Read metadata
        try:
            data = parse_metadata_file(meta_path)
        except Exception as e:
            print(f"[ERROR] Could not parse metadata {meta_path}: {e}")
            continue

        # Find Account_name (and some common variants)
        account_name = get_meta_value(
            data,
            "Account_name",
            "Accountname",
            "AccountName",
            "account_name",
            "account"
        )

        print(f"[DEBUG] Account_name from metadata: {account_name}")

        if not account_name:
            print(f"[WARN] No Account_name in metadata {meta_path}, skipping.")
            continue

        account_folder_name = sanitize_for_path(account_name)
        dest_folder = dest_root / account_folder_name
        dest_folder.mkdir(parents=True, exist_ok=True)

        dest_file = dest_folder / orig_file.name  # keep original filename

        # If same filename already there, add a suffix
        if dest_file.exists():
            base = dest_file.stem
            ext = dest_file.suffix
            counter = 1
            print("[DEBUG] Destination file exists, adding numeric suffix...")
            while dest_file.exists():
                dest_file = dest_folder / f"{base}_{counter}{ext}"
                counter += 1

        try:
            shutil.copy2(orig_file, dest_file)
            total_processed += 1
            print(f"[OK] Copied {orig_file} -> {dest_file}")
        except Exception as e:
            print(f"[ERROR] Copy failed {orig_file} -> {dest_file}: {e}")

    print("\n========== SUMMARY ==========")
    print(f"Total metadata files seen:   {total_meta}")
    print(f"Total files processed/copied:{total_processed}")
    print("================================")


if __name__ == "__main__":
    process_all_metadata(SOURCE_ROOT, DEST_ROOT)
