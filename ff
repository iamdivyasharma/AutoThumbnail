from __future__ import annotations

import os
import re
import time
from pathlib import Path
from typing import Dict, List, Tuple, Iterable
from urllib.parse import urlparse

import boto3
import fitz  # PyMuPDF

from langchain.schema import Document
from langchain_community.vectorstores import FAISS
from langchain_community.document_loaders import AmazonTextractPDFLoader
from langchain_aws import BedrockEmbeddings


# ========================= CONFIG =========================
REGION = os.environ.get("AWS_REGION", "us-east-1")
EMBED_MODEL = os.environ.get("EMBED_MODEL", "amazon.titan-embed-text-v2:0")

# Local: greenlight/gl_to13/<CLIENT_FOLDER>/*.pdf
LOCAL_PDF_ROOT = Path(os.environ.get("LOCAL_PDF_ROOT", "greenlight/gl_to13")).resolve()

# S3: s3://bucket/ALL_PDFS/<CLIENT_FOLDER>/<same_filename>.pdf
S3_ROOT_URI = os.environ.get("S3_ROOT_URI", "s3://YOUR_BUCKET/ALL_PDFS/")

# Output: FAISS_INDEX_DIR/<CLIENT_FOLDER>/
FAISS_INDEX_DIR = Path(os.environ.get("FAISS_INDEX_DIR", "/opt/ml/processing/faiss_indices")).resolve()

CHUNK_SIZE = int(os.environ.get("CHUNK_SIZE", "1200"))
CHUNK_OVERLAP = int(os.environ.get("CHUNK_OVERLAP", "150"))

SCAN_PAGES_TO_CHECK = int(os.environ.get("SCAN_PAGES_TO_CHECK", "3"))
SCAN_TEXT_MIN_CHARS_PER_PAGE = int(os.environ.get("SCAN_TEXT_MIN_CHARS_PER_PAGE", "80"))
SCAN_TOTAL_TEXT_MIN_CHARS = int(os.environ.get("SCAN_TOTAL_TEXT_MIN_CHARS", "150"))
# ==========================================================


def clean_text(t: str) -> str:
    t = t or ""
    t = re.sub(r"[ \t]+\n", "\n", t)
    return t.strip()


def chunk_text(text: str, chunk_size: int, overlap: int) -> List[Tuple[int, int, str]]:
    text = text or ""
    n = len(text)
    if n <= chunk_size:
        return [(0, n, text)]

    out: List[Tuple[int, int, str]] = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        out.append((start, end, text[start:end]))
        if end == n:
            break
        start = end - overlap
        if start < 0:
            start = 0
    return out


def parse_s3_uri(s3_uri: str) -> tuple[str, str]:
    if not s3_uri.startswith("s3://"):
        raise ValueError(f"Invalid S3 URI: {s3_uri}")
    p = urlparse(s3_uri)
    return p.netloc, p.path.lstrip("/")


def ensure_trailing_slash(prefix: str) -> str:
    return prefix if (not prefix or prefix.endswith("/")) else prefix + "/"


def s3_uri_from_local_path(local_pdf: Path) -> str:
    """
    ✅ Correct mapping:
    local: LOCAL_PDF_ROOT/<CLIENT_FOLDER>/file.pdf
    s3:    S3_ROOT_URI/<CLIENT_FOLDER>/file.pdf

    Preserves CLIENT_FOLDER case exactly as local.
    """
    bucket, s3_prefix = parse_s3_uri(S3_ROOT_URI)
    s3_prefix = ensure_trailing_slash(s3_prefix)

    rel = local_pdf.relative_to(LOCAL_PDF_ROOT).as_posix()  # preserves folder case
    key = f"{s3_prefix}{rel}"
    return f"s3://{bucket}/{key}"


def scan_local_pdfs_by_client_folder(root: Path) -> Dict[str, List[Path]]:
    """
    ✅ Client id = folder name exactly (NO lowercasing)
    """
    out: Dict[str, List[Path]] = {}
    for client_dir in sorted([p for p in root.iterdir() if p.is_dir()], key=lambda x: x.name):
        client_id = client_dir.name  # keep case
        pdfs = sorted(list(client_dir.rglob("*.pdf")), key=lambda x: x.name)
        if pdfs:
            out[client_id] = pdfs
    return out


def is_scanned_pdf(local_pdf: Path) -> bool:
    """
    If first N pages contain almost no native text => scanned.
    """
    try:
        with fitz.open(str(local_pdf)) as doc:
            pages_to_check = min(doc.page_count, max(1, SCAN_PAGES_TO_CHECK))
            total_chars = 0
            any_good_page = False

            for i in range(pages_to_check):
                page = doc.load_page(i)
                txt = clean_text(page.get_text("text") or "")
                total_chars += len(txt)
                if len(txt) >= SCAN_TEXT_MIN_CHARS_PER_PAGE:
                    any_good_page = True

            if any_good_page:
                return False

            return total_chars < SCAN_TOTAL_TEXT_MIN_CHARS
    except Exception:
        return True


def extract_native_pymupdf_chunks(local_pdf: Path, client_id: str) -> Iterable[Document]:
    filename = local_pdf.name
    with fitz.open(str(local_pdf)) as doc:
        for pnum in range(doc.page_count):
            page = doc.load_page(pnum)
            text = clean_text(page.get_text("text") or "")
            if not text:
                continue

            for _, _, chunk in chunk_text(text, CHUNK_SIZE, CHUNK_OVERLAP):
                yield Document(
                    page_content=chunk,
                    metadata={
                        "client_id": client_id,
                        "policy_id": filename,
                        "page": pnum + 1,
                        "local_file": str(local_pdf),
                        "extracted_by": "pymupdf",
                    },
                )


def extract_textract_chunks(s3_pdf_uri: str, client_id: str, local_pdf: Path) -> Iterable[Document]:
    """
    ✅ Uses exactly:
       AmazonTextractPDFLoader(s3_uri)
    """
    filename = local_pdf.name

    loader = AmazonTextractPDFLoader(s3_pdf_uri)
    page_docs = loader.load()

    for d in page_docs:
        page_text = clean_text(d.page_content or "")
        if not page_text:
            continue

        page_num = None
        if isinstance(d.metadata, dict):
            page_num = d.metadata.get("page") or d.metadata.get("Page")

        for _, _, chunk in chunk_text(page_text, CHUNK_SIZE, CHUNK_OVERLAP):
            meta = {
                "client_id": client_id,
                "policy_id": filename,
                "source_file": s3_pdf_uri,
                "local_file": str(local_pdf),
                "extracted_by": "textract",
            }
            if page_num is not None:
                try:
                    meta["page"] = int(page_num)
                except Exception:
                    pass
            yield Document(page_content=chunk, metadata=meta)


def get_embeddings() -> BedrockEmbeddings:
    bedrock_runtime = boto3.client("bedrock-runtime", region_name=REGION)
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=bedrock_runtime)


def index_one_client(client_id: str, local_pdfs: List[Path], embeddings: BedrockEmbeddings) -> None:
    client_dir = FAISS_INDEX_DIR / client_id
    client_dir.mkdir(parents=True, exist_ok=True)

    all_chunks: List[Document] = []
    t0 = time.time()

    for local_pdf in local_pdfs:
        scanned = is_scanned_pdf(local_pdf)
        s3_uri = s3_uri_from_local_path(local_pdf)

        if scanned:
            print(f"[{client_id}] Scanned -> Textract: {local_pdf.name}")
            print(f"           ✅ S3 URI: {s3_uri}")
            for d in extract_textract_chunks(s3_uri, client_id, local_pdf):
                all_chunks.append(d)
        else:
            print(f"[{client_id}] Native -> PyMuPDF: {local_pdf.name}")
            for d in extract_native_pymupdf_chunks(local_pdf, client_id):
                all_chunks.append(d)

    if not all_chunks:
        print(f"[{client_id}] No chunks extracted. Skipping.")
        return

    print(f"[{client_id}] Building FAISS with {len(all_chunks)} chunks...")
    vs = FAISS.from_documents(all_chunks, embeddings)
    vs.save_local(str(client_dir))

    print(f"[{client_id}] ✅ Saved FAISS at: {client_dir} (took {time.time() - t0:.1f}s)")


def main():
    if not LOCAL_PDF_ROOT.exists():
        raise SystemExit(f"LOCAL_PDF_ROOT not found: {LOCAL_PDF_ROOT}")

    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)

    local_by_client = scan_local_pdfs_by_client_folder(LOCAL_PDF_ROOT)
    if not local_by_client:
        print("No local client folders found.")
        return

    embeddings = get_embeddings()

    for client_id, pdfs in local_by_client.items():
        print(f"\n=== Indexing: {client_id} ({len(pdfs)} PDFs) ===")
        index_one_client(client_id, pdfs, embeddings)


if __name__ == "__main__":
    main()
