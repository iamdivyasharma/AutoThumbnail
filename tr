# NOTE: change host/ports or switch to your SageMaker proxy URLs if needed.
MCP_CONFIG: Dict[str, dict] = {
    "hotel": {"transport": {"type": "streamable_http", "url": "http://127.0.0.1:9001/mcp"}},
    "air":   {"transport": {"type": "streamable_http", "url": "http://127.0.0.1:9002/mcp"}},
    "tdna":  {"transport": {"type": "streamable_http", "url": "http://127.0.0.1:9003/mcp"}},
}

# Optional: “domain alias” to “preferred tool name” hints. If a preferred tool
# isn’t found via discovery, we’ll just pick the first available tool.
PREFERRED_TOOL_NAME = {
    "hotel": "hotel_query_tool",
    "air":   "air_query_tool",
    "tdna":  "tdna_query_tool",
}

# ───────────────────────────────────────────────────────────────────────────────
#                            LIGHTWEIGHT ORCHESTRATION
# ───────────────────────────────────────────────────────────────────────────────
def heuristic_route(q: str) -> List[str]:
    s = q.lower()
    air   = any(w in s for w in ("flight","flights","air","airline","pnr","fare","seat","airport"))
    hotel = any(w in s for w in ("hotel","room","rooms","stay","booking","reservation","amenities","check-in","check out"))
    tdna  = any(w in s for w in ("tdna","dna","genome","variant","gene","sequence","omics"))
    picks = []
    if air: picks.append("air")
    if hotel: picks.append("hotel")
    if tdna: picks.append("tdna")
    return picks or ["hotel"]

def compose(user_q: str, per_target: Dict[str, Any]) -> str:
    parts = []
    for k in ("hotel","air","tdna"):
        if k in per_target:
            parts.append(f"{k}: {per_target[k]}")
    return " | ".join(map(str, parts)) if parts else "No result."

# ───────────────────────────────────────────────────────────────────────────────
#                                 MEMORY + CACHE
# ───────────────────────────────────────────────────────────────────────────────
MEM: Dict[str, Dict[str, Any]] = defaultdict(lambda: {"history": deque(maxlen=20), "created": time()})
def mem_add(sid: str, role: str, content: Any):
    MEM[sid]["history"].append({"role": role, "content": content, "ts": time()})
def mem_get(sid: str, k: int = 10) -> List[Dict[str, Any]]:
    hist = list(MEM[sid]["history"]); return hist[-k:] if k else hist
def mem_clear(sid: str): MEM.pop(sid, None)

