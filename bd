# pip install boto3 langchain

import json
import boto3
from typing import Any, Dict, List, Optional
from langchain.llms.base import LLM
from langchain.callbacks.manager import CallbackManagerForLLMRun

class BedrockInvokeLLM(LLM):
    """
    LangChain LLM wrapper that calls Bedrock's invoke_model.
    Supports Anthropic Claude 3 and Amazon Titan Text.
    """

    def __init__(
        self,
        model_id: str,
        model_kwargs: Optional[Dict[str, Any]] = None,
        region_name: str = "us-east-1",
    ):
        super().__init__()
        self.model_id = model_id
        self.model_kwargs = model_kwargs or {}

        # 🔑 Hardcoded AWS credentials
        self.client = boto3.client(
            "bedrock-runtime",
            region_name=region_name,
            aws_access_key_id="YOUR_ACCESS_KEY_HERE",
            aws_secret_access_key="YOUR_SECRET_KEY_HERE",
            # If you use temporary credentials, you can also add:
            # aws_session_token="YOUR_SESSION_TOKEN_HERE"
        )

    @property
    def _llm_type(self) -> str:
        return "bedrock-invoke"

    @property
    def _identifying_params(self) -> Dict[str, Any]:
        return {"model_id": self.model_id, **self.model_kwargs}

    def _build_body(self, prompt: str) -> Dict[str, Any]:
        mid = self.model_id.lower()

        if "anthropic" in mid or "claude" in mid:
            return {
                "messages": [
                    {"role": "user", "content": [{"type": "text", "text": prompt}]}
                ],
                "max_tokens": self.model_kwargs.get("max_tokens", 512),
                "temperature": self.model_kwargs.get("temperature", 0),
                "top_p": self.model_kwargs.get("top_p", 0.9),
            }

        if "titan-text" in mid:
            return {
                "inputText": prompt,
                "textGenerationConfig": {
                    "maxTokenCount": self.model_kwargs.get("max_tokens", 512),
                    "temperature": self.model_kwargs.get("temperature", 0),
                    "topP": self.model_kwargs.get("top_p", 0.9),
                },
            }

        return {
            "prompt": prompt,
            "max_tokens": self.model_kwargs.get("max_tokens", 512),
            "temperature": self.model_kwargs.get("temperature", 0),
        }

    def _parse_text(self, response_json: Dict[str, Any]) -> str:
        if "content" in response_json:
            for block in response_json["content"]:
                if block.get("type") == "text":
                    return block.get("text", "")
        if "results" in response_json and response_json["results"]:
            return response_json["results"][0].get("outputText", "")
        if "outputText" in response_json:
            return response_json["outputText"]
        if "completion" in response_json:
            return response_json["completion"]
        if "generation" in response_json:
            return response_json["generation"]
        return json.dumps(response_json)

    def _call(
        self,
        prompt: str,
        stop: Optional[List[str]] = None,
        run_manager: Optional[CallbackManagerForLLMRun] = None,
        **kwargs: Any,
    ) -> str:
        if stop:
            self.model_kwargs["stop"] = stop

        body = self._build_body(prompt)
        resp = self.client.invoke_model(
            modelId=self.model_id,
            contentType="application/json",
            accept="application/json",
            body=json.dumps(body),
        )
        payload = json.loads(resp["body"].read())
        text = self._parse_text(payload)

        if stop:
            for s in stop:
                if s in text:
                    text = text.split(s)[0]
                    break
        return text
