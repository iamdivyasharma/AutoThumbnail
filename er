def _env_bool(name: str, default: bool = False) -> bool:
    v = os.getenv(name, "")
    if v == "": return default
    return v.strip().lower() in ("1","true","yes","on")

LOG_LEVEL = os.getenv("LOG_LEVEL", "DEBUG" if _env_bool("DEBUG", False) else "INFO").upper()
