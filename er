# ============================================================

_SESSION_MEMORY: Dict[str, Dict[str, Any]] = {}


# ============================================================
# Pydantic Models
# ============================================================

class MetadataLookupRequest(BaseModel):
    query: str = Field(..., description="Natural language query like: 'capid for google us'")
    category: Optional[str] = Field(default="finance", description="finance or legal")
    country: Optional[str] = Field(default=None, description="US, UK, INDIA, etc.")
    use_llm: bool = Field(default=False, description="If true, return a natural language answer using Bedrock LLM")
    session_id: Optional[str] = Field(default=None, description="Session id for follow-up queries (optional)")
    limit: Optional[int] = Field(default=None, description="Max matches to return")


class MetadataLookupResponse(BaseModel):
    session_id: str
    query: str
    category: str
    country: Optional[str]
    answer_text: Optional[str]
    top_matches: List[Dict[str, Any]]
    scopes: List[str]
    docs_preview: List[Dict[str, Any]]


