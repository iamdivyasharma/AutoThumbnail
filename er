@app.post("/_debug/ping")
async def debug_ping(payload: Dict[str, Any] = Body(...)):
    """
    Call a specific MCP tool with an arbitrary payload.
    Body:
      {
        "server": "hotel",
        "tool": "hotel_query_tool",
        "payload": {"qquery": "bangalore"}
      }
