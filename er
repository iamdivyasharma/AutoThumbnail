def _redact(obj: Any, redact_keys: set = REDACT_KEYS, depth: int = 0) -> Any:
    """Recursively redact sensitive keys."""
    try:
        if obj is None or isinstance(obj, (int, float, bool)):
            return obj
        if isinstance(obj, str):
            return obj if len(obj) <= 2048 else obj[:2048] + "…"
        if isinstance(obj, dict):
            out = {}
            for k, v in obj.items():
                if str(k).lower() in redact_keys:
                    out[k] = "***REDACTED***"
                else:
                    out[k] = _redact(v, redact_keys, depth+1)
            return out
        if isinstance(obj, (list, tuple)):
            return [ _redact(v, redact_keys, depth+1) for v in obj ]
        # Fallback: render as string (shorten)
        s = str(obj)
        return s if len(s) <= 2048 else s[:2048] + "…"
    except Exception:
        return "***REDACTION_ERROR***"

def _log_json(title: str, data: Any, level=logging.DEBUG):
    if log.isEnabledFor(level):
        try:
            log.log(level, "%s %s", title, json.dumps(_redact(data), ensure_ascii=False, indent=2))
        except Exception:
            log.log(level, "%s %s", title, _redact(data))

def _exc_full(e: BaseException) -> str:
    return "".join(traceback.format_exception(type(e), e, e.__traceback__))

def _timed(fn):
    async def wrapper(*args, **kwargs):
        t0 = time.perf_counter()
        try:
            res = await fn(*args, **kwargs)
            dt = (time.perf_counter()-t0)*1000
            log.debug("%s took %.2f ms", fn.__name__, dt)
            return res
        except Exception as e:
            dt = (time.perf_counter()-t0)*1000
            log.error("%s raised after %.2f ms: %s\n%s", fn.__name__, dt, e, _exc_full(e))
            raise
    return wrapper

