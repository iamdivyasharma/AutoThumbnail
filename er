svc.ensure_loaded()


# ============================================================
# LLM Answer builder (optional)
# ============================================================

def _llm_answer_from_lookup(query: str, lookup_result: Dict[str, Any], session_mem: Dict[str, Any]) -> str:
    """
    Takes lookup_result dict (top_matches + scopes + docs_preview),
    and asks Claude to format the final human answer.
    """
    # Keep it deterministic
    system = (
        "You are a metadata assistant. "
        "You must answer ONLY from the provided structured result. "
        "If CAPID/CID is not present, say it is not found. "
        "If multiple matches exist, list them and ask for country clarification. "
        "Be short and direct."
    )

    # Include memory context
    memory_hint = ""
    if session_mem:
        memory_hint = f"\nSession memory:\n{session_mem}\n"

    user = f"""
User query:
{query}

Lookup result JSON:
{lookup_result}
{memory_hint}

Return the best possible answer for the user.
"""

    # Bedrock Converse format
    body = {
        "messages": [
            {"role": "user", "content": [{"text": user}]}
        ],
        "system": [{"text": system}],
        "inferenceConfig": {
            "temperature": 0.0,
            "maxTokens": 600,
        },
    }

    resp = BEDROCK_RUNTIME.converse(
        modelId=BEDROCK_LLM_MODEL,
        **body
    )

    text_out = resp["output"]["message"]["content"][0]["text"]
    return text_out.strip()


# ============================================================
# Routes
# ============================================================

@app.get("/health")
def health():
    return {"status": "ok"}


@app.post("/api/metadata/lookup", response_model=MetadataLookupResponse)
def metadata_lookup(payload: MetadataLookupRequest):
    if not payload.query or not payload.query.strip():
        raise HTTPException(status_code=400, detail="query is required")

    category = (payload.category or "finance").strip().lower()
    if category not in {"finance", "legal"}:
        raise HTTPException(status_code=400, detail="category must be finance or legal")

    country = payload.country.strip().upper() if payload.country else None
    limit = int(payload.limit or DEFAULT_LIMIT)

    # ✅ session memory
    session_id = payload.session_id or str(uuid.uuid4())
    mem = _SESSION_MEMORY.get(session_id, {})

    # ✅ run deterministic metadata lookup
    result = svc.lookup(
        query=payload.query,
        category=category,
        country=country,
        limit=limit,
    )

    # store memory for followups
    _SESSION_MEMORY[session_id] = {
        "last_query": payload.query,
        "category": category,
        "country": country,
        "scopes": result.get("scopes", []),
        "top_match": (result.get("top_matches") or [{}])[0],
    }

    answer_text = None
    if payload.use_llm:
        try:
            answer_text = _llm_answer_from_lookup(payload.query, result, _SESSION_MEMORY[session_id])
        except Exception as e:
            answer_text = f"(LLM formatting failed: {e})"

    return MetadataLookupResponse(
        session_id=session_id,
        query=payload.query,
        category=category,
        country=country,
        answer_text=answer_text,
        top_matches=result.get("top_matches", []),
        scopes=result.get("scopes", []),
        docs_preview=result.get("docs_preview", []),
    )
