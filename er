#!/usr/bin/env python3
"""
hotel_mcp.py — MCP stdio server using official 'mcp' package.
pip install mcp
"""

import sys, os, asyncio, logging
from typing import Dict, Any

LOG_LEVEL = logging.DEBUG if os.getenv("DEBUG","").lower() in ("1","true","yes","on") else logging.INFO
logging.basicConfig(stream=sys.stderr, level=LOG_LEVEL, format="%(asctime)s | %(levelname)s | hotel-mcp | %(message)s")
log = logging.getLogger("hotel-mcp")

from mcp.server import Server
from mcp.types import Tool, TextContent, CallToolResult

from bot.hotel_bot import hotel_qa_chain

srv = Server("hotel-mcp")

@srv.tool(
    Tool(
        name="hotel_query_tool",
        description="Query hotel availability/prices or QA about hotels. Input field: qquery (string).",
        inputSchema={
            "type": "object",
            "properties": {"qquery": {"type": "string"}},
            "required": ["qquery"],
            "additionalProperties": True,
        },
    )
)
async def hotel_query_tool(qquery: str) -> CallToolResult:
    log.debug("hotel_query_tool called with qquery=%r", qquery)
    try:
        ans = await hotel_qa_chain(qquery) if asyncio.iscoroutinefunction(hotel_qa_chain) else hotel_qa_chain(qquery)
        # Orchestrator looks for 'answer' in dict; we can also send text content.
        return CallToolResult(content=[TextContent(text=f"{ans}")])
    except Exception as e:
        log.exception("hotel_query_tool error: %s", e)
        return CallToolResult(content=[TextContent(text=f"ERROR: {e.__class__.__name__}: {e}")])

if __name__ == "__main__":
    log.info("Starting hotel-mcp (stdio)")
    # IMPORTANT: do not print to stdout except via MCP server
    asyncio.run(srv.run_stdio())

