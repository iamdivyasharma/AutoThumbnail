# FastAPI lifecycle: graceful client close
async def _aclose_client_silent():
    try:
        await mcp_client.aclose()
    except* Exception as eg:
        log.warning("MCP client close errors: %s", _flatten_exc(eg))
    except Exception as e:
        log.warning("MCP client close error: %s", _exc_to_str(e))


# List tools from a session
async def _get_tools_any(session):
    for attr in ("get_tools", "get_all_tools"):
        fn = getattr(session, attr, None)
        if callable(fn):
            try:
                res = await fn()
            except TypeError:
                res = fn()
            tools = [t for _, L in res.items() for t in L] if isinstance(res, dict) else list(res)
            if TRACE_MCP:
                _log_json("[MCP] discovered tools", [getattr(t, "name", "?") for t in tools])
            return tools
    raise RuntimeError("No get_tools/get_all_tools on session")

# Invoke a tool by operation_id on a given server (via MCP) with robust exception handling
@_timed
async def mcp_invoke(server: str, tool_name: str, payload: dict):
    call_id = str(uuid.uuid4())[:8]
    if TRACE_MCP:
        meta = {"server": server, "tool": tool_name, "call_id": call_id}
        _log_json("[MCP] invoke.begin", {"meta": meta, "payload": payload if LOG_PAYLOADS else "***payload suppressed***"})
    try:
        async with mcp_client.session(server) as sess:
            if TRACE_MCP:
                log.debug("[MCP] session opened server=%s call_id=%s", server, call_id)
            tools = await _get_tools_any(sess)
            tool = next((t for t in tools if getattr(t, "name", "") == tool_name), None)
            if tool is None:
                raise RuntimeError(f"Tool {tool_name!r} not found on server {server!r}")

            ainvoke = getattr(tool, "ainvoke", None)
            if callable(ainvoke):
                try:
                    out = await tool.ainvoke(payload)
                except Exception:
                    out = await tool.ainvoke({"input": payload})
            else:
                loop = asyncio.get_running_loop()
                def _call():
                    try: return tool.invoke(payload)
                    except Exception: return tool.invoke({"input": payload})
                out = await loop.run_in_executor(None, _call)

        if TRACE_MCP:
            _log_json("[MCP] invoke.end", {"server": server, "tool": tool_name, "call_id": call_id, "raw": out})
        if isinstance(out, dict):
            return out.get("answer") or out.get("result") or out.get("output") or out.get("content") or out
        return out

    except* Exception as eg:
        msg = f"MCP[{server}:{tool_name}] error: {_flatten_exc(eg)}"
        log.error("%s", msg)
        return msg
    except Exception as e:
        msg = f"MCP[{server}:{tool_name}] error: {_exc_to_str(e)}"
        log.error("%s\n%s", msg, _exc_full(e))
        return msg
    finally:
        if TRACE_MCP:
            log.debug("[MCP] session closed server=%s call_id=%s", server, call_id)

async def mcp_call_backend(target: str, query: str, extra: Optional[Dict[str, Any]]):
    svc = SERVICES[target]
    server, tool, field = svc["server"], svc["tool"], svc["field"]
    payload = {field: query}
    if isinstance(extra, dict): payload.update(extra)

    ckey = f"bot:{server}:{tool}:{_h({'q':query,'x':extra})}"
    hit = cache_get(ckey)
    if hit is not None:
        if TRACE_MCP: log.debug("[CACHE] hit %s", ckey)
        return hit

    val = await mcp_invoke(server, tool, payload)
    cache_set(ckey, val)
    return val

# ============================== Composition & Routing ==============================
def compose_final(query: str, answers_by_target: Dict[str, Any]) -> str:
    if not answers_by_target: return ""
    ckey = f"compose:{_h({'q':query,'a':answers_by_target})}"
    hit = cache_get(ckey)
    if hit is not None:
        if TRACE_MCP: log.debug("[CACHE] hit %s", ckey)
        return hit
    try:
        txt = claude_text(COMPOSER_SYSTEM, {"user_query": query, "answers_by_target": answers_by_target}, max_tokens=512)
        cache_set(ckey, txt)
        return txt
    except Exception as e:
        log.warning("[COMPOSE] fallback due to error: %s", _exc_to_str(e))
        parts = [f"{k}: {v}" for k, v in answers_by_target.items()]
        txt = " | ".join(map(str, parts))
        cache_set(ckey, txt)
        return txt

def llm_decide_targets(query: str) -> List[str]:
    try:
        out = claude_json(ROUTER_SYSTEM, {"query": query}, max_tokens=128)
        return [t for t in out.get("targets", []) if t in SERVICES] or ["hotel"]
    except Exception as e:
        log.warning("[ROUTER] fallback due to error: %s", _exc_to_str(e))
        return ["hotel"]

# ============================== FastAPI app & Middleware ==============================
app = FastAPI(title="Orchestrator (MCP via stdio + detailed debug)")

@app.middleware("http")
async def log_requests(request: Request, call_next):
    rid = request.headers.get("x-request-id") or str(uuid.uuid4())[:8]
    start = time.perf_counter()
    try:
        log.info(">> %s %s rid=%s", request.method, request.url.path, rid)
        response: Response = await call_next(request)
        dt = (time.perf_counter()-start)*1000
        log.info("<< %s %s %s rid=%s (%.2f ms)", request.method, request.url.path, response.status_code, rid, dt)
        return response
    except Exception as e:
        dt = (time.perf_counter()-start)*1000
        log.error("!! %s %s rid=%s (%.2f ms) error=%s\n%s", request.method, request.url.path, rid, dt, e, _exc_full(e))
        return JSONResponse({"error": str(e), "trace": _exc_full(e)}, status_code=500)

@app.on_event("shutdown")
async def _shutdown():
    await _aclose_client_silent()

