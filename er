from fastmcp import Client as MCPClient
import shlex

async def call_backend(target: str, query: str, extra: Optional[Dict[str, Any]]):
    svc = SERVICES[target]
    payload = {svc["field"]: query}
    if isinstance(extra, dict):
        payload.update(extra)

    # Ensure single string command
    raw_cmd = svc["cmd"]                          # e.g. "python -u tdna_mcp_server.py"
    cmd_str = raw_cmd if isinstance(raw_cmd, str) else shlex.join(raw_cmd)

    # Force stdio (no inference)
    async with MCPClient(cmd_str, "stdio") as client:
        result = await client.call_tool(svc["tool"], payload)

    if isinstance(result, dict):
        return (result.get("answer") or result.get("result") or
                result.get("output") or result.get("content") or result)
    return (getattr(result, "json", None) or getattr(result, "data", None) or
            getattr(result, "text", None) or result)
