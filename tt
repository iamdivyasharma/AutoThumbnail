# 🔹 Retrieval queries: you said they are already the fields in order
RETRIEVAL_QUERIES: List[str] = FIELD_NAMES

# AWS (for Bedrock; in practice, prefer IAM role/env vars)
AWS_REGION = "us-east-1"
