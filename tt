#!/usr/bin/env python3
"""
rag_finance_queries_wide_excel_llm_per_client.py

FINANCE-only, file-based, WITH LLM, wide Excel format.

For EACH FINANCE client FAISS index and EACH FILE (policy),
create ONE Excel file:

  ./finance_query_exports/finance_queries_<sanitized_client_id>.xlsx

Each Excel has:

  Row    = one file/policy in that client-category
  Column = one JSON field from the LLM output (1–20 fields)

Columns (example):

  Client | Policy | Source File | <field_1> | <field_2> | ... | <field_20> | FlatString | Sources

Where:
- JSON fields 1–20 come from your fixed schema in the system prompt.
- FlatString is the semicolon-separated string of the 20 values, in order.
"""

from __future__ import annotations

import os
import json
import re
from pathlib import Path
from typing import List, Dict, Any, Tuple

