# =============== Simple router/composer (no external LLM) ==========
def simple_route_decider(q: str) -> List[str]:
    s = q.lower()
    picks: List[str] = []
    if any(w in s for w in ("flight","air","airline","pnr","fare","seat","airport")): picks.append("air")
    if any(w in s for w in ("hotel","room","stay","booking","reservation","amenities","check-in","check out")): picks.append("hotel")
    if any(w in s for w in ("tdna","dna","genome","variant","gene","sequence","omics")): picks.append("tdna")
    return list(dict.fromkeys(picks)) or ["hotel"]

def simple_compose(user_query: str, answers: Dict[str, Any]) -> str:
    parts = []
    for k in ("hotel","air","tdna"):
        if k in answers:
            parts.append(f"{k}: {answers[k]}")
    return " | ".join(map(str, parts)) if parts else ""

# =============== Memory & tiny cache ===============================
MEMORY: Dict[str, Dict[str, Any]] = defaultdict(lambda: {"history": deque(maxlen=20), "created": time()})
def mem_append(sid: str, role: str, content: Any): MEMORY[sid]["history"].append({"role": role, "content": content, "ts": time()})
def mem_get(sid: str, k: int = 10) -> List[Dict[str, Any]]:
    hist = list(MEMORY[sid]["history"]); return hist[-k:] if k else hist
def mem_clear(sid: str): MEMORY.pop(sid, None)

CACHE_TTL_SEC = 300
_CACHE: Dict[str, Tuple[float, Any]] = {}
def _h(obj: Any) -> str: return hashlib.sha256(json.dumps(obj, sort_keys=True, default=str).encode()).hexdigest()[:16]
def cache_get(k: str):
    rec = _CACHE.get(k)
    if not rec: return None
    exp, val = rec
    if exp < time(): _CACHE.pop(k, None); return None
    return val
def cache_set(k: str, v: Any, ttl: int = CACHE_TTL_SEC): _CACHE[k] = (time()+ttl, v)

# =============== Transport normalization (hardcoded) ===============
ALLOWED_TRANSPORTS = {"stdio", "sse", "websocket", "streamable_http"}
TRANSPORT_ALIASES = {
    "http": "streamable_http",
    "rest": "streamable_http",
    "web": "streamable_http",
    "stream": "streamable_http",
    "streamable_http": "streamable_http",
}
PREFERRED_TRANSPORT = "streamable_http"  # use HTTP MCP

def _sanitize_url(u: str) -> str:
    if not isinstance(u, str):
        raise ValueError(f"Bad URL type: {type(u)}")
    u = u.strip()
    if u.startswith("lhttp://"):  u = "http://"  + u[len("lhttp://"):]
    if u.startswith("lhttps://"): u = "https://" + u[len("lhttps://"):]
    if not (u.startswith("http://") or u.startswith("https://")):
        u = "http://" + u
    if not u.rstrip("/").endswith("/mcp"):
        u = u.rstrip("/") + "/mcp"
    return u

def normalize_servers(cfg: dict) -> dict:
    out = {}
    t = TRANSPORT_ALIASES.get(PREFERRED_TRANSPORT, PREFERRED_TRANSPORT)
    if t not in ALLOWED_TRANSPORTS:
        raise ValueError(f"Invalid transport '{t}' (allowed: {sorted(ALLOWED_TRANSPORTS)})")
    for name, val in cfg.items():
        if isinstance(val, str):
            url = _sanitize_url(val)
            out[name] = {"transport": {"type": t, "url": url}}
        elif isinstance(val, dict):
            url = _sanitize_url(val.get("url") or val.get("transport", {}).get("url", ""))
            tt = TRANSPORT_ALIASES.get(val.get("transport", {}).get("type", t), t)
            if tt not in ALLOWED_TRANSPORTS:
                raise ValueError(f"Invalid transport '{tt}' for '{name}' (allowed: {sorted(ALLOWED_TRANSPORTS)})")
            out[name] = {"transport": {"type": tt, "url": url}}
        else:
            raise TypeError(f"Bad server config for '{name}': {val!r}")
    return out

MCP_CONFIG = normalize_servers(RAW_MCP_CONFIG)

# =============== MCP client (single instance + probe) =============
from langchain_mcp_adapters.clients import MultiServerMCPClient

app = FastAPI(title="Orchestrator (MCP debug)")

_client_holder: Dict[str, Any] = {"client": None}

async def _get_tools_any(session):
    for attr in ("get_tools", "get_all_tools"):
        fn = getattr(session, attr, None)
        if callable(fn):
            try:
                res = await fn()
            except TypeError:
                res = fn()
            return [t for _, L in res.items() for t in L] if isinstance(res, dict) else list(res)
    raise RuntimeError("No get_tools/get_all_tools on session")

@app.on_event("startup")
async def _startup_probe():
    print("=== STARTUP DIAG ===")
    print("PREFERRED_TRANSPORT =", PREFERRED_TRANSPORT)
    print("RAW_MCP_CONFIG      =", RAW_MCP_CONFIG)
    print("MCP_CONFIG          =", MCP_CONFIG)

    client = MultiServerMCPClient(MCP_CONFIG)
    for server in MCP_CONFIG.keys():
        try:
            async with client.session(server) as sess:
                tools = await _get_tools_any(sess)
                names = [getattr(t, "name", "") for t in tools]
                print(f"[OK] {server}: tools = {names}")
        except Exception as e:
            print(f"[FAIL] {server}: {type(e).__name__}: {e}")
    _client_holder["client"] = client
    print("=== STARTUP DONE ===")

@app.on_event("shutdown")
async def _shutdown_client():
    cli = _client_holder.get("client")
    if cli:
        with contextlib.suppress(Exception):
            await cli.aclose()

def get_client() -> MultiServerMCPClient:
    cli = _client_holder.get("client")
    if cli is None:
        raise RuntimeError("MCP client not initialized")
    return cli

# =============== Invoke helpers (structured errors) ===============
def _struct_err(server: str, tool: str, e: Exception, stage: str):
    return {
        "_mcp_error": True,
        "server": server,
        "tool": tool,
        "stage": stage,
        "etype": type(e).__name__,
        "message": str(e),
        "trace": traceback.format_exc(),
    }

async def mcp_invoke(server: str, tool_name: str, payload: dict):
    cfg = MCP_CONFIG.get(server)
    print(f"[mcp_invoke] server={server} tool={tool_name} cfg={cfg} payload_keys={list(payload.keys())}")

    # get client
    try:
        cli = get_client()
        print("[mcp_invoke] got client:", type(cli).__name__)
    except Exception as e:
        print("[mcp_invoke] get_client FAILED:", repr(e))
        return _struct_err(server, tool_name, e, stage="get_client")

    # open session (common place for 'unsupported transport')
    try:
        cm = cli.session(server)
        print("[mcp_invoke] have session CM:", type(cm).__name__)
    except Exception as e:
        print("[mcp_invoke] make_session FAILED:", repr(e))
        return _struct_err(server, tool_name, e, stage="make_session")

    try:
        sess = await cm.__aenter__()
        print("[mcp_invoke] __aenter__ OK:", type(sess).__name__)
    except Exception as e:
        print("[mcp_invoke] enter_session FAILED:", repr(e))
        return _struct_err(server, tool_name, e, stage="enter_session")

    try:
        # list tools (verifies transport)
        tools = None
        for attr in ("get_tools", "get_all_tools"):
            fn = getattr(sess, attr, None)
            if fn:
                try: tools = await fn()
                except TypeError: tools = fn()
                break
        if tools is None:
            raise RuntimeError("No get_tools/get_all_tools on session")

        # find tool
        iter_tools = (tools.values() if isinstance(tools, dict) else tools)
        found = None
        for t in iter_tools:
            if getattr(t, "name", "") == tool_name:
                found = t; break
        if found is None:
            raise RuntimeError(f"Tool {tool_name!r} not found on server {server!r}")
        print("[mcp_invoke] tool found:", tool_name)

        # invoke
        ainvoke = getattr(found, "ainvoke", None)
        if callable(ainvoke):
            try:
                out = await found.ainvoke(payload)
            except Exception:
                out = await found.ainvoke({"input": payload})
        else:
            loop = asyncio.get_running_loop()
            def _call():
                try: return found.invoke(payload)
                except Exception: return found.invoke({"input": payload})
            out = await loop.run_in_executor(None, _call)

        print("[mcp_invoke] invoke OK; type:", type(out).__name__)
        if isinstance(out, dict):
            return out.get("answer") or out.get("result") or out.get("output") or out.get("content") or out
        return out

    except Exception as e:
        print("[mcp_invoke] tools_or_invoke FAILED:", repr(e))
        return _struct_err(server, tool_name, e, stage="tools_or_invoke")

    finally:
        try:
            await cm.__aexit__(None, None, None)
        except Exception as e:
            print("[mcp_invoke] __aexit__ WARNING:", repr(e))

async def mcp_call_backend(target: str, query: str, extra: Optional[Dict[str, Any]]):
    svc = SERVICES[target]
    server, tool, field = svc["server"], svc["tool"], svc["field"]
    payload = {field: query}
    if isinstance(extra, dict): payload.update(extra)

    print(f"[mcp_call_backend] target={target} server={server} tool={tool}")
    print(f"[mcp_call_backend] server_cfg={MCP_CONFIG.get(server)}")

    # Disable caching while debugging to avoid stale errors
    val = await mcp_invoke(server, tool, payload)

    # Always print raw
    try:
        print("[mcp_call_backend] RAW:", json.dumps(val, indent=2))
    except Exception:
        print("[mcp_call_backend] RAW(repr):", repr(val))

    if isinstance(val, dict) and val.get("_mcp_error"):
        print("[mcp_call_backend] ERROR -> structured above")
        return val

    print(f"[mcp_call_backend] OK type={type(val).__name__}")
    return val

# =============== API models =======================================
class RouteIn(BaseModel):
    query: str
    extra: Optional[Dict[str, Any]] = None
    target: Optional[str] = None
    targets: Optional[List[str]] = None

class RouteOut(BaseModel):
    tool: str = "route_query_tool"
    targets: List[str]
    routed_by: str
    answer: Any
    answers_by_target: Optional[Dict[str, Any]] = None
    errors: Optional[Dict[str, Any]] = None

class AgentIn(BaseModel):
    query: str
    extra: Optional[Dict[str, Any]] = None
    session_id: str = "default"
    max_iters: int = 1
    parallel_cap: int = 3
    autonomy: bool = True

class AgentOut(BaseModel):
    tool: str = "agent_query_tool"
    session_id: str
    iterations: int
    final_answer: Any
    observations: List[Dict[str, Any]]
    autonomy: bool

# =============== HTTP endpoints ===================================
@app.post("/route_query", operation_id="route_query_tool", response_model=RouteOut)
async def route_query(inp: RouteIn = Body(...)):
    q, extra = inp.query, inp.extra
    if inp.targets:
        targets, routed_by = [t for t in inp.targets if t in SERVICES], "hint:list"
    elif inp.target in SERVICES:
        targets, routed_by = [inp.target], "hint:single"
    elif inp.target == "both":
        targets, routed_by = ["hotel","air"], "hint:both"
    else:
        targets, routed_by = simple_route_decider(q), "heuristic"

    results, errors = {}, {}
    if len(targets) <= 1:
        tgt = targets[0] if targets else "hotel"
        out = await mcp_call_backend(tgt, q, extra)
        if isinstance(out, dict) and out.get("_mcp_error"):
            errors[tgt] = out
        else:
            results[tgt] = out
    else:
        outs = await asyncio.gather(*[mcp_call_backend(t, q, extra) for t in targets], return_exceptions=False)
        for t, out in zip(targets, outs):
            if isinstance(out, dict) and out.get("_mcp_error"):
                errors[t] = out
            else:
                results[t] = out

    answer = simple_compose(q, results) if len(results) > 1 else next(iter(results.values()), "")
    status = 200 if not errors else 502
    return RouteOut(targets=targets, routed_by=routed_by, answer=answer or None,
                    answers_by_target=(results or None), errors=(errors or None)), status

@app.post("/agent_query", operation_id="agent_query_tool", response_model=AgentOut)
async def agent_query(inp: AgentIn = Body(...)):
    q, extra, sid = inp.query, inp.extra, inp.session_id
    mem_append(sid, "user", q)
    observations: List[Dict[str, Any]] = []

    # very small "plan": call all likely targets once
    steps = [{"target": t, "input": q} for t in simple_route_decider(q)][:inp.parallel_cap]

    async def execute(steps: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        outs = await asyncio.gather(
            *[mcp_call_backend(s["target"], s.get("input", q), extra) for s in steps],
            return_exceptions=False
        )
        batch: List[Dict[str, Any]] = []
        for s, out in zip(steps, outs):
            if isinstance(out, dict) and out.get("_mcp_error"):
                batch.append({"step": s, "error": out})
            else:
                batch.append({"step": s, "result": out})
        return batch

    batch = await execute(steps)
    observations.extend(batch)

    latest: Dict[str, Any] = {}
    for ob in reversed(batch):
        t = ob.get("step",{}).get("target")
        if t and "result" in ob and t not in latest:
            latest[t] = ob["result"]
    final_answer = simple_compose(q, latest) if latest else "No result."

    any_err = any("error" in ob for ob in observations)
    status = 200 if not any_err else 502

    mem_append(sid, "assistant", final_answer)
    return AgentOut(session_id=sid, iterations=len(batch),
                    final_answer=final_answer, observations=observations[-6:],
                    autonomy=inp.autonomy), status

