PROXY_BASE = os.getenv("PROXY_BASE", "").rstrip("/")

def proxy_url(port: int, path: str = "mcp") -> str:
    """Builds <PROXY_BASE>/proxy/<port>/<path> if PROXY_BASE is set, else /proxy/<port>/<path>."""
    if PROXY_BASE:
        return f"{PROXY_BASE}/proxy/{port}/{path}"
    # last-resort same-origin path (works if orchestrator runs inside the same Jupyter server)
    return f"/proxy/{port}/{path}"

# Choose transport accepted by langchain-mcp-adapters and exposed by FastApiMCP
PREFERRED_TRANSPORT = "streamable_http"

