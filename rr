# utils.py (or inside hotel_mcp_server.py)

from typing import Dict, Any, Tuple, Optional

def parse_hotel_payload(payload: Dict[str, Any]) -> Tuple[str, Optional[str], Optional[str]]:
    """
    Extract query, user_name, and user_email from the orchestrator payload.

    Args:
        payload: dict like {
            "qquery": "find me a hotel in NYC",
            "user_name": "Alice",
            "user_email": "alice@example.com",
            ... other keys ...
        }

    Returns:
        (query, user_name, user_email)
    """
    query = payload.get("qquery", "").strip()
    user_name = payload.get("user_name")
    user_email = payload.get("user_email")

    return query, user_name, user_email
