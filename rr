# index_clients.py
# Build per-client FAISS indexes from a single ./pdfs/ folder.
# Filenames like:
#   ey_policy_of_ey1.pdf        -> client_id = "ey"
#   google_doc_policy-tm1.pdf   -> client_id = "google"
#
# Per-client chunk settings are read from configs/clients.yaml (optional):
# ey:
#   chunk_size: 1000
#   chunk_overlap: 150
#
# By default, if an index already exists for a client (index.faiss + index.pkl),
# we SKIP rebuilding it. Use --force to rebuild.

import os
import argparse
from pathlib import Path
from collections import defaultdict
from typing import List, Dict

import yaml
import boto3
from langchain_aws import BedrockEmbeddings
from langchain_community.document_loaders import PyPDFLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain_community.vectorstores import FAISS

# ---------- Hardcoded config ----------
REGION = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

# ⚠️ Inline credentials (for local/dev only; prefer env/roles in prod)
AWS_ACCESS_KEY_ID = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

PDFS_DIR = Path("pdfs")
INDEX_DIR = Path("faiss_indices")
INDEX_DIR.mkdir(exist_ok=True)
CONFIG_PATH = Path("configs/clients.yaml")

# Defaults if a client has no chunk settings in YAML
DEFAULT_CHUNK_SIZE = 1200
DEFAULT_CHUNK_OVERLAP = 180

# Create a boto3 session with inline creds
SESSION = boto3.Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)

def load_client_configs() -> Dict[str, Dict]:
    """Load per-client settings from YAML (lowercase keys)."""
    if not CONFIG_PATH.exists():
        return {}
    with open(CONFIG_PATH, "r") as f:
        data = yaml.safe_load(f) or {}
    return {str(k).lower(): (v or {}) for k, v in data.items()}

CLIENT_CONFIGS = load_client_configs()

def get_client_id(filename: str) -> str:
    """
    Extract client id from a filename like:
      ey_policy_of_ey1.pdf        -> ey
      google_doc_policy-tm1.pdf   -> google
    Rule: part before first '_' if present, else before first '-', else stem.
    """
    name = filename.lower()
    if "_" in name:
        return name.split("_")[0]
    if "-" in name:
        return name.split("-")[0]
    return Path(name).stem

def group_pdfs_by_client(recursive: bool = False) -> Dict[str, List[Path]]:
    buckets: Dict[str, List[Path]] = defaultdict(list)
    pattern = "**/*.pdf" if recursive else "*.pdf"
    for p in PDFS_DIR.glob(pattern):
        if p.name.startswith("~$"):  # ignore temp files
            continue
        client = get_client_id(p.name).strip().lower()
        if not client:
            print(f"[skip] Could not parse client from {p.name}")
            continue
        buckets[client].append(p)
    return buckets

def client_index_dir(client_id: str) -> Path:
    return INDEX_DIR / client_id.lower()

def client_index_exists(client_id: str) -> bool:
    """Return True if FAISS artifacts exist for this client."""
    out = client_index_dir(client_id)
    return (out / "index.faiss").exists() and (out / "index.pkl").exists()

def build_one_client_index(client_id: str, pdf_paths: List[Path], force: bool = False):
    out = client_index_dir(client_id)

    if client_index_exists(client_id) and not force:
        print(f"[skip] Index already exists for '{client_id}' at {out} (use --force to rebuild)")
        return

    cfg = CLIENT_CONFIGS.get(client_id, {})
    chunk_size = int(cfg.get("chunk_size", DEFAULT_CHUNK_SIZE))
    chunk_overlap = int(cfg.get("chunk_overlap", DEFAULT_CHUNK_OVERLAP))

    splitter = RecursiveCharacterTextSplitter(
        chunk_size=chunk_size,
        chunk_overlap=chunk_overlap,
        add_start_index=True,
    )

    all_chunks = []
    for pdf in pdf_paths:
        docs = PyPDFLoader(str(pdf)).load()
        chunks = splitter.split_documents(docs)
        for d in chunks:
            # Fix page numbering to be human-friendly (start at 1 not 0)
            d.metadata.update({
                "client_id": client_id.lower(),
                "policy_id": pdf.name,
                "source_file": str(pdf),
                "page": int(d.metadata.get("page", 0)) + 1,
            })
        all_chunks.extend(chunks)

    if not all_chunks:
        print(f"[warn] No chunks generated for client '{client_id}'")
        return

    emb = BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=SESSION.client("bedrock-runtime"),
    )

    # Ensure out dir exists; if rebuilding, clear old files first to avoid stale data
    out.mkdir(parents=True, exist_ok=True)
    # (Optional) wipe old files if force, so we don't leave stale metadata around
    if force:
        for f in out.glob("*"):
            try:
                f.unlink()
            except Exception:
                pass

    vs = FAISS.from_documents(all_chunks, emb)
    vs.save_local(str(out))
    print(f"[ok] {client_id}: {len(all_chunks)} chunks (size={chunk_size}, overlap={chunk_overlap}) → {out}")

def main():
    parser = argparse.ArgumentParser(description="Build per-client FAISS indexes")
    parser.add_argument("--force", action="store_true", help="Rebuild even if index exists")
    parser.add_argument("--recursive", action="store_true", help="Scan pdfs/ recursively")
    parser.add_argument("--client", type=str, help="Build only this client_id (lowercase)")
    args = parser.parse_args()

    buckets = group_pdfs_by_client(recursive=args.recursive)
    if not buckets:
        print("No PDFs found in ./pdfs (or parsing failed).")
        return

    if args.client:
        cid = args.client.strip().lower()
        if cid not in buckets:
            print(f"[error] No PDFs found for client '{cid}'")
            return
        build_one_client_index(cid, buckets[cid], force=args.force)
        return

    for client_id, pdfs in buckets.items():
        build_one_client_index(client_id, pdfs, force=args.force)

if __name__ == "__main__":
    main()
