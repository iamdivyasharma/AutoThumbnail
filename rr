def _excel_answer(question: str, k: int = 6, session_id: Optional[str] = None) -> Dict[str, Any]:
    """
    Retrieve RAG over the XLSX (all sheets), no previews, just use FAISS chunks.
    """
    _ensure_excel_loaded()
    vs = _EXCEL["vs"]
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k})
    docs = retriever.get_relevant_documents(question)

    # Build context directly from retrieved docs (no df.to_string previews)
    context = "\n\n---\n\n".join([d.page_content for d in docs]) if docs else "(no context)"
    history = _EXCEL_HISTORY.get(session_id or "", [])[-6:] if session_id else []

    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=0.15,
        max_tokens=900
    )

    excel_prompt = ChatPromptTemplate.from_messages([
        ("system",
         "You are a precise data analyst. Answer ONLY using the Provided Context from the Excel sheets. "
         "Be specific with rows/columns where possible. If the data needed isn't in the context, say you don't know."),
        *[("human" if t["role"]=="user" else "assistant", t["text"]) for t in history],
        ("human", "Question: {question}\n\nProvided Context:\n{context}\n\nAnswer now with specifics.")
    ])
    chain = excel_prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": question, "context": context})

    # Maintain conversation history
    if session_id:
        sess = _EXCEL_HISTORY.setdefault(session_id, [])
        now = datetime.utcnow().isoformat(timespec="seconds") + "Z"
        sess.append({"role": "user", "text": question, "time": now})
        sess.append({"role": "assistant", "text": answer, "time": now})
        if len(sess) > 40:
            _EXCEL_HISTORY[session_id] = sess[-40:]

    # Sources metadata (no previews)
    srcs: List[Dict[str, Any]] = []
    for idx, d in enumerate(docs):
        if idx >= len(_EXCEL["chunk_meta"]):
            break
        meta = _EXCEL["chunk_meta"][idx]
        srcs.append({
            "sheet": meta.get("sheet"),
            "start_row": meta.get("start_row"),
            "end_row": meta.get("end_row"),
            "snippet": d.page_content[:300]
        })

    return {"answer": answer, "sources": srcs, "history": _EXCEL_HISTORY.get(session_id or "", [])}
