for folder in index_dirs:
    store = self._load_faiss_store(folder)

    # --- MMR Retrieval (diversity) ---
    fetch_k = max(self.top_k * 5, 25)   # pool size for MMR + score lookup
    lambda_mult = 0.5                  # 0 -> more diverse, 1 -> more similar

    # 1) Get diverse docs using MMR (MMR returns Documents without scores)
    mmr_docs = store.max_marginal_relevance_search(
        q,
        k=self.top_k,
        fetch_k=fetch_k,
        lambda_mult=lambda_mult,
    )

    # 2) Get a scored pool using normal similarity (for score mapping)
    scored = store.similarity_search_with_score(q, k=fetch_k)

    def _doc_key(d) -> str:
        md = getattr(d, "metadata", {}) or {}
        md_items = sorted((str(k), str(v)) for k, v in md.items())
        return (getattr(d, "page_content", "") or "") + "||" + "||".join([f"{k}={v}" for k, v in md_items])

    score_map: Dict[str, float] = {}
    for d, s in scored:
        k = _doc_key(d)
        # For FAISS L2 distance: smaller is better
        if k not in score_map or float(s) < score_map[k]:
            score_map[k] = float(s)

    # 3) Add MMR-selected docs with best-effort scores
    for d in mmr_docs:
        text = (d.page_content or "").strip()
        md = dict(d.metadata or {})
        md.setdefault("_index_folder", str(folder))
        score = score_map.get(_doc_key(d), 0.0)
        merged.append(RagChunk(rank=0, score=float(score), text=text, metadata=md))
