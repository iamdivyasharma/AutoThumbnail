# streamlit_app.py
import streamlit as st
import requests
from pathlib import Path
import yaml

# -------------------------
# Config
# -------------------------
BACKEND_URL = "http://localhost:8000/ask"   # hardcoded backend API
CONFIG_PATH = Path("configs/clients.yaml")
LOGO_PATH = Path("assets/logo.png")

# Load per-client configs
if CONFIG_PATH.exists():
    with open(CONFIG_PATH, "r") as f:
        CLIENT_CONFIGS = yaml.safe_load(f) or {}
else:
    CLIENT_CONFIGS = {}

# -------------------------
# UI Setup
# -------------------------
st.set_page_config(page_title="Client RAG Bot", page_icon=":robot_face:", layout="centered")

# Centered logo
if LOGO_PATH.exists():
    st.markdown(
        f"""
        <div style="text-align:center;">
            <img src="data:image/png;base64,{Path(LOGO_PATH).read_bytes().hex()}" 
                 alt="Logo" width="200">
        </div>
        """,
        unsafe_allow_html=True,
    )

st.title("📄 Multi-Client Policy Assistant")

# -------------------------
# Sidebar only for client selection
# -------------------------
clients = sorted(CLIENT_CONFIGS.keys())
if not clients:
    st.error("No clients found in configs/clients.yaml")
    st.stop()

client_id = st.sidebar.selectbox("Choose a client", clients)

# -------------------------
# Chat Interface
# -------------------------
query = st.text_input("💬 Ask a question about the selected client’s policies:")

if st.button("Ask"):
    if not query.strip():
        st.warning("Please enter a question.")
    else:
        with st.spinner("Thinking..."):
            try:
                resp = requests.post(
                    BACKEND_URL,
                    json={"client_id": client_id, "question": query},
                    timeout=60,
                )
                if resp.status_code == 200:
                    st.success("Answer:")
                    st.write(resp.json().get("answer", "No answer found."))
                else:
                    st.error(f"Backend error {resp.status_code}: {resp.text}")
            except Exception as e:
                st.error(f"Error contacting backend: {e}")
