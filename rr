def load_manifest_for_client(client_id: str) -> List[Dict[str, Any]]:
    """
    Manifest-free policy listing:
    Build the list of policies by scanning the FAISS docstore metadata for this client.

    Returns a list of dicts shaped like manifest["docs"]:
      [{"policy_id": "...", "source_file": "..."}, ...]
    """
    try:
        # Create a session locally so we don't need to change main() signature/calls
        session = Session(
            aws_access_key_id=AWS_ACCESS_KEY_ID,
            aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
            region_name=AWS_REGION,
        )

        vs = load_vs_for_client(client_id, session)

        # LangChain FAISS typically uses an InMemoryDocstore with a "_dict"
        doc_dict = getattr(vs.docstore, "_dict", None)
        if not isinstance(doc_dict, dict):
            print(f"[WARN] FAISS docstore for '{client_id}' is not a dict; cannot infer policies.")
            return []

        cid_norm = client_id.strip().lower()
        policies: Dict[str, Dict[str, Any]] = {}

        for doc in doc_dict.values():
            m = getattr(doc, "metadata", {}) or {}
            meta_cid = str(m.get("client_id", "")).strip().lower()
            meta_cat = str(m.get("category", "")).strip().lower()

            # Keep it consistent with your strict finance-only logic
            if meta_cid != cid_norm or meta_cat != "finance":
                continue

            policy_id = m.get("policy_id") or Path(m.get("source_file", "")).name
            if not policy_id:
                continue

            # Keep first seen source_file (good enough for listing)
            if policy_id not in policies:
                policies[policy_id] = {
                    "policy_id": policy_id,
                    "source_file": m.get("source_file", ""),
                }

        docs = list(policies.values())
        docs.sort(key=lambda x: x.get("policy_id", ""))

        if not docs:
            print(f"[WARN] No policies found in FAISS metadata for client '{client_id}'.")
        return docs

    except Exception as e:
        print(f"[WARN] Failed to infer policies from FAISS for '{client_id}': {type(e).__name__}: {e}")
        return []
