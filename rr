# ================== HTTP + normalization helpers ==================
def post(url: str, payload: dict):
    r = requests.post(url, json=payload, timeout=TIMEOUT)
    if r.headers.get("content-type","").startswith("application/json"):
        return r.status_code, r.json()
    return r.status_code, r.text

HEADER_RE = re.compile(
    r'^\s*(?:[*_]{0,2})\s*(air(?:\s*bot)?|hotel(?:\s*bot)?|tdna(?:\s*bot)?)\s*(?:[:\-–—|]+\s*)?(?:[*_]{0,2})\s*$',
    re.IGNORECASE,
)
PREFIX_RE = re.compile(
    r'^\s*(?:[*_]{0,2})\s*(air(?:\s*bot)?|hotel(?:\s*bot)?|tdna(?:\s*bot)?)\s*(?:[:\-–—|]+\s*)',
    re.IGNORECASE,
)
def normalize_answer(text: str) -> str:
    """Drop service headers; strip prefixes; collapse duplicates/blank lines."""
    if not isinstance(text, str):
        text = str(text)
    lines = [ln.rstrip() for ln in text.splitlines()]
    out, prev_norm = [], ""
    for ln in lines:
        s = ln.strip()
        if not s:
            if out and out[-1] != "":
                out.append("")
            continue
        if HEADER_RE.match(s):
            continue
        s = PREFIX_RE.sub("", s)
        norm = " ".join(s.split()).rstrip(" .|").lower()
        if norm == prev_norm:
            continue
        if out and " ".join(out[-1].split()).rstrip(" .|").lower() == norm:
            continue
        out.append(s)
        prev_norm = norm
    cleaned = []
    for s in out:
        if s == "" and (not cleaned or cleaned[-1] == ""):
            continue
        cleaned.append(s)
    return "\n".join(cleaned).strip()

def answer_sig(text: str, payload: dict | None = None) -> str:
    base = {"a": text}
    if payload:
        base["q"] = payload.get("query")
        base["t"] = payload.get("target") or payload.get("targets")
        base["sid"] = payload.get("session_id")
    return hashlib.sha256(json.dumps(base, sort_keys=True, default=str).encode()).hexdigest()[:16]

