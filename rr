    col1, col2, col3, col4 = st.columns(4)
    do_agent = col1.form_submit_button("🤖 Agentic AI")
    do_air   = col2.form_submit_button("✈️ AIR")
    do_hotel = col3.form_submit_button("🏨 HOTEL")
    do_tdna  = col4.form_submit_button("🧬 TDNA")

def parse_extra(s: str):
    if not s or not s.strip():
        return None, None
    try:
        return json.loads(s), None
    except Exception as e:
        return None, f"Extras JSON error: {e}"

def merge_identity(extra: dict | None, name: str, email: str):
    ident = {"user_name": name.strip(), "user_email": email.strip()}
    # Basic validation
    if not ident["user_name"] and not ident["user_email"]:
        return extra, "Please choose or enter at least a name or an email."
    merged = {}
    if isinstance(extra, dict):
        merged.update(extra)
    # Identity wins on conflicts to keep routing consistent
    merged.update(ident)
    return merged, None

def post(url: str, payload: dict):
    r = requests.post(url, json=payload, timeout=TIMEOUT)
    if r.headers.get("content-type","").startswith("application/json"):
        return r.status_code, r.json()
    return r.status_code, r.text

if do_agent or do_air or do_hotel or do_tdna:
    if not query.strip():
        st.error("Please enter a query.")
        st.stop()

    extra, err = parse_extra(extra_json)
    if err:
        st.error(err)
        st.stop()

    extra, id_err = merge_identity(extra, user_name, user_email)
    if id_err:
        st.error(id_err)
        st.stop()

    if do_agent:
        payload = {
            "query": query.strip(),
            "session_id": session_id,
            "autonomy": autonomy,
            "max_iters": max_iters,
            "extra": extra,  # includes user_name & user_email
        }
        status, data = post(AGENT_URL, payload)
        st.subheader(f"🤖 Agentic AI • Status: {status}")
        if isinstance(data, dict):
            st.markdown("**Final Answer**")
            st.write(data.get("final_answer", ""))
            with st.expander("Details (observations)"):
                st.json(data)
        else:
            st.code(data)
    else:
        target = "air" if do_air else "hotel" if do_hotel else "tdna"
        payload = {
            "query": query.strip(),
            "target": target,
            "extra": extra,  # includes user_name & user_email
        }
        status, data = post(ROUTE_URL, payload)
        label = {"air":"✈️ AIR", "hotel":"🏨 HOTEL", "tdna":"🧬 TDNA"}[target]
        st.subheader(f"{label} • Status: {status}")
        if isinstance(data, dict):
            if "answer" in data:
                st.markdown("**Answer**")
                st.write(data["answer"])
            abt = data.get("answers_by_target")
            if isinstance(abt, dict) and abt:
                st.markdown("**Per-target details**")
                for k, v in abt.items():
                    with st.expander(k):
                        st.write(v)
            if data.get("errors"):
                st.warning("Some targets returned errors:")
                st.json(data["errors"])
        else:
            st.code(data)

st.markdown("---")
st.caption("Bots are called via MCP; UI talks to the orchestrator’s HTTP endpoints. MCP server also available at /mcp.")




