# ================== Helpers ==================
def post(url: str, payload: dict):
    r = requests.post(url, json=payload, timeout=TIMEOUT)
    if r.headers.get("content-type","").startswith("application/json"):
        return r.status_code, r.json()
    return r.status_code, r.text

def ensure_state():
    if "messages" not in st.session_state:
        st.session_state.messages = []  # list[{"role":"user"|"assistant","content":str,"meta":dict}]
    if "session_id" not in st.session_state:
        st.session_state.session_id = "user123"
    if "mode" not in st.session_state:
        st.session_state.mode = "Agentic AI"
    if "target" not in st.session_state:
        st.session_state.target = "air"
    if "user_name" not in st.session_state:
        st.session_state.user_name = ""
    if "user_email" not in st.session_state:
        st.session_state.user_email = ""
    if "autonomy" not in st.session_state:
        st.session_state.autonomy = True
    if "max_iters" not in st.session_state:
        st.session_state.max_iters = 3

    # Filters state
    if "filters" not in st.session_state:
        st.session_state.filters = {
            "ond": {"origin": None, "destination": None},
            "start_date": None,             # ISO string "YYYY-MM-DD" or None
            "policy_status": "Any",         # "Any" | "Compliant" | "Non-compliant" | "Pending"
        }

    # Apply-query state for first-time behavior
    if "first_apply_done" not in st.session_state:
        st.session_state.first_apply_done = False
    if "last_applied_query" not in st.session_state:
        st.session_state.last_applied_query = ""
    if "apply_response" not in st.session_state:
        st.session_state.apply_response = None
    if "apply_status" not in st.session_state:
        st.session_state.apply_status = None
    if "apply_payload" not in st.session_state:
        st.session_state.apply_payload = None

ensure_state()

