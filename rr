def _parse_s3_uri(uri: str) -> tuple[str, str]:
    u = urlparse(uri)
    bucket = (u.netloc or "").strip()
    key = (u.path or "").lstrip("/")
    if not bucket:
        raise ValueError(f"Invalid S3 URI (missing bucket): {uri}")
