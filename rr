# If country provided: try <client>/<country> ONLY (no fallback)
if ctry:
    existing: List[Path] = []

    # strict match, but normalize subfolder names
    for cd in client_dirs:
        # First try exact direct path (fast)
        p = cd / ctry
        if p.exists() and p.is_dir():
            existing.append(p)
            continue

        # Also allow folders named like "USA", "U.S." etc by normalization
        for sub in cd.iterdir():
            if not sub.is_dir():
                continue
            if normalize_country(sub.name) == ctry:
                existing.append(sub)

    return existing  # if empty => caller will raise "country not in indexer"
