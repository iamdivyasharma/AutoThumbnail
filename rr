def inline_home_branch_form():
    # Destination + dates only (origin = TDNA home)
    with st.chat_message("assistant"):
        st.markdown("### 🔎 Filters\nChoose **destination** and **dates** you want to travel.")
        dest_code = st.selectbox(
            "Destination",
            options=[x for x in DESTINATION_OPTIONS if x != st.session_state.tdna_home_code],
            index=0,
            format_func=label_for,
            key="dest_home_inline",
        )
        start_default = _snap_to_allowed(START_WHITELIST[0], START_WHITELIST, direction="nearest")
        end_default = _snap_to_allowed(END_WHITELIST[-1], END_WHITELIST, direction="up", min_after=start_default)
        start_input = st.date_input("Start date", value=start_default, min_value=START_WHITELIST[0], max_value=START_WHITELIST[-1], format="YYYY-MM-DD", key="start_home_inline")
        end_input   = st.date_input("End date",   value=end_default,   min_value=END_WHITELIST[0],   max_value=END_WHITELIST[-1],   format="YYYY-MM-DD", key="end_home_inline")

        if st.button("Agent is planning your trip!", key="apply_home_inline", use_container_width=True):
            chosen_start = start_input if isinstance(start_input, date) else START_WHITELIST[0]
            snapped_start = _snap_to_allowed(chosen_start, START_WHITELIST, direction="nearest")
            chosen_end = end_input if isinstance(end_input, date) else END_WHITELIST[-1]
            snapped_end = _snap_to_allowed(chosen_end, END_WHITELIST, direction="up", min_after=snapped_start)

            st.session_state.filters = {
                "ond": {"origin": st.session_state.tdna_home_code, "destination": dest_code},
                "start_date": snapped_start.isoformat(),
                "end_date": snapped_end.isoformat(),
            }
            do_plan_from_filters(source="home_branch_inline")

def inline_other_branch_form():
    # Origin + Destination + Dates
    with st.chat_message("assistant"):
        st.markdown("### 🔎 Filters\nChoose **origin**, **destination**, and **dates** you want to travel.")
        origin_code = st.selectbox(
            "Origin",
            options=ORIGIN_OPTIONS,
            index=ORIGIN_OPTIONS.index(st.session_state.tdna_home_code) if st.session_state.tdna_home_code in ORIGIN_OPTIONS else 0,
            format_func=label_for,
            key="origin_other_inline",
        )
        dest_code = st.selectbox(
            "Destination",
            options=[x for x in DESTINATION_OPTIONS if x != origin_code],
            index=0,
            format_func=label_for,
            key="dest_other_inline",
        )
        start_default = _snap_to_allowed(START_WHITELIST[0], START_WHITELIST, direction="nearest")
        end_default = _snap_to_allowed(END_WHITELIST[-1], END_WHITELIST, direction="up", min_after=start_default)
        start_input = st.date_input("Start date", value=start_default, min_value=START_WHITELIST[0], max_value=START_WHITELIST[-1], format="YYYY-MM-DD", key="start_other_inline")
        end_input   = st.date_input("End date",   value=end_default,   min_value=END_WHITELIST[0],   max_value=END_WHITELIST[-1],   format="YYYY-MM-DD", key="end_other_inline")

        if st.button("Agent is planning your trip!", key="apply_other_inline", use_container_width=True):
            if origin_code == dest_code:
                st.error("Origin and Destination cannot be the same.")
