# services/metadata_service.py
from __future__ import annotations

import os
import re
import json
from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd


def _norm(s: str) -> str:
    return (s or "").strip().lower()


def _clean_alnum(s: str) -> str:
    """Normalize to lowercase alphanumeric only (good for folder matching)."""
    return re.sub(r"[^a-z0-9]+", "", (s or "").lower()).strip()


class MetadataService:
    """
    Metadata Lookup service:
    - Reads your Client Master CSV (cid / parent_hq / country__c etc.)
    - Builds a manifest index from FAISS folders:
        scope_id -> /.../<scope>/manifest.json
    - Answers questions like:
        "capid for google us"
        "list all files under google us"
        "what is ContentDocumentId for google us"
    """

    def __init__(
        self,
        client_master_csv_path: str,
        schema_json_path: str,
        faiss_index_dir: str,
        client_name_col: str = "parent_hq",
        country_col: str = "country__c",
        cid_col: str = "cid",
    ):
        self.client_master_csv_path = Path(client_master_csv_path)
        self.schema_json_path = Path(schema_json_path)
        self.faiss_index_dir = Path(faiss_index_dir)

        self.client_name_col = client_name_col
        self.country_col = country_col
        self.cid_col = cid_col

        self._loaded = False
        self.df: Optional[pd.DataFrame] = None
        self.schema: Dict[str, Any] = {}
        self.scope_to_manifest: Dict[str, Path] = {}

    # -----------------------------
    # Load once at startup
    # -----------------------------
    def ensure_loaded(self) -> None:
        if self._loaded:
            return

        if not self.client_master_csv_path.exists():
            raise FileNotFoundError(f"Client master CSV not found: {self.client_master_csv_path}")

        self.df = pd.read_csv(self.client_master_csv_path)
        self.df.columns = [str(c).strip() for c in self.df.columns]

        if self.schema_json_path.exists():
            try:
                self.schema = json.loads(self.schema_json_path.read_text())
            except Exception:
                self.schema = {}
        else:
            self.schema = {}

        self.scope_to_manifest = self._scan_manifests()
        self._loaded = True

    def _scan_manifests(self) -> Dict[str, Path]:
        """
        Walk FAISS_INDEX_DIR and find every manifest.json.
        Store mapping:
            "finance/google/us" -> "/opt/ml/faiss_indices/finance/google/us/manifest.json"
        """
        mapping: Dict[str, Path] = {}

        if not self.faiss_index_dir.exists():
            return mapping

        for dirpath, _, filenames in os.walk(self.faiss_index_dir):
            if "manifest.json" in filenames:
                p = Path(dirpath) / "manifest.json"
                try:
                    rel = Path(dirpath).relative_to(self.faiss_index_dir)
                    scope_id = _norm(rel.as_posix())
                    mapping[scope_id] = p
                except Exception:
                    continue

        return mapping

    # -----------------------------
    # Manifest reader
    # -----------------------------
    def get_manifest_docs_preview(self, scope_id: str, limit: int = 10) -> List[Dict[str, Any]]:
        """
        Return docs list from manifest.json for a given scope.
        """
        scope_id = _norm(scope_id)

        manifest_path = self.scope_to_manifest.get(scope_id)
        if not manifest_path or not manifest_path.exists():
            return []

        try:
            data = json.loads(manifest_path.read_text())
        except Exception:
            return []

        docs = data.get("docs", []) or []
        out: List[Dict[str, Any]] = []

        for d in docs[: max(1, int(limit or 10))]:
            out.append(
                {
                    "policy_id": d.get("policy_id"),
                    "source_file": d.get("source_file"),
                    "modified_time": d.get("modified_time"),
                    "metadata_attributes": d.get("metadata") or {},
                }
            )
        return out

    # -----------------------------
    # Client Master matching
    # -----------------------------
    def match_client_country(self, client_name: str, country: Optional[str] = None) -> Dict[str, Any]:
        """
        Deterministic match from CSV.
        """
        if self.df is None:
            return {"matches": []}

        cname = _norm(client_name)
        ctry = _norm(country) if country else None

        df = self.df.copy()
        df["_client_norm"] = df[self.client_name_col].astype(str).str.lower()

        df = df[df["_client_norm"].str.contains(cname, na=False)]

        if ctry:
            df["_country_norm"] = df[self.country_col].astype(str).str.lower()
            df = df[df["_country_norm"].str.contains(ctry, na=False)]

        matches = []
        for _, row in df.head(10).iterrows():
            matches.append(
                {
                    "cid": str(row.get(self.cid_col)),
                    "client_name": str(row.get(self.client_name_col)),
                    "country": str(row.get(self.country_col)),
                }
            )
        return {"matches": matches}

    # -----------------------------
    # Scope resolver (IMPORTANT FIX)
    # -----------------------------
    def _find_scopes_for_client(
        self,
        category: str,
        client_name: str,
        country: Optional[str] = None,
    ) -> List[str]:
        category = _norm(category)
        country_norm = _norm(country) if country else None

        variants = set()
        variants.add(_clean_alnum(client_name))

        tokens = re.split(r"[^A-Za-z0-9]+", client_name or "")
        if tokens and tokens[0]:
            variants.add(_clean_alnum(tokens[0]))

        variants = {v for v in variants if v and len(v) >= 3}

        all_scopes = list(self.scope_to_manifest.keys())
        scoped = [s for s in all_scopes if s.startswith(f"{category}/")]

        client_scopes = []
        for s in scoped:
            parts = s.split("/")
            if len(parts) < 2:
                continue
            client_folder = _clean_alnum(parts[1])
            if any(v == client_folder for v in variants):
                client_scopes.append(s)

        if country_norm:
            exact_country = [s for s in client_scopes if s.endswith(f"/{country_norm}")]
            fallback_other = [s for s in client_scopes if not s.endswith(f"/{country_norm}")]

            def _prio(x: str) -> int:
                if x.endswith("/corporatefamily"):
                    return 1
                if x.endswith("/ultimateparent"):
                    return 2
                return 9

            fallback_other.sort(key=_prio)
            return exact_country + fallback_other

        def _prio(x: str) -> int:
            if x.endswith("/corporatefamily"):
                return 1
            if x.endswith("/ultimateparent"):
                return 2
            return 9

        client_scopes.sort(key=_prio)
        return client_scopes

    # -----------------------------
    # Natural-language answer builder
    # -----------------------------
    def _build_nl_answer(
        self,
        query: str,
        resolved: List[Dict[str, Any]],
        scopes: List[str],
        docs_preview: List[Dict[str, Any]],
    ) -> str:
        q = (query or "").lower().strip()

        client_txt = ""
        country_txt = ""
        cid_txt = ""
        if resolved:
            r = resolved[0]
            client_txt = str(r.get("client_name") or "")
            country_txt = str(r.get("country") or "")
            cid_txt = str(r.get("cid") or "")

        if any(x in q for x in ["file", "files", "filename", "file name", "document", "documents", "docs", "list"]):
            if not scopes:
                return "I could not find any matching FAISS scope/index folders for that client and country."

            if not docs_preview:
                return f"I found scope '{scopes[0]}' but the manifest.json returned no documents."

            names = [d.get("policy_id") for d in docs_preview if d.get("policy_id")]
            if not names:
                return f"I found scope '{scopes[0]}' but no policy_id entries were present."

            top = ", ".join(names[:8])
            more = "" if len(names) <= 8 else f" (and {len(names) - 8} more)"
            return (
                f"I found {len(names)} contract file(s) for {client_txt} ({country_txt}) under scope '{scopes[0]}'. "
                f"Top files: {top}{more}."
            )

        if any(x in q for x in ["capid", "cap id", "cid", "client id", "clientid"]):
            if not resolved:
                return "I could not resolve the client from your query."
            return f"The client id (CID/CAPID) for {client_txt} ({country_txt}) is {cid_txt}."

        if any(x in q for x in ["contentdocumentid", "content doc id", "document id", "metadata"]):
            if not docs_preview:
                return "I found the scope but there were no documents available to read metadata from manifest.json."
            first_meta = docs_preview[0].get("metadata_attributes") or {}
            if not first_meta:
                return "The manifest documents exist, but metadataAttributes is empty in the manifest."
            keys = list(first_meta.keys())[:12]
            return f"I found document metadata for {client_txt} ({country_txt}). Example metadata keys: {keys}"

        if not resolved:
            return "I could not resolve the client and country from your query."

        if scopes:
            return f"I resolved {client_txt} ({country_txt}). Available scope(s): {', '.join(scopes[:5])}."
        return f"I resolved {client_txt} ({country_txt}), but no matching FAISS scope was found."

    # -----------------------------
    # Public lookup function (UPDATED ✅)
    # -----------------------------
    def lookup(
        self,
        query: str,
        category: str = "finance",
        country: Optional[str] = None,
        limit: int = 10,  # ✅ FIX: now supports limit
    ) -> Dict[str, Any]:
        """
        Metadata Lookup:
        - match client/country from CSV
        - find scope(s) from scanned manifests
        - preview manifest docs for top scope
        - return answer + structured json
        """
        query_norm = _norm(query)

        csv_match = self.match_client_country(query_norm, country=country)
        matches = csv_match.get("matches", [])

        scopes: List[str] = []
        docs_preview: List[Dict[str, Any]] = []

        if matches:
            m = matches[0]
            client_real = m.get("client_name") or ""
            scopes = self._find_scopes_for_client(
                category=category,
                client_name=client_real,
                country=country,
            )

        scopes = sorted(set(scopes))

        if scopes:
            docs_preview = self.get_manifest_docs_preview(scopes[0], limit=limit)

        answer = self._build_nl_answer(
            query=query,
            resolved=matches[:1],
            scopes=scopes,
            docs_preview=docs_preview,
        )

        return {
            "answer": answer,
            "query": query,
            "category": category,
            "country": country,
            "limit": int(limit or 10),
            "resolved": matches[:1],
            "scopes": scopes,
            "docs_preview": docs_preview,
            "manifest_count": len(self.scope_to_manifest),
        }
