import pandas as pd, json, re
from pathlib import Path

# --- CONFIG ---
input_path  = Path("combined_finance_output.xlsx")        # change if needed
output_path = Path("combined_finance_output_flat.xlsx")
anchor_col  = "the name of the comapny contract by"       # must match header

# --- READ ---
df = pd.read_excel(input_path)
if df.empty:
    raise SystemExit("Input Excel is empty")

# Use LAST column as JSON column
json_col = df.columns[-1]
print("Using JSON column:", json_col)

# --- PARSE JSON + DISCOVER KEYS / CLAUSE COUNT ---
parsed = []
scalar_keys, max_clauses = set(), 0

for raw in df[json_col]:
    if pd.isna(raw):
        obj = {}
    else:
        s = str(raw).strip()
        obj = {}
        if s:
            try:
                obj = json.loads(s)
            except Exception:
                m = re.search(r"\{.*\}", s, re.DOTALL)
                if m:
                    try:
                        obj = json.loads(m.group(0))
                    except Exception:
                        obj = {}
    if not isinstance(obj, dict):
        obj = {}

    for k, v in obj.items():
        if k == "extracted_clauses":
            if isinstance(v, list):
                max_clauses = max(max_clauses, len(v))
        else:
            scalar_keys.add(k)

    parsed.append(obj)

scalar_keys = sorted(scalar_keys)
print("Scalar keys:", scalar_keys)
print("Max clauses:", max_clauses)

# --- SCALAR COLUMNS (all keys except extracted_clauses) ---
for key in scalar_keys:
    vals = []
    for obj in parsed:
        v = obj.get(key, "")
        if v is None:
            vals.append("")
        elif isinstance(v, (str, int, float, bool)):
            vals.append(str(v))
        else:
            try:
                vals.append(json.dumps(v, ensure_ascii=False))
            except Exception:
                vals.append(str(v))
    col_name = key if key not in df.columns else f"{key}_from_json"
    df[col_name] = vals

# --- CLAUSE COLUMNS: first = extracted_clauses, others visually blank ---
for i in range(max_clauses):
    if i == 0:
        col_name = "extracted_clauses"
    else:
        # use spaces so headers look empty but remain unique
        col_name = " " * i

    vals = []
    for obj in parsed:
        clauses = obj.get("extracted_clauses", [])
        if not isinstance(clauses, list) or i >= len(clauses):
            vals.append("")
            continue
        item = clauses[i]
        if not isinstance(item, dict):
            vals.append(str(item))
            continue

        t   = str(item.get("clause_type", "")).strip()
        txt = str(item.get("clause_text", "")).strip()
        sec = str(item.get("section_reference", "")).strip()

        parts = []
        if t and txt:
            parts.append(f"{t} - {txt}")
        elif t:
            parts.append(t)
        elif txt:
            parts.append(txt)
        if sec:
            parts.append(f"Section {sec}")

        vals.append(", ".join(parts))

    df[col_name] = vals

# --- DROP ORIGINAL JSON COLUMN ---
df = df.drop(columns=[json_col])

# --- DROP ALL COLUMNS BEFORE ANCHOR ---
if anchor_col in df.columns:
    idx = df.columns.get_loc(anchor_col)
    print(f"Anchor '{anchor_col}' at index {idx}; dropping {idx} column(s) before it.")
    df = df.iloc[:, idx:]
else:
    print(f"WARNING: anchor column {anchor_col!r} not found; keeping all columns.")

# --- SAVE ---
output_path.parent.mkdir(parents=True, exist_ok=True)
df.to_excel(output_path, index=False)
print("Saved to:", output_path)
