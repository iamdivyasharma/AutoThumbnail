# index_clients_local_or_textract_faiss.py
# ----------------------------------------------------------
# Hybrid per-client FAISS index builder:
# - Local PDFs in SageMaker folder: use PyMuPDF to extract native text
# - If detected as scanned (little/no native text): use AmazonTextractPDFLoader(s3_uri)
# - Mapping local->S3 done by filename match (same names)
# - Embeddings: Amazon Bedrock (IAM role / default credentials)
# - Output: FAISS_INDEX_DIR/<client_id>/ + manifest.json
# ----------------------------------------------------------

from __future__ import annotations

import os
import re
import json
import time
from dataclasses import dataclass
from pathlib import Path, PurePosixPath
from typing import Dict, List, Tuple, Iterable, Optional
from urllib.parse import urlparse

import boto3
import fitz  # PyMuPDF

from langchain.schema import Document
from langchain_community.vectorstores import FAISS
from langchain_aws import BedrockEmbeddings
from langchain_community.document_loaders import AmazonTextractPDFLoader


# ========================= CONFIG =========================
REGION = os.environ.get("AWS_REGION", "us-east-1")
EMBED_MODEL = os.environ.get("EMBED_MODEL", "amazon.titan-embed-text-v2:0")

# Local folder in SageMaker
LOCAL_PDF_ROOT = Path(os.environ.get("LOCAL_PDF_ROOT", "greenlight/gl_to13")).resolve()

# S3 root folder that contains client folders and their pdfs
# Example:
#   s3://bucket/ALL_PDFS/
#       clientA/doc1.pdf
#       clientB/doc2.pdf
S3_ROOT_URI = os.environ.get("S3_ROOT_URI", "s3://YOUR_BUCKET/ALL_PDFS/")

# Output folder for FAISS
FAISS_INDEX_DIR = Path(os.environ.get("FAISS_INDEX_DIR", "/opt/ml/processing/faiss_indices")).resolve()

# Chunking
CHUNK_SIZE = int(os.environ.get("CHUNK_SIZE", "1200"))
CHUNK_OVERLAP = int(os.environ.get("CHUNK_OVERLAP", "150"))

# Scanned detection thresholds
SCAN_PAGES_TO_CHECK = int(os.environ.get("SCAN_PAGES_TO_CHECK", "3"))     # check first N pages
SCAN_TEXT_MIN_CHARS_PER_PAGE = int(os.environ.get("SCAN_TEXT_MIN_CHARS_PER_PAGE", "80"))
SCAN_TOTAL_TEXT_MIN_CHARS = int(os.environ.get("SCAN_TOTAL_TEXT_MIN_CHARS", "150"))

# If Textract fails, fallback to local native extraction anyway?
FALLBACK_TO_LOCAL_IF_TEXTRACT_FAILS = os.environ.get("FALLBACK_TO_LOCAL_IF_TEXTRACT_FAILS", "1") == "1"
# ==========================================================


# ---------------------- Utilities -------------------------

def client_from_filename(name: str) -> str:
    """
    Use everything before the first delimiter as client id.
    Delimiters: '__' (preferred), '_' or '-'
    """
    stem = Path(name).stem
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()


def clean_text(t: str) -> str:
    t = t or ""
    t = re.sub(r"[ \t]+\n", "\n", t)
    return t.strip()


def chunk_text(text: str, chunk_size: int, overlap: int) -> List[Tuple[int, int, str]]:
    text = text or ""
    n = len(text)

    if n <= chunk_size:
        return [(0, n, text)]

    out: List[Tuple[int, int, str]] = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        out.append((start, end, text[start:end]))
        if end == n:
            break
        start = end - overlap
        if start < 0:
            start = 0
    return out


# ---------------------- S3 Helpers ------------------------

def parse_s3_uri(s3_uri: str) -> tuple[str, str]:
    if not s3_uri.startswith("s3://"):
        raise ValueError(f"Not a valid S3 URI: {s3_uri}")
    parsed = urlparse(s3_uri)
    return parsed.netloc, parsed.path.lstrip("/")


def ensure_trailing_slash(prefix: str) -> str:
    return prefix if (not prefix or prefix.endswith("/")) else prefix + "/"


def list_pdf_s3_uris(s3_dir_uri: str, region: str) -> List[str]:
    """
    List all PDFs under S3 prefix (recursive).
    """
    bucket, prefix = parse_s3_uri(s3_dir_uri)
    prefix = ensure_trailing_slash(prefix)

    s3 = boto3.client("s3", region_name=region)
    paginator = s3.get_paginator("list_objects_v2")

    pdfs: List[str] = []
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        for obj in page.get("Contents", []):
            key = obj["Key"]
            if key.endswith("/"):
                continue
            if key.lower().endswith(".pdf"):
                pdfs.append(f"s3://{bucket}/{key}")

    return sorted(pdfs)


def list_s3_pdfs_grouped_by_client_folder(s3_root_uri: str, region: str) -> Dict[str, Dict[str, str]]:
    """
    Returns mapping:
      {
        "clientA": { "doc1.pdf": "s3://.../clientA/doc1.pdf", ... },
        "clientB": { ... }
      }

    Client id is the *first folder* under the root prefix.
    """
    bucket, root_prefix = parse_s3_uri(s3_root_uri)
    root_prefix = ensure_trailing_slash(root_prefix)
    root_path = PurePosixPath(root_prefix)

    all_pdfs = list_pdf_s3_uris(s3_root_uri, region=region)
    out: Dict[str, Dict[str, str]] = {}

    for uri in all_pdfs:
        _, key = parse_s3_uri(uri)
        key_path = PurePosixPath(key)

        try:
            rel = key_path.relative_to(root_path)
        except ValueError:
            continue

        if not rel.parts:
            continue

        client_folder = rel.parts[0].strip().lower()
        filename = rel.parts[-1]

        out.setdefault(client_folder, {})
        # If duplicates exist, last one wins; you can change this if needed
        out[client_folder][filename] = uri

    return out


# ------------------- Local PDF Scan -----------------------

def scan_local_pdfs(root: Path) -> Dict[str, List[Path]]:
    """
    Find all local PDFs and group by client_id derived from filename.
    """
    out: Dict[str, List[Path]] = {}
    for p in root.rglob("*.pdf"):
        cid = client_from_filename(p.name)
        out.setdefault(cid, []).append(p)

    for k in out:
        out[k] = sorted(out[k], key=lambda x: x.name.lower())
    return out


# ---------------- Scanned PDF Detection -------------------

def is_scanned_pdf(pdf_path: Path) -> bool:
    """
    Simple heuristic:
    - Look at first N pages
    - Extract native text (PyMuPDF)
    - If text is very small overall -> likely scanned

    You can tune thresholds via env vars.
    """
    try:
        with fitz.open(str(pdf_path)) as doc:
            pages_to_check = min(doc.page_count, max(1, SCAN_PAGES_TO_CHECK))
            total_chars = 0
            min_chars_ok_pages = 0

            for i in range(pages_to_check):
                page = doc.load_page(i)
                txt = clean_text(page.get_text("text") or "")
                total_chars += len(txt)
                if len(txt) >= SCAN_TEXT_MIN_CHARS_PER_PAGE:
                    min_chars_ok_pages += 1

            # If at least one page has decent native text -> usually NOT scanned
            if min_chars_ok_pages > 0:
                return False

            # Otherwise, if total text is very low -> scanned
            return total_chars < SCAN_TOTAL_TEXT_MIN_CHARS

    except Exception:
        # If we cannot read it properly, treat it as scanned to force Textract
        return True


# ------------------- Extractors ---------------------------

def extract_native_pymupdf_chunks(local_pdf_path: Path, client_id: str) -> Iterable[Document]:
    """
    Extract native text using PyMuPDF (local file), chunk, yield Documents.
    """
    filename = local_pdf_path.name
    with fitz.open(str(local_pdf_path)) as doc:
        for pnum in range(doc.page_count):
            page = doc.load_page(pnum)
            text = clean_text(page.get_text("text") or "")

            if not text.strip():
                continue

            for _, _, chunk in chunk_text(text, CHUNK_SIZE, CHUNK_OVERLAP):
                meta = {
                    "client_id": client_id,
                    "policy_id": filename,
                    "page": pnum + 1,
                    "source_file": str(local_pdf_path),
                    "extracted_by": "pymupdf",
                }
                yield Document(page_content=chunk, metadata=meta)


def extract_textract_chunks(s3_pdf_uri: str, client_id: str, local_pdf_path: Optional[Path] = None) -> Iterable[Document]:
    """
    Extract text using AmazonTextractPDFLoader(s3_uri), chunk, yield Documents.
    Uses IAM role credentials (no keys).
    """
    filename = s3_pdf_uri.split("/")[-1]

    textract_client = boto3.client("textract", region_name=REGION)
    loader = AmazonTextractPDFLoader(s3_pdf_uri, client=textract_client)
    page_docs = loader.load()  # usually one Document per page

    for d in page_docs:
        page_text = clean_text(d.page_content or "")
        if not page_text.strip():
            continue

        # Try to get page from metadata
        page_num = None
        if isinstance(d.metadata, dict):
            page_num = d.metadata.get("page") or d.metadata.get("Page")

        for _, _, chunk in chunk_text(page_text, CHUNK_SIZE, CHUNK_OVERLAP):
            meta = {
                "client_id": client_id,
                "policy_id": filename,
                "source_file": s3_pdf_uri,
                "extracted_by": "textract",
            }
            if page_num is not None:
                try:
                    meta["page"] = int(page_num)
                except Exception:
                    pass
            if local_pdf_path is not None:
                meta["local_file"] = str(local_pdf_path)

            yield Document(page_content=chunk, metadata=meta)


# ---------------- Embeddings / Indexing -------------------

def get_embeddings() -> BedrockEmbeddings:
    """
    Bedrock embeddings using default credential chain (SageMaker role).
    """
    bedrock_runtime = boto3.client("bedrock-runtime", region_name=REGION)
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=bedrock_runtime)


@dataclass
class ManifestRow:
    policy_id: str
    local_file: str
    s3_uri: Optional[str]
    pages: int
    scanned: bool
    extracted_by: str
    chunks_indexed: int


def index_one_client(
    client_id: str,
    local_pdfs: List[Path],
    s3_map_for_client: Dict[str, str],
    embeddings: BedrockEmbeddings,
) -> None:
    client_dir = FAISS_INDEX_DIR / client_id
    client_dir.mkdir(parents=True, exist_ok=True)

    all_chunks: List[Document] = []
    manifest: List[dict] = []

    for local_pdf in local_pdfs:
        policy_id = local_pdf.name
        s3_uri = s3_map_for_client.get(policy_id)

        # Determine scanned vs not
        scanned = is_scanned_pdf(local_pdf)

        extracted_by = "pymupdf"
        chunks_count = 0
        pages = 0

        try:
            with fitz.open(str(local_pdf)) as doc:
                pages = doc.page_count
        except Exception:
            pages = 0

        try:
            if scanned:
                # Use Textract if possible
                if s3_uri:
                    extracted_by = "textract"
                    for d in extract_textract_chunks(s3_uri, client_id, local_pdf_path=local_pdf):
                        all_chunks.append(d)
                        chunks_count += 1
                else:
                    # No S3 match -> fallback to local extraction
                    extracted_by = "pymupdf"
                    for d in extract_native_pymupdf_chunks(local_pdf, client_id):
                        all_chunks.append(d)
                        chunks_count += 1
            else:
                # Not scanned -> use local PyMuPDF native
                extracted_by = "pymupdf"
                for d in extract_native_pymupdf_chunks(local_pdf, client_id):
                    all_chunks.append(d)
                    chunks_count += 1

        except Exception as e:
            print(f"[WARN] Extraction failed for {local_pdf}: {e}")

            # Optional fallback to local
            if scanned and FALLBACK_TO_LOCAL_IF_TEXTRACT_FAILS:
                try:
                    extracted_by = "pymupdf_fallback"
                    for d in extract_native_pymupdf_chunks(local_pdf, client_id):
                        all_chunks.append(d)
                        chunks_count += 1
                except Exception as e2:
                    print(f"[WARN] Fallback local extraction also failed: {e2}")

        manifest.append(
            {
                "policy_id": policy_id,
                "local_file": str(local_pdf),
                "s3_uri": s3_uri,
                "pages": pages,
                "scanned": scanned,
                "extracted_by": extracted_by,
                "chunks_indexed": chunks_count,
            }
        )

    if not all_chunks:
        print(f"[{client_id}] No chunks created. Skipping FAISS.")
        return

    print(f"[{client_id}] Building FAISS index with {len(all_chunks)} chunks ...")
    vs = FAISS.from_documents(all_chunks, embeddings)
    vs.save_local(str(client_dir))

    out_manifest = {
        "client_id": client_id,
        "local_root": str(LOCAL_PDF_ROOT),
        "s3_root": S3_ROOT_URI,
        "embedding_model": EMBED_MODEL,
        "region": REGION,
        "generated_time": int(time.time()),
        "docs": manifest,
    }

    (client_dir / "manifest.json").write_text(json.dumps(out_manifest, indent=2), encoding="utf-8")
    print(f"[{client_id}] ✅ Done. Saved at: {client_dir}")


# --------------------------- MAIN -------------------------

def main():
    if not LOCAL_PDF_ROOT.exists():
        raise SystemExit(f"LOCAL_PDF_ROOT does not exist: {LOCAL_PDF_ROOT}")

    if not S3_ROOT_URI.startswith("s3://"):
        raise SystemExit("S3_ROOT_URI must be like s3://bucket/prefix/")

    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)

    # 1) Scan local PDFs grouped by client id (from filename)
    local_by_client = scan_local_pdfs(LOCAL_PDF_ROOT)
    if not local_by_client:
        print("No local PDFs found.")
        return

    print(f"Found {sum(len(v) for v in local_by_client.values())} local PDFs across {len(local_by_client)} clients.")

    # 2) List S3 PDFs grouped by S3 client folder (first folder under root)
    # Produces: {client_folder: {filename: s3_uri}}
    print(f"Listing S3 PDFs under: {S3_ROOT_URI}")
    s3_by_client_folder = list_s3_pdfs_grouped_by_client_folder(S3_ROOT_URI, region=REGION)
    print(f"Found {sum(len(v) for v in s3_by_client_folder.values())} S3 PDFs across {len(s3_by_client_folder)} client folders.")

    # 3) Build embeddings once
    embeddings = get_embeddings()

    # 4) For each local client -> index
    for client_id, local_pdfs in local_by_client.items():
        s3_map_for_client = s3_by_client_folder.get(client_id, {})

        print(f"\n=== Indexing client: {client_id} | local={len(local_pdfs)} | s3_matches={len(s3_map_for_client)} ===")
        index_one_client(
            client_id=client_id,
            local_pdfs=local_pdfs,
            s3_map_for_client=s3_map_for_client,
            embeddings=embeddings,
        )


if __name__ == "__main__":
    main()
