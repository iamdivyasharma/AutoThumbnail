# ============================================================
# FAISS INDEX CACHE
# ============================================================

_VS_CACHE: Dict[str, Any] = {}
_ID_TO_DIR: Dict[str, Path] = {}
_STEP = 0

CATEGORIES = ["legal", "finance"]
MAX_COMBINED_K = 12  # upper bound of chunks returned from all clients


def _normalize_id(s: str) -> str:
    return str(s or "").strip().lower()


def refresh_id_to_dir(category: Optional[str] = None) -> List[str]:
    """
    Builds mapping like:
      finance/abb/us -> /opt/ml/faiss_indices/finance/abb/us
    """
    global _ID_TO_DIR
    _ID_TO_DIR = {}

    if not FAISS_INDEX_DIR.exists():
        return []

    cats = [category] if category else CATEGORIES
    ids: List[str] = []

    for cat in cats:
        root = FAISS_INDEX_DIR / cat
        if not root.exists():
            continue

        for dirpath, _, filenames in os.walk(root):
            dirpath = Path(dirpath)
            if "index.faiss" in filenames and "index.pkl" in filenames:
                rel = dirpath.relative_to(FAISS_INDEX_DIR)  # finance/abb/us
                cid = _normalize_id(rel.as_posix())
                _ID_TO_DIR[cid] = dirpath
                ids.append(cid)

    return sorted(ids)


def load_faiss_index(client_full_id: str) -> FAISS:
    """
    Loads FAISS store from disk and caches it.
    """
    global _STEP
    _STEP += 1

    cid = _normalize_id(client_full_id)

    if cid not in _ID_TO_DIR:
        refresh_id_to_dir()

    if cid not in _ID_TO_DIR:
        raise HTTPException(404, f"FAISS index not found: {cid}")

    if cid in _VS_CACHE:
        vs, _ = _VS_CACHE[cid]
        _VS_CACHE[cid] = (vs, _STEP)
        return vs

    emb = BedrockEmbeddings(model_id=BEDROCK_EMBED_MODEL, client=bedrock_runtime)
    vs = FAISS.load_local(str(_ID_TO_DIR[cid]), emb, allow_dangerous_deserialization=True)

    _VS_CACHE[cid] = (vs, _STEP)

    # LRU eviction
    if len(_VS_CACHE) > MAX_LOADED_INDEXES:
        oldest = min(_VS_CACHE.items(), key=lambda kv: kv[1][1])[0]
        _VS_CACHE.pop(oldest, None)

    return vs


