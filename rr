#!/usr/bin/env python3
import sys
from pathlib import Path
from typing import Tuple

import fitz  # PyMuPDF

# ====== CONFIG: SET YOUR ROOT FOLDER HERE ======
# Example: root = Path("ce/finance").resolve()
# Or an absolute path if you prefer:
# root = Path("/home/sagemaker-user/Doc/ce/finance").resolve()
root = Path("ce").resolve()   # 👈 change this to whatever you want


SAMPLE_PAGES = 3
CHAR_THRESHOLD = 50  # chars per sampled page


def is_scanned_pdf(
    pdf_path: Path,
    sample_pages: int = SAMPLE_PAGES,
    char_threshold: int = CHAR_THRESHOLD,
) -> Tuple[bool, int]:
    try:
        with fitz.open(str(pdf_path)) as doc:
            n_pages = doc.page_count
            if n_pages == 0:
                return True, 0

            to_sample = min(n_pages, sample_pages)
            total_chars = 0

            for i in range(to_sample):
                page = doc.load_page(i)
                txt = page.get_text("text") or ""
                total_chars += len(txt.strip())

            scanned = total_chars < char_threshold * to_sample
            return scanned, total_chars

    except Exception as e:
        print(f"[WARN] Failed to inspect {pdf_path}: {e}")
        return True, 0  # treat unreadable as scanned


def find_all_pdfs(root: Path):
    pdfs = []
    for p in root.rglob("*"):
        if p.is_file() and p.suffix.lower() == ".pdf":
            pdfs.append(p)
    return pdfs


def main():
    print(f"[INFO] Using root: {root}")
    if not root.exists():
        print(f"[ERROR] Root path does not exist: {root}")
        sys.exit(1)

    all_pdfs = find_all_pdfs(root)
    print(f"[INFO] Found {len(all_pdfs)} PDF(s) under root.")

    if not all_pdfs:
        return

    simple_count = 0
    scanned_count = 0

    for pdf_path in sorted(all_pdfs):
        scanned, total_chars = is_scanned_pdf(pdf_path)
        if scanned:
            status = "SCANNED"
            scanned_count += 1
        else:
            status = "SIMPLE_TEXT"
            simple_count += 1

        print(f"[{status:12}] {pdf_path}  (sampled_chars={total_chars})")

    total = simple_count + scanned_count

    print("\n===== SUMMARY =====")
    print(f"Root:                    {root}")
    print(f"Total PDFs found:        {total}")
    print(f"  Simple text PDFs:      {simple_count}")
    print(f"  Scanned/needs OCR:     {scanned_count}")
    print("====================")


if __name__ == "__main__":
    main()
