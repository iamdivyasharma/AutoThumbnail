import re
from pathlib import Path

def client_from_filename(name: str) -> str:
    """
    Use everything before the first delimiter as client id.
    Delimiters: '__' (preferred), '_' or '-'. Spaces are preserved.
    Examples:
      'BMW US_policy1.pdf'        -> 'bmw us'
      'Ernst & Young--doc.pdf'    -> 'ernst & young'
      'kpmg__benefits_2024.pdf'   -> 'kpmg'
    """
    stem = Path(name).stem  # drop .pdf
    # prefer double-underscore if present
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        # fall back to first _ or -; DO NOT split on spaces
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()
