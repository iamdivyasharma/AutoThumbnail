# ========= YAML / overrides =========

def _load_overrides() -> Dict[str, Dict[str, Any]]:
    """
    Load configs/clients.yaml with keys like:
      "legal/clienta":
      "finance/clientx/us":
    """
    if not CONFIGS_PATH.exists():
        return {}
    raw = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for k, v in raw.items():
        if not isinstance(v, dict):
            continue
        ck = str(k).strip().lower()
        out[ck] = {
            "k": int(v.get("k", GLOBAL_DEFAULTS["k"])),
            "temperature": float(v.get("temperature", GLOBAL_DEFAULTS["temperature"])),
            "max_tokens": int(v.get("max_tokens", GLOBAL_DEFAULTS["max_tokens"])),
            "aliases": [str(a).strip().lower() for a in v.get("aliases", [])],
        }
    return out

CLIENT_OVERRIDES = _load_overrides()

def _normalize_id(s: str) -> str:
    """Normalize a client id / path to lowercase with slashes."""
    return str(s or "").strip().lower()

def _refresh_id_to_dir(category: Optional[str] = None) -> List[str]:
    """
    Scan FAISS_INDEX_DIR and rebuild the mapping from normalized ID -> actual index directory.
    Returns the list of normalized IDs.
    """
    global _ID_TO_DIR
    _ID_TO_DIR = {}

    if not FAISS_INDEX_DIR.exists():
        return []

    cats = [category] if category else CATEGORIES
    ids: List[str] = []

    for cat in cats:
        root = FAISS_INDEX_DIR / cat
        if not root.exists():
            continue

        for dirpath, dirnames, filenames in os.walk(root):
            dirpath = Path(dirpath)
            if "index.faiss" in filenames and "index.pkl" in filenames:
                rel = dirpath.relative_to(FAISS_INDEX_DIR)  # e.g. legal/clienta, finance/clientx/us
                raw_id = rel.as_posix()
                nid = _normalize_id(raw_id)
                _ID_TO_DIR[nid] = dirpath
                ids.append(nid)

    return sorted(ids)

def list_clients(category: Optional[str] = None) -> List[str]:
    """
    Return list of normalized IDs:
      "legal/clienta"
      "finance/clientx/us"
    """
    ids = _refresh_id_to_dir(category=category)
    return ids

def _load_index(client_full_id: str) -> FAISS:
    """
    Load FAISS index for a given normalized ID like "finance/clientx/us".
    """
    global _STEP
    _STEP += 1
    cid_norm = _normalize_id(client_full_id)

    # Ensure mapping is fresh
    if cid_norm not in _ID_TO_DIR:
        _refresh_id_to_dir()

    if cid_norm not in _ID_TO_DIR:
        raise HTTPException(404, f"No index directory for client id {client_full_id}")

    # LRU cache
    if cid_norm in _VS_CACHE:
        vs, _ = _VS_CACHE[cid_norm]
        _VS_CACHE[cid_norm] = (vs, _STEP)
        return vs

    vs_dir = _ID_TO_DIR[cid_norm]
    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
    vs = FAISS.load_local(str(vs_dir), emb, allow_dangerous_deserialization=True)

    _VS_CACHE[cid_norm] = (vs, _STEP)

    if len(_VS_CACHE) > MAX_LOADED:
        oldest = min(_VS_CACHE.items(), key=lambda kv: kv[1][1])[0]
        _VS_CACHE.pop(oldest, None)

    return vs

def choose_params(client_full_id: str) -> Dict[str, Any]:
    cid_norm = _normalize_id(client_full_id)
    return CLIENT_OVERRIDES.get(cid_norm, GLOBAL_DEFAULTS.copy())

# ========= Client detection from question =========

def _normalize_text(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()

def _raw_upper_tokens(s: str) -> set[str]:
    toks = re.split(r"[^A-Za-z0-9]+", s or "")
    return {t.upper() for t in toks if t}

def _build_alias_records(available: List[str]) -> List[Dict[str, Any]]:
    """
    Build alias list per client. 'available' contains normalized IDs like
    'finance/clientx/us' or 'legal/clienta'. We also incorporate aliases from CLIENT_OVERRIDES.
    """
    records: List[Dict[str, Any]] = []

    def add_one(cid: str, alias_raw: str):
        alias_norm = _normalize_text(alias_raw)
        if not alias_norm:
            return
        toks = alias_norm.split()
        short_guard = (len(alias_norm.replace(" ", "")) <= 2)

        records.append({
            "cid": cid,
            "type": "spaced",
            "key": alias_norm,
            "alias_norm": alias_norm,
            "n_tokens": len(toks),
            "len_chars": len(alias_norm.replace(" ", "")),
            "short_guard": short_guard,
        })
        nospace = alias_norm.replace(" ", "")
        records.append({
            "cid": cid,
            "type": "nospace",
            "key": nospace,
            "alias_norm": alias_norm,
            "n_tokens": len(toks),
            "len_chars": len(nospace),
            "short_guard": short_guard,
        })
        if len(toks) >= 2:
            records.append({
                "cid": cid,
                "type": "tokset",
                "key": tuple(sorted(toks)),
                "alias_norm": alias_norm,
                "n_tokens": len(toks),
                "len_chars": len(nospace),
                "short_guard": short_guard,
            })

    for cid in available:
        c = _normalize_id(cid)
        add_one(c, c)  # id itself as alias
        for a in CLIENT_OVERRIDES.get(c, {}).get("aliases", []):
            add_one(c, a)

    type_rank = {"spaced": 0, "nospace": 1, "tokset": 2}
    records.sort(key=lambda r: (-r["n_tokens"], -r["len_chars"], type_rank[r["type"]]))
    return records

def detect_clients_from_text(text: str, available: List[str]) -> List[str]:
    norm_text = f" {_normalize_text(text)} "
    norm_tokens = set(norm_text.split())
    raw_upper = _raw_upper_tokens(text)
    alias_records = _build_alias_records(available)
    detected: List[str] = []

    for rec in alias_records:
        cid = rec["cid"]
        if cid in detected:
            continue

        if rec["short_guard"]:
            alias_upper_token = rec["alias_norm"].replace(" ", "").upper()
            if alias_upper_token not in raw_upper:
                continue

        if rec["type"] == "spaced":
            if f" {rec['key']} " in norm_text:
                detected.append(cid)
        elif rec["type"] == "nospace":
            if rec["key"] in norm_tokens:
                detected.append(cid)
        else:
            toks = set(rec["key"])
            if toks.issubset(norm_tokens):
                detected.append(cid)

    return detected

