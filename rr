def client_from_filename(name: str) -> str:
    # keep everything before first "__" or "_" or "-" (DON'T split on spaces)
    stem = Path(name).stem
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        import re
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip()

def group_by_client(paths: list[Path]) -> dict[str, list[Path]]:
    buckets = {}
    for p in paths:
        raw = client_from_filename(p.name)       # e.g., "estee lau"
        cid = canonicalize_client_id(raw)        # -> "estee" (from YAML) if configured
        buckets.setdefault(cid, []).append(p)
    return buckets
