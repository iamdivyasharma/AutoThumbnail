# ===== Cross-client helpers (paste below generate_llm_answer and above build_matrix) =====

def answer_for_client(session: Session, client_id: str, clause: str, subclause: Optional[str]) -> Dict[str, str]:
    """Retrieve + LLM answer for one client; returns a row dict."""
    # reuse your existing retrieval and LLM
    context = retrieve_context_for(session, client_id, clause, subclause or "")
    status  = classify_status(session, client_id, clause, subclause or "", context)
    content = generate_llm_answer(session, client_id, clause, subclause or "", context)
    return {
        "Client Name":   client_id,
        "Clause":        clause,
        "Sub Clause":    subclause or "",
        "Clause Status": status,
        "Content":       content,
    }

def answer_for_all_clients(session: Session, clause: str, subclause: Optional[str] = None) -> pd.DataFrame:
    """Iterate over ALL FAISS clients and return a table of LLM answers per client."""
    clients = list_clients_from_faiss(FAISS_INDEX_DIR)
    if not clients:
        raise SystemExit(f"No clients found under {FAISS_INDEX_DIR}")
    rows: List[Dict[str, Any]] = []
    for client_id in clients:
        print(f"=== {client_id} ===")
        rows.append(answer_for_client(session, client_id, clause, subclause))
    return pd.DataFrame(rows, columns=["Client Name", "Clause", "Sub Clause", "Clause Status", "Content"])



# ===================== Main =====================
def main():
    import argparse
    parser = argparse.ArgumentParser(description="RAG clause exporter")
    parser.add_argument("--mode", choices=["matrix", "ask-all"], default="matrix",
                        help="'matrix' builds the per-client×clause×subclause workbook; 'ask-all' asks one clause/subclause across all clients.")
    parser.add_argument("--clause", type=str, default="", help="Clause to ask in 'ask-all' mode (e.g., 'Technology').")
    parser.add_argument("--subclause", type=str, default="", help="Optional subclause to ask in 'ask-all' mode.")
    parser.add_argument("--out", type=str, default="", help="Optional output XLSX path; uses defaults if omitted.")
    args = parser.parse_args()

    # AWS session
    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    if args.mode == "matrix":
        df = build_matrix(session)
        out = Path(args.out or OUTPUT_XLSX)
        out.parent.mkdir(parents=True, exist_ok=True)
        df.to_excel(out, index=False)
        print(f"\nSaved: {out}")
        return

    # mode == "ask-all"
    if not args.clause.strip():
        raise SystemExit("In --mode ask-all you must provide --clause '...'.")
    df = answer_for_all_clients(session, args.clause.strip(), args.subclause.strip() or None)
    out = Path(args.out or f"./all_clients_{args.clause.strip().lower().replace(' ', '_')}.xlsx").resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    df.to_excel(out, index=False)
    print(f"\nSaved cross-client answers: {out}")

if __name__ == "__main__":
    main()


