## `rag_core.py`

```python
# rag_core.py
import os, re, json
from dataclasses import dataclass
from typing import List, Dict, Any, Tuple

import numpy as np
import boto3
from botocore.config import Config
from dotenv import load_dotenv

try:
    import fitz  # PyMuPDF (preferred)
except Exception:
    fitz = None
from pypdf import PdfReader

load_dotenv()
REGION = os.getenv("AWS_REGION", "us-east-1")
BEDROCK_SONNET = os.getenv("BEDROCK_SONNET_MODEL_ID", "anthropic.claude-3-5-sonnet")
BEDROCK_EMBED = os.getenv("BEDROCK_TITAN_EMBED_MODEL_ID", "amazon.titan-embed-text-v2")
CHUNK_SIZE = int(os.getenv("CHUNK_SIZE_CHARS", "1200"))
CHUNK_OVERLAP = int(os.getenv("CHUNK_OVERLAP_CHARS", "200"))
TOP_K = int(os.getenv("TOP_K", "6"))

bedrock_rt = boto3.client("bedrock-runtime", region_name=REGION, config=Config(retries={"max_attempts": 3}))

@dataclass
class Chunk:
    client_id: str
    doc_id: str
    page: int
    text: str
    source: str

# In-memory index: { client_id: [ (embedding(np.ndarray), Chunk), ... ] }
INDEX: Dict[str, List[Tuple[np.ndarray, Chunk]]] = {}

# ---------- Embeddings ----------

def _normalize_rows(mat: np.ndarray) -> np.ndarray:
    norms = np.linalg.norm(mat, axis=1, keepdims=True)
    norms[norms == 0] = 1.0
    return mat / norms


def embed_texts(texts: List[str]) -> np.ndarray:
    payload = {"inputText": texts}
    resp = bedrock_rt.invoke_model(
        modelId=BEDROCK_EMBED,
        body=json.dumps(payload),
        accept="application/json",
        contentType="application/json",
    )
    body = json.loads(resp["body"].read())
    if "embeddings" in body:
        vecs = np.array([e["embedding"] for e in body["embeddings"]], dtype=np.float32)
    elif "embedding" in body:
        vecs = np.array([body["embedding"]], dtype=np.float32)
    else:
        raise RuntimeError(f"Unexpected Titan embedding response: keys={list(body.keys())}")
    return _normalize_rows(vecs)

# ---------- PDF parsing ----------

def _extract_all_pages(path: str) -> List[Tuple[int, str]]:
    pages: List[Tuple[int, str]] = []
    if fitz is not None:
        with fitz.open(path) as doc:
            for i, page in enumerate(doc, start=1):
                pages.append((i, page.get_text("text")))
        if any(t.strip() for _, t in pages):
            return pages
    # fallback to PyPDF
    reader = PdfReader(path)
    for i, p in enumerate(reader.pages, start=1):
        try:
            pages.append((i, p.extract_text() or ""))
        except Exception:
            pages.append((i, ""))
    return pages

# ---------- Chunking ----------

def _clean(t: str) -> str:
    return re.sub(r"\s+", " ", t).strip()


def make_chunks(text: str, size: int = CHUNK_SIZE, overlap: int = CHUNK_OVERLAP) -> List[str]:
    text = _clean(text)
    out: List[str] = []
    step = max(1, size - overlap)
    i = 0
    while i < len(text):
        out.append(text[i : i + size])
        i += step
    return [c for c in out if c.strip()]

# ---------- Ingestion (per client) ----------

def ingest_client_pdf(client_id: str, pdf_path: str) -> int:
    """Read a single PDF for one client, chunk it, embed, and store in-memory."""
    pages = _extract_all_pages(pdf_path)
    texts: List[str] = []
    metas: List[Tuple[int, str]] = []
    for pno, tx in pages:
        for ch in make_chunks(tx):
            texts.append(ch)
            metas.append((pno, ch))
    if not texts:
        INDEX[client_id] = []
        return 0
    vecs = embed_texts(texts)  # normalized
    items: List[Tuple[np.ndarray, Chunk]] = []
    doc_id = os.path.splitext(os.path.basename(pdf_path))[0]
    for (pno, ch), v in zip(metas, vecs):
        items.append((v, Chunk(client_id, doc_id, pno, ch, os.path.basename(pdf_path))))
    INDEX[client_id] = items
    return len(items)


def ingest_all_from_mapping(mapping_path: str) -> Dict[str, int]:
    with open(mapping_path, "r", encoding="utf-8") as f:
        mp = json.load(f)
    counts: Dict[str, int] = {}
    for client_id, pdf_path in mp.items():
        n = ingest_client_pdf(client_id, pdf_path)
        counts[client_id] = n
    return counts

# ---------- Retrieval (restricted to selected client) ----------

def retrieve_for_client(client_id: str, query: str, top_k: int = TOP_K) -> List[Dict[str, Any]]:
    items = INDEX.get(client_id, [])
    if not items:
        return []
    q = embed_texts([query])[0]
    scored = [(float(np.dot(q, emb)), ch) for emb, ch in items]
    scored.sort(key=lambda x: x[0], reverse=True)
    out = []
    for s, ch in scored[:top_k]:
        out.append({
            "text": ch.text,
            "score": s,
            "source": ch.source,
            "page": ch.page,
            "doc_id": ch.doc_id,
        })
    return out

# ---------- Prompt + Bedrock streaming ----------

def build_messages(question: str, ctxs: List[Dict[str, Any]], system_prompt: str, instruction_prompt: str):
    ctx_block = "\n\n".join(
        [f"[Source {i+1}] (doc: {c['doc_id']}, page {c['page']}):\n{c['text']}" for i, c in enumerate(ctxs)]
    )
    user = (
        f"{instruction_prompt}\n\n"
        f"Question: {question}\n\nSources:\n{ctx_block}"
    )
    return [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user},
    ]


def stream_sonnet(messages):
    body = json.dumps({
        "anthropic_version": "bedrock-2023-05-31",
        "max_tokens": 1024,
        "messages": messages,
        # optional: "temperature": 0.2
    })
    resp = bedrock_rt.invoke_model_with_response_stream(
        modelId=BEDROCK_SONNET,
        body=body,
        accept="application/json",
        contentType="application/json",
    )
    for event in resp["body"]:
        if "chunk" in event:
            data = json.loads(event["chunk"]["bytes"].decode("utf-8"))
            delta = data.get("delta", {}).get("text", "") or data.get("output_text", "")
            if delta:
                yield delta


def answer_question(client_id: str, question: str, system_prompt: str, instruction_prompt: str, top_k: int = TOP_K):
    ctxs = retrieve_for_client(client_id, question, top_k=top_k)
    msgs = build_messages(question, ctxs, system_prompt, instruction_prompt)
    return ctxs, stream_sonnet(msgs)
```

