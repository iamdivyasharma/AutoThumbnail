#!/usr/bin/env python3
"""
rag_finance_queries_wide_excel_llm_per_client.py

FINANCE-only, file-based, WITH LLM, wide Excel format.

For EACH FINANCE client FAISS index and EACH FILE (policy),
create ONE Excel file:

  ./finance_query_exports/finance_queries_<sanitized_client_id>.xlsx

Each Excel has:

  Row    = one file/policy in that client-category
  Column = one JSON field from the LLM output (1..N fields)

Columns (example):

  Client | Policy | Source File | <field_1> | ... | <field_N> | FlatString | Sources

Where:
- JSON fields come from your fixed schema in the system prompt.
- FlatString is the semicolon-separated string of the N values, in order.
"""

from __future__ import annotations

import os
import json
import re
from pathlib import Path
from typing import List, Dict, Any, Tuple

import pandas as pd
from boto3 import Session
from langchain_aws import BedrockEmbeddings, ChatBedrock
from langchain_community.vectorstores import FAISS
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser

# ===================== CONFIG =====================

# TODO: set this correctly (the same root used by your indexer)
FAISS_INDEX_DIR    = Path("/ABS/PATH/TO/faiss_indices").resolve()
FINANCE_INDEX_ROOT = FAISS_INDEX_DIR / "finance"

OUTPUT_DIR         = Path("./finance_query_exports").resolve()

# Run only for a single finance client id (relative under finance/), or "" for ALL
