# ---------- Client Content Explorer (Excel) ----------
st.markdown("### Client Content Explorer")

try:
    df, CLIENT_COL, CAT_COL, CONTENT_COL = load_excel(EXCEL_PATH)

    # Single dropdown: pick a client
    clients = sorted(df[CLIENT_COL].dropna().unique().tolist())
    sel_client = st.selectbox("Select a Client", ["-- Select --"] + clients, key="sel_client_excel")

    if sel_client and sel_client != "-- Select --":
        # Filter all rows for this client
        selection = (
            df[df[CLIENT_COL] == sel_client]
            [[CAT_COL, CONTENT_COL]]       # only show clause + content
            .rename(columns={CAT_COL: "Clause", CONTENT_COL: "Content"})
            .reset_index(drop=True)
        )

        if selection.empty:
            st.warning("No clauses/content found for this client.")
        else:
            st.success(f"Showing clauses & content for **{sel_client}**")
            # Always show as a dataframe (as requested)
            st.dataframe(selection, use_container_width=True)

    st.divider()

except Exception as e:
    st.error(f"Could not load Excel: {e}")
    st.caption(
        "Check the file path and column names. "
        "Expected columns (or aliases): "
        f"client={COLUMN_ALIASES['client']}, "
        f"category={COLUMN_ALIASES['category']} (includes 'categrpy'), "
        f"content={COLUMN_ALIASES['content']}."
    )
