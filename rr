import streamlit as st
from datetime import date, timedelta

# --- Display labels for airports ---
AIRPORT_LABELS = {
    "DEL": "Delhi — Indira Gandhi Intl",
    "BOM": "Mumbai — Chhatrapati Shivaji Maharaj Intl",
    "BLR": "Bengaluru — Kempegowda Intl",
    "MAA": "Chennai — Chennai Intl",
    "HYD": "Hyderabad — Rajiv Gandhi Intl",
    "CCU": "Kolkata — Netaji Subhas Chandra Bose Intl",
    "PNQ": "Pune — Lohegaon",
    "COK": "Kochi — Cochin Intl",
    "GOI": "Goa — Dabolim",
    "DXB": "Dubai — Dubai Intl",
    "SIN": "Singapore — Changi",
    "LHR": "London — Heathrow",
    "JFK": "New York — John F. Kennedy Intl",
    "SFO": "San Francisco — SFO",
}
ORIGIN_OPTIONS      = ["DEL","BLR","MAA","HYD","CCU","PNQ","COK","GOI","BOM","DXB","SIN","LHR","JFK","SFO"]
DESTINATION_OPTIONS = ["BOM","DEL","BLR","CCU","MAA","HYD","COK","PNQ","GOI","DXB","SIN","LHR","JFK","SFO"]
POLICY_OPTIONS      = ["Any", "Compliant", "Non-compliant", "Pending"]

# --- Only these dates are allowed (edit these lists) ---
ALLOWED_START_DATES = ["2025-09-01", "2025-09-05", "2025-09-08", "2025-09-10", "2025-10-01"]
ALLOWED_END_DATES   = ["2025-09-01", "2025-09-07", "2025-09-10", "2025-09-15", "2025-10-31", "2025-12-31"]

# Helpers
def label_for(code: str) -> str:
    return f"{code} ({AIRPORT_LABELS.get(code, 'Unknown')})"

def _idx(val, opts, default=0):
    try:
        return opts.index(val) if val in opts else default
    except Exception:
        return default

def _iso_to_dates(xs):
    return sorted(date.fromisoformat(x) if isinstance(x, str) else x for x in xs)

def _as_date(x, fallback: date) -> date:
    """Accept date or ISO string; coerce invalid/None to fallback."""
    if isinstance(x, date):
        return x
    if isinstance(x, str):
        try:
            return date.fromisoformat(x)
        except ValueError:
            pass
    return fallback

START_WHITELIST = _iso_to_dates(ALLOWED_START_DATES)
END_WHITELIST   = _iso_to_dates(ALLOWED_END_DATES)

def _snap_to_allowed(chosen: date, allowed: list[date], *, direction="nearest", min_after: date | None = None) -> date:
    if not allowed:
        return chosen
    if min_after is not None:
        allowed = [d for d in allowed if d >= min_after] or [allowed[-1]]
    if direction == "up":
        for d in allowed:
            if d >= chosen:
                return d
        return allowed[-1]
    if direction == "down":
        for d in reversed(allowed):
            if d <= chosen:
                return d
        return allowed[0]
    return min(allowed, key=lambda d: abs(d - chosen))

# ===== Ensure & sanitize state (store dates as ISO strings) =====
DEFAULTS = {
    "ond": {"origin": ORIGIN_OPTIONS[0], "destination": DESTINATION_OPTIONS[0]},
    "start_date": START_WHITELIST[0].isoformat(),
    "end_date": END_WHITELIST[0].isoformat(),
    "policy_status": "Any",
}

if "filters" not in st.session_state or not isinstance(st.session_state.filters, dict):
    st.session_state.filters = DEFAULTS.copy()

# Fill missing keys
for k, v in DEFAULTS.items():
    if k not in st.session_state.filters:
        st.session_state.filters[k] = v

# Coerce bad/missing date values to safe ISO strings
for key, fallback in (("start_date", START_WHITELIST[0]), ("end_date", END_WHITELIST[0])):
    v = st.session_state.filters.get(key)
    if isinstance(v, date):
        st.session_state.filters[key] = v.isoformat()
    elif isinstance(v, str):
        try:
            date.fromisoformat(v)
        except Exception:
            st.session_state.filters[key] = fallback.isoformat()
    else:
        st.session_state.filters[key] = fallback.isoformat()

f = st.session_state.filters

with st.container():
    st.markdown("### 🔎 Filters")

    col1, col2, col3 = st.columns([1,1,1])
    with col1:
        origin_code = st.selectbox(
            "Origin",
            options=ORIGIN_OPTIONS,
            index=_idx(f["ond"]["origin"], ORIGIN_OPTIONS, 0),
            format_func=label_for,
            key="origin_select",
        )
    with col2:
        dest_code = st.selectbox(
            "Destination",
            options=DESTINATION_OPTIONS,
            index=_idx(f["ond"]["destination"], DESTINATION_OPTIONS, 0),
            format_func=label_for,
            key="dest_select",
        )
    with col3:
        policy = st.selectbox(
            "Policy status",
            options=POLICY_OPTIONS,
            index=_idx(f["policy_status"], POLICY_OPTIONS, 0),
            key="policy_select",
        )

    # Calendar pickers (bounded by whitelist range)
    d1, d2 = st.columns(2)
    with d1:
        start_default = _as_date(f.get("start_date"), START_WHITELIST[0])
          # snap to nearest allowed start
        start_default = _snap_to_allowed(start_default, START_WHITELIST, direction="nearest")
        start_pick = st.date_input(
            "Start date",
            value=start_default,
            min_value=START_WHITELIST[0],
            max_value=START_WHITELIST[-1],
            format="YYYY-MM-DD",
            key="start_date_picker",
        )
    with d2:
        end_default = _as_date(f.get("end_date"), END_WHITELIST[0])
        # End must be >= start; snap upward and enforce min_after
        end_default = _snap_to_allowed(end_default, END_WHITELIST, direction="up", min_after=start_pick)
        end_pick = st.date_input(
            "End date",
            value=end_default,
            min_value=END_WHITELIST[0],
            max_value=END_WHITELIST[-1],
            format="YYYY-MM-DD",
            key="end_date_picker",
        )

    a1, a2 = st.columns(2)
    with a1:
        apply_filters = st.button("Apply", use_container_width=True, key="filters_apply")
    with a2:
        clear_filters = st.button("Clear", use_container_width=True, key="filters_clear")

    if apply_filters:
        # snap to allowed sets
        snapped_start = _snap_to_allowed(start_pick, START_WHITELIST, direction="nearest")
        snapped_end   = _snap_to_allowed(end_pick,   END_WHITELIST,   direction="up", min_after=snapped_start)

        if origin_code == dest_code:
            st.warning("Origin and Destination cannot be the same.")
        else:
            # save to state (ISO)
            st.session_state.filters = {
                "ond": {"origin": origin_code, "destination": dest_code},
                "start_date": snapped_start.isoformat(),
                "end_date": snapped_end.isoformat(),
                "policy_status": policy,
            }
            # surface adjustments, if any
            if snapped_start != start_pick:
                st.info(f"Start date adjusted to allowed date: {snapped_start.isoformat()}")
            if snapped_end != end_pick:
                st.info(f"End date adjusted to allowed date: {snapped_end.isoformat()}")
            st.success("Filters applied.")

    if clear_filters:
        st.session_state.filters = DEFAULTS.copy()
        st.info("Filters reset to defaults.")

    fil = st.session_state.filters
    st.caption(
        f"Active → {label_for(fil['ond']['origin'])} → {label_for(fil['ond']['destination'])} | "
        f"Start: {fil['start_date']} | End: {fil['end_date']} | Policy: {fil['policy_status']}"
    )
