

#!/usr/bin/env python3
# index_clients.py — Per-file PyMuPDF vs Textract, using only s3:GetObject (no List)
# - Input: PREDEFINED list of S3 PDF URIs
# - Detect native text using PyMuPDF on bytes from GetObject
# - If "editable": extract with PyMuPDF (page-by-page)
# - Else: extract with Textract (multi-page)
# - Output: FAISS per client under FAISS_INDEX_DIR/<client>/ + manifest.json
# - No pytesseract; no S3 listing

from __future__ import annotations

import os
import re
import json
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Tuple, Iterable, Optional

import fitz  # PyMuPDF
import boto3
from langchain_aws import BedrockEmbeddings
from langchain_community.vectorstores import FAISS
from langchain.schema import Document

# ============ FILL THIS: your fixed list of PDFs ============
S3_PDF_URIS: List[str] = [
    # "s3://your-bucket/ALL_PDFS/ClientA__policy1.pdf",
    # "s3://your-bucket/ALL_PDFS/ClientB-contract-2024.pdf",
]

# ============ Paths / AWS ============
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()

REGION = "us-east-1"
SESSION = boto3.Session(region_name=REGION)
S3 = SESSION.client("s3")
BEDROCK_RT = SESSION.client("bedrock-runtime")
TEXTRACT   = SESSION.client("textract")

try:
    from langchain_community.document_loaders import AmazonTextractPDFLoader
    _HAS_TEXTRACT = True
except Exception:
    _HAS_TEXTRACT = False

# ============ Models / chunking ============
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
CHUNK_SIZE = 1200
CHUNK_OVERLAP = 150

# Native-text detection thresholds
MIN_NATIVE_TEXT_CHARS = 120   # per sampled page
SAMPLE_MAX_PAGES = 50         # cap for huge PDFs

# ============ Helpers ============

def parse_s3_uri(uri: str) -> tuple[str, str]:
    assert uri.lower().startswith("s3://"), f"Not an s3 URI: {uri}"
    _, rest = uri.split("://", 1)
    bucket, key = rest.split("/", 1)
    return bucket, key

def client_from_filename(path_or_uri: str) -> str:
    base = os.path.basename(path_or_uri)
    stem = os.path.splitext(base)[0]
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()

def clean_text(t: str) -> str:
    return re.sub(r"[ \t]+\n", "\n", (t or "")).strip()

def chunk_text(text: str, chunk_size: int = CHUNK_SIZE, overlap: int = CHUNK_OVERLAP) -> List[Tuple[int, int, str]]:
    text = text or ""
    n = len(text)
    if n == 0:
        return []
    if n <= chunk_size:
        return [(0, n, text)]
    chunks: List[Tuple[int, int, str]] = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        chunks.append((start, end, text[start:end]))
        if end == n:
            break
        start = max(0, end - overlap)
    return chunks

@dataclass
class DocInfo:
    policy_id: str
    source_file: str  # s3://...
    pages: int
    modified_time: int  # from HeadObject (works with GetObject permission)

def embedder():
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=BEDROCK_RT)

# ============ S3 I/O using only GetObject / HeadObject ============

def s3_get_object_bytes(bucket: str, key: str) -> Optional[bytes]:
    try:
        obj = S3.get_object(Bucket=bucket, Key=key)
        return obj["Body"].read()
    except Exception as e:
        print(f"[WARN] GetObject failed for s3://{bucket}/{key}: {e}")
        return None

def s3_head_modified_epoch(bucket: str, key: str) -> int:
    try:
        h = S3.head_object(Bucket=bucket, Key=key)
        return int(h["LastModified"].timestamp())
    except Exception:
        return 0

# ============ Detection ============

def analyze_pdf_native_text(bytes_: bytes) -> tuple[bool, int]:
    """
    Returns (is_editable, page_count) by sampling PyMuPDF native text.
    """
    try:
        with fitz.open(stream=bytes_, filetype="pdf") as doc:
            n = doc.page_count
            if n == 0:
                return (False, 0)
            check = min(n, SAMPLE_MAX_PAGES)
            hits = 0
            for i in range(check):
                t = clean_text(doc.load_page(i).get_text("text"))
                if len(t) >= MIN_NATIVE_TEXT_CHARS:
                    hits += 1
            return ((hits / check) >= 0.5, n)
    except Exception as e:
        print(f"[WARN] PyMuPDF analyze failed: {e}")
        return (False, 0)

# ============ Extractors ============

def extract_pymupdf_chunks(bytes_: bytes, s3_uri: str, client_id: str) -> Iterable[Document]:
    """
    Open bytes with PyMuPDF and yield page-chunks.
    """
    policy_id = os.path.basename(s3_uri)
    try:
        with fitz.open(stream=bytes_, filetype="pdf") as doc:
            for pnum in range(doc.page_count):
                text = clean_text(doc.load_page(pnum).get_text("text"))
                if not text:
                    continue
                for _, _, chunk in chunk_text(text):
                    if not chunk.strip():
                        continue
                    meta = {
                        "client_id": client_id,
                        "policy_id": policy_id,
                        "page": pnum + 1,
                        "source_file": s3_uri,   # keep canonical S3 URI
                        "extracted_by": "pymupdf",
                    }
                    yield Document(page_content=chunk, metadata=meta)
    except Exception as e:
        print(f"[WARN] PyMuPDF extract failed for {policy_id}: {e}")

def extract_textract_page_texts(s3_uri: str) -> Dict[int, str]:
    """
    Use AmazonTextractPDFLoader directly on s3:// URI. Returns {page: text}.
    """
    pages: Dict[int, str] = {}
    if not _HAS_TEXTRACT:
        print("[ERROR] AmazonTextractPDFLoader not available.")
        return pages
    try:
        from langchain_community.document_loaders import AmazonTextractPDFLoader
        loader = AmazonTextractPDFLoader(file_path=s3_uri, client=TEXTRACT)
        docs = loader.load()  # list[Document] with metadata.page when available
        if not docs:
            return pages
        any_page_meta = any(int(d.metadata.get("page", 0) or 0) > 0 for d in docs)
        if any_page_meta:
            for d in docs:
                p = int(d.metadata.get("page", 0) or 0) or 1
                pages.setdefault(p, "")
                pages[p] += ("\n\n" if pages[p] else "") + clean_text(d.page_content or "")
        else:
            full = "\n\n".join(clean_text(d.page_content or "") for d in docs)
            if full.strip():
                pages[1] = full
    except Exception as e:
        print(f"[WARN] Textract failed for {s3_uri}: {e}")
    return pages

def extract_textract_chunks(s3_uri: str, client_id: str) -> Iterable[Document]:
    policy_id = os.path.basename(s3_uri)
    page_texts = extract_textract_page_texts(s3_uri)
    for pno in sorted(page_texts.keys()):
        text = clean_text(page_texts[pno])
        if not text:
            continue
        for _, _, chunk in chunk_text(text):
            if not chunk.strip():
                continue
            meta = {
                "client_id": client_id,
                "policy_id": policy_id,
                "page": int(pno),
                "source_file": s3_uri,
                "extracted_by": "textract",
            }
            yield Document(page_content=chunk, metadata=meta)

# ============ Build & Save per-client indexes ============

def index_from_uris(uris: List[str]) -> None:
    # group by client
    by_client: Dict[str, List[str]] = {}
    for uri in uris:
        cid = client_from_filename(uri)
        by_client.setdefault(cid, []).append(uri)
    for cid in by_client:
        by_client[cid] = sorted(by_client[cid], key=str.lower)

    for client_id, client_uris in by_client.items():
        client_dir = (FAISS_INDEX_DIR / client_id)
        client_dir.mkdir(parents=True, exist_ok=True)

        docs: List[Document] = []
        manifest_rows: List[DocInfo] = []

        for s3_uri in client_uris:
            bucket, key = parse_s3_uri(s3_uri)

            # 1) Try to read bytes with GetObject (no listing) for detection
            pdf_bytes = s3_get_object_bytes(bucket, key)

            editable = False
            page_count_detected = 0
            if pdf_bytes:
                editable, page_count_detected = analyze_pdf_native_text(pdf_bytes)

            # 2) Extract using the chosen path
            if editable and pdf_bytes:
                # PyMuPDF
                for d in extract_pymupdf_chunks(pdf_bytes, s3_uri, client_id):
                    docs.append(d)
                pages_for_manifest = page_count_detected
            else:
                # Textract
                page_texts = extract_textract_page_texts(s3_uri)
                pages_for_manifest = (max(page_texts.keys()) if page_texts else 0)
                for d in extract_textract_chunks(s3_uri, client_id):
                    docs.append(d)

            # 3) Manifest row (modified_time from HeadObject, allowed with GetObject)
            manifest_rows.append(DocInfo(
                policy_id=os.path.basename(s3_uri),
                source_file=s3_uri,
                pages=pages_for_manifest,
                modified_time=s3_head_modified_epoch(bucket, key),
            ))

        if not docs:
            print(f"[{client_id}] No extractable text; skipping index.")
            continue

        print(f"[{client_id}] Building FAISS with {len(docs)} chunks…")
        vs = FAISS.from_documents(docs, embedder())
        vs.save_local(str(client_dir))

        manifest = {
            "client_id": client_id,
            "docs": [
                {
                    "policy_id": m.policy_id,
                    "source_file": m.source_file,
                    "pages": m.pages,
                    "modified_time": m.modified_time,
                }
                for m in manifest_rows
            ],
            "generated_time": int(time.time()),
        }
        (client_dir / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
        print(f"[{client_id}] Done. Index at {client_dir}")

# ============ Main ============

def main():
    if not S3_PDF_URIS:
        raise SystemExit("S3_PDF_URIS is empty. Add your s3:// PDF links at the top.")
    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)
    index_from_uris(S3_PDF_URIS)

if __name__ == "__main__":
    main()
