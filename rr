        for line in p.read_text().splitlines():
            try:
                out.append(json.loads(line))
            except Exception:
                continue
        _EXCEL_HISTORY[session_id] = out[-200:]
        return _EXCEL_HISTORY[session_id]

def _append_history(session_id: str, role: str, text: str):
    now = datetime.utcnow().isoformat(timespec="seconds") + "Z"
    rec = {"role": role, "text": text, "time": now}
    with _HISTORY_LOCK:
        sess = _EXCEL_HISTORY.setdefault(session_id, [])
        sess.append(rec)
        if len(sess) > 200:
            _EXCEL_HISTORY[session_id] = sess[-200:]
        # persist
        _hist_path(session_id).write_text(
            "\n".join(json.dumps(x, ensure_ascii=False) for x in _EXCEL_HISTORY[session_id])
        )

# ---------- load & index workbook ----------
def _load_excel_into_frames() -> Dict[str, pd.DataFrame]:
    if not EXCEL_FILE.exists():
        raise HTTPException(404, f"Excel file not found at {EXCEL_FILE}")
    frames = pd.read_excel(EXCEL_FILE, sheet_name=None, engine=None)
    norm = {}
    for sh, df in frames.items():
        df = df.copy()
        df.columns = [str(c) for c in df.columns]
        norm[str(sh)] = df
    return norm

def _df_rows_to_text(df: pd.DataFrame, sheet: str, start: int, end: int) -> str:
    lines = [f"[sheet: {sheet}] rows {start+1}-{end}"]
    for i in range(start, end):
        row = df.iloc[i]
        kv = ", ".join(f"{col}={repr(row[col])}" for col in df.columns)
        lines.append(f"r{i+1}: {kv}")
    return "\n".join(lines)

def _build_excel_faiss() -> None:
    df_by_sheet = _load_excel_into_frames()
    sheets = list(df_by_sheet.keys())
    rows = {s: int(len(df_by_sheet[s])) for s in sheets}
    mtime = datetime.fromtimestamp(EXCEL_FILE.stat().st_mtime).isoformat(timespec="seconds")

    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))

    texts = []
    chunk_meta = []
    CHUNK_SIZE = int(os.getenv("EXCEL_CHUNK_ROWS", "40"))
    for sh in sheets:
        df = df_by_sheet[sh]
        n = len(df)
        if n == 0:
            continue
        for start in range(0, n, CHUNK_SIZE):
            end = min(start + CHUNK_SIZE, n)
            text = _df_rows_to_text(df, sh, start, end)
            texts.append(text)
            chunk_meta.append({"sheet": sh, "start_row": start+1, "end_row": end})

    if not texts:
        raise HTTPException(400, "Excel workbook has no rows to index.")

    vs = FAISS.from_texts(texts=texts, embedding=emb)
    vs.save_local(str(EXCEL_INDEX_DIR))

    _EXCEL["df_by_sheet"] = df_by_sheet
    _EXCEL["meta"] = {"sheets": sheets, "rows": rows, "mtime": mtime, "path": str(EXCEL_FILE)}
    _EXCEL["vs"] = vs
    _EXCEL["chunk_meta"] = chunk_meta
    _EXCEL["last_loaded_at"] = datetime.utcnow().isoformat(timespec="seconds") + "Z"

def _ensure_excel_loaded():
    # if we’ve got both frames and the index, we’re good
    if _EXCEL.get("vs") is not None and _EXCEL.get("df_by_sheet"):
        return
    # try to load saved index
    try:
        emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
        _EXCEL["vs"] = FAISS.load_local(str(EXCEL_INDEX_DIR), emb, allow_dangerous_deserialization=True)
    except Exception:
        _EXCEL["vs"] = None
    # ensure frames
    if not _EXCEL.get("df_by_sheet"):
        try:
            _EXCEL["df_by_sheet"] = _load_excel_into_frames()
        except HTTPException:
            raise
        except Exception as e:
            raise HTTPException(500, f"Failed to read Excel: {e}")
    # rebuild if no vs
    if _EXCEL["vs"] is None:
        _build_excel_faiss()

# ---------- conversation-aware Excel answer ----------
def _rewrite_followup_to_standalone(question: str, history: List[Dict[str, Any]]) -> str:
    """
    Make a standalone question from the latest user message + short conversation window.
    """
    if not history:
        return question

    # take last 6 messages (max 3 user turns)
    window = history[-6:]
    llm = ChatBedrockConverse(model_id=LLM_MODEL, client=SESSION.client("bedrock-runtime"),
                              temperature=0.0, max_tokens=200)
    prompt_rewrite = ChatPromptTemplate.from_messages([
        ("system", "You convert follow-up questions into standalone questions using prior chat turns."),
        *[("user" if t["role"]=="user" else "assistant", t["text"]) for t in window],
        ("user", "Rewrite the last user question into a self-contained question. Do not answer.")
    ])
    chain = prompt_rewrite | llm | StrOutputParser()
    try:
        out = chain.invoke({})
        return out.strip() or question
    except Exception:
        return question

def _excel_answer(question: str, k: int = 6, session_id: Optional[str] = None) -> Dict[str, Any]:
    _ensure_excel_loaded()
    vs = _EXCEL["vs"]

    # ---- history & rewrite ----
    hist = _load_history(session_id) if session_id else []
    standalone_q = _rewrite_followup_to_standalone(question, hist)

    # ---- retrieve with the standalone question ----
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k})
    docs = retriever.get_relevant_documents(standalone_q)

    # build previews (sheet+rows) based on our own chunk_meta indexing
    previews = []
    # NOTE: FAISS returns docs without our external meta, so we attach previews heuristically by re-searching text in chunk_meta order
    for d in docs:
        # find matching chunk_meta by header line "[sheet: X] rows a-b" at the top of d.page_content
        header_match = re.match(r"\[sheet:\s*(?P<sh>.+?)\]\s*rows\s*(?P<a>\d+)-(?P<b>\d+)", d.page_content or "", re.I)
        if header_match:
            sh = header_match.group("sh")
            a  = int(header_match.group("a"))
            b  = int(header_match.group("b"))
            df = _EXCEL["df_by_sheet"].get(sh)
            if df is not None:
                df_slice = df.iloc[max(0, a-1):min(b, a-1+8)]
                preview = df_slice.to_string(index=False)
                previews.append(f"(sheet: {sh}, rows {a}-{min(b, a-1+8)})\n{preview}")

    context = "\n\n---\n\n".join(previews) if previews else "(no preview)"

    # ---- answer with history in the prompt ----
    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=0.15,
        max_tokens=900
    )
    # take a generous memory window
    memory_window = hist[-10:]

    excel_prompt = ChatPromptTemplate.from_messages([
        ("system",
         "You are a precise data analyst. Answer ONLY using the Provided Context from the Excel sheets. "
         "Be specific with rows/columns where possible. If the data needed isn't in the context, say you don't know."),
        *[("user" if t["role"]=="user" else "assistant", t["text"]) for t in memory_window],
        ("user", "Question: {question}\n\nProvided Context:\n{context}\n\nAnswer now with specifics.")
    ])
    chain = excel_prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": question, "context": context})

    # ---- persist history ----
    if session_id:
        _append_history(session_id, "user", question)
        _append_history(session_id, "assistant", answer)

    # ---- sources list ----
    srcs = []
    for d in docs:
        header_match = re.match(r"\[sheet:\s*(?P<sh>.+?)\]\s*rows\s*(?P<a>\d+)-(?P<b>\d+)", d.page_content or "", re.I)
        if header_match:
            srcs.append({
                "sheet": header_match.group("sh"),
                "start_row": int(header_match.group("a")),
                "end_row": int(header_match.group("b")),
                "snippet": (d.page_content or "")[:300]
            })

    return {"answer": answer, "sources": srcs, "history": _EXCEL_HISTORY.get(session_id or "", [])}

# ======= MODELS (Excel) =======
class ExcelChatRequest(BaseModel):
    question: str
    session_id: Optional[str] = None
    k: Optional[int] = 6
    persist: Optional[bool] = True  # not used server-side now, kept for forwards-compat

class ExcelChatResponse(BaseModel):
    answer: str
    sources: List[Dict[str, Any]]
    history: List[Dict[str, Any]]
    meta: Dict[str, Any]

# ======= ROUTES (Excel) =======
@app.get("/excel/metadata")
def excel_metadata():
    _ensure_excel_loaded()
    return {
        "path": _EXCEL["meta"].get("path"),
        "mtime": _EXCEL["meta"].get("mtime"),
        "sheets": _EXCEL["meta"].get("sheets"),
        "rows": _EXCEL["meta"].get("rows"),
        "last_loaded_at": _EXCEL.get("last_loaded_at"),
    }

@app.post("/excel/chat", response_model=ExcelChatResponse)
def excel_chat(payload: ExcelChatRequest):
    if not payload.question or not payload.question.strip():
        raise HTTPException(400, "Missing question.")
    res = _excel_answer(payload.question.strip(), k=int(payload.k or 6), session_id=payload.session_id or "default")
    meta = {
        "path": _EXCEL["meta"].get("path"),
        "mtime": _EXCEL["meta"].get("mtime"),
        "sheets": _EXCEL["meta"].get("sheets"),
    }
    return ExcelChatResponse(answer=res["answer"], sources=res["sources"], history=res["history"], meta=meta)

@app.post("/excel/refresh")
def excel_refresh():
    _build_excel_faiss()
    return {"status": "ok", "message": "Excel reloaded and indexed.", "meta": _EXCEL["meta"]}

@app.get("/excel/history/{session_id}")
def get_excel_history(session_id: str):
    return {"session_id": session_id, "history": _load_history(session_id)}

@app.delete("/excel/history/{session_id}")
def clear_excel_history(session_id: str):
    with _HISTORY_LOCK:
        _EXCEL_HISTORY.pop(session_id, None)
        p = _hist_path(session_id)
        if p.exists():
            try: p.unlink()
            except Exception: pass
    return {"status": "ok", "session_id": session_id, "cleared": True}
