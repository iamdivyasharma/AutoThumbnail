import re, json
from typing import Optional, Dict

def _to_number(s: Optional[str]) -> Optional[float]:
    if not s:
        return None
    m = re.search(r"[-+]?\d[\d,]*(?:\.\d+)?", s)
    if not m:
        return None
    return float(m.group(0).replace(",", ""))

def extract_recommended_wish_price(text: str) -> Dict[str, Optional[float]]:
    """
    Extracts values from a section like:
      Recommended Wish Price:
        - Minimum: $12,345
        - Maximum: 15,000
        - Exact: 13,200
    Also works if they're inline: "Recommended Wish Price: -Minimum: $10 -Maximum: $12 -Exact: $11"
    Returns a dict: {"minimum": float|None, "maximum": float|None, "exact": float|None}
    """
    # 1) Isolate the "Recommended Wish Price" block (until a blank line or end)
    block = None
    m = re.search(r"Recommended\s+Wish\s+Price\s*:?(.*?)(?:\n\s*\n|$)", text, flags=re.IGNORECASE|re.DOTALL)
    if m:
        block = m.group(1)
    else:
        # fallback: use whole text if the tag isn't cleanly formatted
        block = text

    # 2) Try to capture each label within the block (handles bullets, dashes, punctuation)
    def grab(label: str) -> Optional[float]:
        pat = rf"{label}\s*(?:price)?\s*[:\-–]\s*([^\n\r;]+)"
        mm = re.search(pat, block, flags=re.IGNORECASE)
        return _to_number(mm.group(1)) if mm else None

    minimum = grab("Minimum")
    maximum = grab("Maximum")
    exact   = grab("Exact")

    # 3) Fallbacks (in case labels are missing but values appear inline after label tokens)
    if minimum is None or maximum is None or exact is None:
        # Look for compact "-Minimum: X -Maximum: Y -Exact: Z" pattern
        compact = re.search(
            r"Minimum\s*[:\-–]\s*([^\n\r\-]+).*?Maximum\s*[:\-–]\s*([^\n\r\-]+).*?Exact\s*[:\-–]\s*([^\n\r\-]+)",
            block, flags=re.IGNORECASE|re.DOTALL
        )
        if compact:
            minimum = minimum or _to_number(compact.group(1))
            maximum = maximum or _to_number(compact.group(2))
            exact   = exact   or _to_number(compact.group(3))

    return {"minimum": minimum, "maximum": maximum, "exact": exact}

def extract_as_json(text: str) -> str:
    """Convenience wrapper: returns a JSON string."""
    data = extract_recommended_wish_price(text)
    return json.dumps(data, ensure_ascii=False, separators=(",", ":"))

