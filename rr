#!/usr/bin/env python3
# index_clients_s3.py
# S3 → (cheap pre-check) → native-text (pypdf/docx) OR scanned (Textract) → FAISS
#
# - Discovers contracts in S3:
#     s3://BUCKET/CONTRACTS/legal/<ClientName>/...
#     s3://BUCKET/CONTRACTS/finance/<ClientName>/...
# - For each file:
#     PDF:
#       - Try pypdf on first few pages
#       - If enough text => treat as native-text, use pypdf only
#       - Else => treat as scanned/image, use AmazonTextractPDFLoader
#     DOCX:
#       - Always use python-docx (no Textract)
# - Indexes per (contract_type, client_id):
#     FAISS_INDEX_DIR/<contract_type>/<client_id>/

from __future__ import annotations

import io
import os
import re
import json
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Tuple, Optional

from langchain_aws import BedrockEmbeddings
from langchain_community.vectorstores import FAISS
from langchain.schema import Document
from langchain_community.document_loaders import AmazonTextractPDFLoader

import boto3
from pypdf import PdfReader

# DOCX support (optional but recommended)
try:
    from docx import Document as DocxDocument
    _HAS_DOCX = True
except Exception:
    _HAS_DOCX = False

# -------------------------------------------------------------------
# 1) S3 discovery config
# -------------------------------------------------------------------
BUCKET_NAME = "your-bucket-name"  # TODO: change this
ROOT_PREFIXES = [
    "CONTRACTS/legal/",
    "CONTRACTS/finance/",
]

# Minimum number of contracts per (contract_type, client) that you want to index
MIN_CONTRACTS_PER_CLIENT = 10

# -------------------------------------------------------------------
# 2) Output directory (local path where FAISS indexes are stored)
# -------------------------------------------------------------------
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()  # TODO: change this

# -------------------------------------------------------------------
# 3) AWS / Bedrock (embeddings)
# -------------------------------------------------------------------
REGION = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

SESSION = boto3.Session(region_name=REGION)
BEDROCK_RT = SESSION.client("bedrock-runtime")
S3_CLIENT = SESSION.client("s3")

# Known contract types in key path (folder names)
CONTRACT_TYPES = ("legal", "finance")

# -------------------------------------------------------------------
# 4) Chunking
# -------------------------------------------------------------------
CHUNK_SIZE = 1200
CHUNK_OVERLAP = 150

# Heuristics for deciding "native text" vs "scanned"
PDF_MIN_NATIVE_CHARS = 200     # min chars in first few pages to consider native
PDF_CHECK_PAGES = 3            # how many pages to inspect for the heuristic


# -------------------------------------------------------------------
# 5) Helpers
# -------------------------------------------------------------------
def clean_text(t: str) -> str:
    import re as _re
    return _re.sub(r"[ \t]+\n", "\n", (t or "")).strip()


def chunk_text(
    text: str,
    chunk_size: int = CHUNK_SIZE,
    overlap: int = CHUNK_OVERLAP,
) -> List[Tuple[int, int, str]]:
    """
    Return list of (start_idx, end_idx, chunk_text).
    """
    text = text or ""
    n = len(text)
    if n == 0:
        return []
    if n <= chunk_size:
        return [(0, n, text)]
    out: List[Tuple[int, int, str]] = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        out.append((start, end, text[start:end]))
        if end == n:
            break
        start = max(0, end - overlap)
    return out


def client_from_filename(path_or_key: str) -> str:
    """
    Fallback client_id from filename if we can't deduce from folders.

    Uses everything before first '__', '_' or '-' as client id.
    """
    base = os.path.basename(path_or_key)
    stem = os.path.splitext(base)[0]
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()


def parse_s3_uri(s3_uri: str) -> Tuple[str, str]:
    """
    s3://bucket/key -> (bucket, key)
    """
    if not s3_uri.startswith("s3://"):
        raise ValueError(f"Not an S3 URI: {s3_uri}")
    without = s3_uri[len("s3://") :]
    bucket, key = without.split("/", 1)
    return bucket, key


def get_contract_type_and_client(s3_uri: str) -> Tuple[str, str]:
    """
    Infer contract_type (legal / finance) and client_id from S3 key path.

    Expected pattern (example):
      CONTRACTS/legal/ClientA/...
      CONTRACTS/finance/ClientB/...

    Falls back to:
      contract_type = "unknown"
      client_id = client_from_filename(key)
    """
    _, key = parse_s3_uri(s3_uri)
    parts = key.split("/")

    contract_type: Optional[str] = None
    client_id: Optional[str] = None

    for i, part in enumerate(parts):
        pl = part.lower()
        if pl in CONTRACT_TYPES and i + 1 < len(parts):
            contract_type = pl
            client_id = parts[i + 1].strip().lower()
            break

    if contract_type is None:
        contract_type = "unknown"

    if not client_id:
        client_id = client_from_filename(key)

    return contract_type, client_id


@dataclass
class DocInfo:
    policy_id: str     # filename from S3 key
    source_file: str   # full s3://...
    pages: int         # number of pages (for PDF) or 0 (docx)
    modified_time: int # left 0 (no HeadObject for now)


def embedder():
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=BEDROCK_RT)


# -------------------------------------------------------------------
# 6) Discover contract URIs from S3
# -------------------------------------------------------------------
def discover_contract_uris(bucket: str, prefixes: List[str]) -> List[str]:
    """
    List all S3 object keys under the given prefixes and return them as
    fully-qualified s3:// URIs.

    Keeps PDFs and DOCX (extend as needed).
    """
    uris: List[str] = []
    paginator = S3_CLIENT.get_paginator("list_objects_v2")

    for prefix in prefixes:
        for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
            for obj in page.get("Contents", []):
                key = obj["Key"]
                # Filter on extension: adjust if you also store .doc, etc.
                if key.lower().endswith((".pdf", ".docx")):
                    uris.append(f"s3://{bucket}/{key}")

    return uris


# -------------------------------------------------------------------
# 7) Native-text extraction: PDF (pypdf) & DOCX (python-docx)
# -------------------------------------------------------------------
def try_extract_pdf_native_from_s3(
    bucket: str,
    key: str,
    check_pages: int = PDF_CHECK_PAGES,
    min_chars: int = PDF_MIN_NATIVE_CHARS,
) -> Optional[Dict[int, str]]:
    """
    Try to treat a PDF as native-text using pypdf.

    Heuristic:
      - Download from S3
      - Extract text from the first `check_pages` pages
      - If we get >= min_chars characters => consider it "native text"
        and then extract text from all pages.
      - Otherwise => treat as scanned/image PDF and return None.

    Returns:
      - dict {page_number: text} if native-text
      - None if appears to be scanned (use Textract instead)
    """
    obj = S3_CLIENT.get_object(Bucket=bucket, Key=key)
    data = obj["Body"].read()

    reader = PdfReader(io.BytesIO(data))
    num_pages = len(reader.pages)
    pages_to_check = min(num_pages, check_pages)

    pages_text: Dict[int, str] = {}
    text_chars = 0

    # Phase 1: classification on first few pages
    for i in range(pages_to_check):
        page = reader.pages[i]
        t = page.extract_text() or ""
        t = clean_text(t)
        if t:
            pages_text[i + 1] = t
            text_chars += len(t)

    if text_chars < min_chars:
        # Not enough text in first pages -> probably scanned
        return None

    # Phase 2: already know it's native, read the rest of the pages
    for i in range(pages_to_check, num_pages):
        page = reader.pages[i]
        t = page.extract_text() or ""
        t = clean_text(t)
        if t:
            pages_text[i + 1] = t

    return pages_text


def extract_docx_text_from_s3(bucket: str, key: str) -> str:
    """
    Extract text from a DOCX file stored in S3 using python-docx.
    """
    if not _HAS_DOCX:
        print(f"[WARN] python-docx not available; skipping DOCX s3://{bucket}/{key}")
        return ""

    obj = S3_CLIENT.get_object(Bucket=bucket, Key=key)
    data = obj["Body"].read()
    try:
        doc = DocxDocument(io.BytesIO(data))
        texts = [para.text for para in doc.paragraphs if para.text]
        return clean_text("\n".join(texts))
    except Exception as e:
        print(f"[WARN] Failed to read DOCX s3://{bucket}/{key}: {e}")
        return ""


# -------------------------------------------------------------------
# 8) Textract wrapper (for scanned PDFs)
# -------------------------------------------------------------------
def textract_pages(s3_uri: str) -> Dict[int, str]:
    """
    Use AmazonTextractPDFLoader(file_path=s3_uri) to pull text.

    Returns:
        { page_number: "text for that page" }

    If the loader doesn't provide page metadata, we collapse all text into page 1.
    """
    pages: Dict[int, str] = {}
    try:
        loader = AmazonTextractPDFLoader(file_path=s3_uri)
        docs = loader.load()  # list[Document]
        if not docs:
            return pages

        # Check if any document has a numeric "page" in metadata
        any_page_meta = any(int(d.metadata.get("page", 0) or 0) > 0 for d in docs)

        if any_page_meta:
            for d in docs:
                p = int(d.metadata.get("page", 0) or 0) or 1
                pages.setdefault(p, "")
                pages[p] += ("\n\n" if pages[p] else "") + clean_text(d.page_content or "")
        else:
            full = "\n\n".join(clean_text(d.page_content or "") for d in docs)
            if full.strip():
                pages[1] = full
    except Exception as e:
        print(f"[WARN] Textract failed for {s3_uri}: {e}")
    return pages


# -------------------------------------------------------------------
# 9) Grouping helpers
# -------------------------------------------------------------------
def group_uris_by_contract_and_client(
    uris: List[str],
) -> Dict[Tuple[str, str], List[str]]:
    out: Dict[Tuple[str, str], List[str]] = {}
    for uri in uris:
        contract_type, client_id = get_contract_type_and_client(uri)
        key = (contract_type, client_id)
        out.setdefault(key, []).append(uri)

    # deterministic ordering
    for k in out:
        out[k] = sorted(out[k], key=str.lower)
    return out


def filter_groups_by_min_contracts(
    grouped: Dict[Tuple[str, str], List[str]],
    min_contracts: int,
) -> Dict[Tuple[str, str], List[str]]:
    """
    Keep only (contract_type, client) groups that have at least
    min_contracts S3 URIs.
    """
    if min_contracts <= 0:
        return grouped
    return {
        key: uris
        for key, uris in grouped.items()
        if len(uris) >= min_contracts
    }


# -------------------------------------------------------------------
# 10) Indexing logic
# -------------------------------------------------------------------
def index_client(contract_type: str, client_id: str, s3_uris: List[str]) -> None:
    """
    Build and save FAISS index for a given (contract_type, client_id).

    Index directory:
      FAISS_INDEX_DIR/<contract_type>/<client_id>/
    """
    client_dir = (FAISS_INDEX_DIR / contract_type / client_id)
    client_dir.mkdir(parents=True, exist_ok=True)

    docs: List[Document] = []
    manifest_rows: List[DocInfo] = []

    for uri in s3_uris:
        bucket, key = parse_s3_uri(uri)
        suffix = key.lower().split(".")[-1]

        page_texts: Dict[int, str] = {}
        extracted_by = None
        pages_count = 0

        if suffix == "pdf":
            # 1) Try native-text extraction (cheap) via pypdf
            native_pages = try_extract_pdf_native_from_s3(bucket, key)
            if native_pages is not None:
                page_texts = native_pages
                extracted_by = "pypdf"
            else:
                # 2) Fallback to Textract for scanned PDFs
                page_texts = textract_pages(uri)
                extracted_by = "textract"

            pages_count = max(page_texts.keys()) if page_texts else 0

        elif suffix == "docx":
            # DOCX: always use python-docx (no Textract)
            full_text = extract_docx_text_from_s3(bucket, key)
            if full_text.strip():
                page_texts = {1: full_text}
                extracted_by = "python-docx"
                pages_count = 0  # or 1 if you prefer
            else:
                page_texts = {}

        else:
            print(f"[WARN] Unsupported file type for {uri}; skipping.")
            continue

        policy_id = os.path.basename(key)

        # Build chunks / Documents
        for pno in sorted(page_texts.keys()):
            text = clean_text(page_texts[pno])
            if not text:
                continue
            for _, _, chunk in chunk_text(text):
                if not chunk.strip():
                    continue
                meta = {
                    "contract_type": contract_type,   # legal / finance / unknown
                    "client_id": client_id,
                    "policy_id": policy_id,
                    "page": int(pno),
                    "source_file": uri,
                }
                if extracted_by:
                    meta["extracted_by"] = extracted_by
                if suffix == "docx":
                    meta["doc_type"] = "docx"
                docs.append(
                    Document(
                        page_content=chunk,
                        metadata=meta,
                    )
                )

        manifest_rows.append(
            DocInfo(
                policy_id=policy_id,
                source_file=uri,
                pages=pages_count,
                modified_time=0,  # no HeadObject yet
            )
        )

    if not docs:
        print(f"[{contract_type}/{client_id}] No extractable text; skipping index.")
        return

    print(f"[{contract_type}/{client_id}] Building FAISS with {len(docs)} chunks…")
    vs = FAISS.from_documents(docs, embedder())
