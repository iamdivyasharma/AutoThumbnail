# ================== HELPERS ==================
def label_for(code: str) -> str:
    return f"{code} ({AIRPORT_LABELS.get(code, 'Unknown')})"

def _idx(val, opts, default=0):
    try:
        return opts.index(val) if val in opts else default
    except Exception:
        return default

def _as_date(x, fallback: date) -> date:
    if isinstance(x, date): return x
    if isinstance(x, str):
        try: return date.fromisoformat(x)
        except ValueError: pass
    return fallback

def _snap_to_allowed(chosen: date, allowed: List[date], *, direction="nearest", min_after: Optional[date] = None) -> date:
    if not allowed: return chosen
    pool = allowed
    if min_after is not None:
        pool = [d for d in allowed if d >= min_after] or [allowed[-1]]
    if direction == "up":
        for d in pool:
            if d >= chosen: return d
        return pool[-1]
    if direction == "down":
        for d in reversed(pool):
            if d <= chosen: return d
        return pool[0]
    return min(pool, key=lambda d: abs(d - chosen))

def build_orchestrator_query_text(f: Dict[str, Any]) -> str:
    # Exact sentence you asked for, with filters appended.
    return (
        "Provide me the best flights for the given route from AIR bot and also provide "
        "best/prefered hotels from HOTEL bot , do check traveller's past history from TDNA bot. "
        f"[Filters] Origin: {f['ond']['origin']}, Destination: {f['ond']['destination']}, "
        f"Start: {f['start_date']}, End: {f['end_date']}, Policy: {f.get('policy_status','Any')}"
    )

