FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()
CONFIGS_PATH    = Path("/ABS/PATH/TO/configs/clients.yaml").resolve()

# ========= AWS / Bedrock =========
REGION = os.getenv("AWS_REGION", "us-east-1")
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# ⚠️ Dev creds (prefer IAM roles in prod)
AWS_ACCESS_KEY_ID     = os.getenv("AWS_ACCESS_KEY_ID", "YOUR_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.getenv("AWS_SECRET_ACCESS_KEY", "YOUR_SECRET_ACCESS_KEY")

from boto3 import Session
SESSION = Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)
S3_CLIENT = SESSION.client("s3")

GLOBAL_DEFAULTS = {"k": 4, "temperature": 0.20, "max_tokens": 1200}
MAX_COMBINED_K  = 12

# Cache of FAISS stores
_VS_CACHE: Dict[str, Any] = {}
_STEP = 0
MAX_LOADED = 5  # simple LRU: keep last N clients loaded

app = FastAPI(title="Contract RAG Backend")

# ========= Models =========
class AskRequest(BaseModel):
    question: str
    client_ids: Optional[List[str]] = None

class AskResponse(BaseModel):
    answer: str
    used_clients: List[str]
    sources: List[Dict[str, Any]]

# ========= YAML / overrides =========
def _load_overrides() -> Dict[str, Dict[str, Any]]:
    if not CONFIGS_PATH.exists():
        return {}
    raw = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for k, v in raw.items():
        if not isinstance(v, dict):
            continue
        ck = str(k).strip().lower()
        out[ck] = {
            "k": int(v.get("k", GLOBAL_DEFAULTS["k"])),
            "temperature": float(v.get("temperature", GLOBAL_DEFAULTS["temperature"])),
            "max_tokens": int(v.get("max_tokens", GLOBAL_DEFAULTS["max_tokens"])),
            "aliases": [str(a).strip().lower() for a in v.get("aliases", [])],
        }
    return out

CLIENT_OVERRIDES = _load_overrides()

def list_clients() -> List[str]:
    if not FAISS_INDEX_DIR.exists():
        return []
    clients = []
    for p in FAISS_INDEX_DIR.iterdir():
        if not p.is_dir() or p.name.startswith("."):
            continue
        if not (p / "index.faiss").exists() or not (p / "index.pkl").exists():
            continue
        clients.append(p.name)
    return sorted(clients)

def _load_index(client_id: str) -> FAISS:
    """Load FAISS for a client with simple LRU cache."""
    global _STEP
    _STEP += 1
    cid = client_id.strip().lower()
    if cid in _VS_CACHE:
        vs, _ = _VS_CACHE[cid]
        _VS_CACHE[cid] = (vs, _STEP)
        return vs
    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
    vs = FAISS.load_local(str(FAISS_INDEX_DIR / cid), emb, allow_dangerous_deserialization=True)
    _VS_CACHE[cid] = (vs, _STEP)
    if len(_VS_CACHE) > MAX_LOADED:
        oldest = min(_VS_CACHE.items(), key=lambda kv: kv[1][1])[0]
        _VS_CACHE.pop(oldest, None)
    return vs

def choose_params(client_id: str) -> Dict[str, Any]:
    return CLIENT_OVERRIDES.get(client_id.strip().lower(), GLOBAL_DEFAULTS.copy())

# ========= Client detection from question (updated) =========
def _normalize_text(s: str) -> str:
    # Lowercase, remove non-alphanumerics -> single spaces, trim.
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()

def _tokenize_norm(s: str) -> list[str]:
    return _normalize_text(s).split()

def _raw_upper_tokens(s: str) -> set[str]:
    """
    Tokenize on non-alphanumerics directly from the original text,
    return set of tokens in UPPERCASE to preserve signal for short aliases
    like 'EL' while avoiding accidental matches with 'el' in Spanish.
    """
    toks = re.split(r"[^A-Za-z0-9]+", s or "")
    return {t.upper() for t in toks if t}

def _build_alias_records(available: List[str]) -> List[Dict[str, Any]]:
    """
    Build a richer alias list per client with multiple matching strategies:
      - 'spaced'  : normalized spaced alias (whole-word match)
      - 'nospace' : alias with spaces removed (to catch 'bmwus')
      - 'tokset'  : order-insensitive tuple of tokens (to catch 'us bmw')
    Also attach a 'short_guard' flag for ≤2-char aliases (e.g., 'EL').
    """
    records: List[Dict[str, Any]] = []

    def add_one(cid: str, alias_raw: str):
        alias_norm = _normalize_text(alias_raw)
        if not alias_norm:
            return
        toks = alias_norm.split()
        short_guard = (len(alias_norm.replace(" ", "")) <= 2)  # e.g., "el", "ai", "uk"

        # spaced
        records.append({
            "cid": cid,
            "type": "spaced",
            "key": alias_norm,                 # e.g., "bmw us"
            "alias_norm": alias_norm,
            "n_tokens": len(toks),
            "len_chars": len(alias_norm.replace(" ", "")),
            "short_guard": short_guard,
        })
        # nospace
        nospace = alias_norm.replace(" ", "")
        records.append({
            "cid": cid,
            "type": "nospace",
            "key": nospace,                    # e.g., "bmwus"
            "alias_norm": alias_norm,
            "n_tokens": len(toks),
            "len_chars": len(nospace),
            "short_guard": short_guard,
        })
        # tokset (order-insensitive, only if multiple tokens)
        if len(toks) >= 2:
            records.append({
                "cid": cid,
                "type": "tokset",
                "key": tuple(sorted(toks)),    # e.g., ("bmw", "us")
                "alias_norm": alias_norm,
                "n_tokens": len(toks),
                "len_chars": len(nospace),
                "short_guard": short_guard,
            })

    # Pull configured aliases (including client_id itself)
    for cid in available:
        c = cid.strip().lower()
        add_one(c, c)
        for a in CLIENT_OVERRIDES.get(c, {}).get("aliases", []):
            add_one(c, a)

    # Prefer more specific entries first:
    # 1) more tokens, 2) longer char length, 3) type priority: spaced > nospace > tokset
    type_rank = {"spaced": 0, "nospace": 1, "tokset": 2}
    records.sort(key=lambda r: (-r["n_tokens"], -r["len_chars"], type_rank[r["type"]]))
    return records

def detect_clients_from_text(text: str, available: List[str]) -> List[str]:
    """
    Detect clients by:
      - whole-word spaced alias matches
      - nospace token presence (bmwus)
      - order-insensitive token sets (us bmw)
    With a guard: short aliases (<=2 chars) only match when they are uppercase
    in the *original* text (e.g., 'EL'), to reduce false positives.
    """
    norm_text = f" {_normalize_text(text)} "   # padded for whole-word scans
    norm_tokens = set(norm_text.split())       # normalized tokens (lowercase)
    raw_upper = _raw_upper_tokens(text)        # raw tokens uppercased

    alias_records = _build_alias_records(available)
    detected: List[str] = []

    for rec in alias_records:
        cid = rec["cid"]
        if cid in detected:
            continue

        # Short alias guard (<= 2 chars): only accept if the exact uppercase token appears in original text.
        if rec["short_guard"]:
            # Use nospace version to define the guard token
            alias_upper_token = rec["alias_norm"].replace(" ", "").upper()
            if alias_upper_token not in raw_upper:
                continue

        if rec["type"] == "spaced":
            # whole-word check using the padded normalized text
            if f" {rec['key']} " in norm_text:
                detected.append(cid)
        elif rec["type"] == "nospace":
            # token presence (normalized, single piece like "bmwus")
            if rec["key"] in norm_tokens:
                detected.append(cid)
        else:  # "tokset"
            toks = set(rec["key"])
            if toks.issubset(norm_tokens):
                detected.append(cid)

    return detected

