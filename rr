from fastapi import FastAPI, Body, Request
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field
from typing import Any, Dict, Optional

app = FastAPI(title="HotelBot (MCP JSON)")

class HotelIn(BaseModel):
    qquery: str
    user_name: Optional[str] = None
    user_email: Optional[str] = None

    class Config:
        extra = "allow"   # <-- keep any additional fields from orchestrator

@app.post("/hotel_query", operation_id="hotel_query_tool")
async def hotel_query(inp: HotelIn = Body(...)):
    payload: Dict[str, Any] = inp.dict()  # includes extra fields due to extra="allow"
    # If your chain accepts a dict:
    # answer = hotel_qa_chain.run(payload)
    # If it only takes text:
    # answer = hotel_qa_chain.run(inp.qquery)
    answer = f"Hotel for {payload.get('qquery')} (user={payload.get('user_email') or payload.get('user_name') or 'anon'})"
    return {"answer": answer, "echo": payload}  # echo helps you verify pass-through

@app.post("/mcp", response_class=JSONResponse)
async def mcp_jsonrpc(req: Request):
    data = await req.json()
    mid = data.get("id")
    method = data.get("method")
    params = data.get("params") or {}

    if method == "tools/list":
        return JSONResponse({"jsonrpc":"2.0","id":mid,"result":{
            "tools":[{
                "name":"hotel_query_tool",
                "arguments":{
                    "qquery":{"type":"string"},
                    "user_name":{"type":"string"},
                    "user_email":{"type":"string"}
                },
                "description":"Query hotels"
            }]
        }})

    if method == "tools/call":
        name = params.get("name")
        args = params.get("arguments") or {}
        if name != "hotel_query_tool":
            return JSONResponse({"jsonrpc":"2.0","id":mid,"error":{"code":-32601,"message":"Method not found"}}, status_code=400)
        out = await hotel_query(HotelIn(**args))
        return JSONResponse({"jsonrpc":"2.0","id":mid,"result":out})

    return JSONResponse({"jsonrpc":"2.0","id":mid,"error":{"code":-32601,"message":"Method not found"}}, status_code=400)
