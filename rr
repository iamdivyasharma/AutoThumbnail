#!/usr/bin/env python3
"""
rag_finance_queries_export_llm.py  (FINANCE-only, query-based, WITH LLM)

Export RAG answers per FINANCE client & free-form query into an Excel file (.xlsx)
using FAISS + ChatBedrock.

- Uses FINANCE indexes only: FAISS_INDEX_DIR / "finance"
- QUERIES is a list of questions you define.
- Scans FINANCE_INDEX_ROOT recursively for all client indexes,
  OR you can restrict to a single TARGET_CLIENT_ID.

Each FAISS index directory that contains index.faiss + index.pkl is treated as a client.
Example client_ids (relative paths under finance/):
  - "clientA/us"
  - "ABB - SWITZZERLNA/us"
  - "clientB/corporatefamily"

Writes Excel with columns:
    Client | Query | Content | Sources

Where:
  - Content  = LLM answer using the retrieved context
  - Sources  = newline-separated list of:
               "policy: <policy_id> ; pages: <page or range> ; source: <source_file path>"

Deps:
  pip install -U pandas openpyxl "langchain-aws>=0.2.5" "langchain-community" "boto3>=1.34"
"""

from __future__ import annotations

import os
from pathlib import Path
from typing import List, Dict, Any, Tuple

import pandas as pd
from boto3 import Session
from langchain_aws import BedrockEmbeddings, ChatBedrock
from langchain_community.vectorstores import FAISS
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser

# ===================== EDIT THESE =====================

FAISS_INDEX_DIR    = Path("/ABS/PATH/TO/faiss_indices").resolve()   # root used by indexer
FINANCE_INDEX_ROOT = FAISS_INDEX_DIR / "finance"                    # finance-only indexes

OUTPUT_XLSX        = Path("./finance_queries_llm.xlsx").resolve()

# Optional: run only for a single finance client id (relative under finance/)
# Example: "clientA/us" or "ABB - SWITZZERLNA/us"
TARGET_CLIENT_ID = ""   # set to "" to run for ALL finance clients

# 👉 Put ALL your queries here:
QUERIES: List[str] = [
    # EXAMPLES — replace with your real questions:
    "Is there a COLA clause?",
    "How does the COLA rule apply?",
    "What is the COLA source data to be used?",
    # add any other free-form queries you want:
    # "How are retirees treated under this plan?",
    # "What are the eligibility criteria for this benefit?",
]

# AWS (direct keys for dev; prefer IAM roles in prod)
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

# Models
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# Retrieval / generation
K_PER_CLIENT = 4
MAX_TOKENS   = 1200
TEMPERATURE  = 0.2

# ===================== Prompt (generic) =====================
PROMPT = ChatPromptTemplate.from_messages([
    ("system",
     "You are a precise, client-scoped contract assistant for FINANCE documents. "
     "Use ONLY the Provided Context, which comes from one client's policies/contracts. "
     "Answer the question as completely and specifically as possible based on that context. "
     "If the context is insufficient to answer something, say you don't know and what is missing. "
     "Do not hallucinate. Do not add citations or bracket labels."),
    ("human",
     "Client: {client_id}\n"
     "Question: {query}\n\n"
     "Provided Context:\n{context}\n\n"
     "Write the best possible answer now.")
])

# ===================== Helpers =====================
def list_finance_clients(root: Path) -> List[str]:
    """
    Recursively scan FINANCE_INDEX_ROOT for all client index directories.

    A directory is considered a client index if it contains:
      - index.faiss
      - index.pkl

    Returns client_ids as relative paths under finance/, e.g.:
      "clientA/us"
      "clientB/denmark"
      "clientC/corporatefamily"
    """
    if not root.exists():
        return []

    clients: List[str] = []

    for dirpath, dirnames, filenames in os.walk(root):
        filenames_set = set(filenames)
        if "index.faiss" in filenames_set and "index.pkl" in filenames_set:
            p = Path(dirpath)
            rel = p.relative_to(root)           # relative to finance root
            client_id = rel.as_posix()          # e.g. "clientA/us"
            clients.append(client_id)

    clients = sorted(set(clients))
    return clients


def load_vs_for_client(client_id: str, session: Session) -> FAISS:
    """
    Load FAISS for a given finance client_id (relative under FINANCE_INDEX_ROOT).

    Example:
      client_id = "clientA/us"
      path      = FINANCE_INDEX_ROOT / "clientA/us"
    """
    emb = BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=session.client("bedrock-runtime"),
    )
    index_dir = FINANCE_INDEX_ROOT / client_id
    return FAISS.load_local(str(index_dir), emb, allow_dangerous_deserialization=True)


def format_docs(docs) -> str:
    """
    Turn retrieved LangChain Documents into a text block for the LLM.
    (This was the working pattern in your previous script.)
    """
    return "\n\n".join(
        f"(client_id: {d.metadata.get('client_id')}, "
        f"category: {d.metadata.get('category')}, "
        f"policy: {d.metadata.get('policy_id')}, "
        f"page: {d.metadata.get('page', d.metadata.get('page_start', '?'))})\n"
        f"{d.page_content}"
        for d in docs
    )


def build_sources_summary(docs) -> str:
    """
    Build a human-readable summary of all sources used for this query.

    One line per source:
      policy: <policy_id> ; pages: X or X-Y ; source: <source_file path>
    """
    seen = set()
    lines = []

    for d in docs:
        m = d.metadata or {}
        policy_id = m.get("policy_id") or Path(m.get("source_file", "")).name or "UNKNOWN_POLICY"
        source_file = m.get("source_file", "")

        page = m.get("page")
        page_start = m.get("page_start")
        page_end = m.get("page_end")

        # derive page string
        if page is not None:
            page_str = str(page)
        elif page_start is not None and page_end is not None:
            page_str = f"{page_start}-{page_end}" if page_start != page_end else str(page_start)
        elif page_start is not None:
            page_str = str(page_start)
        else:
            page_str = "?"

        key = (policy_id, page_str, source_file)
        if key in seen:
            continue
        seen.add(key)

        line = f"policy: {policy_id} ; pages: {page_str} ; source: {source_file}"
        lines.append(line)

    return "\n".join(lines)


def answer_for_query(session: Session, client_id: str, query: str) -> Tuple[str, str]:
    """
    For a given finance client_id (e.g. 'clientA/us') and a free-form query,
    retrieve relevant chunks and generate:
      - content (LLM answer)
      - sources_summary (policy + pages + source_file)
    """
    # 1) Retrieve from finance FAISS index
    vs = load_vs_for_client(client_id, session)
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": K_PER_CLIENT})

    docs = retriever.get_relevant_documents(query)

    # Hard filter: keep only finance docs that match this client_id in metadata
    cid_norm = client_id.strip().lower()
    filtered_docs = []
    for d in docs:
        m = d.metadata or {}
        meta_cid = str(m.get("client_id", "")).strip().lower()
        meta_cat = str(m.get("category", "")).strip().lower()
        if meta_cid == cid_norm and meta_cat == "finance":
            filtered_docs.append(d)

    if not filtered_docs:
        msg = f"(No matching context found in finance index for client '{client_id}' and query '{query}'.)"
        return msg, ""

    context = format_docs(filtered_docs)
    sources_summary = build_sources_summary(filtered_docs)

    # 2) LLM: ChatBedrock (same style as before, just with Query instead of Clause)
    llm = ChatBedrock(
        client=session.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={
            "temperature": float(TEMPERATURE),
            "max_tokens": int(MAX_TOKENS),
        },
    )
    chain = PROMPT | llm | StrOutputParser()

    try:
        answer = chain.invoke({
            "client_id": client_id,
            "query": query,
            "context": context,
        })
        return answer, sources_summary
    except Exception as e:
        err = f"(LLM error for {client_id} / '{query}': {type(e).__name__}: {e})"
        return err, sources_summary

# ===================== Main =====================
def main():
    # Basic sanity: must have queries
    if not QUERIES:
        raise SystemExit("QUERIES list is empty. Please define at least one query string in QUERIES.")

    # Discover ONLY finance clients automatically
    all_clients = list_finance_clients(FINANCE_INDEX_ROOT)
    if not all_clients:
        raise SystemExit(f"No finance clients found under {FINANCE_INDEX_ROOT}")

    print(f"Found {len(all_clients)} finance client index(es):")
    for c in all_clients:
        print(f"  - {c}")

    # Optional: restrict to a single client id
    if TARGET_CLIENT_ID:
        clients = [c for c in all_clients if c == TARGET_CLIENT_ID]
        if not clients:
            raise SystemExit(
                f"\nTARGET_CLIENT_ID='{TARGET_CLIENT_ID}' not found.\n"
                f"Make sure there is a folder: {FINANCE_INDEX_ROOT / TARGET_CLIENT_ID} "
                f"with index.faiss and index.pkl."
            )
        print(f"\nRunning ONLY for client: {TARGET_CLIENT_ID}")
    else:
        clients = all_clients
        print("\nRunning for ALL finance clients.")

    # AWS session
    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    rows: List[Dict[str, Any]] = []
    for client_id in clients:
        print(f"\n=== Client: {client_id} ===")
        for query in QUERIES:
            print(f"  - Query: {query} ...", end="", flush=True)
            content, sources = answer_for_query(session, client_id, query)
            rows.append({
                "Client": client_id,
                "Query": query,
                "Content": content,
                "Sources": sources,
            })
            print(" done.")

    df = pd.DataFrame(rows, columns=["Client", "Query", "Content", "Sources"])
    OUTPUT_XLSX.parent.mkdir(parents=True, exist_ok=True)
    df.to_excel(OUTPUT_XLSX, index=False)
    print(f"\nSaved: {OUTPUT_XLSX}")

if __name__ == "__main__":
    main()
