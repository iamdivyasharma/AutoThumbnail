from typing import Optional

import requests
import streamlit as st

API_URL   = os.getenv("RAG_API_URL", "http://localhost:8000")  # FastAPI backend
LOGO_PATH = "abc.jpg"  # optional logo next to this file

st.set_page_config(page_title="Contract Assistant", page_icon="📄", layout="wide")

if os.path.exists(LOGO_PATH):
    st.markdown("<div style='text-align:center;'>", unsafe_allow_html=True)
    st.image(LOGO_PATH, width=160)
    st.markdown("</div>", unsafe_allow_html=True)

st.title("Contract Assistant — Multi-Client with Document Viewer")

if "answer" not in st.session_state:
    st.session_state.answer = ""
if "used_clients" not in st.session_state:
    st.session_state.used_clients = []
if "sources" not in st.session_state:
    st.session_state.sources = []
if "client_docs" not in st.session_state:
    st.session_state.client_docs = {}   # {client: [docs]}
if "selected_pdf_src" not in st.session_state:
    st.session_state.selected_pdf_src = None  # can be URL or absolute path
if "selected_label" not in st.session_state:
    st.session_state.selected_label = None


def _resolve_local(path_or_none: str) -> Optional[str]:
    if not path_or_none:
        return None
    p = Path(path_or_none)
    return str(p if p.is_absolute() else (Path.cwd() / p))

def _bytes_from_src(src: str, timeout: int = 25) -> bytes:
   
    if src.startswith("http://") or src.startswith("https://"):
        r = requests.get(src, timeout=timeout)
        r.raise_for_status()
        return r.content
    else:
        p = Path(src)
        if not p.exists():
            raise FileNotFoundError(f"PDF not found: {src}")
        return p.read_bytes()

def _embed_pdf_data_uri(pdf_bytes: bytes, height: int = 820):
   
    data_uri = "data:application/pdf;base64," + base64.b64encode(pdf_bytes).decode("utf-8")
    html = f"""
    <div style="height:{height}px;">
      <object data="{data_uri}" type="application/pdf" width="100%" height="{height}">
        <iframe src="{data_uri}" width="100%" height="{height}" style="border:none;"></iframe>
      </object>
    </div>
    """
    st.components.v1.html(html, height=height + 8, scrolling=True)

def _render_pdf_as_images(pdf_bytes: bytes, start_page: int = 1, end_page: Optional[int] = None, zoom: float = 1.5):
    
    try:
        import fitz  # PyMuPDF
    except Exception as e:
        st.warning("Inline PDF blocked and PyMuPDF not installed. Install with: pip install PyMuPDF")
        return
    try:
        doc = fitz.open(stream=pdf_bytes, filetype="pdf")
    except Exception as e:
        st.error(f"Could not open PDF bytes: {e}")
        return

    total = doc.page_count
    if end_page is None or end_page < 1 or end_page > total:
        end_page = total
    start = max(1, min(start_page, total))

    st.caption(f"Pages {start}-{end_page} of {total}")
    mat = fitz.Matrix(zoom, zoom)
    for page_num in range(start - 1, end_page):
        page = doc.load_page(page_num)
        pix = page.get_pixmap(matrix=mat)
        st.image(pix.tobytes("png"))
    doc.close()

def _render_pdf_inline(src: Optional[str], height: int = 820):
   
    if not src:
        st.info("Select a source or document on the left to preview here.")
        return
    try:
        pdf_bytes = _bytes_from_src(src)
        # Try inline embed first (works in most browsers)
        try:
            _embed_pdf_data_uri(pdf_bytes, height=height)
        except Exception:
            # If embedding errors, fall back to images
            _render_pdf_as_images(pdf_bytes)
    except Exception as e:
        st.error(f"Could not display PDF: {e}")
        # Last resort: let user open externally
        if src.startswith("http://") or src.startswith("https://"):
            st.markdown(f"[Open in new tab]({src})")

def _fetch_all_docs_for_client(client_id: str):
    try:
        resp = requests.get(f"{API_URL}/clients/{client_id}/documents", timeout=20)
        resp.raise_for_status()
        return resp.json()
    except Exception as e:
        st.warning(f"Could not fetch docs for {client_id}: {e}")
        return []


left, right = st.columns([0.55, 0.45], gap="large")

with left:
    question = st.text_input(
        "Ask a question (mention client name(s) in your text, e.g., 'EY', 'Bain', 'KPMG', 'Google'):"
    )

    if st.button("Ask"):
        if not question.strip():
            st.warning("Please enter a question.")
        else:
            with st.spinner("Thinking..."):
                try:
                    resp = requests.post(f"{API_URL}/ask", json={"question": question}, timeout=120)
                    if resp.status_code != 200:
                        st.error(resp.text)
                    else:
                        data = resp.json()
                        st.session_state.used_clients = [c.lower() for c in data.get("used_clients", [])]
                        st.session_state.sources = data.get("sources", [])
                        st.session_state.client_docs = {}
                        st.session_state.selected_pdf_src = None
                        st.session_state.selected_label = None
                        st.session_state.answer = data.get("answer", "")

                      
                        for c in st.session_state.used_clients:
                            st.session_state.client_docs[c] = _fetch_all_docs_for_client(c)

                       
                        st.rerun()
                except Exception as e:
                    st.error(f"Request failed: {e}")

   
    if st.session_state.answer:
        st.markdown("### Answer")
        st.markdown(st.session_state.answer)

    
    if st.session_state.used_clients:
        st.caption(f"Detected client(s): {', '.join(st.session_state.used_clients)}")

    
    if st.session_state.sources:
        st.markdown("### Sources (retrieved)")
        grouped = {}
        for i, s in enumerate(st.session_state.sources):
            client = (s.get("client_id") or "").lower()
            grouped.setdefault(client, []).append((i, s))
        for client, items in grouped.items():
            with st.expander(f"Client: {client}", expanded=True):
                for i, s in items:
                    # Prefer URL if your backend returns it; else use local path.
                    src = s.get("source_url") or _resolve_local(s.get("source_file", ""))
                    if not src:
                        continue
                    label = f"📄 {s.get('policy_id')} — page {s.get('page')}"
                    if st.button(label, key=f"srcbtn_{client}_{i}"):
                        st.session_state.selected_label = label
                        st.session_state.selected_pdf_src = src
                        st.rerun()

    
    if st.session_state.client_docs:
        st.markdown("### All documents (browse)")
        for client, docs in st.session_state.client_docs.items():
            with st.expander(f"Client: {client}", expanded=False):
                if not docs:
                    st.caption("No PDFs found.")
                for j, d in enumerate(docs):
                    src = d.get("source_url") or _resolve_local(d.get("source_file", ""))
                    if not src:
                        continue
                    pages = d.get("pages") or "?"
                    label = f"📄 {d.get('policy_id')} ({pages} pages)"
                    if st.button(label, key=f"alldoc_{client}_{j}"):
                        st.session_state.selected_label = label
                        st.session_state.selected_pdf_src = src
                        st.rerun()

with right:
    st.markdown("### Document Viewer")
    if st.session_state.selected_pdf_src:
        st.caption(f"Showing: {st.session_state.selected_label or Path(str(st.session_state.selected_pdf_src)).name}")
    _render_pdf_inline(st.session_state.selected_pdf_src, height=820)
