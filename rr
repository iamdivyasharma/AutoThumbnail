# app.py
# Streamlit Chatbot UI (single scrollable chat area; no big empty box)
# Run: streamlit run app.py

import json
from pathlib import Path
from typing import List, Dict, Any
import requests
import streamlit as st

# ----------------------------
# Users
# ----------------------------
USERS = [
    {"name": "Alice Singh",  "email": "alice@example.com"},
    {"name": "Bob Kumar",    "email": "bob@example.com"},
    {"name": "Charlie Rao",  "email": "charlie@example.com"},
]
NAME_TO_EMAIL = {u["name"]: u["email"] for u in USERS}

# ----------------------------
# Fixed API endpoint (no env vars)
# ----------------------------
API_URL = "http://localhost:8000/ask"

# ----------------------------
# Per-user memory (JSON files)
# ----------------------------
MEM_DIR = Path("memory")
MEM_DIR.mkdir(parents=True, exist_ok=True)

def _safe_key(email: str) -> str:
    return email.replace("@", "_at_").replace(".", "_dot_")

def memory_path(email: str) -> Path:
    return MEM_DIR / f"{_safe_key(email)}.json"

def load_memory(email: str) -> List[Dict[str, str]]:
    p = memory_path(email)
    if p.exists():
        try:
            return json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            return []
    return []

def save_memory(email: str, messages: List[Dict[str, str]]) -> None:
    memory_path(email).write_text(json.dumps(messages, ensure_ascii=False, indent=2), encoding="utf-8")

def clear_memory(email: str) -> None:
    mp = memory_path(email)
    if mp.exists():
        mp.unlink(missing_ok=True)

# ----------------------------
# Backend call (HTTP only)
# ----------------------------
def query_backend(payload: Dict[str, Any]) -> str:
    try:
        r = requests.post(API_URL, json=payload, timeout=60)
        r.raise_for_status()
        data = r.json()
        return str(data.get("answer", data))
    except Exception as e:
        return f"⚠️ Backend error: {e}"

# ----------------------------
# Page config + CSS
# ----------------------------
st.set_page_config(page_title="User-Scoped Chatbot", page_icon="💬", layout="centered")
st.markdown(
    """
    <style>
      .logo-wrap { display:flex; justify-content:center; align-items:center; margin: 0.25rem 0 0.75rem 0; }
      .chat-wrap { max-width: 820px; margin: 0 auto; }
      /* Use max-height so the box grows only as needed; no big empty box when there are no messages */
      .history-box { max-height: 60vh; overflow-y: auto; padding: 0.25rem 0.5rem; border-radius: 0.5rem; border: 1px solid #e6e6e6; background: #fafafa; }
      .pill { display:inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; background:#f0f0f0; font-size: 0.8rem; margin-left: 0.5rem; }
    </style>
    """,
    unsafe_allow_html=True
)

# ----------------------------
# Session state
# ----------------------------
if "selected_name" not in st.session_state:
    st.session_state.selected_name = USERS[0]["name"]
if "user_name" not in st.session_state:
    st.session_state.user_name = st.session_state.selected_name
if "user_email" not in st.session_state:
    st.session_state.user_email = NAME_TO_EMAIL[st.session_state.user_name]
if "messages_by_user" not in st.session_state:
    st.session_state.messages_by_user = {}

def ensure_loaded(email: str):
    if email not in st.session_state.messages_by_user:
        st.session_state.messages_by_user[email] = load_memory(email)

# ----------------------------
# Sidebar
# ----------------------------
with st.sidebar:
    st.header("⚙️ Settings")
    st.session_state.selected_name = st.selectbox(
        "Select Username",
        options=[u["name"] for u in USERS],
        index=[u["name"] for u in USERS].index(st.session_state.selected_name),
    )
    st.session_state.user_name = st.session_state.selected_name
    st.session_state.user_email = NAME_TO_EMAIL[st.session_state.user_name]
    ensure_loaded(st.session_state.user_email)

    if st.button("🧹 Delete Memory for Selected User"):
        clear_memory(st.session_state.user_email)
        st.session_state.messages_by_user[st.session_state.user_email] = []
        st.success("Memory deleted for this user.")

    st.caption("Per-user conversation history is saved in ./memory")

# ----------------------------
# Centered logo via Path("logo.jpg")
# ----------------------------
logopath = Path("logo.jpg")
st.markdown('<div class="logo-wrap">', unsafe_allow_html=True)
if logopath.exists():
    st.image(str(logopath), width=120)
else:
    st.caption("Place a file named 'logo.jpg' next to app.py to show a centered logo.")
st.markdown('</div>', unsafe_allow_html=True)

# Header
user_badge = f"{st.session_state.user_name} <span class='pill'>{st.session_state.user_email}</span>"
st.markdown(f"<div class='chat-wrap'><h2>💬 Chat with <code>{user_badge}</code></h2></div>", unsafe_allow_html=True)

# ----------------------------
# SINGLE scrollable chat area
# - Only render the box if there are messages (prevents a big empty box)
# ----------------------------
history = st.session_state.messages_by_user.get(st.session_state.user_email, [])
st.markdown("<div class='chat-wrap'>", unsafe_allow_html=True)

if history:
    st.markdown("<div class='history-box'>", unsafe_allow_html=True)
    for msg in history:
        with st.chat_message(msg["role"]):
            st.markdown(msg["content"])
    st.markdown("</div>", unsafe_allow_html=True)
else:
    # Tiny, unobtrusive hint instead of a big empty container
    st.caption("Start a conversation below.")

st.markdown("</div>", unsafe_allow_html=True)

# ----------------------------
# Chat input
# ----------------------------
placeholder = f"Ask {st.session_state.user_name} a question…"
query_text = st.chat_input(placeholder=placeholder)

if query_text:
    # append user message
    history.append({"role": "user", "content": query_text})
    st.session_state.messages_by_user[st.session_state.user_email] = history
    save_memory(st.session_state.user_email, history)

    # STRICT MINIMAL PAYLOAD
    payload = {
        "query": query_text,
        "user_name": (st.session_state.user_name or "").strip(),
        "user_email": (st.session_state.user_email or "").strip(),
    }

    with st.spinner("Thinking…"):
        answer = query_backend(payload)

    # append assistant message
    history.append({"role": "assistant", "content": answer})
    st.session_state.messages_by_user[st.session_state.user_email] = history
    save_memory(st.session_state.user_email, history)

    st.rerun()

# Footer note
st.markdown(
    "<div class='chat-wrap'><hr/><small>"
    "Payload sent to backend is exactly: <code>{'query', 'user_name', 'user_email'}</code>."
    "</small></div>",
    unsafe_allow_html=True,
)
