# ===================== PROMPT TEMPLATE (system + human, per GROUP) =====================

def build_json_schema_example(field_names_subset: List[str]) -> str:
    """
    Build a JSON-like skeleton string with the subset of field names
    to embed in the system prompt.
    """
    lines = ["{"]
    for i, field in enumerate(field_names_subset):
        field_type = FIELD_DEFS[field].get("type", "free_text")
        comma = "," if i < len(field_names_subset) - 1 else ""
        lines.append(f'  "{field}": "<{field_type}>"{comma}')
    lines.append("}")
    return "\n".join(lines)


PROMPT_MULTI = ChatPromptTemplate.from_messages([
    (
        "system",
        """
Instructions:
1. You are a precise, client-scoped contract assistant for FINANCE documents.
2. Use ONLY the Provided Context, which comes from a single client’s policies/contracts.
3. Answer only about the given client and the given policy (file).
4. If the context is insufficient to answer something, explicitly say you don’t know and what is missing.
5. Do NOT hallucinate, infer, or invent terms that are not clearly stated in the contract.
6. Do NOT add citations, references, or bracket labels in any of the field values.
7. Follow the output JSON schema exactly: use the exact field names expected by the calling system.
8. You MUST output a single JSON object ONLY. Do NOT output any additional text, headings, explanations, or semicolon strings.
9. Do NOT wrap the JSON in backticks or any other markup.
10. All output must be valid UTF-8 and valid JSON.

You MUST output a single JSON object with EXACTLY {num_fields} keys.
The keys must be exactly these (order matters):

{json_schema_example}
"""
    ),
    (
        "human",
        """
Client: {client_id}
Policy (file): {policy_id}

Questions / aspects to consider when filling these {num_fields} JSON fields:
{questions_block}

Provided Context (from this client's file only):
{context}

Now produce exactly ONE JSON object with these {num_fields} fields as specified in the system instructions.
"""
    ),
])

# ===================== Helpers =====================

import re  # already imported, but safe

def extract_json_block(text: str) -> str:
    """
    Extract the JSON object from an LLM response.

    Handles cases like:
      ```json
      { ... }
      ```
    or stray headings around the JSON.

    Returns the JSON string (e.g. '{ "field": "value", ... }')

    Raises ValueError if nothing that looks like JSON is found.
    """
    if not text:
        raise ValueError("Empty LLM output")

    # Prefer fenced ```json ... ```
    m = re.search(r"```json\s*(\{.*?\})\s*```", text, re.DOTALL | re.IGNORECASE)
    if m:
        return m.group(1).strip()

    # Fallback: first { ... } block
    m = re.search(r"(\{.*\})", text, re.DOTALL)
    if m:
        return m.group(1).strip()

    raise ValueError("No JSON block found in LLM output")


def list_finance_clients(root: Path) -> List[str]:
    if not root.exists():
        return []
    clients: List[str] = []
    for dirpath, dirnames, filenames in os.walk(root):
        filenames_set = set(filenames)
        if "index.faiss" in filenames_set and "index.pkl" in filenames_set:
            p = Path(dirpath)
            rel = p.relative_to(root)
            client_id = rel.as_posix()
            clients.append(client_id)
    return sorted(set(clients))


def load_vs_for_client(client_id: str, session: Session) -> FAISS:
    emb = BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=session.client("bedrock-runtime"),
    )
    index_dir = FINANCE_INDEX_ROOT / client_id
    return FAISS.load_local(str(index_dir), emb, allow_dangerous_deserialization=True)


def format_docs_for_llm(docs) -> str:
    chunks = []
    for d in docs:
        m = d.metadata or {}
        chunk = (
            f"(client_id: {m.get('client_id')}, "
            f"category: {m.get('category')}, "
            f"policy: {m.get('policy_id')}, "
            f"page: {m.get('page', m.get('page_start', '?'))})\n"
            f"{d.page_content}"
        )
        chunks.append(chunk)
    return "\n\n".join(chunks)


def shorten_source_path(source_file: str, client_id: str) -> str:
    if not source_file:
        return ""
    s = str(source_file)
    idx = s.find(client_id)
    if idx != -1:
        return s[idx:]
    return Path(s).name


def build_sources_summary(docs, client_id: str, max_lines: int = MAX_SOURCE_LINES) -> str:
    seen = set()
    lines: List[str] = []
    for d in docs:
        m = d.metadata or {}
        policy_id = m.get("policy_id") or Path(m.get("source_file", "")).name or "UNKNOWN_POLICY"
        raw_source_file = m.get("source_file", "")
        short_path = shorten_source_path(raw_source_file, client_id)

        page = m.get("page")
        page_start = m.get("page_start")
        page_end = m.get("page_end")

        if page is not None:
            page_str = str(page)
        elif page_start is not None and page_end is not None:
            page_str = f"{page_start}-{page_end}" if page_start != page_end else str(page_start)
        elif page_start is not None:
            page_str = str(page_start)
        else:
            page_str = "?"

        key = (policy_id, page_str, short_path)
        if key in seen:
            continue
        seen.add(key)

        lines.append(f"Document: {policy_id} ; Page no.: {page_str} ")

        if len(lines) >= max_lines:
            break
    return "\n".join(lines)


def sanitize_filename(s: str) -> str:
    s = s.replace("/", "_")
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", s)


def load_manifest_for_client(client_id: str) -> List[Dict[str, Any]]:
    """
    Expects a manifest.json per client with structure like:

    {
      "docs": [
        {
          "policy_id": "Contract_A",
          "source_file": "/path/to/Contract_A.pdf",
          "k": 8,
          "max_tokens": 3000,
          "temperature": 0.1
        },
        ...
      ]
    }
    """
    manifest_path = FINANCE_INDEX_ROOT / client_id / "manifest.json"
    if not manifest_path.exists():
        print(f"[WARN] No manifest.json for client '{client_id}' at {manifest_path}")
        return []

    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[WARN] Failed to read manifest for '{client_id}': {e}")
        return []

    docs = data.get("docs", [])
    if not isinstance(docs, list):
        print(f"[WARN] manifest.json for '{client_id}' has no 'docs' list")
        return []
    return docs


def get_hparams_for_policy(doc_info: Dict[str, Any]) -> Dict[str, Any]:
    """
    Returns hyperparameters for a given file (policy), with fallbacks to globals.

    manifest.json can optionally specify:
      - "k": int
      - "max_tokens": int
      - "temperature": float
    """
    k = int(doc_info.get("k", K_PER_CLIENT))
    max_tokens = int(doc_info.get("max_tokens", MAX_TOKENS))
    temperature = float(doc_info.get("temperature", TEMPERATURE))

    return {
        "k": k,
        "max_tokens": max_tokens,
        "temperature": temperature,
    }

# ===================== LLM per FILE-GROUP (2 calls per file) =====================

def answer_fields_for_file_group(
    session: Session,
    client_id: str,
    policy_id: str,
    field_names_subset: List[str],
    group_label: str,
    k: int,
    max_tokens: int,
    temperature: float,
) -> Tuple[Dict[str, str], str]:
    """
    For a given client_id + policy_id and subset of field names:

      1) Retrieve context separately for each field's retrieval query.
      2) Union all retrieved chunks as a single context for the LLM.
      3) Make ONE Claude call that fills only these fields.
      4) Return:
           - values_by_field_subset: { field_name -> value string }
           - sources_summary: newline-separated sources summary
    """
    values_by_field_subset: Dict[str, str] = {}

    if not field_names_subset:
        return values_by_field_subset, ""

    print(f"[INFO] Building context for client='{client_id}', policy='{policy_id}', group='{group_label}'")
    vs = load_vs_for_client(client_id, session)
    retriever = vs.as_retriever(
        search_type="similarity",
        search_kwargs={"k": k},
    )

    cid_norm = client_id.strip().lower()
    pol_norm = policy_id.strip().lower()

    all_docs = []

    # ---- RAG: each field's retrieval query ----
    for field_name in field_names_subset:
        q = FIELD_DEFS[field_name]["query"]
        print(f"[DEBUG] Retrieval query for this file/group: field='{field_name}', query='{q}'")
        docs = retriever.get_relevant_documents(q)
        print(f"[DEBUG] Retrieved {len(docs)} docs for client='{client_id}', policy='{policy_id}', field='{field_name}'")

        filtered = []
        for d in docs:
            m = d.metadata or {}
            meta_cid = str(m.get("client_id", "")).strip().lower()
            meta_cat = str(m.get("category", "")).strip().lower()
            meta_pol = str(m.get("policy_id", "")).strip().lower()
            print(
                f"[DEBUG] doc meta: client_id='{meta_cid}', "
                f"category='{meta_cat}', policy='{meta_pol}'"
            )

            # Strict: same client, finance category, same file (policy)
            if meta_cid == cid_norm and meta_cat == "finance" and meta_pol == pol_norm:
                filtered.append(d)

        if not filtered:
            print(
                f"[WARN] No docs passed metadata filter for client='{client_id}', "
                f"policy='{policy_id}', field='{field_name}'. Using all {len(docs)} retrieved docs."
            )
            filtered = docs

        all_docs.extend(filtered)

    # Deduplicate docs in context
    seen = set()
    unique_docs = []
    for d in all_docs:
        m = d.metadata or {}
        key = (
            m.get("policy_id"),
            m.get("page"),
            m.get("page_start"),
            m.get("page_end"),
            m.get("source_file"),
        )
        if key in seen:
            continue
        seen.add(key)
        unique_docs.append(d)

    if not unique_docs:
        print(f"[WARN] No usable context docs for client='{client_id}', policy='{policy_id}', group='{group_label}'.")
        sources_summary = ""
        return values_by_field_subset, sources_summary

    context_text = format_docs_for_llm(unique_docs)

    num_fields = len(field_names_subset)
    questions_block = "\n".join(
        f"- {FIELD_DEFS[field]['query']}" for field in field_names_subset
    )
    json_schema_example = build_json_schema_example(field_names_subset)

    llm = ChatBedrock(
        client=session.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={
            "temperature": float(temperature),
            "max_tokens": int(max_tokens),
        },
    )

    chain = PROMPT_MULTI | llm | StrOutputParser()

    try:
        llm_output = chain.invoke({
            "client_id": client_id,
            "policy_id": policy_id,
            "questions_block": questions_block,
            "context": context_text,
            "num_fields": num_fields,
            "json_schema_example": json_schema_example,
        })
    except Exception as e:
        print(f"[WARN] LLM error for client='{client_id}', policy='{policy_id}', group='{group_label}': {type(e).__name__}: {e}")
        llm_output = ""

    # ---- Optional: save raw LLM output for this file + group ----
    if SAVE_LLM_RAW:
        debug_dir = OUTPUT_DIR / "llm_raw"
        debug_dir.mkdir(parents=True, exist_ok=True)
        debug_file = debug_dir / (
            f"{sanitize_filename(client_id)}__{sanitize_filename(policy_id)}__{group_label}.txt"
        )
        try:
            debug_file.write_text(llm_output or "", encoding="utf-8")
            print(f"[DEBUG] Saved raw LLM output to {debug_file}")
        except Exception as e:
            print(f"[WARN] Could not save raw LLM output: {e}")

    # ---- JSON extraction (JSON-only output expected) ----
    llm_output = (llm_output or "").strip()

    try:
        json_str = extract_json_block(llm_output)
    except ValueError:
        # If no special markers, assume the whole output is the JSON
        json_str = llm_output
        print(f"[INFO] Using full LLM output as JSON for client='{client_id}', policy='{policy_id}', group='{group_label}'")

    try:
        parsed = json.loads(json_str)
    except Exception as e:
        print(f"[WARN] Failed to parse JSON for client='{client_id}', policy='{policy_id}', group='{group_label}': {e}")
        print(f"[DEBUG] JSON candidate was:\n{json_str}")
        parsed = {}

    if isinstance(parsed, dict):
        expected = set(field_names_subset)
        actual   = set(parsed.keys())
        missing  = expected - actual
        extra    = actual - expected
        if missing:
            print(f"[WARN] Missing keys in LLM JSON for {client_id}/{policy_id} group='{group_label}': {missing}")
        if extra:
            print(f"[WARN] Unexpected keys in LLM JSON for {client_id}/{policy_id} group='{group_label}': {extra}")
    else:
        print(f"[WARN] Parsed JSON is not an object for {client_id}/{policy_id}, group='{group_label}', type={type(parsed)}")
        parsed = {}

    # Convert values to strings for Excel (serialize dict/list as JSON string)
    for field in field_names_subset:
        value = parsed.get(field, "")
        if value is None:
            values_by_field_subset[field] = ""
        elif isinstance(value, (dict, list)):
            values_by_field_subset[field] = json.dumps(value, ensure_ascii=False)
        else:
            values_by_field_subset[field] = str(value)

    sources_summary = build_sources_summary(unique_docs, client_id=client_id, max_lines=MAX_SOURCE_LINES)
    return values_by_field_subset, sources_summary

# ===================== Main =====================

def main():
    if not FIELD_NAMES:
        raise SystemExit("FIELD_DEFS is empty. Please define your JSON fields in FIELD_DEFS.")

    # Split fields into two groups for 2 LLM calls per file
    n_fields = len(FIELD_NAMES)
    mid = n_fields // 2
    GROUP_1_FIELDS = FIELD_NAMES[:mid]
    GROUP_2_FIELDS = FIELD_NAMES[mid:]

    print(f"Total fields: {n_fields}")
    print(f"Group 1 fields ({len(GROUP_1_FIELDS)}): {GROUP_1_FIELDS}")
    print(f"Group 2 fields ({len(GROUP_2_FIELDS)}): {GROUP_2_FIELDS}")

    all_clients = list_finance_clients(FINANCE_INDEX_ROOT)
    if not all_clients:
        raise SystemExit(f"No finance clients found under {FINANCE_INDEX_ROOT}")

    print("Finance clients found:")
    for c in all_clients:
        print("  -", c)

    if TARGET_CLIENT_ID:
        clients = [c for c in all_clients if c == TARGET_CLIENT_ID]
        if not clients:
            raise SystemExit(
                f"\nTARGET_CLIENT_ID='{TARGET_CLIENT_ID}' not found.\n"
                f"Make sure there is a folder: {FINANCE_INDEX_ROOT / TARGET_CLIENT_ID} "
                f"with index.faiss and index.pkl."
            )
        print(f"\nRunning ONLY for client: {TARGET_CLIENT_ID}")
    else:
        clients = all_clients
        print("\nRunning for ALL finance clients.")

    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    for client_id in clients:
        print(f"\n=== Client: {client_id} ===")

        safe_name = sanitize_filename(client_id)
        out_path = OUTPUT_DIR / f"finance_queries_{safe_name}.xlsx"

        # Optional: skip if already created
        if out_path.exists():
            print(f"  -> Skipping {client_id}: {out_path} already exists.")
            continue

        manifest_docs = load_manifest_for_client(client_id)
        if not manifest_docs:
            print(f"[WARN] No manifest docs for client '{client_id}', skipping.")
            continue

        rows: List[Dict[str, Any]] = []

        for doc_info in manifest_docs:
            policy_id = doc_info.get("policy_id") or Path(doc_info.get("source_file", "")).name
            source_file = doc_info.get("source_file", "")

            print(f"  -> File (policy): {policy_id}")

            # Per-file hyperparameters (fallback to global defaults)
            hparams = get_hparams_for_policy(doc_info)
            k           = hparams["k"]
            max_tokens  = hparams["max_tokens"]
            temperature = hparams["temperature"]
            print(f"     Using hparams: k={k}, max_tokens={max_tokens}, temperature={temperature}")

            # ---- LLM Call 1: Group 1 fields ----
            vals_1, sources_1 = answer_fields_for_file_group(
                session=session,
                client_id=client_id,
                policy_id=policy_id,
                field_names_subset=GROUP_1_FIELDS,
                group_label="group1",
                k=k,
                max_tokens=max_tokens,
                temperature=temperature,
            )

            # ---- LLM Call 2: Group 2 fields ----
            vals_2, sources_2 = answer_fields_for_file_group(
                session=session,
                client_id=client_id,
                policy_id=policy_id,
                field_names_subset=GROUP_2_FIELDS,
                group_label="group2",
                k=k,
                max_tokens=max_tokens,
                temperature=temperature,
            )

            # Merge values from both groups
            values_all: Dict[str, str] = {}
            for field in FIELD_NAMES:
                if field in vals_1:
                    values_all[field] = vals_1[field]
                elif field in vals_2:
                    values_all[field] = vals_2[field]
                else:
                    values_all[field] = ""

            # Merge sources summaries
            sources_summary_parts = []
            if sources_1:
                sources_summary_parts.append("[Group 1]\n" + sources_1)
            if sources_2:
                sources_summary_parts.append("[Group 2]\n" + sources_2)
            sources_summary = "\n\n".join(sources_summary_parts)

            row: Dict[str, Any] = {
                "Client": client_id,
                "Policy": policy_id,
                "Source File": source_file,
                "Sources": sources_summary,
            }

            for field in FIELD_NAMES:
                row[field] = values_all.get(field, "")

            rows.append(row)

        if not rows:
            print(f"[WARN] No rows generated for client '{client_id}'.")
            continue

        df = pd.DataFrame(rows)
        df.to_excel(out_path, index=False)
        print(f"  -> Saved: {out_path}")

    print("\nAll client exports completed.")


if __name__ == "__main__":
    main()
