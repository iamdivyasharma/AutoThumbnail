#!/usr/bin/env python3
# FastAPI backend (S3-aware):
# - Free-text client detection (with aliases) + strict per-client retrieval
# - Loads FAISS per client from local disk
# - Yellow highlights via PyMuPDF exact search, supporting local paths **and** s3:// URIs
# - Lists documents from per-client manifest.json (no local filesystem fallback)

