from __future__ import annotations

import json
from typing import Any, Dict, List, Optional

from langchain_aws import ChatBedrockConverse
from langchain_core.output_parsers import StrOutputParser
from langchain_core.prompts import ChatPromptTemplate


def build_llm(model_id: str, client) -> ChatBedrockConverse:
    # Temperature 0 makes this deterministic as possible
    return ChatBedrockConverse(
        model_id=model_id,
        client=client,
        temperature=0.0,
        max_tokens=600,
    )


_PARSER_PROMPT = ChatPromptTemplate.from_messages([
    (
        "system",
        "You convert a user's natural language question into a small JSON object. "
        "Return ONLY valid JSON. No explanation.\n\n"
        "Rules:\n"
        "- Use only the provided schema fields when choosing 'fields'.\n"
        "- If the user asks for ALL metadata, set fields=['*'].\n"
        "- Normalize country to standard 2-letter or full uppercase if given (e.g. US, UK, INDIA, DENMARK, JAPAN).\n"
        "- If the user asks for 'CAPID' or 'cap id', map to field 'cap_id' if present in schema, else 'cid' if present.\n"
        "- If client name is abbreviated (e.g., 'APMM'), keep it in client_name_raw and also propose best normalized in client_name_hint." 
    ),
    (
        "human",
        "Schema fields: {schema_fields}\n"
        "Known countries (examples): {countries}\n"
        "Known client name samples: {client_samples}\n\n"
        "User query: {query}\n\n"
        "Return JSON with keys:\n"
        "- intent: 'lookup'\n"
        "- client_name_raw: string or null\n"
        "- client_name_hint: string or null\n"
        "- country: string or null\n"
        "- fields: list of strings (schema field names) or ['*']\n"
        "- identifiers: object with optional keys 'cid', 'cap_id' if the query contains them\n"
    ),
])


def parse_query_with_llm(
    query: str,
    schema_fields: List[str],
    countries: List[str],
    client_samples: List[str],
    llm: ChatBedrockConverse,
) -> Dict[str, Any]:
    chain = _PARSER_PROMPT | llm | StrOutputParser()

    schema_str = ", ".join(schema_fields[:200])
    country_str = ", ".join(countries[:50])
    sample_str = ", ".join(client_samples[:30])

    text = chain.invoke({
        "query": query,
        "schema_fields": schema_str,
        "countries": country_str,
        "client_samples": sample_str,
    })

    # Hard-parse JSON only
    try:
        obj = json.loads(text)
        if not isinstance(obj, dict):
            return {}
        return obj
    except Exception:
        return {}

