#!/usr/bin/env python3
# index_clients.py — OCR page-wise, chunk PDF-wise (local PDFs + AWS Textract sync, no S3)

from __future__ import annotations

import os
import re
import json
import time
import random
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Tuple, Iterable

import fitz  # PyMuPDF
import boto3
from botocore.config import Config
from botocore.exceptions import ClientError

from langchain_aws import BedrockEmbeddings
from langchain_community.vectorstores import FAISS
from langchain.schema import Document

# ========= EDIT THESE ABSOLUTE PATHS =========
PDF_ROOT         = Path("/ABS/PATH/TO/pdfs").resolve()           # e.g., "/home/ubuntu/pdfs"
FAISS_INDEX_DIR  = Path("/ABS/PATH/TO/faiss_indices").resolve()  # e.g., "/home/ubuntu/faiss_indices"

# ========= AWS / Bedrock / Textract =========
REGION      = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

AWS_ACCESS_KEY_ID     = os.getenv("AWS_ACCESS_KEY_ID", "YOUR_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.getenv("AWS_SECRET_ACCESS_KEY", "YOUR_SECRET_ACCESS_KEY")

SESSION  = boto3.Session(
    region_name=REGION,
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
)
RUNTIME  = SESSION.client("bedrock-runtime", config=Config(retries={"max_attempts": 8, "mode": "adaptive"}))
TEXTRACT = SESSION.client("textract",         config=Config(retries={"max_attempts": 8, "mode": "standard"}))
EMB      = BedrockEmbeddings(model_id=EMBED_MODEL, client=RUNTIME)

# ========= Chunking / OCR settings =========
CHUNK_SIZE        = 1200
CHUNK_OVERLAP     = 150
TEXT_MIN_LEN      = 120      # native text length threshold
MIN_NATIVE_WORDS  = 10       # native word count threshold
OCR_DPI_CANDIDATES = [300, 240, 200, 150]  # adaptive
MAX_TEXTRACT_BYTES = 9_500_000
USE_TEXTRACT_OCR  = True

# ========= Helpers =========

def client_from_filename(name: str) -> str:
    """Head before first '__' or '_' or '-' (spaces preserved)."""
    stem = Path(name).stem
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()

def clean_text(t: str) -> str:
    return re.sub(r"[ \t]+\n", "\n", (t or "")).strip()

def chunk_text(text: str, chunk_size: int = CHUNK_SIZE, overlap: int = CHUNK_OVERLAP) -> List[Tuple[int, int, str]]:
    """Return list of (start_idx, end_idx, chunk_text); skip empty."""
    text = (text or "").strip()
    if not text:
        return []
    n = len(text)
    if n <= chunk_size:
        return [(0, n, text)]
    chunks = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        chunk = text[start:end]
        if chunk.strip():
            chunks.append((start, end, chunk))
        if end == n:
            break
        start = max(0, end - overlap)
    return chunks

def textract_words_to_pdf_points(words: List[dict], page_rect: fitz.Rect) -> List[dict]:
    """Convert Textract WORD Geometry (normalized 0..1) to PDF points."""
    pdf_w = float(page_rect.width)
    pdf_h = float(page_rect.height)
    x0 = float(page_rect.x0)
    y0 = float(page_rect.y0)
    out = []
    for w in words:
        bb = w.get("Geometry", {}).get("BoundingBox") or {}
        left   = float(bb.get("Left", 0.0))
        top    = float(bb.get("Top", 0.0))
        width  = float(bb.get("Width", 0.0))
        height = float(bb.get("Height", 0.0))
        out.append({
            "text": w.get("Text", ""),
            "x": x0 + left * pdf_w,
            "y": y0 + top  * pdf_h,
            "width":  width * pdf_w,
            "height": height * pdf_h,
        })
    return out

def textract_detect_document_text(img_bytes: bytes, max_attempts: int = 6, base_delay: float = 0.6) -> dict:
    """DetectDocumentText with exponential backoff."""
    attempt = 0
    while True:
        attempt += 1
        try:
            return TEXTRACT.detect_document_text(Document={"Bytes": img_bytes})
        except ClientError as e:
            code = e.response.get("Error", {}).get("Code", "")
            http = e.response.get("ResponseMetadata", {}).get("HTTPStatusCode")
            throttled = code in ("ThrottlingException", "ProvisionedThroughputExceededException") or http in (429, 503)
            if throttled and attempt < max_attempts:
                delay = min(8.0, base_delay * (2 ** (attempt - 1))) + random.uniform(0, 0.2)
                time.sleep(delay)
                continue
            raise

def ocr_page_with_textract_adaptive(page: fitz.Page) -> tuple[str, List[dict], int] | tuple[str, List[dict], None]:
    """Try multiple DPIs until PNG small enough + Textract succeeds."""
    for dpi in OCR_DPI_CANDIDATES:
        try:
            mat = fitz.Matrix(dpi / 72.0, dpi / 72.0)
            pix = page.get_pixmap(matrix=mat, alpha=False)
            img_bytes = pix.tobytes("png")
            if len(img_bytes) > MAX_TEXTRACT_BYTES:
                continue  # try lower DPI
            resp = textract_detect_document_text(img_bytes)
            lines, words = [], []
            for b in resp.get("Blocks", []):
                bt = b.get("BlockType")
                if bt == "LINE":
                    txt = (b.get("Text") or "").strip()
                    if txt: lines.append(txt)
                elif bt == "WORD":
                    if (b.get("Text") or "").strip(): words.append(b)
            page_text = "\n".join(lines).strip()
            pdf_words = textract_words_to_pdf_points(words, page.rect)
            return page_text, pdf_words, dpi
        except Exception:
            continue
    return "", [], None

def page_has_machine_text(page: fitz.Page) -> bool:
    """Heuristic: true text if enough words or text blocks exist."""
    try:
        if len(page.get_text("words") or []) >= MIN_NATIVE_WORDS:
            return True
    except Exception:
        pass
    try:
        rd = page.get_text("rawdict") or {}
        if any(b.get("type") == 0 for b in rd.get("blocks", [])):  # 0 = text block
            return True
    except Exception:
        pass
    return False

@dataclass
class DocInfo:
    policy_id: str
    source_file: str
    pages: int
    modified_time: int

def scan_pdfs(root: Path) -> Dict[str, List[Path]]:
    out: Dict[str, List[Path]] = {}
    for p in root.rglob("*"):
        if not p.is_file():
            continue
        if p.suffix.lower() != ".pdf":
            continue
        if any(part.startswith(".") for part in p.parts):
            continue
        if ".ipynb_checkpoints" in p.as_posix():
            continue
        cid = client_from_filename(p.name)
        out.setdefault(cid, []).append(p)
    for k in out:
        out[k] = sorted(out[k], key=lambda x: x.name.lower())
    return out

def build_manifest_entry(pdf_path: Path) -> DocInfo:
    try:
        with fitz.open(str(pdf_path)) as doc:
            pages = doc.page_count
    except Exception:
        pages = 0
    stat = pdf_path.stat()
    return DocInfo(
        policy_id=pdf_path.name,
        source_file=str(pdf_path.resolve()),
        pages=pages,
        modified_time=int(stat.st_mtime),
    )

def extract_pdf_pages(pdf_path: Path) -> tuple[List[str], Dict[int, List[dict]]]:
    """
    Return (page_texts, ocr_words_by_page).
      - page_texts[p-1] = final text for page p (native or OCR)
      - ocr_words_by_page[p] = list of word boxes for page p (empty if native used)
    """
    page_texts: List[str] = []
    ocr_words_by_page: Dict[int, List[dict]] = {}
    with fitz.open(str(pdf_path)) as doc:
        for pnum in range(doc.page_count):
            page = doc.load_page(pnum)
            native_text = clean_text(page.get_text("text") or "")
            use_native = page_has_machine_text(page) and len(native_text) >= TEXT_MIN_LEN
            if use_native or not USE_TEXTRACT_OCR:
                txt = native_text
                words = []
            else:
                ocr_text, o_words, used_dpi = ocr_page_with_textract_adaptive(page)
                ocr_text = clean_text(ocr_text)
                if len(ocr_text) > len(native_text):
                    txt = ocr_text
                    words = o_words
                else:
                    txt = native_text
                    words = []
            page_texts.append(txt)
            if words:
                ocr_words_by_page[pnum + 1] = words  # 1-based
    return page_texts, ocr_words_by_page

def build_pdfwise_chunks(page_texts: List[str], sep: str = "\n\n—— Page Break ——\n\n") -> tuple[str, List[Tuple[int,int,int]]]:
    """
    Concatenate all page texts into one doc string with separators.
    Returns:
      combined_text,
      page_spans = [(page_num, start_idx, end_idx), ...]  # char ranges per page in combined_text
    """
    parts = []
    spans: List[Tuple[int,int,int]] = []
    cursor = 0
    for i, txt in enumerate(page_texts, start=1):
        ptxt = (txt or "").strip()
        if ptxt:
            parts.append(ptxt)
            start = cursor
            end = cursor + len(ptxt)
            spans.append((i, start, end))
            cursor = end
        # add separator between pages (doesn't get a span)
        if i != len(page_texts):
            parts.append(sep)
            cursor += len(sep)
    combined = "".join(parts)
    return combined, spans

def pages_covered_by_span(span_start: int, span_end: int, page_spans: List[Tuple[int,int,int]]) -> Tuple[int, int]:
    """Map doc-level [start,end) into first/last page numbers using page_spans."""
    first, last = None, None
    for pnum, s, e in page_spans:
        if e <= span_start:
            continue
        if s >= span_end:
            break
        if first is None:
            first = pnum
        last = pnum
    if first is None:
        first = page_spans[0][0] if page_spans else 1
    if last is None:
        last = first
    return first, last

def index_client(client_id: str, pdfs: List[Path], force: bool = False) -> None:
    client_dir = FAISS_INDEX_DIR / client_id
    client_dir.mkdir(parents=True, exist_ok=True)

    # Skip if already built (unless --force)
    if not force and (client_dir / "index.faiss").exists() and (client_dir / "index.pkl").exists():
        print(f"[skip] {client_id}: index already exists. Use --force to rebuild.")
        return

    docs: List[Document] = []
    manifest_rows: List[DocInfo] = []

    for pdf in pdfs:
        info = build_manifest_entry(pdf)
        manifest_rows.append(info)

        # 1) per-page extraction (native or OCR)
        page_texts, ocr_words_by_page = extract_pdf_pages(pdf)

        # 2) build one combined string per PDF + page spans
        combined_text, page_spans = build_pdfwise_chunks(page_texts)
        if not combined_text.strip():
            print(f"[skip-doc] {pdf.name}: no text after OCR/native")
            continue

        # 3) chunk across the whole PDF text
        for start, end, chunk in chunk_text(combined_text):
            if not chunk.strip():
                continue
            pg_start, pg_end = pages_covered_by_span(start, end, page_spans)

            # put OCR words only for the first page of this chunk (for highlights)
            ocr_words = ocr_words_by_page.get(pg_start, [])

            meta = {
                "client_id": client_id,
                "policy_id": pdf.name,
                "page": pg_start,                   # first page covered (UI scroll point)
                "page_end": pg_end,                # last page covered (extra metadata)
                "source_file": str(pdf.resolve()),
            }
            if ocr_words:
                meta["ocr_words"] = ocr_words
            docs.append(Document(page_content=chunk, metadata=meta))

    # Always write manifest so UI can browse even if no chunks
    (client_dir / "manifest.json").write_text(json.dumps({
        "client_id": client_id,
        "docs": [
            {"policy_id": m.policy_id, "source_file": m.source_file, "pages": m.pages, "modified_time": m.modified_time}
            for m in manifest_rows
        ],
        "embed_model": EMBED_MODEL,
        "region": REGION,
        "generated_time": int(time.time()),
    }, indent=2), encoding="utf-8")

    if not docs:
        print(f"[{client_id}] No non-empty text extracted; FAISS not created (browse only).")
        return

    print(f"[{client_id}] Building FAISS with {len(docs)} chunks…")
    vs = FAISS.from_documents(docs, EMB)
    vs.save_local(str(client_dir))
    print(f"[{client_id}] Done. Index at {client_dir}")

def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="Rebuild even if index exists")
    parser.add_argument("--client", help="Only index this client id (from filename head)")
    args = parser.parse_args()

    if not PDF_ROOT.exists():
        raise SystemExit(f"PDF_ROOT does not exist: {PDF_ROOT}")
    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)

    # scan .pdf/.PDF, skip hidden & checkpoints
    by_client: Dict[str, List[Path]] = {}
    for p in PDF_ROOT.rglob("*"):
        if p.is_file() and p.suffix.lower() == ".pdf" and ".ipynb_checkpoints" not in p.as_posix():
            cid = client_from_filename(p.name)
            by_client.setdefault(cid, []).append(p)
    for k in by_client:
        by_client[k] = sorted(by_client[k], key=lambda x: x.name.lower())

    if not by_client:
        print("No PDFs found.")
        return

    if args.client:
        cid = args.client.strip().lower()
        pdfs = by_client.get(cid, [])
        if not pdfs:
            print(f"No PDFs for client '{cid}' in {PDF_ROOT}")
            return
        index_client(cid, pdfs, force=args.force)
    else:
        print(f"Found {sum(len(v) for v in by_client.values())} PDFs across {len(by_client)} client(s).")
        for client_id, pdfs in by_client.items():
            index_client(client_id, pdfs, force=args.force)

if __name__ == "__main__":
    main()
