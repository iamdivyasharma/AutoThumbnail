# ============= TDNA bootstrap (explicit START) =============
def _bootstrap_tdna_home():
    """Kick off TDNA 'What is the home airport?' via the orchestrator (internally routed).
    The orchestrator is responsible for actually querying TDNA and mapping city->IATA if needed.
    We just wait for the first assistant message to include/confirm home mapping—OR we parse codes if returned.
    """
    # Ask orchestrator to do the bootstrap implicitly by sending a harmless planning prompt.
    # (Agent endpoint already always calls TDNA Home internally on first run.)
    payload = build_agent_payload("bootstrap: home airport", source="ui_bootstrap")
    with st.status("Asking TDNA for your home airport…", expanded=False) as s:
        try:
            status, data = post(AGENT_URL, payload)
            raw = data.get("final_answer", "") if isinstance(data, dict) else str(data)
            s.update(label="TDNA responded", state="complete")
        except Exception as e:
            st.error(f"TDNA bootstrap error: {e}")
            st.session_state.boot_tdna_home = True
            return

    # Try to extract IATA code from the returned text (optional best-effort).
    found_code = None
    for code in ORIGIN_OPTIONS:
        if re.search(rf"\b{re.escape(code)}\b", raw, re.IGNORECASE):
            found_code = code
            break
    if found_code:
        st.session_state.tdna_home_code = found_code
        st.session_state.tdna_home_label = label_for(found_code)
    # Mark as booted; if orchestrator returns a richer structure in future, you can parse it here.
    st.session_state.boot_tdna_home = True

# Show a top prompt to start
def _start_guard():
    if not (st.session_state.user_name or st.session_state.user_email):
        st.info("Pick a user (or enter name/email) in the left sidebar, then click **Start planning**.")
        return False
    if not st.session_state.started:
        if st.button("▶️ Start planning", type="primary", use_container_width=True):
            st.session_state.started = True
            # trigger TDNA bootstrap exactly once on start
            if not st.session_state.boot_tdna_home:
                _bootstrap_tdna_home()
            st.rerun()
        return False
    return True

