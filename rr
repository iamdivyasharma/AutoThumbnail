# ragbot_api.py
# FastAPI wrapper for Ragbot.py
# Run: uvicorn ragbot_api:app --host 0.0.0.0 --port 8000

import os
import sys
import importlib
import importlib.util
from typing import Optional, Callable

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

# ------------------------------------------------------
# Config: where to find Ragbot.py and allowed CORS origins
# ------------------------------------------------------
RAGBOT_MODULE_NAME = os.getenv("RAGBOT_MODULE", "Ragbot")  # import Ragbot by default
RAGBOT_PATH = os.getenv("RAGBOT_PATH")  # optional absolute/relative path to Ragbot.py
CORS_ALLOW_ORIGINS = os.getenv("CORS_ALLOW_ORIGINS", "*").split(",")

def _load_ragbot_module():
    try:
        return importlib.import_module(RAGBOT_MODULE_NAME)
    except ModuleNotFoundError:
        if RAGBOT_PATH and os.path.exists(RAGBOT_PATH):
            spec = importlib.util.spec_from_file_location(RAGBOT_MODULE_NAME, RAGBOT_PATH)
            mod = importlib.util.module_from_spec(spec)
            sys.modules[RAGBOT_MODULE_NAME] = mod
            assert spec and spec.loader
            spec.loader.exec_module(mod)
            return mod
        raise  # bubble up if not found and no path provided

def _select_handler(mod) -> Optional[Callable]:
    """Pick the first available handler from Ragbot.py."""
    for fn_name in ("get_answer", "answer", "query"):
        fn = getattr(mod, fn_name, None)
        if callable(fn):
            return fn
    return None

app = FastAPI(title="Ragbot API", version="1.0.0", docs_url="/docs")

# CORS so your Streamlit app can call this API from the browser
app.add_middleware(
    CORSMiddleware,
    allow_origins=CORS_ALLOW_ORIGINS,
    allow_credentials=True,
    allow_methods=["GET", "POST", "OPTIONS"],
    allow_headers=["*"],
)

# ---------------------------
# Strict payload models
# ---------------------------
class QueryPayload(BaseModel):
    query: str = Field(..., min_length=1)
    user_name: str = Field(..., min_length=1)
    user_email: str = Field(..., min_length=3)

    class Config:
        extra = "forbid"  # 🚫 reject any unexpected keys

class AnswerResponse(BaseModel):
    answer: str

_ragbot_handler: Optional[Callable] = None

@app.on_event("startup")
def _startup():
    global _ragbot_handler
    mod = _load_ragbot_module()
    _ragbot_handler = _select_handler(mod)
    if not _ragbot_handler:
        raise RuntimeError(
            "No callable found in Ragbot module. Implement one of: "
            "get_answer(payload), answer(payload), or query(payload)."
        )

@app.get("/health")
def health():
    return {"status": "ok"}

@app.post("/ask", response_model=AnswerResponse)
def ask(payload: QueryPayload):
    # sanitize like your Streamlit code does
    clean = {
        "query": payload.query.strip(),
        "user_name": payload.user_name.strip(),
        "user_email": payload.user_email.strip(),
    }
    try:
        out = _ragbot_handler(clean)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Ragbot error: {e}") from e
    return {"answer": str(out)}
