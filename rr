Context:
{context}

Question:
{question}

Answer:
"""


# ---------- Core helpers ----------

def load_dashboard_df(path: str = EXCEL_PATH) -> pd.DataFrame:
    """
    Load the dashboard Excel file as a pandas DataFrame
    and drop the first column from the sheet.
    """
    df = pd.read_excel(path)
    # Drop the first column (0 = first)
    df = df.iloc[:, 1:]
    return df


def df_to_documents(df: pd.DataFrame, source: str) -> List[Document]:
    """
    Convert a DataFrame into a list of LangChain Documents.
    Each row becomes one Document.

    Example:
        docs_dashboard = df_to_documents(df, "dashboard")
    """
    docs: List[Document] = []

    for idx, row in df.iterrows():
        text_lines = [f"{col}: {row[col]}" for col in df.columns]
        text = "\n".join(text_lines)
        metadata = {
            "source": source,
            "row_index": int(idx),
        }
        docs.append(Document(page_content=text, metadata=metadata))

    return docs


def chunk_documents(
    docs: List[Document],
    chunk_size: int = 1000,
    chunk_overlap: int = 150,
) -> List[Document]:
    """
    Split documents into smaller chunks using RecursiveCharacterTextSplitter.
    """
    splitter = RecursiveCharacterTextSplitter(
        chunk_size=chunk_size,
        chunk_overlap=chunk_overlap,
    )
    return splitter.split_documents(docs)


def build_qa_chain_from_df(df: pd.DataFrame) -> RetrievalQA:
    """
    Build a RetrievalQA chain on top of a DataFrame using:

    - df_to_documents(df, "dashboard")
    - RecursiveCharacterTextSplitter
    - BedrockEmbeddings (Titan embed)
    - FAISS vector store
    - ChatBedrockConverse (Claude 3.5 on Bedrock)
    """
    # 1) DataFrame -> Documents
    all_docs = df_to_documents(df, source="dashboard")

    # 2) Chunk documents
    split_docs = chunk_documents(all_docs, chunk_size=1000)

    # 3) Embeddings (Titan via Amazon Bedrock)
    embeddings = BedrockEmbeddings(
        model_id="amazon.titan-embed-text-v2:0",  # adjust to your Titan text embed model
        client=bedrock_runtime_client,
    )

    # 4) Vector store (FAISS)
    vectorstore = FAISS.from_documents(split_docs, embedding=embeddings)
    retriever = vectorstore.as_retriever(
        search_type="similarity",
        search_kwargs={"k": 4},
    )

    # 5) LLM (Claude 3.5 Sonnet on Bedrock)
    llm = ChatBedrockConverse(
        model_id="anthropic.claude-3-5-sonnet-20240620-v1:0",
        client=bedrock_runtime_client,
        temperature=0.1,
        max_tokens=512,
    )

    # 6) Prompt
    prompt = PromptTemplate(
        template=RAG_TEMPLATE,
        input_variables=["context", "question"],
    )

    # 7) RetrievalQA chain
    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        chain_type="stuff",
        retriever=retriever,
        chain_type_kwargs={"prompt": prompt},
        return_source_documents=False,
    )

    return qa_chain


def run_rag_query(
    query: str,
    df: pd.DataFrame,
    extra_instruction: Optional[str] = None,
) -> str:
    """
    Simple one-shot RAG query over the whole df.
    (Kept in case you still want direct Q&A.)
    """
    qa_chain = build_qa_chain_from_df(df)

    full_question = query
    if extra_instruction:
        full_question = f"{query}\n\nAdditional instructions from the user:\n{extra_instruction}"

    result = qa_chain.invoke({"query": full_question})

    if isinstance(result, dict) and "result" in result:
        return result["result"]

    return str(result)


# ---------- Row-wise "Updated LLM insight" generation ----------

def update_llm_insights_for_filtered_df(
    df_filtered: pd.DataFrame,
    user_instruction: str,
    filter_col: Optional[str] = None,
    filter_values: Optional[Sequence[str]] = None,
    updated_col_name: str = UPDATED_LLM_COL,
) -> pd.DataFrame:
    """
    Run the RAG chain row-wise on a FILTERED DataFrame and fill a new column
    (default: 'Updated LLM insight') with the model's answer for each row.

    - df_filtered: subset of the original df after user filters.
    - user_instruction: the text the user typed in Streamlit describing what
      should change in LLM insight.
    - filter_col / filter_values: optional metadata so the model knows what filter
      was applied.

    Returns a NEW DataFrame (does not modify df_filtered in-place).
    """
    if df_filtered.empty:
        return df_filtered.copy()

    qa_chain = build_qa_chain_from_df(df_filtered)
    updated_df = df_filtered.copy()

    for idx, row in updated_df.iterrows():
        row_text = "\n".join(f"{col}: {row[col]}" for col in updated_df.columns)

        question = f"""
You are updating the '{updated_col_name}' for ONE row of an Excel dashboard.

Filter info (for context only):
- Filter column: {filter_col or "none"}
- Filter values: {list(filter_values) if filter_values else "none"}

Here is the row data:
{row_text}

User's instructions for how the LLM insight should be changed:
{user_instruction}

Return ONLY the text that should go into the '{updated_col_name}' column
for THIS row. Do not talk about any other rows or give extra explanations.
"""

        result = qa_chain.invoke({"query": question})
        if isinstance(result, dict) and "result" in result:
            insight_text = str(result["result"]).strip()
        else:
            insight_text = str(result).strip()

        updated_df.at[idx, updated_col_name] = insight_text

    return updated_df


# ---------- NEW: conversational chat over filtered data (with memory) ----------

def chat_with_filtered_df(
    df_filtered: pd.DataFrame,
    user_question: str,
    filter_col: Optional[str] = None,
    filter_values: Optional[Sequence[str]] = None,
    chat_history: Optional[Sequence[tuple[str, str]]] = None,
) -> str:
    """
    Conversational RAG over the *filtered* DataFrame.

    - df_filtered: the filtered subset of the main dashboard.
    - user_question: the latest user message.
    - filter_col / filter_values: metadata about which filter was applied.
    - chat_history: list of (role, content) tuples from Streamlit session state,
      e.g. [("user", "..."), ("assistant", "..."), ...]

    We turn the history into text and prepend it to the question, so the LLM
    can answer in a conversational, context-aware way.
    """
    if df_filtered.empty:
        return (
            "The filtered DataFrame currently has 0 rows. "
            "Adjust your filters and try asking again."
        )

    qa_chain = build_qa_chain_from_df(df_filtered)

    history_text = ""
    if chat_history:
        # Keep only the most recent few turns to keep prompts manageable
        formatted_turns = []
        for role, content in chat_history[-10:]:
            # Streamlit uses "user"/"assistant" – map to readable labels
            role_label = "User" if role == "user" else "Assistant"
            formatted_turns.append(f"{role_label}: {content}")
        history_text = "Conversation so far:\n" + "\n".join(formatted_turns) + "\n\n"

    filter_info = (
        f"Filter info (for context only):\n"
        f"- Filter column: {filter_col or 'none'}\n"
        f"- Filter values: {list(filter_values) if filter_values else 'none'}\n\n"
    )

    full_question = (
        f"{history_text}"
        f"{filter_info}"
        "Using ONLY the information in the provided context and the conversation above, "
        "answer the current user question.\n\n"
        f"Current user question:\n{user_question}"
    )

    result = qa_chain.invoke({"query": full_question})

    if isinstance(result, dict) and "result" in result:
        return str(result["result"]).strip()

    return str(result).strip()




