#
# 👉 IMPORTANT:
#  - Keys MUST match exactly the JSON keys you describe in your system prompt.
#  - Put ALL your ~42 fields here, in the ORDER you want them in Excel / FlatString.
FIELD_DEFS: Dict[str, Dict[str, str]] = {
    # ==== EXAMPLES – replace with YOUR real fields ====
