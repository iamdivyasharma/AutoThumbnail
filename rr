            st.session_state.pop(key, None)

        # Optionally also clear chat when resetting session
        st.session_state.chat_history_data = []
        st.session_state.chat_history_insights = []

        st.experimental_rerun()


# ---------- HEADER with LOGO ----------

header_cols = st.columns([1, 5])

