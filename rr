def ragbot(payload):
    """
    payload: { "username": str, "email": str, "query": str }
    returns: str (answer only)
    """
    from langchain.chains import ConversationalRetrievalChain

    # lazy bootstrap once
    if not hasattr(ragbot, "_conv_qa"):
        import boto3
        from langchain_aws.chat_models import BedrockChat
        from langchain_aws.embeddings import BedrockEmbeddings
        from langchain_chroma import Chroma

        # hardcode your AWS + models
        bedrock = boto3.client(
            "bedrock-runtime",
            region_name="us-east-1",
            aws_access_key_id="AKIA...YOUR_KEY...",
            aws_secret_access_key="YOUR_SECRET...",
        )
        llm = BedrockChat(client=bedrock, model_id="anthropic.claude-3-haiku-20240307-v1:0", temperature=0.1)
        emb = BedrockEmbeddings(client=bedrock, model_id="amazon.titan-embed-text-v2:0")

        # open existing vector index (use FAISS.load_local if you prefer FAISS)
        vstore = Chroma(collection_name="ragbot", embedding_function=emb, persist_directory=".chroma")
        retriever = vstore.as_retriever(search_kwargs={"k": 4})

        ragbot._conv_qa = ConversationalRetrievalChain.from_llm(
            llm=llm,
            retriever=retriever,
            return_source_documents=False,  # not needed if you only want the answer
        )
        ragbot._mem = {}  # {"u:..|e:..": [(human, ai), ...]}

    # pull fields
    u = (payload.get("username") or payload.get("user_name") or "").strip()
    e = (payload.get("email") or "").strip()
    q = (payload.get("query") or "").strip()
    if not (u and e and q):
        return ""  # or raise/return an error if you prefer

    sid = f"u:{u.lower()}|e:{e.lower()}"
    chat_history = ragbot._mem.get(sid, [])

    # ask
    out = ragbot._conv_qa({"question": q, "chat_history": chat_history})
    answer = out.get("answer", "")

    # save turn
    ragbot._mem[sid] = chat_history + [(q, answer)]

    return answer
