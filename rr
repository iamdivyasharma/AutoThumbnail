# at top:
from pathlib import Path

def get_pdf_page_count_local(path: str):
    """Return page count for a local PDF path. Tries pypdf -> PyPDF2 -> PyMuPDF."""
    try:
        p = Path(path)
        if not p.exists() or p.suffix.lower() != ".pdf":
            return None

        # Try pypdf
        try:
            from pypdf import PdfReader
            return len(PdfReader(str(p)).pages)
        except Exception:
            pass

        # Fallback: PyPDF2
        try:
            from PyPDF2 import PdfReader as P2Reader
            return len(P2Reader(str(p)).pages)
        except Exception:
            pass

        # Fallback: PyMuPDF
        try:
            import fitz
            with fitz.open(str(p)) as doc:
                return doc.page_count
        except Exception:
            pass

        return None
    except Exception:
        return None
