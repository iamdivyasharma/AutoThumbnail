def make_chunks_for_pdf(pdf_path: Path, category: str, client_id: str) -> Iterable[Document]:
    """
    Decide between:
      - PyMuPDF for text-based PDFs.
      - AmazonTextractPDFLoader (via S3) for scanned PDFs.
    """
    policy_id = pdf_path.name
    scanned = is_scanned_pdf(pdf_path)

    # ===== NEW: SCANNED PDF → TEXTRACT LOADER VIA S3 =====
    if scanned:
        s3_key = local_path_to_s3_key(pdf_path)
        if not s3_key:
            print(f"[WARN] Could not map {pdf_path} to S3 key; skipping Textract loader.")
            return

        print(f"[TEXTRACT] Using AmazonTextractPDFLoader for s3://{S3_DOC_BUCKET}/{s3_key}")

        try:
            loader = AmazonTextractPDFLoader(
                client=TEXTRACT_CLIENT,   # your boto3 Textract client
                bucket=S3_DOC_BUCKET,
                key=s3_key,
                # add extra params here if your version supports them
            )
            tex_docs = loader.load()  # -> List[Document]
        except Exception as e:
            print(f"[WARN] AmazonTextractPDFLoader failed for {pdf_path}: {e}")
            return

        if not tex_docs:
            print(f"[WARN] AmazonTextractPDFLoader returned no docs for {pdf_path}")
            return

        # Combine all loader docs into one big string
        concatenated = ""
        page_ranges: List[Tuple[int, int, int]] = []  # (start_char, end_char, page_num)
        cursor = 0

        for d in tex_docs:
            txt = clean_text(d.page_content or "")
            if not txt:
                continue

            # Try to get page number from loader metadata; default to 1
            page_num = int(d.metadata.get("page", 1)) if isinstance(d.metadata, dict) else 1

            start = cursor
            concatenated += txt + "\n"
            cursor = len(concatenated)
            page_ranges.append((start, cursor, page_num))

        if not concatenated.strip():
            print(f"[WARN] Empty text after Textract loader for {pdf_path}")
            return

        # Chunk across pages just like before
        for c_start, c_end, chunk in chunk_text(concatenated):
            pages = sorted({
                page_num
                for p_start, p_end, page_num in page_ranges
                if not (p_end <= c_start or p_start >= c_end)
            })
            if not pages:
                continue

            meta = {
                "category": category,
                "client_id": client_id,
                "policy_id": policy_id,
                "page_start": pages[0],
                "page_end": pages[-1],
                "source_file": str(pdf_path.resolve()),
                "extracted_by": "amazon_textract_loader",
            }
            yield Document(page_content=chunk, metadata=meta)

        return

    # ===== EXISTING: NON-SCANNED PDF → PYMUPDF =====
    try:
        with fitz.open(str(pdf_path)) as doc:
            for pnum in range(doc.page_count):
                page = doc.load_page(pnum)
                text = clean_text(page.get_text("text") or "")
                if not text.strip():
                    continue
                for _, _, chunk in chunk_text(text):
                    meta = {
                        "category": category,
                        "client_id": client_id,
                        "policy_id": policy_id,
                        "page": pnum + 1,
                        "source_file": str(pdf_path.resolve()),
                        "extracted_by": "pymupdf",
                    }
                    yield Document(page_content=chunk, metadata=meta)
    except Exception as e:
        print(f"[WARN] Failed to process PDF {pdf_path} via PyMuPDF: {e}")
