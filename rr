from __future__ import annotations

import argparse
import json
from pathlib import Path

import pandas as pd


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--excel", required=True, help="Path to Excel file")
    p.add_argument("--sheet", default=None, help="Sheet name (optional)")
    p.add_argument("--out", required=True, help="Output schema json path")
    args = p.parse_args()

    excel = Path(args.excel).resolve()
    if not excel.exists():
        raise SystemExit(f"Excel not found: {excel}")

    if args.sheet:
        df = pd.read_excel(excel, sheet_name=args.sheet)
    else:
        # default: first sheet
        frames = pd.read_excel(excel, sheet_name=None)
        first = list(frames.keys())[0]
        df = frames[first]

    columns = [str(c) for c in df.columns]
    schema = {
        "excel": str(excel),
        "sheet": args.sheet,
        "columns": columns,
        "n_rows": int(len(df)),
    }

    out = Path(args.out).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(schema, indent=2), encoding="utf-8")
    print(f"Wrote schema: {out}")


if __name__ == "__main__":
    main()

