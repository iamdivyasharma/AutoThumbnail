# ================== CHAT TABS ==================
tabs = st.tabs(["Agentic AI", "AIR bot", "HOTEL bot", "TDNA"])

def send_chat_message(label: str, user_msg: str) -> str:
    """
    Agentic AI -> /agent_query
    AIR/HOTEL/TDNA -> /route_query with target=<bot>
    In chat_mode: do NOT include filters in extra.
    """
    extra: Dict[str, Any] = {"source": "streamlit_ui", "chat_mode": st.session_state.chat_mode}
    # Only include filters in extra when not in chat_mode and when bot supports filters
    if not st.session_state.chat_mode and label in ["Agentic AI","AIR bot","HOTEL bot"]:
        f = st.session_state.filters
        extra["filters"] = {
            "origin": f["ond"]["origin"],
            "destination": f["ond"]["destination"],
            "start_date": f["start_date"],
            "end_date": f["end_date"],
            "policy_status": f.get("policy_status","Any"),
        }

    if label == "Agentic AI":
        data = call_agent_query(user_msg, extra=extra)
        return data.get("final_answer") or data.get("error") or "No response."
    elif label == "AIR bot":
        data = call_route_query(user_msg, target="air", extra=extra)
        return data.get("answer") or data.get("error") or "No response."
    elif label == "HOTEL bot":
        data = call_route_query(user_msg, target="hotel", extra=extra)
        return data.get("answer") or data.get("error") or "No response."
    else:  # TDNA
        data = call_route_query(user_msg, target="tdna", extra=extra)
        return data.get("answer") or data.get("error") or "No response."

def chat_tab(label: str):
    with tabs[["Agentic AI","AIR bot","HOTEL bot","TDNA"].index(label)]:
        st.markdown(f"**{label} conversation**")

        # 👇 No filters for any bot when chat_mode is True
        show_filters = False if st.session_state.chat_mode else (label in ["Agentic AI","AIR bot","HOTEL bot"])
        if show_filters and label != "TDNA":
            with st.expander("Adjust filters for this chat", expanded=False):
                render_filters(block_key=f"chat_{label.replace(' ','_').lower()}")

        # Existing messages
        for role, msg in st.session_state.chat[label]:
            with st.chat_message(role):
                st.markdown(msg)

        # Chat input
        user_msg = st.chat_input(f"Message {label}…", key=f"chat_input_{label}")
        if user_msg:
            st.session_state.chat[label].append(("user", user_msg))
            reply = send_chat_message(label, user_msg)
            st.session_state.chat[label].append(("assistant", reply))
            st.rerun()

chat_tab("Agentic AI")
chat_tab("AIR bot")
chat_tab("HOTEL bot")
chat_tab("TDNA")

