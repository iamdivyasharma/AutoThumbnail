import os
import boto3

# ==== SETTINGS – CHANGE THESE ====
BUCKET_NAME = "your-bucket-name"   # <-- put your bucket here
ROOT_FOLDER = r"/path/to/root"     # <-- this folder contains "finance" and "legal"
SUBFOLDERS = ["finance", "legal"]  # the two top folders you mentioned
# =================================

s3 = boto3.client("s3")

for sub in SUBFOLDERS:
    local_root = os.path.join(ROOT_FOLDER, sub)

    # walk through each subfolder and its children
    for dirpath, dirnames, filenames in os.walk(local_root):
        for filename in filenames:
            # only pdf and docx
            if not filename.lower().endswith((".pdf", ".docx")):
                continue

            local_path = os.path.join(dirpath, filename)

            # path relative to ROOT_FOLDER, e.g. "finance/clientA/file.pdf"
            rel_path = os.path.relpath(local_path, ROOT_FOLDER)

            # S3 wants forward slashes
            s3_key = rel_path.replace(os.sep, "/")

            print(f"Uploading {local_path} -> s3://{BUCKET_NAME}/{s3_key}")
            s3.upload_file(local_path, BUCKET_NAME, s3_key)
