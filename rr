# API-1: RAG SEARCH API
# ============================================================

class AskRequest(BaseModel):
    question: str
    category: Optional[str] = None
    client_ids: Optional[List[str]] = None

    # ✅ important for your orchestrator design
    mode: str = "retrieve"  # "retrieve" or "rag"
    k: int = 6              # number of chunks per client


class Chunk(BaseModel):
    text: str
    metadata: Dict[str, Any]


class AskResponse(BaseModel):
    mode: str
    answer: Optional[str] = None
    used_clients: List[str]
    chunks: List[Chunk]
    sources: List[Dict[str, Any]]


_rag_prompt = ChatPromptTemplate.from_messages([
    ("system",
     "You are a precise contract assistant. Use ONLY the context below. "
     "If context is insufficient, say you don't know."),
    ("human",
     "Question: {question}\n\nContext:\n{context}\n\nAnswer:")
])


@app.post("/api/rag-search", response_model=AskResponse)
def rag_search(payload: AskRequest):
    """
    API-1: RAG Search API
    ✅ works directly from FAISS indexes
    ✅ supports retrieval-only mode (recommended)
    ✅ supports optional answer generation mode
    """
    if not payload.question.strip():
        raise HTTPException(400, "question is required")

    category = payload.category.strip().lower() if payload.category else None
    if category and category not in CATEGORIES:
        raise HTTPException(400, f"category must be one of {CATEGORIES}")

    available = refresh_id_to_dir(category=category)
    if not available:
        raise HTTPException(404, "No FAISS indexes found")

    if not payload.client_ids:
        raise HTTPException(
            400,
            "client_ids is required for production (orchestrator should resolve this via metadata API first)"
        )

    requested = [_normalize_id(x) for x in payload.client_ids]
    invalid = [c for c in requested if c not in available]
    if invalid:
        raise HTTPException(404, f"Invalid client_ids: {invalid}")

    n_clients = len(requested)
    per_cap = max(1, math.ceil(MAX_COMBINED_K / n_clients))
    k_effective = min(payload.k, per_cap)

    all_docs = []
    for cid in requested:
        vs = load_faiss_index(cid)
        retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k_effective})
        docs = retriever.get_relevant_documents(payload.question)
        all_docs.extend(docs)

    all_docs = all_docs[:MAX_COMBINED_K]

    chunks: List[Chunk] = []
    sources: List[Dict[str, Any]] = []

    for d in all_docs:
        meta = dict(d.metadata or {})
        chunks.append(Chunk(text=d.page_content, metadata=meta))

        sources.append({
            "policy_id": meta.get("policy_id"),
            "page": meta.get("page", meta.get("page_start")),
            "page_end": meta.get("page_end"),
            "client_id": meta.get("client_id"),
            "category": meta.get("category"),
            "source_file": meta.get("source_file"),
        })

    # ✅ retrieval-only
    if payload.mode.lower() == "retrieve":
        return AskResponse(
            mode="retrieve",
            answer=None,
            used_clients=requested,
            chunks=chunks,
            sources=sources,
        )

    # ✅ full RAG mode (LLM answer)
    context = "\n\n---\n\n".join([c.text for c in chunks])
    llm = ChatBedrockConverse(
        model_id=BEDROCK_LLM_MODEL,
        client=bedrock_runtime,
        temperature=0.15,
        max_tokens=900,
    )
    chain = _rag_prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": payload.question, "context": context})

    return AskResponse(
        mode="rag",
        answer=answer,
        used_clients=requested,
        chunks=chunks,
        sources=sources,
    )


