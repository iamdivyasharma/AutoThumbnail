# services/metadata_service.py
from __future__ import annotations

import json
import os
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import pandas as pd


def _norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()


def _safe_read_json(path: Path) -> Optional[dict]:
    try:
        return json.loads(path.read_text(encoding="utf-8", errors="ignore"))
    except Exception:
        return None


@dataclass
class ClientMatch:
    cid: str
    client_name: str
    country: Optional[str] = None
    score: float = 0.0


class MetadataService:
    """
    Metadata Lookup Service

    - Resolves client using client master CSV (cid, parent_hq, country__c)
    - Uses FAISS folder structure to find scopes
    - Reads manifest.json in each scope to preview docs + metadataAttributes
    """

    def __init__(
        self,
        faiss_index_dir: str,
        client_master_csv_path: str,
        schema_json_path: str,
        client_name_col: str = "parent_hq",
        country_col: str = "country__c",
        cid_col: str = "cid",
        max_manifest_docs_preview: int = 20,
    ):
        self.faiss_index_dir = Path(faiss_index_dir).resolve()
        self.client_master_csv_path = Path(client_master_csv_path).resolve()
        self.schema_json_path = Path(schema_json_path).resolve()

        self.client_name_col = client_name_col
        self.country_col = country_col
        self.cid_col = cid_col

        self.max_manifest_docs_preview = max_manifest_docs_preview

        self._df: Optional[pd.DataFrame] = None
        self._schema: Optional[dict] = None

    def ensure_loaded(self):
        # --- schema JSON (only for reference / allowed fields) ---
        if self._schema is None:
            if self.schema_json_path.exists():
                self._schema = _safe_read_json(self.schema_json_path) or {}
            else:
                self._schema = {}

        # --- client master CSV ---
        if self._df is None:
            if not self.client_master_csv_path.exists():
                raise FileNotFoundError(f"Client master CSV not found: {self.client_master_csv_path}")

            df = pd.read_csv(self.client_master_csv_path, dtype=str, keep_default_na=False)
            # Normalize required cols
            for c in [self.client_name_col, self.country_col, self.cid_col]:
                if c not in df.columns:
                    raise ValueError(f"Missing column '{c}' in CSV {self.client_master_csv_path}")
            df[self.client_name_col] = df[self.client_name_col].astype(str)
            df[self.country_col] = df[self.country_col].astype(str)
            df[self.cid_col] = df[self.cid_col].astype(str)

            # add normalized name column
            df["_client_norm"] = df[self.client_name_col].map(_norm)
            df["_cid_norm"] = df[self.cid_col].map(lambda x: str(x).strip())
            df["_country_norm"] = df[self.country_col].map(lambda x: str(x).strip().upper())

            self._df = df

    # -------------------------
    # MAIN LOOKUP ENTRY POINT
    # -------------------------
    def lookup(
        self,
        query: str,
        country: Optional[str] = None,
        category: Optional[str] = None,   # ✅ FIX: accept category here
        limit: int = 5,
    ) -> Dict[str, Any]:
        """
        Returns:
          - best client matches from CSV (cid, parent_hq, country__c)
          - available FAISS scopes from faiss_indices
          - docs_preview from manifest.json
        """
        self.ensure_loaded()
        q = (query or "").strip()
        if not q:
            return {"matches": [], "error": "Empty query"}

        cat = (category or "").strip().lower() or None
        if cat and cat not in {"finance", "legal"}:
            cat = None  # ignore unknown

        country_norm = (country or "").strip().upper() or None

        # 1) Resolve client from CSV
        matches = self._resolve_client_from_csv(q, country_norm=country_norm, limit=limit)

        # 2) For each match, find FAISS scopes + manifest preview
        enriched = []
        for m in matches:
            scopes = self._find_scopes_for_client(m.client_name, category=cat, country=country_norm)
            docs_preview = self._preview_docs_from_scopes(scopes)

            enriched.append({
                "cid": m.cid,
                "client_name": m.client_name,
                "country": m.country,
                "score": m.score,
                "scopes": scopes,
                "docs_preview": docs_preview,
            })

        return {
            "query": q,
            "category": cat,
            "country": country_norm,
            "matches": enriched,
        }

    # -------------------------
    # Client Resolution (CSV)
    # -------------------------
    def _resolve_client_from_csv(self, query: str, country_norm: Optional[str], limit: int) -> List[ClientMatch]:
        assert self._df is not None
        qn = _norm(query)

        # exact cid search
        cid_hits = self._df[self._df["_cid_norm"] == query.strip()]
        if not cid_hits.empty:
            out = []
            for _, r in cid_hits.head(limit).iterrows():
                out.append(ClientMatch(
                    cid=r[self.cid_col],
                    client_name=r[self.client_name_col],
                    country=r[self.country_col] or None,
                    score=1.0,
                ))
            return out

        # filter by country if provided
        df = self._df
        if country_norm:
            df = df[df["_country_norm"] == country_norm]

        # simple fuzzy-like scoring (no heavy deps)
        # score = shared token overlap
        q_tokens = set(qn.split())
        scored: List[Tuple[float, int]] = []

        for i, row in df.iterrows():
            name_tokens = set(str(row["_client_norm"]).split())
            if not name_tokens:
                continue
            overlap = len(q_tokens.intersection(name_tokens))
            score = overlap / max(1, len(q_tokens))
            if score > 0:
                scored.append((score, i))

        scored.sort(reverse=True, key=lambda x: x[0])

        out: List[ClientMatch] = []
        for score, i in scored[:limit]:
            r = df.loc[i]
            out.append(ClientMatch(
                cid=r[self.cid_col],
                client_name=r[self.client_name_col],
                country=r[self.country_col] or None,
                score=float(score),
            ))
        return out

    # -------------------------
    # Find scopes in faiss_indices
    # -------------------------
    def _find_scopes_for_client(self, client_name: str, category: Optional[str], country: Optional[str]) -> List[str]:
        """
        Returns IDs like:
          finance/google/us
          finance/google/ultimateparent
          legal/google
        """
        client_folder_guess = _norm(client_name).replace(" ", "")
        # your folder naming may already be normalized in FAISS dirs; adapt safely:
        # We'll scan everything and match folder name loosely
        scopes: List[str] = []
        if not self.faiss_index_dir.exists():
            return scopes

        categories = [category] if category else ["finance", "legal"]

        for cat in categories:
            root = self.faiss_index_dir / cat
            if not root.exists():
                continue

            # walk directories that contain manifest.json
            for manifest_path in root.rglob("manifest.json"):
                try:
                    rel = manifest_path.parent.relative_to(self.faiss_index_dir).as_posix()
                except Exception:
                    continue

                # rel like "finance/google/us" or "legal/abb"
                rel_low = rel.lower()

                # client name match: do a light contains check
                if client_folder_guess and client_folder_guess not in rel_low.replace("/", ""):
                    continue

                # if country provided, keep only matching scope
                if country and cat == "finance":
                    if f"/{country.lower()}" not in rel_low:
                        # allow ultimateparent/corporatefamily when asked explicitly?
                        # for strict country queries, skip them
                        continue

                scopes.append(rel_low)

        return sorted(set(scopes))

    # -------------------------
    # Read manifest.json docs preview
    # -------------------------
    def _preview_docs_from_scopes(self, scopes: List[str]) -> List[Dict[str, Any]]:
        out: List[Dict[str, Any]] = []

        for s in scopes:
            manifest = self.faiss_index_dir / s / "manifest.json"
            if not manifest.exists():
                continue

            data = _safe_read_json(manifest) or {}
            docs = data.get("docs", []) or []

            for d in docs[: self.max_manifest_docs_preview]:
                meta = d.get("metadata") or {}
                # You said .pdf.metadata stores: {"metadataAttributes":{...}}
                attrs = meta.get("metadataAttributes") or meta.get("metadataAtrributes") or {}

                out.append({
                    "scope": s,
                    "policy_id": d.get("policy_id"),
                    "pages": d.get("pages"),
                    "modified_time": d.get("modified_time"),
                    "source_file": d.get("source_file"),
                    "metadataAttributes": attrs,
                })

        return out
