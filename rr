## `app.py`

```python
# app.py
import os, io, json
import streamlit as st
from dotenv import load_dotenv

from rag_core import ingest_all_from_mapping, answer_question, INDEX
from prompts import SYSTEM_PROMPT, INSTRUCTION_PROMPT

load_dotenv()

APP_TITLE = os.getenv("APP_TITLE", "Chat with Contracts")
APP_LOGO_PATH = os.getenv("APP_LOGO_PATH", "")

st.set_page_config(page_title=APP_TITLE, layout="wide")

# Sidebar branding
st.sidebar.title(APP_TITLE)
if APP_LOGO_PATH and os.path.exists(APP_LOGO_PATH):
    st.sidebar.image(APP_LOGO_PATH, use_column_width=True)

# One-time bulk ingestion (11 clients -> 11 PDFs) from clients.json
with st.sidebar.expander("Load client PDFs (once)"):
    mapping_path = st.text_input("clients.json path", value="./clients.json")
    if st.button("Index all clients", type="primary", use_container_width=True):
        with st.spinner("Indexing all client PDFs …"):
            counts = ingest_all_from_mapping(mapping_path)
        msg = " | ".join([f"{k}:{v}" for k, v in counts.items()])
        st.success(f"Done. Chunks per client — {msg}")

# Client picker: only clients that are indexed will appear
indexed_clients = sorted([k for k, v in INDEX.items() if v])
client = st.sidebar.selectbox("Choose client", indexed_clients) if indexed_clients else None

# Prompt editor
sys_prompt = st.sidebar.text_area("System prompt", value=SYSTEM_PROMPT, height=120)
inst_prompt = st.sidebar.text_area("Instruction prompt", value=INSTRUCTION_PROMPT, height=140)

st.markdown(f"## {APP_TITLE}")
if client:
    st.caption(f"Tenant: **{client}** — answers come only from this client's single indexed PDF.")
else:
    st.caption("No clients indexed. Load clients.json and click ‘Index all clients’.")

# Per-client chat history
if "history" not in st.session_state:
    st.session_state.history = {}
if client and client not in st.session_state.history:
    st.session_state.history[client] = []

# Replay history
if client:
    for role, content in st.session_state.history[client]:
        with st.chat_message(role):
            st.markdown(content)

user_q = st.chat_input("Ask about the selected client's document …")

if client and user_q:
    st.session_state.history[client].append(("user", user_q))
    with st.chat_message("user"):
        st.markdown(user_q)

    with st.chat_message("assistant"):
        placeholder = st.empty()
        sources_box = st.empty()
        ctxs, stream = answer_question(client, user_q, sys_prompt, inst_prompt)
        buf = io.StringIO()
        for token in stream:
            buf.write(token)
            placeholder.markdown(buf.getvalue())
        if ctxs:
            src_lines = [
                f"- [Source {i+1}] **{c.get('doc_id')}** page {c.get('page')} — _{c.get('source')}_ (score {c.get('score'):.3f})"
                for i, c in enumerate(ctxs)
            ]
            sources_box.markdown("**Sources**\n\n" + "\n".join(src_lines))
        st.session_state.history[client].append(("assistant", buf.getvalue()))
