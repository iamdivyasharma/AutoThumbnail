import pandas as pd
from datetime import datetime

# One Excel for metadata; one for your existing extracted workbook
METADATA_EXCEL_FILE = Path(os.getenv("METADATA_EXCEL_PATH", "data/metadata.xlsx")).resolve()
WORKBOOK_EXCEL_FILE = Path(os.getenv("LOCAL_EXCEL_PATH", "data/workbook.xlsx")).resolve()

EXCEL_INDEX_DIR = Path(os.getenv("LOCAL_EXCEL_INDEX_DIR", "excel_faiss")).resolve()
EXCEL_INDEX_DIR.mkdir(parents=True, exist_ok=True)

# Separate state per mode ("metadata" vs "workbook")
_EXCELS: Dict[str, Dict[str, Any]] = {
    "metadata": {
        "file": METADATA_EXCEL_FILE,
        "index_dir": EXCEL_INDEX_DIR / "metadata",
        "df_by_sheet": {},
        "meta": {},
        "vs": None,
        "chunk_meta": [],
        "last_loaded_at": None,
    },
    "workbook": {
        "file": WORKBOOK_EXCEL_FILE,
        "index_dir": EXCEL_INDEX_DIR / "workbook",
        "df_by_sheet": {},
        "meta": {},
        "vs": None,
        "chunk_meta": [],
        "last_loaded_at": None,
    },
}

_EXCEL_HISTORY: Dict[str, List[Dict[str, Any]]] = {}   # session_id -> history

def _load_excel_into_frames(mode: str) -> Dict[str, pd.DataFrame]:
    cfg = _EXCELS[mode]
    xfile = cfg["file"]
    if not xfile.exists():
        raise HTTPException(404, f"Excel file for mode '{mode}' not found at {xfile}")
    frames = pd.read_excel(xfile, sheet_name=None, engine=None)
    norm = {}
    for sh, df in frames.items():
        df = df.copy()
        df.columns = [str(c) for c in df.columns]
        norm[str(sh)] = df
    return norm

def _df_rows_to_text(df: pd.DataFrame, sheet: str, start: int, end: int) -> str:
    lines = [f"[sheet: {sheet}] rows {start+1}-{end}"]
    for i in range(start, end):
        row = df.iloc[i]
        kv = ", ".join(f"{col}={repr(row[col])}" for col in df.columns)
        lines.append(f"r{i+1}: {kv}")
    return "\n".join(lines)

def _build_excel_faiss(mode: str) -> None:
    cfg = _EXCELS[mode]
    xfile = cfg["file"]
    index_dir = cfg["index_dir"]
    index_dir.mkdir(parents=True, exist_ok=True)

    df_by_sheet = _load_excel_into_frames(mode)
    sheets = list(df_by_sheet.keys())
    rows = {s: int(len(df_by_sheet[s])) for s in sheets}
    mtime = datetime.fromtimestamp(xfile.stat().st_mtime).isoformat(timespec="seconds")

    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))

    texts = []
    chunk_meta = []
    CHUNK_SIZE = 40  # rows per chunk

    for sh in sheets:
        df = df_by_sheet[sh]
        n = len(df)
        if n == 0:
            continue
        for start in range(0, n, CHUNK_SIZE):
            end = min(start + CHUNK_SIZE, n)
            text = _df_rows_to_text(df, sh, start, end)
            texts.append(text)
            chunk_meta.append({"sheet": sh, "start_row": start+1, "end_row": end})

    if not texts:
        raise HTTPException(400, f"Excel workbook for mode '{mode}' has no rows to index.")

    vs = FAISS.from_texts(texts=texts, embedding=emb)
    vs.save_local(str(index_dir))

    cfg["df_by_sheet"] = df_by_sheet
    cfg["meta"] = {"sheets": sheets, "rows": rows, "mtime": mtime, "path": str(xfile)}
    cfg["vs"] = vs
    cfg["chunk_meta"] = chunk_meta
    cfg["last_loaded_at"] = datetime.utcnow().isoformat(timespec="seconds") + "Z"

def _ensure_excel_loaded(mode: str):
    cfg = _EXCELS[mode]
    if cfg.get("vs") is not None and cfg.get("df_by_sheet"):
        return

    index_dir = cfg["index_dir"]
    xfile = cfg["file"]

    # Try to load saved FAISS
    try:
        emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
        cfg["vs"] = FAISS.load_local(str(index_dir), emb, allow_dangerous_deserialization=True)
    except Exception:
        cfg["vs"] = None

    # If we don't have vs or dataframes, rebuild from Excel
    if cfg["vs"] is None or not cfg.get("df_by_sheet"):
        if not xfile.exists():
            raise HTTPException(404, f"Excel file for mode '{mode}' not found at {xfile}")
        _build_excel_faiss(mode)

def _excel_answer(
    question: str,
    k: int = 6,
    session_id: Optional[str] = None,
    mode: str = "metadata",
    category: Optional[str] = None,
) -> Dict[str, Any]:
    mode = (mode or "metadata").strip().lower()
    if mode not in _EXCELS:
        raise HTTPException(400, f"Unknown Excel mode '{mode}'. Expected one of {list(_EXCELS.keys())}.")

    _ensure_excel_loaded(mode)
    cfg = _EXCELS[mode]
    vs = cfg["vs"]

    # If user chose category (legal/finance) in metadata mode, prepend constraint in the question.
    effective_question = question.strip()
    if mode == "metadata" and category:
        cat_norm = category.strip().lower()
        effective_question = (
            f"Only use rows where category = '{cat_norm}'. "
            f"Original question: {effective_question}"
        )

    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k})
    docs = retriever.get_relevant_documents(effective_question)

    previews = []
    chunk_meta = cfg["chunk_meta"]
    df_by_sheet = cfg["df_by_sheet"]

    for idx, d in enumerate(docs):
        if idx >= len(chunk_meta):
            break
        meta = chunk_meta[idx]
        sh = meta.get("sheet")
        s = int(meta.get("start_row", 1)) - 1
        e = int(meta.get("end_row", s+1))
        df = df_by_sheet.get(sh)
        if df is None:
            continue
        df_slice = df.iloc[max(0, s):min(e, s+8)]
        preview = df_slice.to_string(index=False)
        previews.append(f"(sheet: {sh}, rows {s+1}-{min(e, s+8)})\n{preview}")

    context = "\n\n---\n\n".join(previews) if previews else "(no preview)"
    history = _EXCEL_HISTORY.get(session_id or "", [])[-6:] if session_id else []

    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=0.15,
        max_tokens=900,
    )

    excel_prompt = ChatPromptTemplate.from_messages([
        ("system",
         "You are a precise data analyst. Answer ONLY using the Provided Context from the Excel sheets. "
         "Be specific with rows/columns where possible. If the data needed isn't in the context, say you don't know."),
        *[("human" if t["role"] == "user" else "assistant", t["text"]) for t in history],
        ("human", "Question: {question}\n\nProvided Context:\n{context}\n\nAnswer now with specifics.")
    ])

    chain = excel_prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": effective_question, "context": context})

    if session_id:
        sess = _EXCEL_HISTORY.setdefault(session_id, [])
        now = datetime.utcnow().isoformat(timespec="seconds") + "Z"
        sess.append({"role": "user", "text": question, "time": now})
        sess.append({"role": "assistant", "text": answer, "time": now})
        if len(sess) > 40:
            _EXCEL_HISTORY[session_id] = sess[-40:]

    srcs = []
    for idx, d in enumerate(docs):
        if idx >= len(chunk_meta):
            break
        meta = chunk_meta[idx]
        srcs.append({
            "sheet": meta.get("sheet"),
            "start_row": meta.get("start_row"),
            "end_row": meta.get("end_row"),
            "snippet": d.page_content[:300],
        })

    return {
        "answer": answer,
        "sources": srcs,
        "history": _EXCEL_HISTORY.get(session_id or "", []),
        "meta": cfg["meta"],
        "mode": mode,
        "category": (category.strip().lower() if category else None),
    }

# ======= MODELS (Excel) =======

class ExcelChatRequest(BaseModel):
    question: str
    session_id: Optional[str] = None
    k: Optional[int] = 6
    mode: Optional[str] = "metadata"      # "metadata" or "workbook"
    category: Optional[str] = None        # "legal", "finance", or None

class ExcelChatResponse(BaseModel):
    answer: str
    sources: List[Dict[str, Any]]
    history: List[Dict[str, Any]]
    meta: Dict[str, Any]
    mode: str
    category: Optional[str]

# ======= ROUTES (Excel) =======

@app.get("/excel/metadata")
def excel_metadata(mode: str = "metadata"):
    mode = (mode or "metadata").strip().lower()
    if mode not in _EXCELS:
        raise HTTPException(400, f"Unknown Excel mode '{mode}'. Expected one of {list(_EXCELS.keys())}.")
    _ensure_excel_loaded(mode)
    cfg = _EXCELS[mode]
    return {
        "mode": mode,
        "path": cfg["meta"].get("path"),
        "mtime": cfg["meta"].get("mtime"),
        "sheets": cfg["meta"].get("sheets"),
        "rows": cfg["meta"].get("rows"),
        "last_loaded_at": cfg.get("last_loaded_at"),
    }

@app.post("/excel/chat", response_model=ExcelChatResponse)
def excel_chat(payload: ExcelChatRequest):
    if not payload.question or not payload.question.strip():
        raise HTTPException(400, "Missing question.")

    res = _excel_answer(
        question=payload.question.strip(),
        k=int(payload.k or 6),
        session_id=payload.session_id,
        mode=payload.mode or "metadata",
        category=payload.category,
    )

    return ExcelChatResponse(
        answer=res["answer"],
        sources=res["sources"],
        history=res["history"],
        meta=res["meta"],
        mode=res["mode"],
        category=res["category"],
    )

@app.post("/excel/refresh")
def excel_refresh(mode: str = "metadata"):
    mode = (mode or "metadata").strip().lower()
    if mode not in _EXCELS:
        raise HTTPException(400, f"Unknown Excel mode '{mode}'. Expected one of {list(_EXCELS.keys())}.")
    _build_excel_faiss(mode)
    cfg = _EXCELS[mode]
    return {"status": "ok", "mode": mode, "message": "Excel reloaded and indexed.", "meta": cfg["meta"]}

@app.get("/excel/history/{session_id}")
def get_excel_history(session_id: str):
    return {"session_id": session_id, "history": _EXCEL_HISTORY.get(session_id, [])}

@app.delete("/excel/history/{session_id}")
def clear_excel_history(session_id: str):
    _EXCEL_HISTORY.pop(session_id, None)
    return {"status": "ok", "session_id": session_id, "cleared": True}
