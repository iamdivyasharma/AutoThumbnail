def _format_docs(docs) -> str:
    return "\n\n".join(
        f"(client: {d.metadata.get('client_id')}, policy: {d.metadata.get('policy_id')}, page: {d.metadata.get('page','?')})\n{d.page_content}"
        for d in docs
    )

# ========= S3 helpers =========
def _is_s3_uri(path: Optional[str]) -> bool:
    return isinstance(path, str) and path.lower().startswith("s3://")

def _parse_s3_uri(uri: str) -> Tuple[str, str]:
    # s3://bucket/key...
    _, rest = uri.split("://", 1)
    bucket, key = rest.split("/", 1)
    return bucket, key

def _read_pdf_bytes(path_or_uri: str) -> bytes:
    if _is_s3_uri(path_or_uri):
        bkt, key = _parse_s3_uri(path_or_uri)
        obj = S3_CLIENT.get_object(Bucket=bkt, Key=key)
        return obj["Body"].read()
    else:
        p = Path(path_or_uri)
        return p.read_bytes()

# ========= Manifest / Documents =========
@app.get("/clients")
def api_list_clients() -> List[str]:
    return list_clients()

@app.get("/clients/{client_id}/documents")
def api_client_documents(client_id: str):
    """
    Reads the per-client manifest.json written by the indexer.
    No local-folder fallback (since PDFs live in S3 now).
    """
    cid = client_id.strip().lower()
    manifest = (FAISS_INDEX_DIR / cid / "manifest.json")
    if not manifest.exists():
        # Prefer failing fast so the UI tells you to (re)run the indexer
        return []
    data = json.loads(manifest.read_text())
    docs = []
    for d in data.get("docs", []):
        docs.append({
            "policy_id": d.get("policy_id"),
            "source_file": d.get("source_file"),  # may be s3://bucket/key
            "pages": d.get("pages"),
            "client_id": cid,
            "modified_time": d.get("modified_time"),
            "modified_iso": (None if not d.get("modified_time")
                             else __import__("datetime").datetime.fromtimestamp(d["modified_time"]).isoformat(timespec="seconds")),
        })
    return sorted(docs, key=lambda x: x["policy_id"])

def client_from_filename(name: str) -> str:
    stem = Path(name).stem  # drop .pdf
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()

# ========= Highlights (PyMuPDF exact search) =========
from difflib import SequenceMatcher

def _norm(s: str) -> str:
    return re.sub(r"\s+", " ", (s or "")).strip()

def _pick_phrases(answer: str, chunk_text: str, max_phrases: int = 3) -> list[str]:
    ans = _norm(answer).lower()
    phrases = []
    sentences = re.split(r"[.\n]+", chunk_text or "")
    for s in sentences:
        s2 = _norm(s)
        if len(s2) >= 30 and s2.lower() in ans:
            phrases.append(s2[:180])
            if len(phrases) >= max_phrases: return phrases
    for s in sentences:
        s2 = _norm(s)
        if len(s2) >= 40 and SequenceMatcher(None, s2.lower(), ans).quick_ratio() >= 0.65:
            phrases.append(s2[:180])
            if len(phrases) >= max_phrases: return phrases
    return phrases

def _ann_from_pdf_path_or_s3(path_or_uri: str, page_num: int, phrases: list[str]) -> list[dict]:
    """
    Open either a local path or an s3:// URI, then search & build highlight boxes.
    """
    ann = []
    try:
        pdf_bytes = _read_pdf_bytes(path_or_uri)
        with fitz.open(stream=pdf_bytes, filetype="pdf") as doc:
            if page_num < 1 or page_num > doc.page_count:
                return ann
            page = doc.load_page(page_num - 1)
            seen = set()
            for phrase in phrases:
                if len(_norm(phrase)) < 8:
                    continue
                for r in page.search_for(phrase):
                    key = (round(r.x0,1), round(r.y0,1), round(r.width,1), round(r.height,1))
                    if key in seen:
                        continue
                    seen.add(key)
                    ann.append({
                        "page": page_num,
                        "x": float(r.x0), "y": float(r.y0),
                        "width": float(r.width), "height": float(r.height),
                        "color": "yellow",
                    })
                    if len(ann) >= 30:
                        return ann
    except Exception:
        pass
    return ann

def _ann_from_ocr_words(meta: dict, phrases: list[str]) -> list[dict]:
    """
    Backward-compat: highlight OCR words if present (legacy indexes).
    The new indexer may not populate 'ocr_words'.
    """
    ann = []
    words = meta.get("ocr_words") or []
    if not words:
        return ann
    want = [re.sub(r"\s+", " ", (p or "").lower()).strip() for p in phrases if p]
    if not want:
        return ann
    for w in words:
        t = str(w.get("text", "")).lower().strip()
        if not t:
            continue
        if any(t in ph for ph in want) and all(k in w for k in ("x","y","width","height")):
            ann.append({
                "page": int(meta.get("page") or 1),
                "x": float(w["x"]), "y": float(w["y"]),
                "width": float(w["width"]), "height": float(w["height"]),
                "color": "yellow",
            })
        if len(ann) >= 60:
            break
    return ann

# ========= Ask =========
def _format_context(docs):
    return _format_docs(docs)

@app.post("/ask", response_model=AskResponse)
def ask(payload: AskRequest):
    available = list_clients()
    if not available:
        raise HTTPException(404, "No client indexes available. Build indexes first.")

    # Determine clients
    if payload.client_ids:
        requested = sorted({c.strip().lower() for c in payload.client_ids})
    else:
        requested = detect_clients_from_text(payload.question, available)
    if not requested:
        raise HTTPException(400, f"No client detected in the question. Mention a client name (e.g., {', '.join(available[:5])} ...)")

    invalid = [c for c in requested if c not in available]
    if invalid:
        raise HTTPException(404, f"Unknown client id(s): {invalid}. Available: {available}")

    # Params merge
    per_client_params = {c: choose_params(c) for c in requested}
    temperature = min(p["temperature"] for p in per_client_params.values())
    max_tokens  = max(p["max_tokens"]  for p in per_client_params.values())
    n_clients   = len(requested)
    per_cap     = max(1, math.ceil(MAX_COMBINED_K / n_clients))

    # Retrieve
    combined_docs = []
    for cid in requested:
        vs = _load_index(cid)
        k_yaml      = per_client_params[cid]["k"]
        k_effective = min(k_yaml, per_cap)
        retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k_effective})
        docs = retriever.get_relevant_documents(payload.question)
        # hard guard: keep only this client's docs
        docs = [d for d in docs if str(d.metadata.get("client_id", "")).strip().lower() == cid]
        combined_docs.extend(docs)

    if not combined_docs:
        raise HTTPException(404, f"No matching content for clients {requested}.")

    if len(combined_docs) > MAX_COMBINED_K:
        combined_docs = combined_docs[:MAX_COMBINED_K]

    context = _format_context(combined_docs)
    llm = ChatBedrockConverse(model_id=LLM_MODEL, client=SESSION.client("bedrock-runtime"),
                              temperature=temperature, max_tokens=max_tokens)
    chain = prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": payload.question, "context": context})

    # Build sources + annotations (supports local paths and s3:// URIs)
    sources = []
    for d in combined_docs:
        meta = d.metadata
        page_num = int(meta.get("page") or 1)
        path_or_uri = meta.get("source_file")

        phrases = _pick_phrases(answer, d.page_content, max_phrases=3)

        anns = []
        if path_or_uri:
            anns = _ann_from_pdf_path_or_s3(path_or_uri, page_num, phrases)
        if not anns and meta.get("ocr_words"):
            anns = _ann_from_ocr_words(meta, phrases)

        sources.append({
            "policy_id": meta.get("policy_id"),
            "page": page_num,
            "client_id": meta.get("client_id"),
            "source_file": path_or_uri,  # local or s3://
            "annotations": anns,
        })

    return AskResponse(answer=answer, used_clients=requested, sources=sources)
