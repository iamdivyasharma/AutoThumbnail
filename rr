# ============== Filters (hidden only for Direct→TDNA) ==============
def compose_filters_caption(fil: dict) -> str:
    return (f"{label_for(fil['ond']['origin'])} → {label_for(fil['ond']['destination'])} | "
            f"Start: {fil['start_date']} | End: {fil['end_date']} | Policy: {fil['policy_status']}")

show_filters = not (st.session_state.mode == "Direct tool" and st.session_state.target == "tdna")

if show_filters:
    with st.container():
        st.markdown("### 🔎 Filters")
        fcol1, fcol2, fcol3, fcol4, fcol5 = st.columns([1,1,1,1,1])

        with fcol1:
            origin_code = st.selectbox(
                "Origin",
                options=ORIGIN_OPTIONS,
                index=(ORIGIN_OPTIONS.index(st.session_state.filters["ond"]["origin"])
                       if st.session_state.filters["ond"]["origin"] in ORIGIN_OPTIONS else 0),
                format_func=label_for,
            )
        with fcol2:
            dest_code = st.selectbox(
                "Destination",
                options=DESTINATION_OPTIONS,
                index=(DESTINATION_OPTIONS.index(st.session_state.filters["ond"]["destination"])
                       if st.session_state.filters["ond"]["destination"] in DESTINATION_OPTIONS else 0),
                format_func=label_for,
            )
        with fcol3:
            start_default = date.fromisoformat(st.session_state.filters["start_date"])
            start_default = _snap_to_allowed(start_default, START_WHITELIST, direction="nearest")
            start_input = st.date_input(
                "Start date",
                value=start_default,
                min_value=START_WHITELIST[0],
                max_value=START_WHITELIST[-1],
                format="YYYY-MM-DD",
                key="start_date_picker",
            )
        with fcol4:
            end_default = date.fromisoformat(st.session_state.filters["end_date"])
            end_default = _snap_to_allowed(end_default, END_WHITELIST, direction="up", min_after=start_input)
            end_input = st.date_input(
                "End date",
                value=end_default,
                min_value=END_WHITELIST[0],
                max_value=END_WHITELIST[-1],
                format="YYYY-MM-DD",
                key="end_date_picker",
            )
        with fcol5:
            policy_input = st.selectbox(
                "Policy status",
                options=["In policy", "Out of policy"],
                index=["In policy", "Out of policy"].index(st.session_state.filters["policy_status"])
            )
            apply = st.button("Apply", use_container_width=True)
            clear = st.button("Clear", use_container_width=True)

        if apply:
            if origin_code == dest_code:
                st.warning("Origin and Destination cannot be the same.")

            chosen_start = start_input if isinstance(start_input, date) else START_WHITELIST[0]
            snapped_start = _snap_to_allowed(chosen_start, START_WHITELIST, direction="nearest")

            chosen_end = end_input if isinstance(end_input, date) else END_WHITELIST[-1]
            snapped_end = _snap_to_allowed(chosen_end, END_WHITELIST, direction="up", min_after=snapped_start)

            st.session_state.filters = {
                "ond": {"origin": origin_code, "destination": dest_code},
                "start_date": snapped_start.isoformat(),
                "end_date": snapped_end.isoformat(),
                "policy_status": policy_input,
            }

            # ---------- First-time-only Apply behavior ----------
            def _call_orchestrator(url: str, payload: dict, response_key: str):
                with st.chat_message("assistant"):
                    ph = st.empty()
                    ph.markdown("**Great! Agent is planning your trip…**")
                    with st.spinner("Processing…"):
                        status, data = post(url, payload)
                    raw_answer = data.get(response_key, "") if isinstance(data, dict) else str(data)
                    ph.markdown(str(raw_answer))
                sig = answer_sig(str(raw_answer), payload)
                if st.session_state.last_answer_hash != sig:
                    st.session_state.messages.append({"role": "assistant", "content": str(raw_answer)})
                    st.session_state.last_answer_hash = sig

            if st.session_state.mode == "Agentic AI":
                if not st.session_state.boot_agentic:
                    qtext = (
                        "Provide me the best flights for the given route from AIR bot and also provide "
                        "best/preferred hotels from HOTEL bot, and check traveller's past history from TDNA bot. "
                        f"[Filters] Origin: {origin_code}, Destination: {dest_code}, "
                        f"Start: {snapped_start.isoformat()}, End: {snapped_end.isoformat()}, Policy: {policy_input}"
                    )
                    payload = {
                        "query": qtext,
                        "session_id": st.session_state.session_id,
                        "targets": ["air", "hotel", "tdna"],
                        "extra": {
                            "user_name": st.session_state.user_name.strip(),
                            "user_email": st.session_state.user_email.strip(),
                            "filters": st.session_state.filters,
                            "ui_version": "new-ui-v1",
                            "source": "filters_apply",
                            "llm_hints": "Use conversation history; avoid repetition.",
                        },
                    }
                    _call_orchestrator(ROUTE_URL, payload, response_key="answer")
                    st.session_state.boot_agentic = True
                else:
                    st.info("Filters updated. They’ll be used for your next message.", icon="✅")

            else:
                if st.session_state.target == "hotel":
                    if not st.session_state.boot_hotel:
                        qtext = build_query_hotels_only(st.session_state.filters)
                        payload = {
                            "query": qtext,
                            "session_id": st.session_state.session_id,
                            "target": "hotel",
                            "extra": {
                                "user_name": st.session_state.user_name.strip(),
                                "user_email": st.session_state.user_email.strip(),
                                "filters": st.session_state.filters,
                                "ui_version": "new-ui-v1",
                                "source": "filters_apply",
                            },
                        }
                        _call_orchestrator(ROUTE_URL, payload, response_key="answer")
                        st.session_state.boot_hotel = True
                    else:
                        st.info("Filters updated. They’ll be used for your next message.", icon="✅")

                elif st.session_state.target == "air":
                    if not st.session_state.boot_air:
                        qtext = build_query_flights_only(st.session_state.filters)
                        payload = {
                            "query": qtext,
                            "session_id": st.session_state.session_id,
                            "target": "air",
                            "extra": {
                                "user_name": st.session_state.user_name.strip(),
                                "user_email": st.session_state.user_email.strip(),
                                "filters": st.session_state.filters,
                                "ui_version": "new-ui-v1",
                                "source": "filters_apply",
                            },
                        }
                        _call_orchestrator(ROUTE_URL, payload, response_key="answer")
                        st.session_state.boot_air = True
                    else:
                        st.info("Filters updated. They’ll be used for your next message.", icon="✅")

                else:
                    st.info("TDNA does not use filters. Please type directly in chat.", icon="ℹ️")

        if clear:
            st.session_state.filters = {
                "ond": {"origin": ORIGIN_OPTIONS[0], "destination": DESTINATION_OPTIONS[0]},
                "start_date": START_WHITELIST[0].isoformat(),
                "end_date": END_WHITELIST[-1].isoformat(),
                "policy_status": "In policy",
            }
            st.info("Filters cleared.")

        st.caption("Active filters → " + compose_filters_caption(st.session_state.filters))
else:
    st.info("Filters are not available when using TDNA directly. Switch to Agentic AI or a different tool to apply filters.")

# ================== Chat transcript (oldest → newest) ==================
for m in st.session_state.messages:
    with st.chat_message(m["role"]):
        st.markdown(m["content"])

# ================== Chat input ==================
prompt = st.chat_input("Type a message and press Enter…")
if prompt:
    # show user message now
    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    # build extra (include filters always; TDNA may ignore)
    extra = {
        "user_name": st.session_state.user_name.strip(),
        "user_email": st.session_state.user_email.strip(),
        "filters": {
            "ond": {
                "origin": st.session_state.filters["ond"]["origin"],
                "destination": st.session_state.filters["ond"]["destination"],
            },
            "start_date": st.session_state.filters["start_date"],
            "end_date": st.session_state.filters["end_date"],
            "policy_status": st.session_state.filters["policy_status"],
        },
        "ui_version": "new-ui-v1"
    }

    try:
        if st.session_state.mode == "Agentic AI":
            payload = {
                "query": prompt.strip(),
                "session_id": st.session_state.session_id,  # keep stable across turns!
                "autonomy": st.session_state.autonomy,
                "max_iters": st.session_state.max_iters,
                "extra": extra,
            }
            with st.chat_message("assistant"):
                with st.spinner("Processing…"):
                    status, data = post(AGENT_URL, payload)
                final_answer = data.get("final_answer", "") if isinstance(data, dict) else str(data)
                st.markdown(final_answer)

        else:
            target = st.session_state.target
            payload = {
                "query": prompt.strip(),
                "target": target,
                "session_id": st.session_state.session_id,  # no tool suffix → preserves context
                "extra": extra,
            }
            with st.chat_message("assistant"):
                with st.spinner("Processing…"):
                    status, data = post(ROUTE_URL, payload)
                final_answer = data.get("answer", "") if isinstance(data, dict) else str(data)
                st.markdown(final_answer)

        sig = answer_sig(final_answer, payload)
        if st.session_state.last_answer_hash != sig:
            st.session_state.messages.append({"role": "assistant", "content": final_answer})
            st.session_state.last_answer_hash = sig

    except Exception as e:
        err = f"Request error: {e}"
        with st.chat_message("assistant"):
            st.error(err)
        st.session_state.messages.append({"role": "assistant", "content": err})

# footer
st.markdown("---")
st.caption("Conversational Orchestrator UI — history persists per user until you switch users or start a new chat.")
