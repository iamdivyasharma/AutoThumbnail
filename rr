def ragbot(payload):
    """
    payload: {
      "username": str,
      "email": str,
      "query": str,
      "reset_history": bool (optional)
    }
    returns: {"answer": str, "sources": [str], "username": str, "email": str, "history_len": int}
    """
    # ---------- lazy one-time init ----------
    if not hasattr(ragbot, "_bootstrapped"):
        import os, hashlib
        import boto3
        from dotenv import load_dotenv, find_dotenv
        load_dotenv(find_dotenv())

        # LangChain bits
        from langchain_core.messages import AIMessage, HumanMessage
        from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder
        from langchain.chains import create_history_aware_retriever, create_retrieval_chain
        from langchain.chains.combine_documents import create_stuff_documents_chain

        # *** AWS Bedrock models ***
        # pip install langchain-aws boto3
        from langchain_aws.chat_models import BedrockChat
        from langchain_aws.embeddings import BedrockEmbeddings

        # Vector store (swap to FAISS/PGVector/etc. if you prefer)
        # pip install langchain-chroma chromadb
        from langchain_chroma import Chroma

        # ---- AWS / Bedrock config
        region = os.getenv("BEDROCK_REGION", "us-east-1")
        bedrock = boto3.client("bedrock-runtime", region_name=region)

        # Claude 3 Haiku (Bedrock)
        ragbot._LLM = BedrockChat(
            client=bedrock,
            model_id=os.getenv(
                "BEDROCK_CLAUDE_MODEL_ID",
                "anthropic.claude-3-haiku-20240307-v1:0"
            ),
            temperature=0.1,
            max_tokens=None,  # let Anthropic decide; set if you want hard caps
        )

        # Amazon Titan Embeddings (Bedrock)
        ragbot._EMBEDDINGS = BedrockEmbeddings(
            client=bedrock,
            model_id=os.getenv(
                "BEDROCK_TITAN_EMBED_MODEL_ID",
                "amazon.titan-embed-text-v2:0"
            ),
        )

        # ---- Vector store / retriever
        ragbot._VECTORSTORE = Chroma(
            collection_name=os.getenv("CHROMA_COLLECTION", "ragbot"),
            embedding_function=ragbot._EMBEDDINGS,
            persist_directory=os.getenv("CHROMA_DIR", ".chroma"),
        )
        ragbot._RETRIEVER = ragbot._VECTORSTORE.as_retriever(
            search_kwargs={"k": int(os.getenv("TOP_K", "4"))}
        )

        # ---- Prompts
        ragbot._CONDENSE_PROMPT = ChatPromptTemplate.from_messages(
            [
                ("system",
                 "Rewrite the latest user question into a standalone query using chat history. "
                 "Do NOT answer; return only the rewritten query."),
                MessagesPlaceholder("chat_history"),
                ("human", "{input}"),
            ]
        )
        ragbot._QA_PROMPT = ChatPromptTemplate.from_messages(
            [
                ("system",
                 "You are a helpful assistant. Use ONLY the provided context to answer. "
                 "If the answer is not in the context, say you don't know.\n\n"
                 "CONTEXT:\n{context}"),
                MessagesPlaceholder("chat_history"),
                ("human", "{input}"),
            ]
        )

        # ---- Chains
        ragbot._HISTORY_AWARE_RETRIEVER = create_history_aware_retriever(
            ragbot._LLM, ragbot._RETRIEVER, ragbot._CONDENSE_PROMPT
        )
        ragbot._QA_CHAIN = create_stuff_documents_chain(
            llm=ragbot._LLM, prompt=ragbot._QA_PROMPT
        )
        ragbot._RAG_CHAIN = create_retrieval_chain(
            ragbot._HISTORY_AWARE_RETRIEVER, ragbot._QA_CHAIN
        )

        # ---- Per-identity in-memory history
        ragbot._HISTORY = {}  # key -> [HumanMessage, AIMessage, ...]
        ragbot._MAX_TURNS = int(os.getenv("MAX_TURNS", "20"))
        ragbot._AIMessage = AIMessage
        ragbot._HumanMessage = HumanMessage
        ragbot._bootstrapped = True

    # ---------- helpers ----------
    def _identity_key(username: str, email: str) -> str:
        u = (username or "unknown").strip().lower()
        e = (email or "unknown").strip().lower()
        return f"u:{u}|e:{e}"

    def _get_history(key: str):
        return list(ragbot._HISTORY.get(key, []))

    def _append_turn(key: str, human: str, ai: str):
        msgs = ragbot._HISTORY.setdefault(key, [])
        msgs.extend([ragbot._HumanMessage(content=human), ragbot._AIMessage(content=ai)])
        if len(msgs) > ragbot._MAX_TURNS * 2:
            ragbot._HISTORY[key] = msgs[-ragbot._MAX_TURNS * 2:]

    def _reset_history(key: str):
        ragbot._HISTORY[key] = []

    # ---------- request handling ----------
    username = (payload.get("username") or payload.get("user_name") or "").strip()
    email = (payload.get("email") or "").strip()
    query = (payload.get("query") or "").strip()
    force_reset = bool(payload.get("reset_history", False))

    if not query:
        return {"error": "query is required"}

    key = _identity_key(username, email)
    if force_reset:
        _reset_history(key)

    chat_history = _get_history(key)

    # ---------- RAG invoke ----------
    try:
        result = ragbot._RAG_CHAIN.invoke({"input": query, "chat_history": chat_history})
        answer = result.get("answer", "")
        docs = result.get("context", []) or []

        _append_turn(key, query, answer)

        # collect source strings
        sources, seen = [], set()
        for d in docs:
            meta = getattr(d, "metadata", {}) or {}
            src = meta.get("source") or meta.get("url") or meta.get("path")
            if src and src not in seen:
                sources.append(src); seen.add(src)

        return {
            "username": username,
            "email": email,
            "answer": answer,
            "sources": sources,
            "history_len": len(ragbot._HISTORY.get(key, [])),
        }
    except Exception as e:
        return {"username": username, "email": email, "error": f"RAG chain failed: {e}"}
