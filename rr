#!/usr/bin/env python3
import pandas as pd

INPUT  = "client_clause_matrix.xlsx"
OUTPUT = "ahaooob_clients_yes_by_clause.xlsx"

df = pd.read_excel(INPUT)

# keep only "Yes" rows (case/space safe)
yes_df = df[df["Clause Status"].astype(str).str.strip().str.lower() == "yes"]

# group clause-wise and list unique client names (comma-separated)
def clients_for_clause(g: pd.DataFrame) -> str:
    names = (g["Client Name"]
             .dropna()
             .astype(str)
             .str.strip()
             .unique())
    return ", ".join(sorted(names, key=str.lower))

out = (
    yes_df.groupby("Clauses", as_index=False)
          .apply(clients_for_clause)
          .rename(columns={None: "Clients (Clause Status = Yes)"})
          [["Clauses", "Clients (Clause Status = Yes)"]]
)

out.to_excel(OUTPUT, index=False)
print(f"Saved: {OUTPUT}")
