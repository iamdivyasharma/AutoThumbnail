# ================== Allowed dates (START whitelist) ==================
ALLOWED_START_DATES = [
    "2025-09-01", "2025-09-05", "2025-09-08", "2025-09-10", "2025-10-01"
]

def _iso_to_dates(xs):
    return sorted(date.fromisoformat(x) if isinstance(x, str) else x for x in xs)

START_WHITELIST = _iso_to_dates(ALLOWED_START_DATES)

def _snap_to_allowed(chosen: date, allowed: list[date], direction="nearest") -> date:
    if not allowed:
        return chosen
    if direction == "up":
        for d in allowed:
            if d >= chosen:
                return d
        return allowed[-1]
    if direction == "down":
        for d in reversed(allowed):
            if d <= chosen:
                return d
        return allowed[0]
    return min(allowed, key=lambda d: abs(d - chosen))

