from typing import Optional
from langchain_openai import ChatOpenAI
from langchain.chains import RetrievalQA
from langchain.memory import ConversationBufferMemory
from langchain.prompts import PromptTemplate

# ---- your retriever & llm (replace retriever with your own) ----
retriever = ...  # e.g. vectorstore.as_retriever(search_kwargs={"k": 4})
llm = ChatOpenAI(model="gpt-4")

# ---- prompt passed via chain_type_kwargs ----
RAG_TEMPLATE = """You are a helpful assistant.
Use the retrieved context to answer the user's question. If the answer is not in the context, say you don't know.

# Chat history (most recent last)
{chat_history}

# Retrieved context
{context}

# Question
{question}

# Instructions
- Be concise and accurate.
- If the question depends on prior turns, use the chat history.
Answer:
"""
RAG_PROMPT = PromptTemplate(
    template=RAG_TEMPLATE,
    input_variables=["chat_history", "context", "question"],
)

# ---- single active memory that resets when user changes ----
_current_user: Optional[str] = None
_memory: Optional[ConversationBufferMemory] = None

def _get_memory_for(user_name: str) -> ConversationBufferMemory:
    """Keep memory if same user; reset when user changes."""
    global _current_user, _memory
    if _current_user != user_name or _memory is None:
        _current_user = user_name
        _memory = ConversationBufferMemory(
            memory_key="chat_history",
            return_messages=True,
        )
    return _memory

def _build_chain(memory: ConversationBufferMemory) -> RetrievalQA:
    return RetrievalQA.from_chain_type(
        llm=llm,
        chain_type="stuff",
        retriever=retriever,
        memory=memory,
        chain_type_kwargs={"prompt": RAG_PROMPT},
        return_source_documents=True,
    )

# ---- your handler that receives a payload with user_name ----
def handle_rag_request(payload: dict):
    """
    Expected payload:
      {
        "user_name": "alice",
        "query": "your question here"
      }
    """
    user_name = payload.get("user_name") or "anonymous"
    query = payload.get("query") or payload.get("question") or ""

    memory = _get_memory_for(user_name)
    qa = _build_chain(memory)
    return qa.invoke({"query": query})
