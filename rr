#!/usr/bin/env python3
"""
Create a fresh Excel sheet of (Client Name, Clauses, Sub Clauses, Clause Status)
by querying a client-scoped RAG (FAISS + Bedrock). No input Excel required.

- Discovers clients from FAISS_INDEX_DIR/<client>/ (must contain index.faiss + index.pkl).
- For each client and each (Clause -> list[Sub Clause]) in CLAUSES:
    * Query = "Clause + SubClause"
    * Retrieve context from that client's FAISS
    * Classify Clause Status as: Yes / No / Partial (ONLY from provided context)
- Saves OUTPUT_XLSX with columns:
    Client Name | Clauses | Sub Clauses | Clause Status

Dependencies:
  pip install -U pandas openpyxl "langchain-aws>=0.2.5" "langchain-community" "boto3>=1.34" faiss-cpu
"""

from __future__ import annotations

import os
import re
from pathlib import Path
from typing import List, Dict, Any, Optional

import pandas as pd
from boto3 import Session
from langchain_aws import BedrockEmbeddings, ChatBedrock
from langchain_community.vectorstores import FAISS
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser

# ===================== EDIT THESE =====================
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()     # <-- set your FAISS root
OUTPUT_XLSX     = Path("./client_clause_matrix.xlsx").resolve()    # <-- destination workbook

# Define your clauses with MULTIPLE sub-clauses each
# Example structure:
CLAUSES: Dict[str, List[str]] = {
    "Data Management": [
        "Data retention duration and deletion timelines",
        "Data storage location and encryption at rest",
        "Processing purposes and lawful bases",
        "Data sharing and onward transfer restrictions",
        "Responsibilities for incident response",
    ],
    "Data Suppression": [
        "Opt-out process and suppression triggers",
        "Suppression propagation timelines across systems",
        "Audit trail / logging for suppression events",
    ],
    "Data Restrictions": [
        "Prohibited uses (advertising / combining datasets)",
        "Geographic restrictions or BU limitations",
        "Access controls and least privilege",
    ],
    "Data Consent": [
        "Consent withdrawal process and records",
        "Renewal / re-consent cadence",
        "Sensitive categories / age gating",
    ],
    # Add more clauses with lists of sub-clauses...
}

# AWS (for local testing only — prefer IAM roles in prod)
AWS_REGION = os.getenv("AWS_REGION", "us-east-1")
AWS_ACCESS_KEY_ID     = os.getenv("AWS_ACCESS_KEY_ID", "YOUR_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.getenv("AWS_SECRET_ACCESS_KEY", "YOUR_SECRET_ACCESS_KEY")

# Models
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# Retrieval / generation
K_PER_CLIENT = 6
MAX_TOKENS   = 700
TEMPERATURE  = 0.2

# Valid statuses
VALID_STATUSES = {"yes", "no", "partial"}

# ===================== Prompt (JSON classification) =====================
PROMPT_CLASSIFY = ChatPromptTemplate.from_messages([
    ("system",
     "You are a precise, client-scoped contract assistant. Use ONLY the Provided Context.\n"
     "Task: Decide if the SPECIFIC sub-clause exists or is satisfied in the client's documents.\n"
     "Return SINGLE-LINE JSON ONLY: {\"status\":\"Yes|No|Partial\"}.\n"
     "- 'Yes'     = clear, specific evidence the sub-clause is present/affirmed.\n"
     "- 'No'      = clear, specific evidence it is absent/contradicted or not found.\n"
     "- 'Partial' = some evidence but incomplete/ambiguous/conditional.\n"
     "DO NOT add code fences or any extra text; JSON only."
    ),
    ("human",
     "Client: {client_id}\n"
     "Clause: {clause}\n"
     "Sub-Clause: {subclause}\n\n"
     "Provided Context (from client PDFs):\n{context}\n\n"
     "Classify status now. Output JSON only.")
])

# ===================== Helpers =====================
def list_clients_from_faiss(root: Path) -> List[str]:
    if not root.exists():
        return []
    out = []
    for p in root.iterdir():
        if p.is_dir() and not p.name.startswith(".") and (p / "index.faiss").exists() and (p / "index.pkl").exists():
            out.append(p.name)
    return sorted(out)

def load_vs_for_client(client_id: str, session: Session) -> Optional[FAISS]:
    path = FAISS_INDEX_DIR / client_id
    if not (path / "index.faiss").exists():
        return None
    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=session.client("bedrock-runtime"))
    return FAISS.load_local(str(path), emb, allow_dangerous_deserialization=True)

def format_docs(docs) -> str:
    # Compact but traceable
    return "\n\n".join(
        f"(client: {d.metadata.get('client_id')}, policy: {d.metadata.get('policy_id')}, page: {d.metadata.get('page','?')})\n{d.page_content}"
        for d in docs
    )

def retrieve_context_for(session: Session, client_id: str, clause: str, subclause: str) -> str:
    vs = load_vs_for_client(client_id, session)
    if not vs:
        return ""
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": K_PER_CLIENT})
    query = f"{clause} + {subclause}"  # <- clause + sub-clause
    docs = retriever.get_relevant_documents(query)
    # strict client guard
    docs = [d for d in docs if str(d.metadata.get("client_id", "")).strip().lower() == client_id.strip().lower()]
    if not docs:
        return ""
    return format_docs(docs)

def classify_status(session: Session, client_id: str, clause: str, subclause: str, context: str) -> str:
    """Return 'Yes' / 'No' / 'Partial'."""
    llm = ChatBedrock(
        client=session.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={"temperature": float(TEMPERATURE), "max_tokens": int(MAX_TOKENS)},
    )
    chain = PROMPT_CLASSIFY | llm | StrOutputParser()
    try:
        raw = chain.invoke({
            "client_id": client_id,
            "clause": clause,
            "subclause": subclause,
            "context": (context or "(no matching context found)"),
        }).strip()
        # strip accidental fences/backticks
        raw = raw.strip().strip("`")
        m = re.search(r'"status"\s*:\s*"(?P<v>yes|no|partial)"', raw, flags=re.I)
        if m:
            v = m.group("v").strip().lower()
            if v in VALID_STATUSES:
                return v.capitalize()
    except Exception:
        pass
    # Fallback policy:
    # - If no context at all was retrieved -> "No" (not found).
    # - If parse failed but we had some context -> "Partial" (ambiguous).
    return "No" if not context else "Partial"

def build_matrix(session: Session) -> pd.DataFrame:
    clients = list_clients_from_faiss(FAISS_INDEX_DIR)
    if not clients:
        raise SystemExit(f"No clients found under {FAISS_INDEX_DIR}")

    rows: List[Dict[str, Any]] = []
    for client_id in clients:
        print(f"=== {client_id} ===")
        for clause, subclauses in CLAUSES.items():
            # de-dup and keep order
            seen = set()
            ordered_subs = [s for s in subclauses if not (s in seen or seen.add(s))]
            for subclause in ordered_subs:
                print(f"  - {clause} :: {subclause} ...", end="", flush=True)
                context = retrieve_context_for(session, client_id, clause, subclause)
                status  = classify_status(session, client_id, clause, subclause, context)
                rows.append({
                    "Client Name":   client_id,
                    "Clauses":       clause,
                    "Sub Clauses":   subclause,
                    "Clause Status": status,   # Yes / No / Partial
                })
                print(f" {status}.")
    return pd.DataFrame(rows, columns=["Client Name", "Clauses", "Sub Clauses", "Clause Status"])

# ===================== Main =====================
def main():
    # AWS session
    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    df = build_matrix(session)
    OUTPUT_XLSX.parent.mkdir(parents=True, exist_ok=True)
    df.to_excel(OUTPUT_XLSX, index=False)
    print(f"\nSaved: {OUTPUT_XLSX}")

if __name__ == "__main__":
    main()
