# --- 1) Custom prompt for the "stuff" chain_type via chain_type_kwargs ---
# Note the input variables: "context" and "question" are standard for RetrievalQA(stuff),
# and we ALSO add "chat_history" so the memory can inject past turns.
RAG_TEMPLATE = """You are a helpful assistant.
Use the retrieved context to answer the user's question. If the answer is not in the context, say you don't know.

# Chat history (most recent last)
{chat_history}

# Retrieved context
{context}

# Question
{question}

# Instructions
- Be concise and accurate.
- If the question depends on prior turns, use the chat history.
- Cite only if sources are provided by the system.
Answer:
"""

RAG_PROMPT = PromptTemplate(
    template=RAG_TEMPLATE,
    input_variables=["chat_history", "context", "question"],
)

# --- 2) Simple per-user memory registry ---
class MemoryRegistry:
    """Keeps a ConversationBufferMemory per user_name."""
    def __init__(self):
        self._memories = {}

    def for_user(self, user_name: str) -> ConversationBufferMemory:
        if user_name not in self._memories:
            self._memories[user_name] = ConversationBufferMemory(
                memory_key="chat_history",
                return_messages=True,
            )
        return self._memories[user_name]

    def reset_user(self, user_name: str):
        self._memories[user_name] = ConversationBufferMemory(
            memory_key="chat_history",
            return_messages=True,
        )

memory_registry = MemoryRegistry()

# --- 3) Factory to build a RetrievalQA chain with user-scoped memory ---
def build_user_scoped_qa_chain(user_name: str) -> RetrievalQA:
    memory = memory_registry.for_user(user_name)
    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        chain_type="stuff",
        retriever=retriever,
        memory=memory,  # <- memory is attached to the chain
        chain_type_kwargs={"prompt": RAG_PROMPT},  # <- custom prompt injected here
        return_source_documents=True,
    )
    return qa_chain

# --- 4) Example usage ---
def answer_question(user_name: str, question: str):
    """
    If the same user_name calls this repeatedly, their chat history is retained.
    If you pass a different user_name, that user gets a fresh memory by default.
    """
    qa = build_user_scoped_qa_chain(user_name)
    # RetrievalQA expects {"query": "..."} as input
    result = qa.invoke({"query": question})
    return result

# --- 5) Optional: explicit refresh when you detect a different user ---
# If you truly want to *force* clearing memory when a user changes identity
# within the same session (instead of separate memories per user), you can:
def answer_question_switching_users(current_user: str, previous_user: str | None, question: str):
    if previous_user is not None and current_user != previous_user:
        # "refresh" the current user's memory (fresh buffer)
        memory_registry.reset_user(current_user)

    qa = build_user_scoped_qa_chain(current_user)
    return qa.invoke({"query": question})
