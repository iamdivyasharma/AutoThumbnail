#!/usr/bin/env python3
"""
build_metadata_excel.py

Scan all manifest.json files under FAISS_INDEX_DIR and build a single
Excel file (data/metadata.xlsx) where each row = one document entry,
including all fields from the nested `metadata` dict.

Works for both:
  /faiss_indices/legal/<client>/manifest.json
  /faiss_indices/finance/<client>/<country>/manifest.json
"""

from __future__ import annotations

import json
from pathlib import Path
from typing import Dict, Any, List, Optional

import pandas as pd

# ⚠️ EDIT THIS to match your indexer + app3.py
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()
OUT_XLSX        = Path("data/metadata.xlsx").resolve()


def parse_client_scope(category: Optional[str], client_id: Optional[str]) -> Dict[str, Optional[str]]:
    """
    category: "legal" or "finance"
    client_id from manifest.json, e.g.:
      - legal:   "clienta"
      - finance: "clientx/us"
    Return {client_name, country}.
    """
    if not client_id:
        return {"client_name": None, "country": None}

    cid = str(client_id)
    if category == "finance":
        parts = cid.split("/")
        if len(parts) >= 2:
            return {"client_name": parts[0], "country": parts[1]}
        else:
            return {"client_name": parts[0], "country": None}
    else:
        # legal or anything else: just a single name
        return {"client_name": cid, "country": None}


def collect_rows() -> List[Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []

    # Find every manifest.json under FAISS_INDEX_DIR (including nested dirs)
    for manifest_path in FAISS_INDEX_DIR.rglob("manifest.json"):
        data = json.loads(manifest_path.read_text())

        category   = data.get("category")
        client_id  = data.get("client_id")
        docs       = data.get("docs", [])
        scope      = parse_client_scope(category, client_id)

        for d in docs:
            base = {
                "category": category,
                "client_id": client_id,
                "client_name": scope["client_name"],
                "country": scope["country"],
                "policy_id": d.get("policy_id"),
                "source_file": d.get("source_file"),
                "pages": d.get("pages"),
                "modified_time": d.get("modified_time"),
            }
            meta = d.get("metadata") or {}
            # Merge base fields + ALL metadata fields
            row = {**base, **meta}
            rows.append(row)

    return rows


def main():
    OUT_XLSX.parent.mkdir(parents=True, exist_ok=True)

    rows = collect_rows()
    if not rows:
        print(f"No manifest.json docs found under {FAISS_INDEX_DIR}")
        return

    df = pd.DataFrame(rows)
    print(f"Collected {len(df)} rows from manifests.")

    # Bring core columns to the front; leave all metadata fields after them
    front_cols = [
        "category",
        "client_id",
        "client_name",
        "country",
        "policy_id",
        "source_file",
        "pages",
        "modified_time",
    ]
    cols = front_cols + [c for c in df.columns if c not in front_cols]
    df = df[cols]

    df.to_excel(OUT_XLSX, index=False)
    print(f"Wrote metadata Excel to {OUT_XLSX}")


if __name__ == "__main__":
    main()
