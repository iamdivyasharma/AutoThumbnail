from __future__ import annotations

import os
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import pandas as pd
import boto3
from rapidfuzz import fuzz, process

from services.utils import normalize_text, safe_json_load
from services.llm_parser import build_llm, parse_query_with_llm


@dataclass
class ResolvedTarget:
    client_name: Optional[str] = None
    country: Optional[str] = None
    cid: Optional[str] = None
    cap_id: Optional[str] = None
    category: Optional[str] = None
    requested_fields: Optional[List[str]] = None


class MetadataService:
    """
    Production-friendly Metadata Lookup service.

    - Loads Excel once at startup
    - Scans FAISS index folders to find manifest.json files
    - Answers natural-language lookups with optional LLM parsing
    - Maintains simple in-memory session memory
    """

    def __init__(
        self,
        faiss_index_dir: str,
        excel_path: str,
        excel_sheet: Optional[str] = None,
        enable_llm_query_parser: bool = True,
        default_category: str = "finance",
        max_docs_per_scope: int = 50,
    ):
        self.faiss_index_dir = Path(faiss_index_dir).resolve()
        self.excel_path = Path(excel_path).resolve()
        self.excel_sheet = excel_sheet
        self.enable_llm_query_parser = bool(enable_llm_query_parser)
        self.default_category = (default_category or "finance").strip().lower()
        self.max_docs_per_scope = int(max_docs_per_scope)

        self._df: Optional[pd.DataFrame] = None
        self._schema_fields: List[str] = []

        self._col_cid: Optional[str] = None
        self._col_country: Optional[str] = None
        self._col_client_name: Optional[str] = None

        # Client-name index for fuzzy matching
        self._client_name_choices: List[str] = []
        self._client_name_to_rows: Dict[str, List[int]] = {}

        # Scope manifests found on disk
        self._scopes: List[Dict[str, Any]] = []

        # Session memory (simple)
        self._memory: Dict[str, Dict[str, Any]] = {}

        # Optional LLM client
        self._llm = None

        self._startup_load()

    # --------------------- startup ---------------------

    def _startup_load(self) -> None:
        self._load_excel()
        self._scan_scopes()
        self._init_llm()

    def _init_llm(self) -> None:
        if not self.enable_llm_query_parser:
            self._llm = None
            return

        region = os.getenv("AWS_REGION", "us-east-1")
        llm_model = os.getenv("BEDROCK_LLM_MODEL", "anthropic.claude-3-5-sonnet-20240620-v1:0")

        # boto3 picks up creds from:
        # - SageMaker role (recommended)
        # - or env vars AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
        sess = boto3.Session(region_name=region)
        bedrock_client = sess.client("bedrock-runtime")

        self._llm = build_llm(model_id=llm_model, client=bedrock_client)

    @staticmethod
    def _find_col(df: pd.DataFrame, candidates: List[str]) -> Optional[str]:
        cols = {normalize_text(str(c)): str(c) for c in df.columns}
        for cand in candidates:
            key = normalize_text(cand)
            if key in cols:
                return cols[key]
        return None

    def _load_excel(self) -> None:
        if not self.excel_path.exists():
            raise RuntimeError(f"Excel file not found: {self.excel_path}")

        frames = pd.read_excel(self.excel_path, sheet_name=None)
        if not frames:
            raise RuntimeError(f"Excel has no sheets: {self.excel_path}")

        if self.excel_sheet and self.excel_sheet in frames:
            df = frames[self.excel_sheet]
        else:
            # first sheet
            first_sheet = list(frames.keys())[0]
            df = frames[first_sheet]

        df = df.copy()
        df.columns = [str(c) for c in df.columns]

        # Detect your main columns (flexible)
        self._col_cid = self._find_col(df, ["cid", "client id", "client_id", "capid", "cap id", "cap_id"])
        self._col_country = self._find_col(df, ["country__c", "country", "country code", "country_code"])
        self._col_client_name = self._find_col(df, ["parent_hq", "client name", "client_name", "account_name", "ultimate parent"])

        if not self._col_client_name:
            raise RuntimeError(
                "Could not detect a client name column. Expected something like parent_hq/client_name/account_name"
            )
        if not self._col_country:
            raise RuntimeError("Could not detect a country column. Expected something like country__c/country")

        # Ensure string columns
        for c in df.columns:
            if df[c].dtype == object:
                df[c] = df[c].fillna("")

        self._df = df
        self._schema_fields = list(df.columns)

        # Build fuzzy index
        self._client_name_choices = []
        self._client_name_to_rows = {}
        for idx, row in df.iterrows():
            name = str(row.get(self._col_client_name, "")).strip()
            if not name:
                continue
            n = normalize_text(name)
            if not n:
                continue
            if n not in self._client_name_to_rows:
                self._client_name_choices.append(n)
                self._client_name_to_rows[n] = []
            self._client_name_to_rows[n].append(int(idx))

    # --------------------- FAISS scope scanning ---------------------

    def _scan_scopes(self) -> None:
        scopes: List[Dict[str, Any]] = []
        root = self.faiss_index_dir
        if not root.exists():
            self._scopes = []
            return

        for dirpath, dirnames, filenames in os.walk(root):
            if "manifest.json" not in filenames:
                continue
            p = Path(dirpath)
            try:
                rel = p.relative_to(root).as_posix()  # e.g. finance/clientx/us
            except Exception:
                rel = p.name

            parts = rel.split("/")
            category = parts[0] if parts else ""

            scopes.append({
                "scope_id": rel.lower(),
                "category": category.lower(),
                "path": str(p),
                "manifest": str(p / "manifest.json"),
            })

        self._scopes = sorted(scopes, key=lambda x: x["scope_id"])

    # --------------------- public helpers ---------------------

    def get_schema(self) -> Dict[str, Any]:
        return {
            "excel_path": str(self.excel_path),
            "sheet": self.excel_sheet,
            "excel_fields": self._schema_fields,
            "detected_columns": {
                "client_name": self._col_client_name,
                "country": self._col_country,
                "cid": self._col_cid,
            },
        }

    def get_session_memory(self, session_id: str) -> Dict[str, Any]:
        return self._memory.get(session_id, {})

    def clear_session_memory(self, session_id: str) -> None:
        self._memory.pop(session_id, None)

    # --------------------- query parsing ---------------------

    @staticmethod
    def _extract_id_tokens(query: str) -> Dict[str, Optional[str]]:
        q = query or ""
        # pick 4-8 digit sequences as possible client ids
        m = re.search(r"\b(\d{4,10})\b", q)
        cid = m.group(1) if m else None

        cap = None
        m2 = re.search(r"cap\s*id\s*[:=]?\s*(\d{4,10})", q, flags=re.I)
        if m2:
            cap = m2.group(1)

        return {"cid": cid, "cap_id": cap}

    def _parse_query(self, query: str) -> Dict[str, Any]:
        # Simple heuristic fallback
        obj: Dict[str, Any] = {
            "intent": "lookup",
            "client_name_raw": None,
            "client_name_hint": None,
            "country": None,
            "fields": [],
            "identifiers": self._extract_id_tokens(query),
        }

        if not self.enable_llm_query_parser or self._llm is None:
            return obj

        # Call LLM parser (deterministic prompt -> JSON)
        client_samples = [
            self._df.iloc[i][self._col_client_name]  # type: ignore[index]
            for i in range(min(25, len(self._df or [])))
        ]
        countries = sorted({str(x).upper() for x in (self._df[self._col_country].dropna().unique().tolist() if self._df is not None else [])})

        parsed = parse_query_with_llm(
            query=query,
            schema_fields=self._schema_fields,
            countries=countries,
            client_samples=[str(x) for x in client_samples if str(x).strip()],
            llm=self._llm,
        )

        if not parsed:
            return obj

        # Merge safely
        obj.update({k: parsed.get(k) for k in ["client_name_raw", "client_name_hint", "country", "fields", "identifiers"] if k in parsed})
        if not obj.get("identifiers"):
            obj["identifiers"] = self._extract_id_tokens(query)

        return obj

    # --------------------- Excel matching ---------------------

    def _match_rows_by_id(self, cid: Optional[str], country: Optional[str]) -> List[int]:
        if self._df is None or not self._col_cid:
            return []
        if not cid:
            return []

        df = self._df
        col_cid = self._col_cid
        col_country = self._col_country

        cid_norm = str(cid).strip()
        # exact string match
        mask = df[col_cid].astype(str).str.strip().eq(cid_norm)
        if country:
            ctry = str(country).strip().upper()
            mask = mask & df[col_country].astype(str).str.upper().eq(ctry)

        return df.index[mask].astype(int).tolist()

    def _match_rows_by_name(self, client_name: str, country: Optional[str], top_k: int) -> List[Tuple[int, int]]:
        """Return list of (row_index, score)."""
        if self._df is None:
            return []
        if not client_name:
            return []

        name_norm = normalize_text(client_name)
        if not name_norm:
            return []

        # RapidFuzz: match against normalized unique client names
        matches = process.extract(
            query=name_norm,
            choices=self._client_name_choices,
            scorer=fuzz.WRatio,
            limit=max(10, top_k * 3),
        )

        out: List[Tuple[int, int]] = []
        for choice, score, _ in matches:
            for row_idx in self._client_name_to_rows.get(choice, []):
                out.append((row_idx, int(score)))

        # optional filter by country
        if country:
            ctry = str(country).strip().upper()
            out = [
                (i, s) for (i, s) in out
                if str(self._df.iloc[i][self._col_country]).strip().upper() == ctry
            ]

        # Deduplicate, keep best score per row
        best: Dict[int, int] = {}
        for i, s in out:
            best[i] = max(best.get(i, 0), s)

        ranked = sorted(best.items(), key=lambda x: (-x[1], x[0]))
        return ranked[:top_k]

    # --------------------- scope matching ---------------------

    def _best_scopes_for(self, client_name: str, country: Optional[str], category: str, top_k: int = 5) -> List[Dict[str, Any]]:
        client_norm = normalize_text(client_name)
        ctry = (country or "").strip().lower()
        cat = (category or self.default_category).strip().lower()

        candidates = [s for s in self._scopes if s.get("category") == cat]
        if not candidates:
            return []

        scored: List[Tuple[int, Dict[str, Any]]] = []
        for s in candidates:
            scope_id = s.get("scope_id", "")
            # scope_id example: finance/clientx/us
            parts = scope_id.split("/")
            client_part = parts[1] if len(parts) >= 2 else ""
            leaf_part = parts[2] if len(parts) >= 3 else ""

            score = fuzz.WRatio(client_norm, normalize_text(client_part))

            # give extra points if country matches leaf
            if ctry and leaf_part and ctry == leaf_part:
                score += 10

            scored.append((int(score), s))

        scored.sort(key=lambda x: -x[0])
        out = []
        for score, s in scored[:top_k]:
            out.append({
                "scope_id": s["scope_id"],
                "category": s["category"],
                "score": score,
                "manifest": s["manifest"],
                "path": s["path"],
            })
        return out

    # --------------------- manifest + pdf.metadata ---------------------

    @staticmethod
    def _read_pdf_metadata_sidecar(source_file: str) -> Optional[Dict[str, Any]]:
        p = Path(str(source_file))
        cands = [
            Path(str(p) + ".metadata"),
            Path(str(p) + ".metadata.json"),
        ]
        for c in cands:
            if c.exists():
                data = safe_json_load(c)
                if not data:
                    continue
                return data.get("metadataAttributes") or data.get("metadataAtrributes") or data
        return None

    def _load_manifest(self, manifest_path: str, include_pdf_metadata: bool, max_docs: int) -> Dict[str, Any]:
        mpath = Path(manifest_path)
        data = safe_json_load(mpath) or {}

        docs = data.get("docs") or []
        docs = docs[: min(max_docs, self.max_docs_per_scope)]

        out_docs = []
        for d in docs:
            item = dict(d)
            if include_pdf_metadata:
                src = d.get("source_file")
                if src:
                    item["pdf_metadata"] = self._read_pdf_metadata_sidecar(src)
            out_docs.append(item)

        return {
            "category": data.get("category"),
            "client_id": data.get("client_id"),
            "generated_time": data.get("generated_time"),
            "docs_count": len(docs),
            "docs": out_docs,
        }

    # --------------------- main API logic ---------------------

    def lookup(
        self,
        query: str,
        session_id: Optional[str] = None,
        category: Optional[str] = None,
        top_k: int = 5,
        include_manifest: bool = True,
        include_pdf_metadata: bool = False,
        max_docs: int = 20,
    ) -> Dict[str, Any]:
        if self._df is None:
            raise RuntimeError("Excel not loaded")

        sid = (session_id or "").strip() or None
        cat = (category or self.default_category).strip().lower()

        # 1) parse query into structured intent
        parsed = self._parse_query(query)

        # 2) load session memory (if any)
        mem = self._memory.get(sid, {}) if sid else {}

        # 3) resolve client/country/ids (prefer current query, else memory)
        identifiers = parsed.get("identifiers") or {}
        cid = identifiers.get("cid") or identifiers.get("cap_id")
        country = parsed.get("country")

        # client name may be missing in follow-ups; use memory
        client_raw = parsed.get("client_name_raw") or parsed.get("client_name_hint")

        if not cid and mem.get("cid"):
            cid = mem.get("cid")
        if not country and mem.get("country"):
            country = mem.get("country")
        if not client_raw and mem.get("client_name"):
            client_raw = mem.get("client_name")

        # 4) determine requested fields
        fields = parsed.get("fields") or []
        if not fields and mem.get("fields"):
            fields = mem.get("fields")

        resolved = ResolvedTarget(
            client_name=str(client_raw).strip() if client_raw else None,
            country=str(country).strip().upper() if country else None,
            cid=str(cid).strip() if cid else None,
            cap_id=str(identifiers.get("cap_id") or "").strip() or None,
            category=cat,
            requested_fields=fields if isinstance(fields, list) else [],
        )

        # 5) Excel row matching
        matched_rows: List[int] = []
        row_scores: Dict[int, int] = {}

        # try id match first
        if resolved.cid and self._col_cid:
            matched_rows = self._match_rows_by_id(resolved.cid, resolved.country)
            for r in matched_rows:
                row_scores[r] = 100

        if not matched_rows and resolved.client_name:
            ranked = self._match_rows_by_name(resolved.client_name, resolved.country, top_k=top_k)
            matched_rows = [r for r, _ in ranked]
            row_scores = {r: s for r, s in ranked}

        # fallback: if still nothing, try memory values
        if not matched_rows and mem.get("client_name"):
            ranked = self._match_rows_by_name(str(mem["client_name"]), resolved.country, top_k=top_k)
            matched_rows = [r for r, _ in ranked]
            row_scores = {r: s for r, s in ranked}

        excel_rows: List[Dict[str, Any]] = []
        for r in matched_rows[:top_k]:
            row = self._df.iloc[r].to_dict()
            row["_match_score"] = row_scores.get(r, 0)
            excel_rows.append(row)

        # 6) scopes from FAISS manifests
        scopes: List[Dict[str, Any]] = []
        if resolved.client_name:
            scopes = self._best_scopes_for(resolved.client_name, resolved.country, cat, top_k=top_k)

        # 7) optional manifest load (best scope only)
        manifest: Optional[Dict[str, Any]] = None
        if include_manifest and scopes:
            manifest = self._load_manifest(
                manifest_path=scopes[0]["manifest"],
                include_pdf_metadata=include_pdf_metadata,
                max_docs=max_docs,
            )

        # 8) update session memory
        if sid:
            best_client_name = resolved.client_name
            if not best_client_name and excel_rows:
                best_client_name = str(excel_rows[0].get(self._col_client_name) or "").strip() or None

            self._memory[sid] = {
                "client_name": best_client_name,
                "country": resolved.country,
                "cid": resolved.cid,
                "category": cat,
                "scope_id": scopes[0]["scope_id"] if scopes else None,
                "fields": resolved.requested_fields,
            }

        # 9) if fields are specified, filter excel rows to only those fields
        #    Note: we keep *_match_score always.
        if resolved.requested_fields and resolved.requested_fields != ["*"]:
            keep = set(resolved.requested_fields)
            keep.add("_match_score")
            excel_rows = [{k: v for k, v in r.items() if k in keep} for r in excel_rows]

        return {
            "resolved": {
                "client_name": resolved.client_name,
                "country": resolved.country,
                "cid": resolved.cid,
                "category": cat,
                "requested_fields": resolved.requested_fields,
                "note": "If client/country are missing in follow-up queries, pass session_id to reuse memory.",
            },
            "excel_rows": excel_rows,
            "scopes": scopes,
            "manifest": manifest,
            "memory": self._memory.get(sid, {}) if sid else None,
        }


