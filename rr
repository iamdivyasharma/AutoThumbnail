# Field order (Python 3.7+ preserves dict insertion order)
FIELD_NAMES: List[str] = list(FIELD_DEFS.keys())

# Retrieval queries used for RAG
RETRIEVAL_QUERIES: List[str] = [cfg["query"] for cfg in FIELD_DEFS.values()]

# AWS / Bedrock (prefer env vars / IAM role in real usage)
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID     = os.getenv("AWS_ACCESS_KEY_ID", "YOUR_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.getenv("AWS_SECRET_ACCESS_KEY", "YOUR_SECRET_ACCESS_KEY")

EMBED_MODEL = "amazon.titan-embed-text-v2:0"
# Update to your actual Claude Sonnet model id on Bedrock if different
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# RAG / generation params
K_PER_CLIENT      = 4     # good default for ~40–50 fields
MAX_TOKENS        = 2000  # LLM max tokens
TEMPERATURE       = 0.0   # deterministic extraction
MAX_SOURCE_LINES  = 10    # max lines in Sources column

# ===================== PROMPT TEMPLATE (system + human) =====================

def build_json_schema_example() -> str:
    """
    Build a JSON-like skeleton string with all FIELD_NAMES to embed in the system prompt.
    """
    lines = ["{"]
    for i, (field, cfg) in enumerate(FIELD_DEFS.items()):
        field_type = cfg.get("type", "free_text")
        comma = "," if i < len(FIELD_DEFS) - 1 else ""
        lines.append(f'  "{field}": "<{field_type}>"{comma}')
    lines.append("}")
    return "\n".join(lines)


PROMPT_MULTI = ChatPromptTemplate.from_messages([
    (
        "system",
        """
Instructions:
1. You are a precise, client-scoped contract assistant for FINANCE documents.
2. Use ONLY the Provided Context, which comes from a single client’s policies/contracts.
3. Answer only about the given client and the given policy (file).
4. If the context is insufficient to answer something, explicitly say you don’t know and what is missing.
5. Do NOT hallucinate, infer, or invent terms that are not clearly stated in the contract.
6. Do NOT add citations, references, or bracket labels in any of the field values.
7. Follow the output JSON schema exactly: use the exact field names expected by the calling system.
8. Do NOT output anything except:
   - a single JSON object with the required fields, and
   - on the next line, a single semicolon-separated string of all field values.

Important notes:
1. The Provided Context may contain multiple relevant clauses; treat them as part of the same contract.
2. When the contract is silent on a question, do NOT guess. Return "NA" or an empty string, as appropriate.
3. For Yes/No/NA fields, the value MUST be exactly one of: "Yes", "No", or "NA".
4. Free-text fields may contain any text: extracted clauses, explanations, references to sections, etc.
5. Some fields may be booleans, dates, numbers, lists, or nested objects; return them as valid JSON values.
6. Dates should be in ISO format "YYYY-MM-DD" where possible.
7. Monetary amounts should include currency or units if given.
8. If there are multiple relevant clauses for a field, summarize them or include them clearly.
9. Be internally consistent across all fields; do not contradict yourself.
10. Never change, rename, add, or remove keys from the JSON schema.
11. All output must be valid UTF-8 and valid JSON in the first line.
12. Do NOT wrap the JSON or the semicolon string in backticks or any other markup.

You MUST output a single JSON object with EXACTLY {num_fields} keys.
The keys must be exactly these (order matters):

{json_schema_example}

In addition to this JSON object, you MUST also output, on the NEXT line only,
a single semicolon-separated string that contains ALL {num_fields} values in the SAME ORDER
as the JSON, WITHOUT labels.

Rules for the semicolon-separated string:
- It must contain exactly {num_fields} values separated by ';'.
- Do not include field names, labels, or quotes around the entire string.
- Use the same order of fields as in the JSON.
- If a value is NA or empty, still include an empty position between semicolons.
- Do NOT output any text before the JSON.
- Do NOT output any text after the semicolon-separated string.
"""
    ),
    (
        "human",
        """
Client: {client_id}
Policy (file): {policy_id}

Questions / aspects to consider when filling the {num_fields} JSON fields:
{questions_block}

Provided Context (from this client's file only):
{context}

Now produce:
1) Exactly ONE JSON object with the {num_fields} fields as specified in the system instructions.
2) On the next line, exactly ONE semicolon-separated string with the {num_fields} values
   in the same order, without labels.
"""
    ),
])

# ===================== Helpers =====================

def list_finance_clients(root: Path) -> List[str]:
    if not root.exists():
        return []
    clients: List[str] = []
    for dirpath, dirnames, filenames in os.walk(root):
        filenames_set = set(filenames)
        if "index.faiss" in filenames_set and "index.pkl" in filenames_set:
            p = Path(dirpath)
            rel = p.relative_to(root)
            client_id = rel.as_posix()
            clients.append(client_id)
    return sorted(set(clients))


def load_vs_for_client(client_id: str, session: Session) -> FAISS:
    emb = BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=session.client("bedrock-runtime"),
    )
    index_dir = FINANCE_INDEX_ROOT / client_id
    return FAISS.load_local(str(index_dir), emb, allow_dangerous_deserialization=True)


def format_docs_for_llm(docs) -> str:
    chunks = []
    for d in docs:
        m = d.metadata or {}
        chunk = (
            f"(client_id: {m.get('client_id')}, "
            f"category: {m.get('category')}, "
            f"policy: {m.get('policy_id')}, "
            f"page: {m.get('page', m.get('page_start', '?'))})\n"
            f"{d.page_content}"
        )
        chunks.append(chunk)
    return "\n\n".join(chunks)


def shorten_source_path(source_file: str, client_id: str) -> str:
    if not source_file:
        return ""
    s = str(source_file)
    idx = s.find(client_id)
    if idx != -1:
        return s[idx:]
    return Path(s).name


def build_sources_summary(docs, client_id: str, max_lines: int = MAX_SOURCE_LINES) -> str:
    seen = set()
    lines: List[str] = []
    for d in docs:
        m = d.metadata or {}
        policy_id = m.get("policy_id") or Path(m.get("source_file", "")).name or "UNKNOWN_POLICY"
        raw_source_file = m.get("source_file", "")
        short_path = shorten_source_path(raw_source_file, client_id)

        page = m.get("page")
        page_start = m.get("page_start")
        page_end = m.get("page_end")

        if page is not None:
            page_str = str(page)
        elif page_start is not None and page_end is not None:
            page_str = f"{page_start}-{page_end}" if page_start != page_end else str(page_start)
        elif page_start is not None:
            page_str = str(page_start)
        else:
            page_str = "?"

        key = (policy_id, page_str, short_path)
        if key in seen:
            continue
        seen.add(key)

        lines.append(f"Document: {policy_id} ; Page no.: {page_str} ")

        if len(lines) >= max_lines:
            break
    return "\n".join(lines)


def sanitize_filename(s: str) -> str:
    s = s.replace("/", "_")
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", s)


def load_manifest_for_client(client_id: str) -> List[Dict[str, Any]]:
    manifest_path = FINANCE_INDEX_ROOT / client_id / "manifest.json"
    if not manifest_path.exists():
        print(f"[WARN] No manifest.json for client '{client_id}' at {manifest_path}")
        return []

    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[WARN] Failed to read manifest for '{client_id}': {e}")
        return []

    docs = data.get("docs", [])
    if not isinstance(docs, list):
        print(f"[WARN] manifest.json for '{client_id}' has no 'docs' list")
        return []
    return docs

# ===================== LLM per FILE (one call, N fields) =====================

def answer_all_queries_for_file(
    session: Session,
    client_id: str,
    policy_id: str,
) -> Tuple[Dict[str, str], str, str]:
    """
    For a given client_id + policy_id (single file):

      1) Retrieve context separately for each retrieval query, restricted to this file.
      2) Union all retrieved chunks as a single context for the LLM.
      3) Make ONE Claude call that fills all fields + semicolon string.
      4) Return:
           - values_by_field: { field_name -> value string }
           - flat_string: 'v1;v2;...;vN'
           - sources_summary: newline-separated sources summary
    """
    print(f"[INFO] Building context for client='{client_id}', policy='{policy_id}'")
    vs = load_vs_for_client(client_id, session)
    retriever = vs.as_retriever(
        search_type="similarity",
        search_kwargs={"k": K_PER_CLIENT},
    )

    cid_norm = client_id.strip().lower()
    pol_norm = policy_id.strip().lower()

    all_docs = []

    # ====== RAG: each field's retrieval query ======
    for q in RETRIEVAL_QUERIES:
        print(f"[DEBUG] Retrieval query for this file: {q}")
        docs = retriever.get_relevant_documents(q)
        print(f"[DEBUG] Retrieved {len(docs)} docs for client='{client_id}', policy='{policy_id}', query='{q}'")

        filtered = []
        for d in docs:
            m = d.metadata or {}
            meta_cid = str(m.get("client_id", "")).strip().lower()
            meta_cat = str(m.get("category", "")).strip().lower()
            meta_pol = str(m.get("policy_id", "")).strip().lower()
            print(
                f"[DEBUG] doc meta: client_id='{meta_cid}', "
                f"category='{meta_cat}', policy='{meta_pol}'"
            )

            # Strict: same client, finance category, same file (policy)
            if meta_cid == cid_norm and meta_cat == "finance" and meta_pol == pol_norm:
                filtered.append(d)

        if not filtered:
            print(
                f"[WARN] No docs passed metadata filter for client='{client_id}', "
                f"policy='{policy_id}', query='{q}'. Using all {len(docs)} retrieved docs."
            )
            filtered = docs

        all_docs.extend(filtered)

    # Deduplicate docs in context
    seen = set()
    unique_docs = []
    for d in all_docs:
        m = d.metadata or {}
        key = (
            m.get("policy_id"),
            m.get("page"),
            m.get("page_start"),
            m.get("page_end"),
            m.get("source_file"),
        )
        if key in seen:
            continue
        seen.add(key)
        unique_docs.append(d)

    if not unique_docs:
        print(f"[WARN] No usable context docs for client='{client_id}', policy='{policy_id}'.")
        values_by_field = {field: "" for field in FIELD_NAMES}
        flat_string = ";".join("" for _ in FIELD_NAMES)
        sources_summary = ""
        return values_by_field, flat_string, sources_summary

    context_text = format_docs_for_llm(unique_docs)

    num_fields = len(FIELD_NAMES)
    questions_block = "\n".join(
        f"- {cfg['query']}" for cfg in FIELD_DEFS.values()
    )
    json_schema_example = build_json_schema_example()

    llm = ChatBedrock(
        client=session.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={
            "temperature": float(TEMPERATURE),
            "max_tokens": int(MAX_TOKENS),
        },
    )

    chain = PROMPT_MULTI | llm | StrOutputParser()

    try:
        llm_output = chain.invoke({
            "client_id": client_id,
            "policy_id": policy_id,
            "questions_block": questions_block,
            "context": context_text,
            "num_fields": num_fields,
            "json_schema_example": json_schema_example,
        })
    except Exception as e:
        print(f"[WARN] LLM error for client='{client_id}', policy='{policy_id}': {type(e).__name__}: {e}")
        llm_output = ""

    # ====== DEBUG: save raw LLM output for this file ======
    debug_dir = OUTPUT_DIR / "llm_raw"
    debug_dir.mkdir(parents=True, exist_ok=True)
    debug_file = debug_dir / f"{sanitize_filename(client_id)}__{sanitize_filename(policy_id)}.txt"
    try:
        debug_file.write_text(llm_output or "", encoding="utf-8")
        print(f"[DEBUG] Saved raw LLM output to {debug_file}")
    except Exception as e:
        print(f"[WARN] Could not save raw LLM output: {e}")

    # ====== Robust JSON + flat string extraction ======
    llm_output = llm_output or ""
    # Strip code fences like ```json ...```
    cleaned = llm_output.replace("```json", "```").replace("```JSON", "```")
    if "```" in cleaned:
        parts = cleaned.split("```")
        # Heuristic: JSON likely in the first fenced block that starts with "{"
        for part in parts:
            part = part.strip()
            if part.startswith("{") and "}" in part:
                cleaned = part + "\n" + cleaned.split(part, 1)[-1]
                break

    # JSON between first '{' and last '}'
    start = cleaned.find("{")
    end = cleaned.rfind("}")
    if start != -1 and end != -1 and end > start:
        json_str = cleaned[start:end+1].strip()
        remainder = cleaned[end+1:].strip()
    else:
        print(f"[WARN] Could not find JSON braces in LLM output for client='{client_id}', policy='{policy_id}'")
        json_str = "{}"
        remainder = ""

    # Flat string: first non-empty line after JSON
    flat_string = ""
    if remainder:
        for ln in remainder.splitlines():
            ln = ln.strip()
            if ln:
                flat_string = ln
                break

    # Parse JSON
    try:
        parsed = json.loads(json_str)
    except Exception as e:
        print(f"[WARN] Failed to parse JSON for client='{client_id}', policy='{policy_id}': {e}")
        print(f"[DEBUG] JSON candidate was:\n{json_str}")
        parsed = {}

    if isinstance(parsed, dict):
        expected = set(FIELD_NAMES)
        actual   = set(parsed.keys())
        missing  = expected - actual
        extra    = actual - expected
        if missing:
            print(f"[WARN] Missing keys in LLM JSON for {client_id}/{policy_id}: {missing}")
        if extra:
            print(f"[WARN] Unexpected keys in LLM JSON for {client_id}/{policy_id}: {extra}")
    else:
        print(f"[WARN] Parsed JSON is not an object for {client_id}/{policy_id}, type={type(parsed)}")
        parsed = {}

    # Whatever types came back, stringify for Excel
    values_by_field: Dict[str, str] = {}
    for field in FIELD_NAMES:
        value = parsed.get(field, "")
        if value is None:
            values_by_field[field] = ""
        elif isinstance(value, (dict, list)):
            values_by_field[field] = json.dumps(value, ensure_ascii=False)
        else:
            values_by_field[field] = str(value)

    # If flat_string missing or wrong length, reconstruct from parsed values
    if not flat_string or flat_string.count(";") + 1 != len(FIELD_NAMES):
        flat_values = [values_by_field.get(field, "") for field in FIELD_NAMES]
        flat_string = ";".join(flat_values)

    sources_summary = build_sources_summary(unique_docs, client_id=client_id, max_lines=MAX_SOURCE_LINES)

    return values_by_field, flat_string, sources_summary

# ===================== Main =====================

def main():
    if not FIELD_NAMES:
        raise SystemExit("FIELD_DEFS is empty. Please define your JSON fields in FIELD_DEFS.")

    all_clients = list_finance_clients(FINANCE_INDEX_ROOT)
    if not all_clients:
        raise SystemExit(f"No finance clients found under {FINANCE_INDEX_ROOT}")

    print("Finance clients found:")
    for c in all_clients:
        print("  -", c)

    if TARGET_CLIENT_ID:
        clients = [c for c in all_clients if c == TARGET_CLIENT_ID]
        if not clients:
            raise SystemExit(
                f"\nTARGET_CLIENT_ID='{TARGET_CLIENT_ID}' not found.\n"
                f"Make sure there is a folder: {FINANCE_INDEX_ROOT / TARGET_CLIENT_ID} "
                f"with index.faiss and index.pkl."
            )
        print(f"\nRunning ONLY for client: {TARGET_CLIENT_ID}")
    else:
        clients = all_clients
        print("\nRunning for ALL finance clients.")

    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    for client_id in clients:
        print(f"\n=== Client: {client_id} ===")

        safe_name = sanitize_filename(client_id)
        out_path = OUTPUT_DIR / f"finance_queries_{safe_name}.xlsx"

        # Optional: skip if already created
        if out_path.exists():
            print(f"  -> Skipping {client_id}: {out_path} already exists.")
            continue

        manifest_docs = load_manifest_for_client(client_id)
        if not manifest_docs:
            print(f"[WARN] No manifest docs for client '{client_id}', skipping.")
            continue

        rows: List[Dict[str, Any]] = []

        for doc_info in manifest_docs:
            policy_id = doc_info.get("policy_id") or Path(doc_info.get("source_file", "")).name
            source_file = doc_info.get("source_file", "")

            print(f"  -> File (policy): {policy_id}")

            values_by_field, flat_string, sources_summary = answer_all_queries_for_file(
                session=session,
                client_id=client_id,
                policy_id=policy_id,
            )

            row: Dict[str, Any] = {
                "Client": client_id,
                "Policy": policy_id,
                "Source File": source_file,
                "FlatString": flat_string,
                "Sources": sources_summary,
            }

            for field in FIELD_NAMES:
                row[field] = values_by_field.get(field, "")

            rows.append(row)

        if not rows:
            print(f"[WARN] No rows generated for client '{client_id}'.")
            continue

        df = pd.DataFrame(rows)
        df.to_excel(out_path, index=False)
        print(f"  -> Saved: {out_path}")

    print("\nAll client exports completed.")


if __name__ == "__main__":
    main()
