                sess = ClientSession(read, write)
                await sess.initialize()
                try:
                    yield _MCPStdIOSession(sess)
                finally:
                    await sess.close()
            return

        # non-stdio (HTTP-ish) branch
        if not self.http_client:
            raise RuntimeError(f"[HybridMCP] server '{server}' transport={ttype!r} but no HTTP client configured")
        if TRACE_MCP:
            log.debug("[HybridMCP] delegating HTTP session for server=%s via MultiServerMCPClient", server)
        async with self.http_client.session(server) as s:
