from __future__ import annotations

import os
import json
from pathlib import Path
from typing import Any, Dict, List, Optional

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

from dotenv import load_dotenv
load_dotenv()  # ✅ loads .env automatically

import boto3
from boto3.session import Session

from langchain_aws import BedrockEmbeddings, ChatBedrockConverse
from langchain_community.vectorstores import FAISS


# =============================
# ENV CONFIG
# =============================

AWS_REGION = os.getenv("AWS_REGION", "us-east-1")

# ✅ Titan embed default
BEDROCK_EMBED_MODEL = os.getenv(
    "BEDROCK_EMBED_MODEL",
    "amazon.titan-embed-text-v2:0"
)

# ✅ You can override with Claude 4.5 Sonnet in .env
BEDROCK_LLM_MODEL = os.getenv(
    "BEDROCK_LLM_MODEL",
    "anthropic.claude-3-5-sonnet-20240620-v1:0"
)

FAISS_INDEX_DIR = Path(os.getenv("FAISS_INDEX_DIR", "/opt/ml/faiss_indices")).resolve()

MAX_LOADED_INDEXES = int(os.getenv("MAX_LOADED_INDEXES", "8"))

AWS_ACCESS_KEY_ID = os.getenv("AWS_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.getenv("AWS_SECRET_ACCESS_KEY")
AWS_SESSION_TOKEN = os.getenv("AWS_SESSION_TOKEN")  # optional


# =============================
# AWS SESSION (keys from .env)
# =============================

def get_boto_session() -> Session:
    """
    If keys exist in .env -> use them.
    Otherwise -> fall back to IAM role (best practice in SageMaker).
    """
    if AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY:
        return Session(
            aws_access_key_id=AWS_ACCESS_KEY_ID,
            aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
            aws_session_token=AWS_SESSION_TOKEN,
            region_name=AWS_REGION,
        )
    return Session(region_name=AWS_REGION)

SESSION = get_boto_session()


# =============================
# FASTAPI APP
# =============================

app = FastAPI(
    title="API #1 - RAG Search (FAISS Retrieval + Manifest Metadata)",
    version="1.0"
)

# =============================
# Pydantic Models
# =============================

class RAGSearchRequest(BaseModel):
    question: str
    category: str = "finance"               # legal | finance
    client_ids: Optional[List[str]] = None  # e.g. ["finance/google/us"]
    k: int = 6                              # retrieval top-k
    mode: str = "retrieve"                  # retrieve | rag

class RetrievedChunk(BaseModel):
    text: str
    metadata: Dict[str, Any]

class RAGSearchResponse(BaseModel):
    mode: str
    used_clients: List[str]
    chunks: List[RetrievedChunk]
    answer: Optional[str] = None


# =============================
# FAISS INDEX DISCOVERY
# =============================

_ID_TO_DIR: Dict[str, Path] = {}
_VS_CACHE: Dict[str, FAISS] = {}

def normalize_id(x: str) -> str:
    return str(x or "").strip().lower()

def refresh_id_map() -> None:
    """
    Builds:
      finance/google/us -> /opt/ml/faiss_indices/finance/google/us
    """
    global _ID_TO_DIR
    _ID_TO_DIR = {}

    if not FAISS_INDEX_DIR.exists():
        return

    for dirpath, dirnames, filenames in os.walk(FAISS_INDEX_DIR):
        dirpath = Path(dirpath)
        if "index.faiss" in filenames and "index.pkl" in filenames:
            rel = dirpath.relative_to(FAISS_INDEX_DIR).as_posix()
            _ID_TO_DIR[normalize_id(rel)] = dirpath

def list_clients() -> List[str]:
    refresh_id_map()
    return sorted(_ID_TO_DIR.keys())

def load_index(client_id: str) -> FAISS:
    client_id = normalize_id(client_id)

    if client_id not in _ID_TO_DIR:
        refresh_id_map()

    if client_id not in _ID_TO_DIR:
        raise HTTPException(404, f"FAISS index not found for client_id='{client_id}'")

    if client_id in _VS_CACHE:
        return _VS_CACHE[client_id]

    embed = BedrockEmbeddings(
        model_id=BEDROCK_EMBED_MODEL,
        client=SESSION.client("bedrock-runtime")
    )

    vs_dir = _ID_TO_DIR[client_id]
    vs = FAISS.load_local(str(vs_dir), embed, allow_dangerous_deserialization=True)

    _VS_CACHE[client_id] = vs

    # small cache eviction
    if len(_VS_CACHE) > MAX_LOADED_INDEXES:
        _VS_CACHE.pop(next(iter(_VS_CACHE)))

    return vs


# =============================
# MANIFEST + SIDE METADATA
# =============================

_MANIFEST_CACHE: Dict[str, Dict[str, Any]] = {}

def load_manifest(client_id: str) -> Dict[str, Any]:
    """
    Loads manifest.json stored beside FAISS files.
    """
    client_id = normalize_id(client_id)
    if client_id in _MANIFEST_CACHE:
        return _MANIFEST_CACHE[client_id]

    idx_dir = _ID_TO_DIR.get(client_id)
    if not idx_dir:
        return {}

    manifest_path = idx_dir / "manifest.json"
    if not manifest_path.exists():
        return {}

    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
        _MANIFEST_CACHE[client_id] = data
        return data
    except Exception:
        return {}

def find_doc_entry(manifest: Dict[str, Any], policy_id: str) -> Dict[str, Any]:
    """
    Get per-file metadata entry inside manifest.json
    """
    for d in manifest.get("docs", []):
        if str(d.get("policy_id", "")).strip() == str(policy_id).strip():
            return d
    return {}

def load_sidecar_pdf_metadata(pdf_path: str) -> Dict[str, Any]:
    """
    Reads:
      contract.pdf.metadata
    which contains JSON:
      {"metadataAttributes": {...}}
    """
    if not pdf_path:
        return {}

    p = Path(pdf_path)
    sidecar1 = Path(str(p) + ".metadata")       # ✅ your format
    sidecar2 = Path(str(p) + ".metadata.json")  # extra fallback

    for sidecar in [sidecar1, sidecar2]:
        if sidecar.exists():
            try:
                raw = json.loads(sidecar.read_text(encoding="utf-8"))
                return (
                    raw.get("metadataAttributes")
                    or raw.get("metadataAtrributes")
                    or raw
                )
            except Exception:
                return {}
    return {}


# =============================
# ROUTES
# =============================

@app.get("/clients")
def api_clients():
    """
    Lists available FAISS scopes (client_ids)
    """
    return {"clients": list_clients()}


@app.post("/api/rag-search", response_model=RAGSearchResponse)
def rag_search(payload: RAGSearchRequest):
    """
    ✅ API #1: RAG Search

    - If mode="retrieve": returns top chunks only
    - If mode="rag": returns chunks + final LLM answer
    """

    category = normalize_id(payload.category)
    if category not in ["finance", "legal"]:
        raise HTTPException(400, "category must be 'finance' or 'legal'")

    if not payload.client_ids:
        raise HTTPException(
            400,
            "client_ids is required for production flow (metadata-first orchestration). "
            "Example: ['finance/google/us']"
        )

    requested = [normalize_id(x) for x in payload.client_ids]

    combined_chunks: List[Dict[str, Any]] = []

    for cid in requested:
        # validate category prefix
        if not cid.startswith(category + "/"):
            raise HTTPException(400, f"client_id '{cid}' does not belong to category '{category}'")

        vs = load_index(cid)
        retriever = vs.as_retriever(search_kwargs={"k": int(payload.k)})

        docs = retriever.get_relevant_documents(payload.question)

        manifest = load_manifest(cid)

        for d in docs:
            meta = dict(d.metadata or {})
            policy_id = meta.get("policy_id")

            # try manifest metadata first
            entry = find_doc_entry(manifest, policy_id) if policy_id else {}
            manifest_meta = entry.get("metadata", {}) if isinstance(entry, dict) else {}

            # try sidecar metadata too
            source_file = meta.get("source_file") or entry.get("source_file")
            sidecar_meta = load_sidecar_pdf_metadata(source_file) if source_file else {}

            meta["doc_metadataAttributes"] = manifest_meta or sidecar_meta

            combined_chunks.append({
                "text": d.page_content,
                "metadata": meta
            })

    if not combined_chunks:
        raise HTTPException(404, "No chunks retrieved from FAISS")

    # retrieve-only mode (orchestrator uses evidence)
    if payload.mode.strip().lower() == "retrieve":
        return RAGSearchResponse(
            mode="retrieve",
            used_clients=requested,
            chunks=[RetrievedChunk(**c) for c in combined_chunks],
            answer=None
        )

    # =============================
    # OPTIONAL: RAG ANSWER MODE
    # =============================

    llm = ChatBedrockConverse(
        model_id=BEDROCK_LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=0.2,
        max_tokens=900,
    )

    # simple context merge
    context = "\n\n---\n\n".join([c["text"] for c in combined_chunks[:6]])

    prompt = f"""
You are a contract assistant.
Answer ONLY using the context.

QUESTION:
{payload.question}

CONTEXT:
{context}
"""

    answer = llm.invoke(prompt).content

    return RAGSearchResponse(
        mode="rag",
        used_clients=requested,
        chunks=[RetrievedChunk(**c) for c in combined_chunks],
        answer=answer
    )
