# index_clients.py
# Build per-client FAISS indexes from LOCAL ./pdfs folder.
# - Text PDFs  -> PyPDFLoader
# - Scanned    -> local OCR with pytesseract per page
# Saves FAISS locally under faiss_indices/<client>/ and writes manifest.json

import os
import re
import json
import time
import shutil
import argparse
from pathlib import Path
from collections import defaultdict
from typing import List, Dict, Any

import fitz  # PyMuPDF
import pytesseract
from PIL import Image

from langchain_aws import BedrockEmbeddings
from langchain_community.document_loaders import PyPDFLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain_community.vectorstores import FAISS
from langchain.schema import Document

# ========= EDIT THESE ABSOLUTE PATHS =========
PDF_ROOT  = Path("/ABS/PATH/TO/pdfs").resolve()           # <---- your local PDFs folder
INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()  # <---- where FAISS per-client folders go
CONFIGS_PATH = Path("/ABS/PATH/TO/configs/clients.yaml").resolve()
INDEX_DIR.mkdir(parents=True, exist_ok=True)

# ========= AWS / Bedrock (for embeddings) =========
REGION      = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

# ⚠️ Dev creds (prefer IAM roles in prod)
AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

from boto3 import Session
SESSION = Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)
EMB = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))

# ========= Chunking defaults (can be overridden per client in YAML) =========
DEFAULT_CHUNK_SIZE    = 1200
DEFAULT_CHUNK_OVERLAP = 180

# ========= OCR config =========
OCR_LANG = "eng"     # e.g., "eng+hin"
OCR_DPI  = 300       # render dpi for OCR

# ========= Utilities =========
def load_yaml_overrides() -> Dict[str, Any]:
    if not CONFIGS_PATH.exists():
        return {}
    import yaml
    raw = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    return {str(k).lower(): (v or {}) for k, v in raw.items()}

OVERRIDES = load_yaml_overrides()

def client_from_filename(name: str) -> str:
    """
    Derive client_id from filename by taking the first token before space/_/-/.
    'BMW US_policy1.2.pdf'   -> 'bmw'
    'estee lau_plocuy67.pdf' -> 'estee'
    'kpmg-benefits.pdf'      -> 'kpmg'
    'ey_policy.pdf'          -> 'ey'
    """
    base = Path(name).name.lower()
    base = Path(base).stem
    first = re.split(r"[ _\-\.]+", base, maxsplit=1)[0]
    return first.strip()

def list_local_pdfs() -> List[Path]:
    return sorted([p for p in PDF_ROOT.rglob("*.pdf") if p.is_file()])

def group_by_client(paths: List[Path]) -> Dict[str, List[Path]]:
    buckets: Dict[str, List[Path]] = defaultdict(list)
    for p in paths:
        cid = client_from_filename(p.name)
        buckets[cid].append(p)
    return buckets

def has_text_first_pages(local_pdf: Path, sample_pages: int = 3) -> bool:
    """Heuristic: if any of the first few pages has selectable text -> treat as text-PDF."""
    try:
        doc = fitz.open(str(local_pdf))
        n = min(sample_pages, doc.page_count)
        for i in range(n):
            if doc.load_page(i).get_text("text").strip():
                return True
        return False
    except Exception:
        return False

def ocr_page_with_tesseract(pdf_path: Path, page_index: int, dpi: int = OCR_DPI, lang: str = OCR_LANG):
    """
    Render a PDF page to an image, OCR with Tesseract, return:
      - full page text (joined words by line)
      - word boxes in PDF coordinate space (points), as [{text,x,y,width,height}, ...]
    """
    doc = fitz.open(str(pdf_path))
    page = doc.load_page(page_index)

    # Render to image
    zoom = dpi / 72.0
    mat = fitz.Matrix(zoom, zoom)
    pix = page.get_pixmap(matrix=mat, alpha=False)  # RGB
    img = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)

    # OCR words with bounding boxes (pixels)
    data = pytesseract.image_to_data(img, lang=lang, output_type=pytesseract.Output.DICT)

    words = []
    lines = {}  # line key -> [text tokens]
    page_text_lines = []

    # Convert pixel boxes → PDF points
    sx = page.rect.width / float(pix.width)
    sy = page.rect.height / float(pix.height)

    n = len(data.get("text", []))
    for i in range(n):
        txt = (data["text"][i] or "").strip()
        if not txt:
            continue
        x, y, w, h = data["left"][i], data["top"][i], data["width"][i], data["height"][i]

        words.append({
            "text": txt,
            "x": float(x) * sx,
            "y": float(y) * sy,
            "width": float(w) * sx,
            "height": float(h) * sy,
        })

        key = (
            data.get("block_num", [0])[i],
            data.get("par_num",   [0])[i],
            data.get("line_num",  [0])[i]
        )
        lines.setdefault(key, []).append(txt)

    for _, tokens in sorted(lines.items(), key=lambda kv: kv[0]):
        page_text_lines.append(" ".join(tokens))

    return "\n".join(page_text_lines), words

def per_page_documents_from_ocr(local_pdf: Path, client_id: str, policy_id: str) -> List[Document]:
    """OCR each page with pytesseract and build per-page Documents (with OCR word boxes)."""
    docs: List[Document] = []
    if not shutil.which("tesseract"):
        print("[warn] Tesseract binary not found on PATH; skipping OCR.")
        return docs
    try:
        doc = fitz.open(str(local_pdf))
        for pidx in range(doc.page_count):
            text, words = ocr_page_with_tesseract(local_pdf, pidx, dpi=OCR_DPI, lang=OCR_LANG)
            if not text.strip():
                continue
            page = doc.load_page(pidx)
            docs.append(Document(
                page_content=text,
                metadata={
                    "client_id": client_id,
                    "policy_id": policy_id,
                    "page": int(pidx + 1),  # 1-based
                    "source_file": str(local_pdf.resolve()),
                    "ocr_words": words,  # [{text,x,y,width,height}]
                    "page_width": float(page.rect.width),
                    "page_height": float(page.rect.height),
                }
            ))
    except Exception as e:
        print(f"[warn] OCR failed for {policy_id}: {e}")
    return docs

def per_page_documents_from_textpdf(local_pdf: Path, client_id: str, policy_id: str) -> List[Document]:
    """Use PyPDFLoader (keeps page numbers)."""
    raw_docs = PyPDFLoader(str(local_pdf)).load()
    docs: List[Document] = []
    for d in raw_docs:
        md = dict(d.metadata)
        md.update({
            "client_id": client_id,
            "policy_id": policy_id,
            "page": int(md.get("page", 0)) + 1,   # 1-based
            "source_file": str(local_pdf.resolve()),
        })
        docs.append(Document(page_content=d.page_content, metadata=md))
    return docs

def build_client(client_id: str, pdfs: List[Path], force: bool = False):
    outdir = INDEX_DIR / client_id
    if outdir.exists() and (outdir / "index.faiss").exists() and (outdir / "index.pkl").exists() and not force:
        print(f"[skip] {client_id}: index already exists (use --force to rebuild).")
        return

    # chunking (can be per-client in YAML)
    cfg = OVERRIDES.get(client_id, {})
    chunk_size    = int(cfg.get("chunk_size", DEFAULT_CHUNK_SIZE))
    chunk_overlap = int(cfg.get("chunk_overlap", DEFAULT_CHUNK_OVERLAP))
    splitter = RecursiveCharacterTextSplitter(chunk_size=chunk_size, chunk_overlap=chunk_overlap, add_start_index=True)

    all_chunks = []
    manifest_docs = []

    for pdf in pdfs:
        basename  = pdf.name
        # choose text vs OCR
        if has_text_first_pages(pdf):
            page_docs = per_page_documents_from_textpdf(pdf, client_id, basename)
        else:
            page_docs = per_page_documents_from_ocr(pdf, client_id, basename)

        # split + propagate metadata
        for d in page_docs:
            parts = splitter.split_documents([d])
            for c in parts:
                md = dict(c.metadata)
                md.setdefault("client_id", client_id)
                md.setdefault("policy_id", basename)
                md.setdefault("page", d.metadata.get("page"))
                md.setdefault("source_file", str(pdf.resolve()))
                if "ocr_words" in d.metadata:  md["ocr_words"] = d.metadata["ocr_words"]
                if "page_width" in d.metadata: md["page_width"] = d.metadata["page_width"]
                if "page_height" in d.metadata:md["page_height"] = d.metadata["page_height"]
                c.metadata = md
                all_chunks.append(c)

        # collect manifest info (page count & mtime)
        try:
            pc = fitz.open(str(pdf)).page_count
        except Exception:
            pc = None
        stat = pdf.stat()
        manifest_docs.append({
            "policy_id": basename,
            "source_file": str(pdf.resolve()),
            "pages": pc,
            "modified_time": int(stat.st_mtime),
            "size": stat.st_size,
        })

    if not all_chunks:
        print(f"[warn] {client_id}: no chunks")
        return

    vs = FAISS.from_documents(all_chunks, EMB)
    outdir.mkdir(parents=True, exist_ok=True)
    vs.save_local(str(outdir))
    # write manifest
    (outdir / "manifest.json").write_text(json.dumps({
        "client_id": client_id,
        "region": REGION,
        "embed_model": EMBED_MODEL,
        "chunk_size": chunk_size,
        "chunk_overlap": chunk_overlap,
        "docs": manifest_docs,
        "updated_at": int(time.time()),
    }, indent=2))
    print(f"[ok] {client_id}: {len(all_chunks)} chunks → {outdir}")

def main():
    paths = list_local_pdfs()
    if not paths:
        print(f"No PDFs found in {PDF_ROOT}")
        return
    buckets = group_by_client(paths)

    parser = argparse.ArgumentParser()
    parser.add_argument("--client", help="build only this client id")
    parser.add_argument("--force", action="store_true", help="force rebuild even if index exists")
    args = parser.parse_args()

    if args.client:
        cid = args.client.lower().strip()
        pdfs = buckets.get(cid, [])
        if not pdfs:
            print(f"No PDFs for client '{cid}' in {PDF_ROOT}")
            return
        build_client(cid, pdfs, force=args.force)
    else:
        for cid, pdfs in buckets.items():
            build_client(cid, pdfs, force=args.force)

if __name__ == "__main__":
    main()
