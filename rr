#!/usr/bin/env python3
"""
classify_pdfs_for_ocr.py

Scan all PDFs under a given root directory and count:
- How many are "simple" (text-based, no OCR/Textract needed)
- How many are "scanned" (likely require OCR/Textract)

Heuristic:
  - Open PDF with PyMuPDF.
  - Sample up to SAMPLE_PAGES pages.
  - If total text chars < CHAR_THRESHOLD * sampled_pages → treat as scanned.
"""

import sys
from pathlib import Path
from typing import Tuple

import fitz  # PyMuPDF


# ===== Heuristic parameters =====
SAMPLE_PAGES = 3
CHAR_THRESHOLD = 50  # chars per sampled page; tweak if needed


def is_scanned_pdf(
    pdf_path: Path,
    sample_pages: int = SAMPLE_PAGES,
    char_threshold: int = CHAR_THRESHOLD,
) -> Tuple[bool, int]:
    """
    Returns (is_scanned, total_chars_sampled).

    If we fail to open or read the PDF at all, we err on the side of
    "scanned = True" so those get pushed through OCR/Textract in your pipeline.
    """
    try:
        with fitz.open(str(pdf_path)) as doc:
            n_pages = doc.page_count
            if n_pages == 0:
                return True, 0

            to_sample = min(n_pages, sample_pages)
            total_chars = 0

            for i in range(to_sample):
                page = doc.load_page(i)
                txt = page.get_text("text") or ""
                total_chars += len(txt.strip())

            scanned = total_chars < char_threshold * to_sample
            return scanned, total_chars

    except Exception as e:
        print(f"[WARN] Failed to inspect {pdf_path}: {e}")
        # If we can't read it, treat as scanned to be safe
        return True, 0


def find_all_pdfs(root: Path):
    """
    Recursively find all PDFs under root, case-insensitive on extension.
    """
    pdfs = []
    for p in root.rglob("*"):
        if p.is_file() and p.suffix.lower() == ".pdf":
            pdfs.append(p)
    return pdfs


def main():
    # Ignore Jupyter/SageMaker "-f" crap and only keep non-flag args
    args = [a for a in sys.argv[1:] if not a.startswith("-")]

    if args:
        root = Path(args[0]).expanduser().resolve()
    else:
        # 👇 CHANGE THIS DEFAULT to what you want
        # e.g. Path("ce") or Path("ce/finance")
        root = Path("ce").expanduser().resolve()

    print(f"[DEBUG] Current working directory: {Path.cwd()}")
    print(f"[DEBUG] Using root: {root}")

    if not root.exists():
        print(f"[ERROR] Root path does not exist: {root}")
        sys.exit(1)

    all_pdfs = find_all_pdfs(root)
    print(f"[DEBUG] Number of *.pdf files found under root: {len(all_pdfs)}")

    if not all_pdfs:
        print("No PDF files found under this root. "
              "Check that you're pointing to the correct folder (e.g. 'ce', 'ce/finance').")
        return

    simple_count = 0
    scanned_count = 0

    for pdf_path in sorted(all_pdfs):
        scanned, total_chars = is_scanned_pdf(pdf_path)
        if scanned:
            status = "SCANNED"
            scanned_count += 1
        else:
            status = "SIMPLE_TEXT"
            simple_count += 1

        print(f"[{status:12}] {pdf_path}  (sampled_chars={total_chars})")

    total = simple_count + scanned_count

    print("\n===== SUMMARY =====")
    print(f"Root:                    {root}")
    print(f"Total PDFs found:        {total}")
    print(f"  Simple text PDFs:      {simple_count}")
    print(f"  Scanned/needs OCR:     {scanned_count}")
    print("====================")


if __name__ == "__main__":
    main()
