#!/usr/bin/env python3
"""
rag_finance_query.py

Ask free-form questions against a single FINANCE client FAISS index and get:

- Answer (LLM, using RAG over finance/<client_id>)
- Sources (policy_id + pages + source_file for all chunks used)

Usage examples:
  python rag_finance_query.py --client "clientA/us" --question "Is there a COLA clause?"
  python rag_finance_query.py --client "ABB - SWITZZERLNA/us"

If --question is omitted, the script will prompt you in the terminal.
"""

from __future__ import annotations

import os
import argparse
from pathlib import Path
from typing import List, Dict, Any, Tuple

from boto3 import Session
from langchain_aws import BedrockEmbeddings, ChatBedrock
from langchain_community.vectorstores import FAISS
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser

# ===================== EDIT THESE =====================
FAISS_INDEX_DIR    = Path("/ABS/PATH/TO/faiss_indices").resolve()   # root used by indexer
FINANCE_INDEX_ROOT = FAISS_INDEX_DIR / "finance"                    # finance-only indexes

# AWS (direct keys for dev; prefer IAM roles in prod)
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

# Models
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# Retrieval / generation
K_PER_CLIENT = 6
MAX_TOKENS   = 1400
TEMPERATURE  = 0.2

# ===================== Prompt (generic, not COLA-only) =====================
PROMPT = ChatPromptTemplate.from_messages([
    ("system",
     "You are a precise, client-scoped contract assistant for FINANCE documents. "
     "You must use ONLY the Provided Context, which comes from one client's policies/contracts. "
     "Answer the user's question as completely and specifically as possible based on the context. "
     "If the context is insufficient to answer something, say you don't know and what is missing. "
     "Do not hallucinate. Do not add citations or bracket labels."),
    ("human",
     "Client: {client_id}\n"
     "Question: {question}\n\n"
     "Provided Context:\n{context}\n\n"
     "Write the best possible answer now.")
])

# ===================== Helpers =====================
def list_finance_clients(root: Path) -> List[str]:
    """
    Recursively scan FINANCE_INDEX_ROOT for all client index directories.

    A directory is considered a client index if it contains:
      - index.faiss
      - index.pkl

    Returns client_ids as relative paths under finance/, e.g.:
      "clientA/us"
      "ABB - SWITZZERLNA/us"
    """
    if not root.exists():
        return []

    clients: List[str] = []
    for dirpath, dirnames, filenames in os.walk(root):
        filenames_set = set(filenames)
        if "index.faiss" in filenames_set and "index.pkl" in filenames_set:
            p = Path(dirpath)
            rel = p.relative_to(root)
            client_id = rel.as_posix()
            clients.append(client_id)

    return sorted(set(clients))


def load_vs_for_client(client_id: str, session: Session) -> FAISS:
    """
    Load FAISS for a given finance client_id (relative under FINANCE_INDEX_ROOT).

    Example:
      client_id = "clientA/us"
      -> uses FINANCE_INDEX_ROOT / "clientA/us"
    """
    emb = BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=session.client("bedrock-runtime"),
    )
    index_dir = FINANCE_INDEX_ROOT / client_id
    return FAISS.load_local(str(index_dir), emb, allow_dangerous_deserialization=True)


def format_docs(docs) -> str:
    """
    Turn retrieved LangChain Documents into a text block for the LLM.
    """
    parts = []
    for d in docs:
        m = d.metadata or {}
        part = (
            f"(client_id: {m.get('client_id')}, "
            f"category: {m.get('category')}, "
            f"policy: {m.get('policy_id')}, "
            f"page: {m.get('page', m.get('page_start', '?'))})\n"
            f"{d.page_content}"
        )
        parts.append(part)
    return "\n\n".join(parts)


def build_sources_summary(docs) -> List[Dict[str, Any]]:
    """
    Turn retrieved docs into a structured list of sources:
      [
        {"policy_id": "...", "pages": "10-12", "source_file": "..."},
        ...
      ]
    """
    from pathlib import Path as _P

    seen = set()
    out: List[Dict[str, Any]] = []

    for d in docs:
        m = d.metadata or {}
        policy_id = m.get("policy_id") or _P(m.get("source_file", "")).name or "UNKNOWN_POLICY"
        source_file = m.get("source_file", "")

        page = m.get("page")
        page_start = m.get("page_start")
        page_end = m.get("page_end")

        if page is not None:
            page_str = str(page)
        elif page_start is not None and page_end is not None:
            page_str = f"{page_start}-{page_end}" if page_start != page_end else str(page_start)
        elif page_start is not None:
            page_str = str(page_start)
        else:
            page_str = "?"

        key = (policy_id, page_str, source_file)
        if key in seen:
            continue
        seen.add(key)

        out.append({
            "policy_id": policy_id,
            "pages": page_str,
            "source_file": source_file,
        })

    return out


def ask_one_question(session: Session, client_id: str, question: str) -> Tuple[str, List[Dict[str, Any]]]:
    """
    RAG for a SINGLE question and SINGLE finance client_id.

    Returns:
      answer_text, sources_list
    """
    vs = load_vs_for_client(client_id, session)
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": K_PER_CLIENT})

    docs = retriever.get_relevant_documents(question)
    if not docs:
        return f"(No matching content found for client '{client_id}' and this question.)", []

    # Hard filter by metadata (but fall back to all if filter empties it)
    cid_norm = client_id.strip().lower()
    filtered_docs = []
    for d in docs:
        m = d.metadata or {}
        meta_cid = str(m.get("client_id", "")).strip().lower()
        meta_cat = str(m.get("category", "")).strip().lower()
        if meta_cid == cid_norm and meta_cat == "finance":
            filtered_docs.append(d)

    if not filtered_docs:
        # fallback to everything FAISS returned
        filtered_docs = docs

    context = format_docs(filtered_docs)
    sources = build_sources_summary(filtered_docs)

    llm = ChatBedrock(
        client=session.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={
            "temperature": float(TEMPERATURE),
            "max_tokens": int(MAX_TOKENS),
        },
    )
    chain = PROMPT | llm | StrOutputParser()

    try:
        answer = chain.invoke({
            "client_id": client_id,
            "question": question,
            "context": context,
        })
    except Exception as e:
        answer = f"(LLM error for client '{client_id}': {type(e).__name__}: {e})"

    return answer, sources

# ===================== CLI / main =====================
def main():
    parser = argparse.ArgumentParser(description="Ask free-form questions over a finance client FAISS index.")
    parser.add_argument(
        "--client",
        required=True,
        help="Finance client_id (relative under 'finance/'), e.g. 'clientA/us' or 'ABB - SWITZZERLNA/us'",
    )
    parser.add_argument(
        "--question",
        help="Question to ask. If omitted, you will be prompted interactively.",
    )
    args = parser.parse_args()

    client_id = args.client.strip()
    question = (args.question or "").strip()

    # Validate client id
    all_clients = list_finance_clients(FINANCE_INDEX_ROOT)
    if client_id not in all_clients:
        print("Known finance client_ids:")
        for c in all_clients:
            print("  -", c)
        raise SystemExit(
            f"\nClient '{client_id}' not found. Make sure there is a folder "
            f"{(FINANCE_INDEX_ROOT / client_id)} with index.faiss and index.pkl."
        )

    if not question:
        # ask user in the terminal
        question = input(f"Enter your question for client '{client_id}': ").strip()
        if not question:
            raise SystemExit("No question provided.")

    # AWS session
    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    print(f"\n=== Asking client: {client_id} ===")
    print(f"Q: {question}\n")

    answer, sources = ask_one_question(session, client_id, question)

    print("=== ANSWER ===")
    print(answer)
    print("\n=== SOURCES ===")
    if not sources:
        print("(no sources)")
    else:
        for s in sources:
            print(
                f"- policy: {s['policy_id']} ; pages: {s['pages']} ; source: {s['source_file']}"
            )

if __name__ == "__main__":
    main()
