import json
import pandas as pd
from pathlib import Path

CSV_PATH = Path("Excel/Contractextraction list1.csv").resolve()
OUT_SCHEMA = Path("data/client_master_schema.json").resolve()

def main():
    if not CSV_PATH.exists():
        raise FileNotFoundError(f"CSV not found: {CSV_PATH}")

    OUT_SCHEMA.parent.mkdir(parents=True, exist_ok=True)

    # read just header
    df = pd.read_csv(CSV_PATH, nrows=1, dtype=str, encoding="utf-8")
    schema = [str(c).strip() for c in df.columns.tolist()]

    OUT_SCHEMA.write_text(json.dumps(schema, indent=2), encoding="utf-8")
    print(f"[OK] Schema written to: {OUT_SCHEMA}")
    print(f"Fields count: {len(schema)}")

if __name__ == "__main__":
    main()
