# ragbot_api.py
# Run: uvicorn ragbot_api:app --host 0.0.0.0 --port 8000
# Expects Ragbot.py in the same folder with: def get_answer(payload: dict) -> str

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
import Ragbot  # direct import, no env vars

app = FastAPI(title="Ragbot API", version="1.0.0", docs_url="/docs")

# Strict payload model (rejects extra keys)
class QueryPayload(BaseModel):
    query: str = Field(..., min_length=1)
    user_name: str = Field(..., min_length=1)
    user_email: str = Field(..., min_length=3)

    class Config:
        extra = "forbid"

class AnswerResponse(BaseModel):
    answer: str

@app.get("/health")
def health():
    return {"status": "ok"}

@app.post("/ask", response_model=AnswerResponse)
def ask(payload: QueryPayload):
    # sanitize like Streamlit does
    clean = {
        "query": payload.query.strip(),
        "user_name": payload.user_name.strip(),
        "user_email": payload.user_email.strip(),
    }

    # Always call Ragbot.get_answer(payload)
    try:
        get_answer = getattr(Ragbot, "get_answer")
    except AttributeError as e:
        raise HTTPException(
            status_code=500,
            detail="Ragbot.get_answer(payload) not found. Implement it in Ragbot.py.",
        ) from e

    try:
        result = get_answer(clean)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Ragbot error: {e}") from e

    return {"answer": str(result)}
