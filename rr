# ================== Sidebar ==================
with st.sidebar:
    st.subheader("User")
    user_labels = [f"{u['name']} <{u['email']}>" for u in USERS] + ["Other…"]
    picked = st.selectbox("Choose a user", user_labels, index=(0 if st.session_state.prev_picked is None else user_labels.index(st.session_state.prev_picked) if st.session_state.prev_picked in user_labels else 0))

    # Defaults from preset or blanks for Other…
    if picked != "Other…":
        idx = user_labels.index(picked)
        chosen = USERS[idx]
        name_default = chosen["name"]
        email_default = chosen["email"]
    else:
        name_default = st.session_state.prev_user_name or ""
        email_default = st.session_state.prev_user_email or ""

    name_val = st.text_input("Name", value=name_default, placeholder="e.g., Priya Sharma", key="user_name_input")
    email_val = st.text_input("Email", value=email_default, placeholder="e.g., priya@company.com", key="user_email_input")

    # ---- Identity switching logic ----
    def _switch_to_identity(name: str, email: str, reason: str):
        # Use email as stable session id if present; else name; else random
        new_sid = (email.strip() or name.strip() or f"user-{uuid.uuid4().hex[:8]}")
        st.session_state.session_id = new_sid
        st.session_state.messages = []
        st.session_state.boot_agentic = False
        st.session_state.boot_air = False
        st.session_state.boot_hotel = False
        st.session_state.user_name = name.strip()
        st.session_state.user_email = email.strip()
        st.session_state.prev_picked = picked
        st.session_state.prev_user_name = name.strip()
        st.session_state.prev_user_email = email.strip()
        st.success(f"Switched user ({reason}). New session id: {new_sid}")

    # Auto-switch for preset change
    if st.session_state.prev_picked is None:
        st.session_state.prev_picked = picked
        st.session_state.user_name = name_default
        st.session_state.user_email = email_default
        if (email_default or name_default):
            st.session_state.session_id = (email_default or name_default)
    elif picked != st.session_state.prev_picked and picked != "Other…":
        _switch_to_identity(name_default, email_default, reason="preset")

    # Manual switch for 'Other…' (avoid resets on every keystroke)
    if picked == "Other…":
        if st.button("🔁 Switch User"):
            _switch_to_identity(name_val, email_val, reason="manual (Other…)")

    st.markdown("---")
    st.subheader("Session")
    # You can still override the session id if needed
    new_session_id = st.text_input("Session ID", value=st.session_state.session_id, key="sid_input")
    if new_session_id != st.session_state.session_id:
