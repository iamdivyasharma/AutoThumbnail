# hotel_mcp_server.py
from typing import Any, Dict
from fastapi import FastAPI, Body, Request
from fastapi.responses import JSONResponse

# ⬅️ import the parsers you already wrote
from utils import parse_hotel_payload_v2, extract_filter_values

app = FastAPI(title="HotelBot (MCP JSON)")

# ---------- Unified handler (used by both REST and JSON-RPC) ----------
async def handle_hotel(arguments: Dict[str, Any]) -> Dict[str, Any]:
    # 1) Parse and normalize everything from orchestrator
    inputs = parse_hotel_payload_v2(arguments)
    origin, dest, start_dt, end_dt, policy = extract_filter_values(inputs.filters)

    # 2) Build a clean payload for your bot
    bot_payload: Dict[str, Any] = {
        "query": inputs.query,
        "user_name": inputs.user_name,
        "user_email": inputs.user_email,
        "session_id": inputs.session_id,
        "target": inputs.target,
        "filters": {
            "origin": origin,
            "destination": dest,
            "start_date": start_dt,
            "end_date": end_dt,
            "policy_status": policy,
        },
        # keep the raw extra in case the bot needs more knobs
        "extra": inputs.extra,
        "ui_version": inputs.ui_version,
    }

    # 3) Call your downstream bot
    #    (import inside function to avoid circular imports during app startup)
    from bots.hotel_bot import run_hotel_bot  # make this function in your bot file
    answer = run_hotel_bot(bot_payload)  # if async: `answer = await run_hotel_bot(bot_payload)`

    # 4) Return MCP-style result
    return {"answer": answer}

# ---------- REST tool (so you can call it directly if needed) ----------
@app.post("/hotel_query", operation_id="hotel_query_tool")
async def hotel_query(arguments: Dict[str, Any] = Body(...)):
    return await handle_hotel(arguments)

# ---------- JSON-RPC MCP (batch/JSON) ----------
@app.post("/mcp", response_class=JSONResponse)
async def mcp_jsonrpc(req: Request):
    data = await req.json()
    mid = data.get("id")
    method = data.get("method")
    params = data.get("params") or {}

    try:
        if method == "tools/list":
            result = {
                "tools": [
                    {
                        "name": "hotel_query_tool",
                        # Advertise the modern args (backward compatible; we still accept qquery too)
                        "arguments": {
                            "query":   {"type": "string"},
                            "extra":   {"type": "object"},
                            "context": {"type": "object"},
                        },
                        "description": "Query hotel inventory/prices with filters (OND, dates, policy).",
                    }
                ]
            }
            return JSONResponse({"jsonrpc": "2.0", "id": mid, "result": result})

        if method == "tools/call":
            name = params.get("name")
            args = params.get("arguments") or {}
            if name != "hotel_query_tool":
                return JSONResponse(
                    {"jsonrpc": "2.0", "id": mid,
                     "error": {"code": -32601, "message": "Method not found"}},
                    status_code=400,
                )
            out = await handle_hotel(args)
            return JSONResponse({"jsonrpc": "2.0", "id": mid, "result": out})

        # Unknown method
        return JSONResponse(
            {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "Method not found"}},
            status_code=400,
        )
    except Exception as e:
        return JSONResponse(
            {"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": str(e)}},
            status_code=500,
        )

