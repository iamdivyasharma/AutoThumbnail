# ==================== Tiny MCP HTTP client (JSON-RPC over HTTP, JSON response) ====================
class MCPHTTPClient:
    def __init__(self, base_url: str, timeout: float = 30.0, headers: Optional[Dict[str, str]] = None):
        self.base_url = base_url.rstrip("/")
        self.timeout = timeout
        self._id = 0
        self.headers = {
            "content-type": "application/json",
            "accept": "application/json",
            "cache-control": "no-cache",
            "connection": "keep-alive",
        }
        if headers:
            merged = {**self.headers, **headers}
            merged["accept"] = "application/json"
            self.headers = merged

    def _next_id(self) -> str:
        self._id += 1
        return str(self._id)

    async def _rpc(self, method: str, params: Dict[str, Any]) -> Any:
        payload = {"jsonrpc": "2.0", "id": self._next_id(), "method": method, "params": params}
        async with httpx.AsyncClient(timeout=self.timeout) as client:
            r = await client.post(self.base_url, json=payload, headers=self.headers)
            r.raise_for_status()
            data = r.json()
        if "error" in data:
            raise RuntimeError(f"RPC error: {data['error']}")
        return data.get("result")

    async def tools_list(self) -> Dict[str, Any]:
        return await self._rpc("tools/list", {})

    async def tools_call(self, name: str, arguments: Dict[str, Any]) -> Any:
        return await self._rpc("tools/call", {"name": name, "arguments": arguments})

MCP_CLIENTS: Dict[str, MCPHTTPClient] = {
