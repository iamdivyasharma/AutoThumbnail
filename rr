from __future__ import annotations
import os
import json
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Dict, Any, List

import pandas as pd


def _norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()


def _make_acronym(name: str) -> str:
    """
    Example: "A.P. Moller Maersk" -> "APMM"
    """
    parts = re.split(r"[^A-Za-z0-9]+", name or "")
    parts = [p for p in parts if p]
    # take first character of each token
    return "".join(p[0].upper() for p in parts if p[0].isalnum())


@dataclass
class LookupResult:
    found: bool
    answer_text: str
    matched_client_name: Optional[str] = None
    cid: Optional[str] = None
    country: Optional[str] = None
    scopes: Optional[List[str]] = None


class MetadataService:
    def __init__(
        self,
        client_master_csv_path: str,
        schema_json_path: Optional[str] = None,
        client_name_col: str = "parent_hq",
        country_col: str = "country__c",
        cid_col: str = "cid",
        faiss_index_dir: Optional[str] = None,   # ✅ FIX: now accepted
    ):
        self.client_master_csv_path = Path(client_master_csv_path)
        self.schema_json_path = Path(schema_json_path) if schema_json_path else None

        self.client_name_col = client_name_col
        self.country_col = country_col
        self.cid_col = cid_col

        # ✅ Optional FAISS root for building scope suggestions like finance/<client>/<country>
        self.faiss_index_dir = Path(
            faiss_index_dir or os.getenv("FAISS_INDEX_DIR", "/opt/ml/faiss_indices")
        )

        self.df: Optional[pd.DataFrame] = None
        self.schema: Dict[str, Any] = {}

        # cached name matching
        self._names: List[str] = []
        self._names_norm: List[str] = []
        self._names_acronym: List[str] = []

    def ensure_loaded(self):
        if self.df is not None:
            return

        if not self.client_master_csv_path.exists():
            raise FileNotFoundError(f"Client master CSV not found: {self.client_master_csv_path}")

        # ✅ uses CSV only (no BadZipFile Excel errors)
        self.df = pd.read_csv(self.client_master_csv_path)

        # schema optional
        if self.schema_json_path and self.schema_json_path.exists():
            self.schema = json.loads(self.schema_json_path.read_text())
        else:
            self.schema = {"columns": list(self.df.columns)}

        if self.client_name_col not in self.df.columns:
            raise ValueError(f"Missing client_name_col='{self.client_name_col}' in CSV columns={list(self.df.columns)}")

        # cache normalized names + acronym
        self._names = self.df[self.client_name_col].fillna("").astype(str).tolist()
        self._names_norm = [_norm(x) for x in self._names]
        self._names_acronym = [_make_acronym(x) for x in self._names]

    def _match_client(self, query: str) -> Optional[int]:
        """
        Return best matching row index in df for client name.
        Priority:
          1) Acronym match  (APMM)
          2) Contains match (google)
          3) Reverse contains
        """
        qn = _norm(query)
        if not qn:
            return None

        q_tokens = set(qn.split())
        q_upper_tokens = {t.upper() for t in re.split(r"[^A-Za-z0-9]+", query or "") if t}

        # 1) acronym match
        for i, ac in enumerate(self._names_acronym):
            if ac and ac in q_upper_tokens:
                return i

        # 2) contains match
        for i, name_norm in enumerate(self._names_norm):
            if name_norm and name_norm in qn:
                return i

        # 3) reverse contains (query inside client name)
        for i, name_norm in enumerate(self._names_norm):
            if name_norm and qn in name_norm:
                return i

        # 4) token overlap (light fuzzy)
        best_i = None
        best_score = 0
        for i, name_norm in enumerate(self._names_norm):
            toks = set(name_norm.split())
            score = len(toks.intersection(q_tokens))
            if score > best_score:
                best_score = score
                best_i = i

        return best_i if best_score > 0 else None

    def lookup(self, query: str, country: Optional[str] = None, category: str = "finance") -> Dict[str, Any]:
        """
        Lookup client/cid/country from client_master CSV.
        Returns basic info + optional scopes list.
        """
        self.ensure_loaded()

        idx = self._match_client(query)
        if idx is None:
            return {
                "found": False,
                "answer_text": f"Could not find a matching client for '{query}'.",
                "matched_client_name": None,
                "cid": None,
                "country": country,
                "scopes": [],
            }

        row = self.df.iloc[idx]
        client_name = str(row.get(self.client_name_col, "")).strip()
        cid = str(row.get(self.cid_col, "")).strip() if self.cid_col in self.df.columns else None

        # if country not provided, try from sheet
        sheet_country = None
        if self.country_col in self.df.columns:
            sheet_country = str(row.get(self.country_col, "")).strip()

        final_country = (country or sheet_country or "").strip()

        # produce scopes (these will only be suggestions)
        scopes = []
        client_folder_guess = client_name.strip().lower().replace(" ", "_")

        if final_country:
            scopes.append(f"{category}/{client_folder_guess}/{final_country.lower()}")
        scopes.append(f"{category}/{client_folder_guess}/ultimateparent")
        scopes.append(f"{category}/{client_folder_guess}/corporatefamily")

        answer_text = f"Client: {client_name}"
        if cid:
            answer_text += f", CID/CAPID: {cid}"
        if final_country:
            answer_text += f", Country: {final_country}"

        return {
            "found": True,
            "answer_text": answer_text,
            "matched_client_name": client_name,
            "cid": cid,
            "country": final_country,
            "scopes": scopes,
        }


