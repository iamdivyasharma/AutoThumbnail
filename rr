# ==================== Rewriter ====================
def rewrite_with_history(sid: str, user_query: str, extra: Optional[dict] = None) -> str:
    history = mem_get(sid, 10)
    hist_min = [
        {"role": h["role"], "content": h["content"] if isinstance(h["content"], str) else str(h["content"])}
        for h in history
    ]
    payload = {
        "latest_user_query": user_query,
        "chat_history": hist_min,
        "sticky_filters": (extra or {}).get("filters", {}),
    }
    try:
        txt = claude_text(CONTEXTUALIZER_SYSTEM, payload, max_tokens=180, temperature=0)
        return txt.strip().strip('"')
    except Exception:
        return user_query

# ==================== Routing helpers ====================
def heuristic_targets_from_filters(extra: Optional[dict]) -> List[str]:
    """If filters contain a valid O/D route, default to air+hotel."""
    try:
        fil = (extra or {}).get("filters", {}) or {}
        ond = fil.get("ond") or {}
        o, d = ond.get("origin"), ond.get("destination")
        if o and d and o != d:
            return ["air", "hotel"]
    except Exception:
        pass
    return []

# ==================== Routing & composition ====================
def llm_decide_targets(query: str, sid: Optional[str] = None) -> List[str]:
    try:
        payload = {"query": query}
        if sid:
            payload["history"] = mem_get(sid, 6)
        out = claude_json(ROUTER_SYSTEM, payload, max_tokens=128)
        picks = [t for t in out.get("targets", []) if t in SERVICES]
        return list(dict.fromkeys(picks))  # NO implicit hotel fallback
    except Exception:
        return []  # Let caller decide (heuristic or error)

def compose_final(user_query: str, answers_by_target: Dict[str, Any], answer_schema: Optional[dict] = None) -> str:
    if not answers_by_target:
        return ""
    cleaned = sanitize_map(answers_by_target)
    ckey = f"compose:{_h({'q':user_query,'a':cleaned,'schema':answer_schema})}"
    hit = cache_get(ckey)
    if hit is not None:
        return hit
    try:
        txt = claude_text(
            COMPOSER_SYSTEM,
            {"user_query": user_query, "answers_by_target": cleaned, "answer_schema": answer_schema},
            max_tokens=900
        )
        final_txt = sanitize_answer(txt)
        cache_set(ckey, final_txt)
        return final_txt
    except Exception:
        parts = [f"{k}: {v}" for k, v in cleaned.items()]
        final_txt = sanitize_answer(" | ".join(map(str, parts)))
        cache_set(ckey, final_txt)
        return final_txt

# ==================== Build tool call arguments ====================
def _build_tool_arguments(target: str, query: str, extra: Optional[Dict[str, Any]], sid: str, field_name: str) -> Dict[str, Any]:
    args: Dict[str, Any] = {field_name: query}
    args["context"] = {"session_id": sid, "target": target}
    if isinstance(extra, dict) and extra:
        if PASS_EXTRA_MODE in ("nested", "both"):
            args["extra"] = extra
        if PASS_EXTRA_MODE in ("flat", "both"):
            for k, v in extra.items():
                if k not in (field_name, "context", "extra"):
                    args[k] = v
    return args

# ==================== Tool metadata introspection ====================
async def ensure_tool_caps(target: str):
    if TOOL_CAPS.get(target):
        return
    client = MCP_CLIENTS[target]
    try:
        info = await client.tools_list()
    except Exception:
        info = {"tools": []}
    TOOL_CAPS[target] = {"tools": info.get("tools", []), "hints": PLANNING_HINTS.get(target, {})}

# ==================== Downstream MCP calls ====================
async def call_backend(target: str, query: str, extra: Optional[Dict[str, Any]], sid: str):
    await ensure_tool_caps(target)
    svc = SERVICES[target]
    client = MCP_CLIENTS[target]
    args = _build_tool_arguments(target=target, query=query, extra=extra, sid=sid, field_name=svc["field"])

    ckey = f"bot:{target}:{_h({'q':query,'x':extra,'sid':sid,'mode':PASS_EXTRA_MODE})}"
    hit = cache_get(ckey)
    if hit is not None:
        return hit

    # retry for tool call
    last_ex = None
    for attempt in range(3):
        try:
            result = await client.tools_call(name=svc["tool"], arguments=args)
            if isinstance(result, dict):
                val = result.get("answer") or result.get("result") or result.get("output") or result.get("content") or result
            else:
                val = result
            cache_set(ckey, val)
            return val
        except Exception as e:
            last_ex = e
            await asyncio.sleep(0.25 * (2 ** attempt) + random.random() * 0.2)
    return f"{type(last_ex).__name__}: {last_ex}"

# ==================== Models ====================
class Step(BaseModel):
    target: str = Field(..., description="one of: air, hotel, tdna")
    input: str
    after: Optional[List[int]] = None  # indices of dependent steps

class Plan(BaseModel):
    steps: List[Step] = Field(default_factory=list)
    finish: bool = False
    final_answer: str = ""

class FinishDecision(BaseModel):
    finish: bool
    final_answer: Optional[str] = None

# ==================== Execution helpers ====================
def topo_batches(steps: List[Step]) -> List[List[int]]:
    # Kahn-style batching by dependencies
    deps: Dict[int, Set[int]] = {i: set(s.after or []) for i, s in enumerate(steps)}
    remaining: Set[int] = set(range(len(steps)))
    batches: List[List[int]] = []
    while remaining:
        ready = [i for i in sorted(remaining) if not deps[i]]
        if not ready:
            # cycle fallback: execute smallest index
            i = min(remaining)
            ready = [i]
        batches.append(ready)
        for i in ready:
            remaining.remove(i)
        for j in remaining:
            deps[j] -= set(ready)
    return batches

async def execute_steps(steps: List[Step], q: str, extra_aug: dict, sid: str, parallel_cap: int) -> List[Dict[str, Any]]:
    """Execute DAG steps in batches. Returns list of observations (ordered by execution)."""
    observations: List[Dict[str, Any]] = []
    batches = topo_batches(steps)
    for batch_idxs in batches:
        if not batch_idxs:
            continue
        # obey parallel cap
        slice_idxs = [batch_idxs[i:i+parallel_cap] for i in range(0, len(batch_idxs), parallel_cap)]
        for idxs in slice_idxs:
            coros = []
            idx_map = []
            for i in idxs:
                s = steps[i]
                if s.target not in SERVICES:
                    observations.append({"step_index": i, "step": s.dict(), "error": f"Unknown target {s.target}"})
                    continue
                idx_map.append(i)
                coros.append(call_backend(s.target, s.input or q, extra_aug, sid))
            outs = await asyncio.gather(*coros, return_exceptions=True)
            for i, out in zip(idx_map, outs):
                s = steps[i]
                if isinstance(out, Exception):
                    observations.append({"step_index": i, "step": s.dict(), "error": f"{type(out).__name__}: {out}"})
                else:
                    observations.append({"step_index": i, "step": s.dict(), "result": out})
    return observations

# ==================== Scoring & Selection ====================
def score_observations(user_query: str, observations: List[Dict[str, Any]]) -> Dict[str, Any]:
    """Ask LLM to score each observation's relevance; returns per-target best pick."""
    try:
        scored = claude_json(
            "Score each observation 0-1 for relevance to the user_query; group by target and pick best per target. Return JSON {best:{target: {index:int, score:float}}}",
            {"user_query": user_query, "observations": observations}, max_tokens=220
        )
    except Exception:
        # trivial fallback: first success per target
        best: Dict[str, Dict[str, Any]] = {}
        for ob in observations:
            tgt = ob.get("step", {}).get("target")
            if tgt and "result" in ob and tgt not in best:
                best[tgt] = {"index": ob.get("step_index", 0), "score": 0.6}
        scored = {"best": best}

    # materialize best results map
    latest: Dict[str, Any] = {}
    for tgt, meta in (scored.get("best") or {}).items():
        idx = meta.get("index")
        if isinstance(idx, int) and 0 <= idx < len(observations):
            ob = observations[idx]
            if "result" in ob:
                latest[tgt] = ob["result"]
    if not latest:  # last-resort sweep
        for ob in reversed(observations):
            tgt = ob.get("step", {}).get("target")
            if tgt and "result" in ob and tgt not in latest:
                latest[tgt] = ob["result"]
    return latest

# ==================== Validator ====================
def validate_consistency(user_query: str, answers_by_target: Dict[str, Any], filters: Optional[dict]) -> dict:
    cleaned = sanitize_map(answers_by_target or {})
    try:
        out = claude_json(
            VALIDATOR_SYSTEM,
            {"user_query": user_query, "filters": filters or {}, "answers_by_target": cleaned},
            max_tokens=256
        )
        ok = bool(out.get("ok", True))
        reasons = out.get("reasons") or []
        which = out.get("which") or {}
        return {"ok": ok, "reasons": reasons, "which": which}
    except Exception:
        # If validator fails, do not block a valid answer
        return {"ok": True, "reasons": [], "which": {}}

