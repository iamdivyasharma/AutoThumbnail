# ======== NL helpers: parse trip from free text (IATA + dates) ========
_TRIP_DATES = re.compile(
    r"(?P<start>(?:\d{4}[-/]\d{1,2}[-/]\d{1,2})|(?:\w{3,9}\s+\d{1,2},?\s*\d{4})|(?:\w{3}\s+\d{1,2}(?:-\d{1,2})?,?\s*\d{4}))"
    r"\s*(?:to|-|–|—)\s*"
    r"(?P<end>(?:\d{4}[-/]\d{1,2}[-/]\d{1,2})|(?:\w{3,9}\s+\d{1,2},?\s*\d{4})|(?:\w{3}\s+\d{1,2},?\s*\d{4}))",
    re.IGNORECASE
)
_IATA = re.compile(r"\b([A-Z]{3})\b")

def _norm_date_iso(d: str) -> str:
    d = d.replace("/", "-").strip()
    try:
        from dateutil import parser  # optional; if not available, we leave as-is
        return parser.parse(d, dayfirst=False).date().isoformat()
    except Exception:
        return d

def map_city_to_iata(token: str) -> str | None:
    t = token.strip().lower()
    return CITY_TO_IATA_PRIMARY.get(t)

def try_parse_trip_from_text(text: str):
    if not text:
        return None
    # 1) find IATA codes if present
    codes = [m.group(1) for m in _IATA.finditer(text.upper())]
    origin = dest = None
    for c in codes:
        if origin is None:
            origin = c
        elif c != origin:
            dest = c
            break

    # 2) try city names (fallback if IATA missing)
    if origin is None or dest is None:
        # naive split around " to "
        parts = re.split(r"\bto\b", text, flags=re.IGNORECASE)
        if len(parts) >= 2:
            lhs = parts[0]
            rhs = parts[1]
            cand_o = None
            cand_d = None
            # scan words near edges
            left_tokens  = re.findall(r"[A-Za-z ]{2,}", lhs.strip())[-3:] if lhs.strip() else []
            right_tokens = re.findall(r"[A-Za-z ]{2,}", rhs.strip())[:3] if rhs.strip() else []
            for tok in reversed(left_tokens):
                code = map_city_to_iata(tok)
                if code:
                    cand_o = code
                    break
            for tok in right_tokens:
                code = map_city_to_iata(tok)
                if code:
                    cand_d = code
                    break
            origin = origin or cand_o
            dest   = dest or cand_d

    # 3) dates
    start = end = None
    m = _TRIP_DATES.search(text)
    if m:
        start, end = _norm_date_iso(m.group("start")), _norm_date_iso(m.group("end"))

    if origin and dest and start and end and origin != dest:
        return {"origin": origin, "destination": dest, "start_date": start, "end_date": end}
    return None

# ================== TDNA Bootstrap ==================
DEFAULT_TDNA_QUESTION = "What is the home airport?"

def _extract_home_airport(answer_text: str) -> tuple[str|None, str|None]:
    if not isinstance(answer_text, str) or not answer_text.strip():
        return None, None
    # 1) exact IATA
    for code in ORIGIN_OPTIONS:
        if re.search(rf"\b{re.escape(code)}\b", answer_text, re.IGNORECASE):
            return code, label_for(code)
    # 2) fuzzy by name parts
    lower = answer_text.lower()
    for code, full in AIRPORT_LABELS.items():
        name_parts = re.split(r"[—\-(),]", full)
        if any(p.strip().lower() and p.strip().lower() in lower for p in name_parts):
            if code in ORIGIN_OPTIONS:
                return code, label_for(code)
    return None, None

def tdna_bootstrap(user_name: str, user_email: str, session_id: str):
    """Call TDNA once via /route_query with target='tdna'."""
    payload = {
        "query": DEFAULT_TDNA_QUESTION,
        "session_id": session_id,
        "target": "tdna",
        "extra": {"user_name": user_name.strip(), "user_email": user_email.strip(), "source": "tdna_boot"},
    }
    with st.status("Asking TDNA for home airport…", expanded=False) as s:
        try:
            status, data = post(ROUTE_URL, payload)
            raw = ""
            if isinstance(data, dict):
                raw = data.get("answer", "") or data.get("final_answer", "") or ""
            else:
                raw = str(data)
            s.update(label="TDNA responded", state="complete")
        except Exception as e:
            st.error(f"TDNA error: {e}")
            st.session_state.boot_tdna_home = True
            return
    code, label = _extract_home_airport(raw)
    st.session_state.tdna_home_code = code
    st.session_state.tdna_home_label = label
    st.session_state.boot_tdna_home = True

