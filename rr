# ragbot_api.py
# Minimal FastAPI wrapper for Ragbot.py (no CORS, no env vars)
# Run: uvicorn ragbot_api:app --host 0.0.0.0 --port 8000
# Place Ragbot.py in the same folder and implement one of:
#   get_answer(payload) OR answer(payload) OR query(payload)

from typing import Callable, Optional
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
import Ragbot  # simple, direct import from same folder

app = FastAPI(title="Ragbot API", version="1.0.0", docs_url="/docs")

# Strict payload
class QueryPayload(BaseModel):
    query: str = Field(..., min_length=1)
    user_name: str = Field(..., min_length=1)
    user_email: str = Field(..., min_length=3)

    class Config:
        extra = "forbid"  # reject unexpected keys

class AnswerResponse(BaseModel):
    answer: str

# pick first available handler
def pick_handler(mod) -> Optional[Callable]:
    for fn_name in ("get_answer", "answer", "query"):
        fn = getattr(mod, fn_name, None)
        if callable(fn):
            return fn
    return None

handler: Optional[Callable] = pick_handler(Ragbot)
if handler is None:
    raise RuntimeError("Implement get_answer(payload) or answer(payload) or query(payload) in Ragbot.py")

@app.get("/health")
def health():
    return {"status": "ok"}

@app.post("/ask", response_model=AnswerResponse)
def ask(payload: QueryPayload):
    clean = {
        "query": payload.query.strip(),
        "user_name": payload.user_name.strip(),
        "user_email": payload.user_email.strip(),
    }
    try:
        out = handler(clean)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Ragbot error: {e}") from e
    return {"answer": str(out)}
