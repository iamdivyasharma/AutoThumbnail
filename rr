app = FastAPI(title="Agentic Orchestrator (MCP over HTTP JSON)")

# ----- Schemas -----
class RouteIn(BaseModel):
    query: str
    extra: Optional[Dict[str, Any]] = None
    target: Optional[str] = None
    targets: Optional[List[str]] = None
    session_id: str = "default"

class RouteOut(BaseModel):
    tool: str = "route_query_tool"
    targets: List[str]
    routed_by: str
    answer: Any
    answers_by_target: Optional[Dict[str, Any]] = None
    errors: Optional[Dict[str, str]] = None

class AgentIn(BaseModel):
    query: str
    extra: Optional[Dict[str, Any]] = None
    session_id: str = "default"
    max_iters: int = 3
    parallel_cap: int = 2
    autonomy: bool = True
    answer_schema: Optional[Dict[str, Any]] = None

class AgentOut(BaseModel):
    tool: str = "agent_query_tool"
    session_id: str
    iterations: int
    final_answer: Any
    observations: List[Dict[str, Any]]
    autonomy: bool
    trace_id: str

# ==================== /route_query (simple router; generally unused for planning) ====================
@app.post("/route_query", operation_id="route_query_tool", response_model=RouteOut)
async def route_query(inp: RouteIn = Body(...)):
    q_orig, extra, sid = inp.query, inp.extra, inp.session_id
    mem_append(sid, "user", q_orig)
    compress_history_if_needed(sid)

    q = q_orig  # keep raw (the UI may use this only for TDNA home bootstrap)
    extra_aug = dict(extra or {})
    extra_aug["conversation_window"] = mem_get(sid, 6)

    if inp.targets:
        targets, routed_by = [t for t in inp.targets if t in SERVICES], "hint:list"
    elif inp.target in SERVICES:
        targets, routed_by = [inp.target], "hint:single"
    elif inp.target == "both":
        targets, routed_by = ["hotel", "air"], "hint:both"
    else:
        targets, routed_by = ["hotel"], "default"

    results: Dict[str, Any] = {}
    errors: Dict[str, str] = {}

    if len(targets) <= 1:
        tgt = targets[0] if targets else "hotel"
        try:
            out = await call_backend(tgt, q, extra_aug, sid)
            results[tgt] = out
        except Exception as e:
            errors[tgt] = f"{type(e).__name__}: {e}"
    else:
        coros = [call_backend(t, q, extra_aug, sid) for t in targets]
        outs = await asyncio.gather(*coros, return_exceptions=True)
        for t, out in zip(targets, outs):
            if isinstance(out, Exception):
                errors[t] = f"{type(out).__name__}: {out}"
            else:
                results[t] = out

    if len(results) > 1:
        answer = compose_final(q, results, answer_schema=None)
        answers_by_target = sanitize_map(results)
    else:
        answer = sanitize_answer(next(iter(results.values()), ""))
        answers_by_target = None

    mem_append(sid, "assistant", answer)

    return RouteOut(
        targets=targets, routed_by=routed_by, answer=answer,
        answers_by_target=answers_by_target or None,
        errors=(errors or None)
    )

# ==================== /agent_query (NL trip detection + TDNA/AIR/HOTEL flow) ====================
@app.post("/agent_query", operation_id="agent_query_tool", response_model=AgentOut)
async def agent_query(inp: AgentIn = Body(...)):
    q_raw, extra, sid = inp.query, inp.extra, inp.session_id
    trace_id = _h({"sid": sid, "t": time(), "nonce": random.random()})

    mem_append(sid, "user", q_raw)
    compress_history_if_needed(sid)

    # Use raw text for NL extraction; keep rewrite only for context-aware follow-ups if needed later
    q = q_raw
    extra_aug = dict(extra or {})
    extra_aug["conversation_window"] = mem_get(sid, 6)

    observations: List[Dict[str, Any]] = []
    final_answer: Optional[str] = None

    # ---- (A) TDNA home-airport bootstrap (internal, once per session) ----
    boot_key = "tdna_boot_home_done"
    if not MEMORY[sid].get(boot_key):
        try:
            home_ans = await call_backend("tdna", "What is the home airport?", extra_aug, sid)
            observations.append({"step_index": -1, "step": {"target":"tdna","input":"What is the home airport?"}, "result": home_ans})
        except Exception as e:
            observations.append({"step_index": -1, "step": {"target":"tdna","input":"What is the home airport?"}, "error": f"{type(e).__name__}: {e}"})
        MEMORY[sid][boot_key] = True  # mark done

    # ---- (B) Determine trip: prefer explicit filters; else parse from text ----
    fil = (extra or {}).get("filters") or {}
    ond = fil.get("ond") or {}
    origin = ond.get("origin")
    dest   = ond.get("destination")
    start  = fil.get("start_date")
    end    = fil.get("end_date")

    if not (origin and dest and start and end) and q_raw:
        guessed = try_parse_trip_from_text(q_raw)
        if guessed:
            origin = guessed["origin"]; dest = guessed["destination"]
            start  = guessed["start_date"]; end  = guessed["end_date"]

    def have_trip() -> bool:
        return bool(origin and dest and start and end and origin != dest)

    # ---- (C) If we have a trip, run AIR + HOTEL + TDNA(history) in parallel ----
    if have_trip():
        main_trip_query = f"plan me a trip from {origin} to {dest} on {start} to {end}"
        air_query   = f"{main_trip_query}. Provide me the best flight for this trip + default query"
        hotel_query = f"{main_trip_query}. Provide best hotels for this trip + default query"
        tdna_hist_q = "this user travel history"

        try:
            air_coro   = call_backend("air",   air_query,   extra_aug, sid)
            hotel_coro = call_backend("hotel", hotel_query, extra_aug, sid)
            tdna_coro  = call_backend("tdna",  tdna_hist_q, extra_aug, sid)
            air_res, hotel_res, tdna_res = await asyncio.gather(air_coro, hotel_coro, tdna_coro, return_exceptions=True)

            if isinstance(air_res, Exception):
                observations.append({"step_index": 0, "step": {"target": "air", "input": air_query}, "error": f"{type(air_res).__name__}: {air_res}"})
                air_best = ""
            else:
                observations.append({"step_index": 0, "step": {"target": "air", "input": air_query}, "result": air_res})
                air_best = air_res

            if isinstance(hotel_res, Exception):
                observations.append({"step_index": 1, "step": {"target": "hotel", "input": hotel_query}, "error": f"{type(hotel_res).__name__}: {hotel_res}"})
                hotel_best = ""
            else:
                observations.append({"step_index": 1, "step": {"target": "hotel", "input": hotel_query}, "result": hotel_res})
                hotel_best = hotel_res

            if isinstance(tdna_res, Exception):
                observations.append({"step_index": 2, "step": {"target": "tdna", "input": tdna_hist_q}, "error": f"{type(tdna_res).__name__}: {tdna_res}"})
                tdna_hist = ""
            else:
                observations.append({"step_index": 2, "step": {"target": "tdna", "input": tdna_hist_q}, "result": tdna_res})
                tdna_hist = tdna_res

        except Exception as e:
            observations.append({"step_index": 99, "error": f"{type(e).__name__}: {e}"})
            tdna_hist, air_best, hotel_best = "", "", ""

        latest = {"air": air_best, "hotel": hotel_best, "tdna": tdna_hist}
        final_answer = compose_final(main_trip_query, latest, inp.answer_schema)

    # ---- (D) Otherwise, fall back to generic planning loop ----
    if final_answer is None:
        for _iter in range(max(1, min(inp.max_iters, 6))):
            try:
                plan_raw = claude_json(
                    'Plan a minimal DAG of tool calls. Return ONLY JSON {"steps":[{target,input,after?}], "finish": false, "final_answer": ""}',
                    {"user_query": q, "memory": mem_get(sid, 6), "observations": observations[-4:], "tool_caps": TOOL_CAPS, "hints": PLANNING_HINTS},
                    max_tokens=300
                )
                plan = Plan(**plan_raw)
            except Exception:
                plan = Plan(steps=[Step(target="hotel", input=q)])

            if plan.finish and plan.final_answer:
                final_answer = plan.final_answer
                break

            batch_obs = await execute_steps(plan.steps, q, extra_aug, sid, inp.parallel_cap)
            observations.extend(batch_obs)

            if not inp.autonomy:
                latest = score_observations(q, observations)
                final_answer = compose_final(q, latest, inp.answer_schema) if latest else "No result."
                break

            try:
                fin_raw = claude_json(
                    'If observations satisfy the goal, return {"finish": true, "final_answer": "..."} else {"finish": false}.',
                    {"user_query": q, "memory": mem_get(sid, 6), "observations": batch_obs}, max_tokens=180
                )
                fin = FinishDecision(**fin_raw)
            except Exception:
                fin = FinishDecision(finish=False)
            if fin.finish:
                final_answer = fin.final_answer or ""
                break

        if final_answer is None:
            latest = score_observations(q, observations)
            final_answer = compose_final(q, latest, inp.answer_schema) if latest else "No result."

    # ---- Critic pass (single attempt) ----
    try:
        critic = claude_json(
            'Check final_answer for relevance/consistency. Return {"ok":true} or {"ok":false,"revise":"..."}',
            {"user_query": q, "final_answer": final_answer, "observations": observations[-6:]},
            max_tokens=220
        )
        if not critic.get("ok") and critic.get("revise"):
            final_answer = critic.get("revise")
    except Exception:
        pass

    final_answer = sanitize_answer(final_answer)
    mem_append(sid, "assistant", final_answer)

    iters = len([ob for ob in observations if "result" in ob or "error" in ob])

    return AgentOut(
        session_id=sid,
        iterations=iters,
        final_answer=final_answer,
        observations=observations[-8:],
        autonomy=inp.autonomy,
        trace_id=_h({"sid": sid, "n": iters, "t": time()})
    )

