#!/usr/bin/env python3
# index_clients.py — Textract-only (no S3 list/get), per-client FAISS indexer
# - Input: PREDEFINED list of S3 PDF URIs
# - Extractor: AmazonTextractPDFLoader (works for scanned + editable PDFs)
# - Chunking: per-page text -> fixed-size text chunks with overlap
# - Output: FAISS under FAISS_INDEX_DIR/<client>/ and manifest.json per client
# - No PyMuPDF, no pytesseract, no S3 GetObject/ListObjects — only Textract + Bedrock

from __future__ import annotations

import os
import re
import json
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Tuple, Iterable

import boto3
from langchain_aws import BedrockEmbeddings
from langchain_community.vectorstores import FAISS
from langchain.schema import Document

# ============ FILL THIS: your fixed list of S3 PDFs ============
S3_PDF_URIS: List[str] = [
    # "s3://your-bucket/ALL_PDFS/ClientA__policy1.pdf",
    # "s3://your-bucket/ALL_PDFS/ClientB-contract-2024.pdf",
]

# ============ Paths / AWS ============
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()

REGION = "us-east-1"
SESSION = boto3.Session(region_name=REGION)
BEDROCK_RT = SESSION.client("bedrock-runtime")
TEXTRACT   = SESSION.client("textract")

# LangChain Textract loader
from langchain_community.document_loaders import AmazonTextractPDFLoader

# ============ Models / chunking ============
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
CHUNK_SIZE = 1200
CHUNK_OVERLAP = 150

# ============ Helpers ============

def client_from_filename(path_or_uri: str) -> str:
    """
    Use everything before the first delimiter as client id.
    Delimiters: '__' (preferred), '_' or '-'.
    Examples:
      'BMW US_policy1.pdf'        -> 'bmw us'
      'Ernst & Young--doc.pdf'    -> 'ernst & young'
      'kpmg__benefits_2024.pdf'   -> 'kpmg'
    """
    base = os.path.basename(path_or_uri)
    stem = os.path.splitext(base)[0]
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()

def clean_text(t: str) -> str:
    return re.sub(r"[ \t]+\n", "\n", (t or "")).strip()

def chunk_text(text: str, chunk_size: int = CHUNK_SIZE, overlap: int = CHUNK_OVERLAP) -> List[Tuple[int, int, str]]:
    """
    Return list of (start_idx, end_idx, chunk_text).
    """
    text = text or ""
    n = len(text)
    if n == 0:
        return []
    if n <= chunk_size:
        return [(0, n, text)]
    chunks: List[Tuple[int, int, str]] = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        chunks.append((start, end, text[start:end]))
        if end == n:
            break
        start = max(0, end - overlap)
    return chunks

@dataclass
class DocInfo:
    policy_id: str
    source_file: str  # s3://...
    pages: int
    modified_time: int  # unknown without S3 HeadObject → use 0

def embedder():
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=BEDROCK_RT)

def textract_by_page(s3_uri: str) -> Dict[int, str]:
    """
    Use AmazonTextractPDFLoader directly on an S3 URI.
    Returns {page_number: text}. If page metadata missing, collapses to page 1.
    """
    pages: Dict[int, str] = {}
    try:
        loader = AmazonTextractPDFLoader(file_path=s3_uri, client=TEXTRACT)
        docs = loader.load()  # list[Document]; usually each has metadata["page"]
        if not docs:
            return pages

        any_page_meta = any(int(d.metadata.get("page", 0) or 0) > 0 for d in docs)
        if any_page_meta:
            for d in docs:
                p = int(d.metadata.get("page", 0) or 0) or 1
                pages.setdefault(p, "")
                pages[p] += ("\n\n" if pages[p] else "") + clean_text(d.page_content or "")
        else:
            full = "\n\n".join(clean_text(d.page_content or "") for d in docs)
            if full.strip():
                pages[1] = full
    except Exception as e:
        print(f"[WARN] Textract failed for {s3_uri}: {e}")
    return pages

def yield_chunks_for_pdf(s3_uri: str, client_id: str) -> Iterable[Document]:
    """
    Extract with Textract and yield LangChain Document chunks with useful metadata.
    """
    policy_id = os.path.basename(s3_uri)
    page_texts = textract_by_page(s3_uri)
    for pno in sorted(page_texts.keys()):
        text = clean_text(page_texts[pno])
        if not text:
            continue
        for _, _, chunk in chunk_text(text):
            if not chunk.strip():
                continue
            meta = {
                "client_id": client_id,
                "policy_id": policy_id,
                "page": int(pno),
                "source_file": s3_uri,      # keep canonical S3 URI
                "extracted_by": "textract",
            }
            yield Document(page_content=chunk, metadata=meta)

def group_uris_by_client(uris: List[str]) -> Dict[str, List[str]]:
    by: Dict[str, List[str]] = {}
    for uri in uris:
        cid = client_from_filename(uri)
        by.setdefault(cid, []).append(uri)
    for k in by:
        by[k] = sorted(by[k], key=str.lower)
    return by

def index_client(client_id: str, s3_uris: List[str]) -> None:
    client_dir = (FAISS_INDEX_DIR / client_id)
    client_dir.mkdir(parents=True, exist_ok=True)

    docs: List[Document] = []
    manifest_rows: List[DocInfo] = []

    for uri in s3_uris:
        # Extract via Textract
        page_texts = textract_by_page(uri)
        pages = (max(page_texts.keys()) if page_texts else 0)

        for d in yield_chunks_for_pdf(uri, client_id):
            docs.append(d)

        manifest_rows.append(DocInfo(
            policy_id=os.path.basename(uri),
            source_file=uri,
            pages=pages,
            modified_time=0,  # we aren't calling HeadObject by design
        ))

    if not docs:
        print(f"[{client_id}] No extractable text; skipping index.")
        return

    # Build & save FAISS
    print(f"[{client_id}] Building FAISS with {len(docs)} chunks…")
    vs = FAISS.from_documents(docs, embedder())
    vs.save_local(str(client_dir))

    # Save manifest.json
    manifest = {
        "client_id": client_id,
        "docs": [
            {
                "policy_id": m.policy_id,
                "source_file": m.source_file,
                "pages": m.pages,
                "modified_time": m.modified_time,
            }
            for m in manifest_rows
        ],
        "generated_time": int(time.time()),
    }
    (client_dir / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    print(f"[{client_id}] Done. Index at {client_dir}")

def main():
    if not S3_PDF_URIS:
        raise SystemExit("S3_PDF_URIS is empty. Add your s3:// PDF links at the top.")
    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)
    grouped = group_uris_by_client(S3_PDF_URIS)
    print(f"Found {sum(len(v) for v in grouped.values())} PDFs across {len(grouped)} client(s).")
    for client_id, uris in grouped.items():
        index_client(client_id, uris)

if __name__ == "__main__":
    main()
