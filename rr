# ---- Load per-client overrides from YAML (for aliases & optional chunking) ----
from pathlib import Path
import yaml

# Point this to your real file
CONFIGS_PATH = Path("/ABS/PATH/TO/configs/clients.yaml").resolve()

def load_yaml_overrides() -> dict:
    if not CONFIGS_PATH.exists():
        return {}
    data = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    # normalize keys to lowercase
    return {str(k).strip().lower(): (v or {}) for k, v in data.items()}

OVERRIDES = load_yaml_overrides()
