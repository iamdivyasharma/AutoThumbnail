import pandas as pd

INPUT = "client_clause_matrix.xlsx"
OUTPUT = "ahaooob_clients_only.xlsx"

df = pd.read_excel(INPUT)

def club_clients(group: pd.DataFrame) -> str:
    names = (group["Client Name"]
             .dropna()
             .astype(str)
             .str.strip()
             .unique())
    return ", ".join(sorted(names, key=str.lower))

out = (
    df.groupby(["Clauses","Sub Clauses"], as_index=False)
      .apply(lambda g: club_clients(g))
      .rename(columns={None: "Clients"})[["Clauses","Sub Clauses","Clients"]]
)

out.to_excel(OUTPUT, index=False)
print(f"Saved: {OUTPUT}")
