#!/usr/bin/env python3
import os, re, hashlib
import pandas as pd
from pathlib import Path
from langchain_aws import ChatBedrockConverse
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser
from boto3 import Session

INPUT  = "client_clause_matrix.xlsx"
OUTPUT = "ahaooob_clause_subclause_content.xlsx"

# ---- LLM config ----
REGION    = os.getenv("AWS_REGION", "us-east-1")
LLM_MODEL = os.getenv("LLM_MODEL", "anthropic.claude-3-5-sonnet-20240620-v1:0")
TEMPERATURE = 0.1
MAX_TOKENS  = 300   # small, because we want short summaries
MAX_CHARS_PER_BULLET = 240  # final safety clamp per bullet

# Single, reusable prompt
SUMMARY_PROMPT = ChatPromptTemplate.from_messages([
    ("system",
     "You compress contract snippets into crisp 1-2 sentence summaries. "
     "Keep concrete facts (numbers, timelines, obligations). No line breaks, no bullets, no client names."),
    ("human",
     "Clause: {clause}\nSub-Clause: {subclause}\n\nText:\n{content}\n\n"
     "Write a concise 1–2 sentence summary (<= 240 characters).")
])
PARSER = StrOutputParser()

def _shorten(s: str, limit: int) -> str:
    s = re.sub(r"\s+", " ", (s or "").strip())
    if len(s) <= limit: return s
    cut = s[:limit]
    i = max(cut.rfind(". "), cut.rfind("; "), cut.rfind(", "), cut.rfind(" "))
    return (cut[:i].rstrip() if i > 40 else cut.rstrip()) + "…"

def main():
    if not Path(INPUT).exists():
        raise SystemExit(f"Missing input: {INPUT}")
    df = pd.read_excel(INPUT)

    # Basic sanity: required columns
    need = {"Client Name","Clauses","Sub Clauses","Content"}
    miss = need - set(df.columns)
    if miss:
        raise SystemExit(f"Missing columns in {INPUT}: {sorted(miss)}")

    # LLM
    session = Session(region_name=REGION)
    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=session.client("bedrock-runtime"),
        temperature=float(TEMPERATURE),
        max_tokens=int(MAX_TOKENS)
    )

    # Cache summaries to avoid repeat calls on identical content
    cache = {}
    def summarize_row(row) -> str:
        text = (row.get("Content") or "").strip()
        if not text:
            return ""
        key = hashlib.sha256(text.encode("utf-8")).hexdigest()
        if key in cache:
            return cache[key]
        chain = SUMMARY_PROMPT | llm | PARSER
        out = (chain.invoke({
            "clause": row["Clauses"],
            "subclause": row["Sub Clauses"],
            "content": text
        }) or "").strip()
        out = _shorten(out, MAX_CHARS_PER_BULLET)
        cache[key] = out
        return out

    # Make a summarized column
    df["Content_Short"] = df.apply(summarize_row, axis=1)

    # Group and club into bullets (client: summary)
    def club(group: pd.DataFrame) -> str:
        bullets, seen = [], set()
        for _, r in group.sort_values(["Client Name"]).iterrows():
            s = (r.get("Content_Short") or "").strip()
            if not s: continue
            b = f"- {r['Client Name']}: {s}"
            if b in seen: continue
            seen.add(b); bullets.append(b)
        return "\n".join(bullets)

    out = (
        df.groupby(["Clauses","Sub Clauses"], as_index=False)
          .apply(club)
          .rename(columns={None: "Content"})[["Clauses","Sub Clauses","Content"]]
    )

    out.to_excel(OUTPUT, index=False)
    print(f"Saved: {OUTPUT}")

if __name__ == "__main__":
    main()
