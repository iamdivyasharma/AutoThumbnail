# replace your _list_client_pdfs with this
from datetime import datetime

def _list_client_pdfs(client_id: str) -> List[Dict[str, Any]]:
    client = client_id.strip().lower()
    pdfs: List[Dict[str, Any]] = []
    # use rglob if PDFs are in subfolders; otherwise glob("*.pdf")
    for p in PDF_ROOT.rglob("*.pdf"):
        if not p.is_file():
            continue
        if p.name.startswith((".", "~$")):
            continue
        # your naming rule: client id is before first "_" or "-"
        if _get_client_id_from_filename(p.name) != client:
            continue

        abs_path = str(p.resolve())
        pages = get_pdf_page_count_local(abs_path)
        stat = p.stat()
        pdfs.append({
            "policy_id": p.name,
            "source_file": abs_path,  # absolute local path
            "pages": pages,
            "client_id": client,
            "modified_time": int(stat.st_mtime),
            "modified_iso": datetime.fromtimestamp(stat.st_mtime).isoformat(timespec="seconds"),
        })
    return sorted(pdfs, key=lambda x: x["policy_id"])
