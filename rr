#!/usr/bin/env python3
# index_clients.py
# Build per-client FAISS indexes from PDFs with native text + OCR fallback.
# - Single-page image PDFs: AmazonTextractPDFLoader
# - Native text: PyMuPDF
# - OCR: pytesseract (Tesseract), with word box coordinates converted to PDF points
# - Embeddings: Bedrock
# - Output: FAISS under FAISS_INDEX_DIR/<client>/, manifest.json per client

from __future__ import annotations

import os
import re
import json
import math
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Tuple, Iterable, Optional

import fitz  # PyMuPDF
import pytesseract
from PIL import Image

from langchain_aws import BedrockEmbeddings
from langchain_community.vectorstores import FAISS
from langchain.schema import Document

# NEW: Textract loader for single-page image PDFs
try:
    from langchain_community.document_loaders import AmazonTextractPDFLoader
    _HAS_TEXTRACT_LOADER = True
except Exception:
    _HAS_TEXTRACT_LOADER = False

# ========= EDIT THESE ABSOLUTE PATHS =========
# All PDFs now live under ALL_PDFS/
PDF_ROOT        = Path("ALL_PDFS").resolve()
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()

# ========= AWS / Bedrock =========
REGION = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

# ⚠️ Dev creds (prefer IAM roles in prod)
AWS_ACCESS_KEY_ID     = os.environ.get("AWS_ACCESS_KEY_ID", "YOUR_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.environ.get("AWS_SECRET_ACCESS_KEY", "YOUR_SECRET_ACCESS_KEY")

from boto3 import Session
SESSION = Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)

# ========= Chunking params =========
CHUNK_SIZE = 1200
CHUNK_OVERLAP = 150

# ========= OCR params =========
USE_OCR = True                 # set False to disable OCR fallback
OCR_DPI = 200                  # rendering DPI for OCR images (200–300 is typical)
OCR_LANG = "eng"               # change/add languages like "eng+deu"
TESSERACT_CMD = os.environ.get("TESSERACT_CMD")  # optional explicit path to tesseract binary

if TESSERACT_CMD:
    pytesseract.pytesseract.tesseract_cmd = TESSERACT_CMD

# ========= Helpers =========

def client_from_filename(name: str) -> str:
    """
    Use everything before the first delimiter as client id.
    Delimiters: '__' (preferred), '_' or '-'. Spaces are preserved.
    Examples:
      'BMW US_policy1.pdf'        -> 'bmw us'
      'Ernst & Young--doc.pdf'    -> 'ernst & young'
      'kpmg__benefits_2024.pdf'   -> 'kpmg'
    """
    stem = Path(name).stem
    if "__" in stem:
        head = stem.split("__", 1)[0]
    else:
        head = re.split(r"[_-]", stem, maxsplit=1)[0]
    return head.strip().lower()

def clean_text(t: str) -> str:
    # Light cleanup; keep punctuation and newlines
    return re.sub(r"[ \t]+\n", "\n", t).strip()

def chunk_text(text: str, chunk_size: int = CHUNK_SIZE, overlap: int = CHUNK_OVERLAP) -> List[Tuple[int, int, str]]:
    """
    Return list of (start_idx, end_idx, chunk_text).
    """
    text = text or ""
    n = len(text)
    if n <= chunk_size:
        return [(0, n, text)]
    chunks = []
    start = 0
    while start < n:
        end = min(n, start + chunk_size)
        chunk = text[start:end]
        chunks.append((start, end, chunk))
        if end == n: break
        start = end - overlap
        if start < 0: start = 0
    return chunks

def words_to_pdf_points(words: List[Dict], page_rect: fitz.Rect, img_w: int, img_h: int) -> List[Dict]:
    """
    Convert pytesseract image-pixel boxes to PDF points using page_rect.
    pytesseract image_to_data returns left, top, width, height in image pixels.
    """
    px_w, px_h = float(img_w), float(img_h)
    pdf_w = float(page_rect.width)
    pdf_h = float(page_rect.height)
    scale_x = pdf_w / px_w if px_w else 1.0
    scale_y = pdf_h / px_h if px_h else 1.0

    out = []
    for w in words:
        try:
            x = float(w["left"]) * scale_x + float(page_rect.x0)
            y = float(w["top"]) * scale_y + float(page_rect.y0)
            w_pt = float(w["width"]) * scale_x
            h_pt = float(w["height"]) * scale_y
            out.append({
                "text": w.get("text", ""),
                "x": x, "y": y,
                "width": w_pt, "height": h_pt,
            })
        except Exception:
            continue
    return out

def ocr_page_to_words(page: fitz.Page, dpi: int = OCR_DPI, lang: str = OCR_LANG) -> Tuple[str, List[Dict]]:
    """
    Render page -> PIL Image -> pytesseract -> returns (full_text, word_boxes_in_pdf_points).
    """
    mat = fitz.Matrix(dpi / 72.0, dpi / 72.0)
    pix = page.get_pixmap(matrix=mat, alpha=False)  # RGB
    img = Image.frombytes("RGB", [pix.width, pix.height], pix.samples)

    data = pytesseract.image_to_data(img, lang=lang, output_type=pytesseract.Output.DICT)
    # data keys: level,page_num,block_num,par_num,line_num,word_num,left,top,width,height,conf,text
    words = []
    assembled_lines: Dict[int, List[str]] = {}
    for i, t in enumerate(data.get("text", [])):
        t = (t or "").strip()
        if not t:
            continue
        word = {
            "text": t,
            "left": data["left"][i],
            "top": data["top"][i],
            "width": data["width"][i],
            "height": data["height"][i],
        }
        words.append(word)
        line_id = (data["block_num"][i], data["par_num"][i], data["line_num"][i])
        assembled_lines.setdefault(line_id, []).append(t)

    # Build "full_text" from lines, preserving order
    if assembled_lines:
        full_text = "\n".join([" ".join(assembled_lines[k]) for k in sorted(assembled_lines.keys())])
    else:
        full_text = " ".join([w["text"] for w in words])

    pdf_words = words_to_pdf_points(words, page.rect, pix.width, pix.height)
    return full_text, pdf_words

@dataclass
class DocInfo:
    policy_id: str
    source_file: str
    pages: int
    modified_time: int

def scan_pdfs(root: Path) -> Dict[str, List[Path]]:
    out: Dict[str, List[Path]] = {}
    for p in root.rglob("*.pdf"):
        cid = client_from_filename(p.name)
        out.setdefault(cid, []).append(p)
    # sort deterministically
    for k in out:
        out[k] = sorted(out[k], key=lambda x: x.name.lower())
    return out

def build_manifest_entry(pdf_path: Path) -> DocInfo:
    try:
        with fitz.open(str(pdf_path)) as doc:
            pages = doc.page_count
    except Exception:
        pages = None
    stat = pdf_path.stat()
    return DocInfo(
        policy_id=pdf_path.name,
        source_file=str(pdf_path.resolve()),
        pages=pages or 0,
        modified_time=int(stat.st_mtime),
    )

def embedder():
    return BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))

# --- NEW: Textract-based extractor for single-page image PDFs ---
def extract_with_textract(pdf_path: Path) -> str:
    """
    Use AmazonTextractPDFLoader to extract text from a single-page image PDF.
    Falls back to empty string on any error.
    """
    if not _HAS_TEXTRACT_LOADER:
        print(f"[WARN] AmazonTextractPDFLoader not available; skipping Textract for {pdf_path.name}")
        return ""
    try:
        # Per your spec: AmazonTextractPDFLoader('pdffilename.pdf'); loader.load()
        loader = AmazonTextractPDFLoader(str(pdf_path))
        docs = loader.load()  # list[Document]
        textract_text = "\n\n".join((d.page_content or "").strip() for d in docs if d and d.page_content)
        return clean_text(textract_text)
    except Exception as e:
        print(f"[WARN] Textract extraction failed for {pdf_path.name}: {e}")
        return ""

def make_chunks_for_pdf(pdf_path: Path, client_id: str) -> Iterable[Document]:
    """
    Yield LangChain Documents (chunks) with metadata including OCR words.
    For single-page PDFs: use AmazonTextractPDFLoader (image-PDF path).
    For multi-page PDFs: use native text + OCR fallback (existing logic).
    """
    policy_id = pdf_path.name
    with fitz.open(str(pdf_path)) as doc:
        # --- NEW BRANCH: treat ANY single-page PDF as an image PDF and use Textract ---
        if doc.page_count == 1:
            full_text = extract_with_textract(pdf_path)
            if not full_text.strip():
                # If Textract failed or returned empty, fall back to the old 1-page flow
                page = doc.load_page(0)
                text = clean_text(page.get_text("text") or "")
                ocr_words: List[Dict] = []
                if USE_OCR and len(text) < 120:
                    try:
                        ocr_text, ocr_words = ocr_page_to_words(page)
                        ocr_text = clean_text(ocr_text)
                        if len(ocr_text) > len(text):
                            text = ocr_text
                    except Exception:
                        pass
                for _, _, chunk in chunk_text(text):
                    meta = {
                        "client_id": client_id,
                        "policy_id": policy_id,
                        "page": 1,
                        "source_file": str(pdf_path.resolve()),
                    }
                    if ocr_words:
                        meta["ocr_words"] = ocr_words
                    yield Document(page_content=chunk, metadata=meta)
            else:
                # Successful Textract path
                for _, _, chunk in chunk_text(full_text):
                    meta = {
                        "client_id": client_id,
                        "policy_id": policy_id,
                        "page": 1,  # single-page image PDF
                        "source_file": str(pdf_path.resolve()),
                        "extracted_by": "textract",
                    }
                    yield Document(page_content=chunk, metadata=meta)
            return  # single-page handled; stop here

        # --- ORIGINAL MULTI-PAGE FLOW ---
        for pnum in range(doc.page_count):
            page = doc.load_page(pnum)

            # 1) Native text
            text = page.get_text("text") or ""
            text = clean_text(text)

            ocr_words: List[Dict] = []
            if USE_OCR and len(text) < 120:  # threshold: short/empty -> likely scanned
                try:
                    ocr_text, ocr_words = ocr_page_to_words(page)
                    ocr_text = clean_text(ocr_text)
                    # Prefer OCR text if native is empty/very short
                    if len(ocr_text) > len(text):
                        text = ocr_text
                except Exception:
                    # silently continue; index native text only
                    pass

            # Safety: allow empty; downstream can filter if needed
            if not text.strip():
                text = ""

            # Chunk and yield
            for _, _, chunk in chunk_text(text):
                meta = {
                    "client_id": client_id,
                    "policy_id": policy_id,
                    "page": pnum + 1,
                    "source_file": str(pdf_path.resolve()),
                }
                if ocr_words:
                    meta["ocr_words"] = ocr_words  # used by your viewer for highlights
                yield Document(page_content=chunk, metadata=meta)

def index_client(client_id: str, pdfs: List[Path]) -> None:
    client_dir = (FAISS_INDEX_DIR / client_id)
    client_dir.mkdir(parents=True, exist_ok=True)

    # Build documents for the client
    docs: List[Document] = []
    manifest_rows: List[DocInfo] = []
    for pdf in pdfs:
        manifest_rows.append(build_manifest_entry(pdf))
        for doc in make_chunks_for_pdf(pdf, client_id):
            docs.append(doc)

    if not docs:
        print(f"[{client_id}] No extractable text; skipping index.")
        return

    # Build / Save FAISS
    print(f"[{client_id}] Building FAISS with {len(docs)} chunks…")
    vs = FAISS.from_documents(docs, embedder())
    vs.save_local(str(client_dir))

    # Save manifest.json
    manifest = {
        "client_id": client_id,
        "docs": [
            {
                "policy_id": m.policy_id,
                "source_file": m.source_file,
                "pages": m.pages,
                "modified_time": m.modified_time,
            }
            for m in manifest_rows
        ],
        "generated_time": int(time.time()),
    }
    (client_dir / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    print(f"[{client_id}] Done. Index at {client_dir}")

def main():
    if not PDF_ROOT.exists():
        raise SystemExit(f"PDF_ROOT does not exist: {PDF_ROOT}")
    FAISS_INDEX_DIR.mkdir(parents=True, exist_ok=True)

    by_client = scan_pdfs(PDF_ROOT)
    if not by_client:
        print("No PDFs found.")
        return

    print(f"Found {sum(len(v) for v in by_client.values())} PDFs across {len(by_client)} client(s).")
    for client_id, pdfs in by_client.items():
        index_client(client_id, pdfs)

if __name__ == "__main__":
    main()
