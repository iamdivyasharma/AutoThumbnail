#!/usr/bin/env python3
"""
Export RAG answers per client & clause into an Excel file (.xlsx) using FAISS + ChatBedrock,
reusing the same LRU FAISS cache and per-client overrides logic as your FastAPI app.

- No CLI args needed; edit constants at the top.
- Scans FAISS_INDEX_DIR/<client>/ for all clients.
- For each client and each CLAUSE, retrieves with that client's override params and generates an answer.
- Writes: Client | Clause | Content  to client_clauses.xlsx
"""

from __future__ import annotations

import os
import json
import math
from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd
from boto3 import Session
from langchain_aws import BedrockEmbeddings, ChatBedrock
from langchain_community.vectorstores import FAISS
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser
import yaml

# =============== EDIT THESE ===============
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()   # <-- set me
CONFIGS_PATH    = Path("/ABS/PATH/TO/configs/clients.yaml").resolve()  # same YAML your app.py uses
OUTPUT_XLSX     = Path("./client_clauses.xlsx").resolve()

# AWS keys embedded (requested) — for local testing only; prefer IAM roles in prod
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

# Models (match your app.py)
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# Global defaults & cache (match app.py style)
GLOBAL_DEFAULTS = {"k": 4, "temperature": 0.20, "max_tokens": 1200}
MAX_COMBINED_K  = 12
_VS_CACHE: Dict[str, Any] = {}
_STEP = 0
MAX_LOADED = 5  # LRU keep last N clients loaded

# Hardcoded clauses you want to export
CLAUSES = [
    "Data Management",
    "Data Suppression",
    "Data Restrictions",
    "Data Consent",
]

# Clause-wise prompt tuning (optional)
CLAUSE_PROMPTS: Dict[str, str] = {
    "Data Management": (
        "Focus on lifecycle: collection, storage, processing, sharing, deletion. "
        "Extract definitions, responsibilities, retention, governance controls."
    ),
    "Data Suppression": (
        "Emphasize opt-out/suppression triggers, timelines, systems, who can request, "
        "audit trails, exceptions, and procedural steps."
    ),
    "Data Restrictions": (
        "Detail prohibited uses, geo/BU limits, consent prerequisites, access controls, "
        "and exception escalation paths."
    ),
    "Data Consent": (
        "Cover consent collection/renewal/withdrawal, lawful bases, records, UI/notice wording, "
        "and sensitive/age-related considerations."
    ),
}

# =============== AWS session ===============
SESSION = Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=AWS_REGION,
)

# =============== Reused helpers from your app ===============
def _load_overrides() -> Dict[str, Dict[str, Any]]:
    if not CONFIGS_PATH.exists():
        return {}
    raw = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for k, v in raw.items():
        if not isinstance(v, dict):
            continue
        ck = str(k).strip().lower()
        out[ck] = {
            "k": int(v.get("k", GLOBAL_DEFAULTS["k"])),
            "temperature": float(v.get("temperature", GLOBAL_DEFAULTS["temperature"])),
            "max_tokens": int(v.get("max_tokens", GLOBAL_DEFAULTS["max_tokens"])),
            "aliases": [str(a).strip().lower() for a in v.get("aliases", [])],
        }
    return out

CLIENT_OVERRIDES = _load_overrides()

def _load_index(client_id: str) -> FAISS:
    """Load FAISS for a client with simple LRU cache (same as app.py)."""
    global _STEP
    _STEP += 1
    cid = client_id.strip().lower()
    if cid in _VS_CACHE:
        vs, _ = _VS_CACHE[cid]
        _VS_CACHE[cid] = (vs, _STEP)
        return vs
    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
    vs = FAISS.load_local(str(FAISS_INDEX_DIR / cid), emb, allow_dangerous_deserialization=True)
    _VS_CACHE[cid] = (vs, _STEP)
    if len(_VS_CACHE) > MAX_LOADED:
        oldest = min(_VS_CACHE.items(), key=lambda kv: kv[1][1])[0]
        _VS_CACHE.pop(oldest, None)
    return vs

def list_clients() -> List[str]:
    if not FAISS_INDEX_DIR.exists():
        return []
    clients = []
    for p in FAISS_INDEX_DIR.iterdir():
        if not p.is_dir() or p.name.startswith("."):
            continue
        if not (p / "index.faiss").exists() or not (p / "index.pkl").exists():
            continue
        clients.append(p.name)
    return sorted(clients)

def choose_params(client_id: str) -> Dict[str, Any]:
    return CLIENT_OVERRIDES.get(client_id.strip().lower(), GLOBAL_DEFAULTS.copy())

# =============== Prompt ===============
PROMPT = ChatPromptTemplate.from_messages([
    ("system",
     "You are a precise, client-scoped contract assistant. Use ONLY the Provided Context. "
     "Respond specifically for the client's policies. Be complete and specific to the clause. "
     "If the context is insufficient, say you don't know and list what is missing. No citations.\n\n"
     "Clause-specific guidance:\n{clause_instructions}"),
    ("human",
     "Client: {client_id}\nClause: {clause}\n\nProvided Context:\n{context}\n\n"
     "Write the best possible answer now.")
])

def _format_docs(docs) -> str:
    return "\n\n".join(
        f"(client: {d.metadata.get('client_id')}, policy: {d.metadata.get('policy_id')}, page: {d.metadata.get('page','?')})\n{d.page_content}"
        for d in docs
    )

def _clause_instructions(clause: str) -> str:
    # exact or case-insensitive match; otherwise generic
    if clause in CLAUSE_PROMPTS:
        return CLAUSE_PROMPTS[clause]
    for k, v in CLAUSE_PROMPTS.items():
        if k.lower() == clause.lower():
            return v
    return ("Extract specific policy details, steps, limits, definitions, and exceptions for this clause. "
            "Use concise, actionable language grounded in the provided context.")

# =============== Core RAG step per client/clause ===============
def answer_for_clause(client_id: str, clause: str) -> str:
    # per-client params (k/temp/max_tokens)
    params = choose_params(client_id)
    k_effective = max(1, int(params.get("k", GLOBAL_DEFAULTS["k"])))
    temperature = float(params.get("temperature", GLOBAL_DEFAULTS["temperature"]))
    max_tokens  = int(params.get("max_tokens", GLOBAL_DEFAULTS["max_tokens"]))

    # Load index (cached) and retrieve
    vs = _load_index(client_id)
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k_effective})
    query = f"Extract contract policy content related to '{clause}' relevant to client '{client_id}'."
    docs = retriever.get_relevant_documents(query)
    # Hard guard: keep only this client's docs (paranoia)
    docs = [d for d in docs if str(d.metadata.get("client_id", "")).strip().lower() == client_id.strip().lower()]
    if not docs:
        return f"(No matching context found in {client_id} for clause '{clause}'.)"

    context = _format_docs(docs)

    # LLM: ChatBedrock (classic)
    llm = ChatBedrock(
        client=SESSION.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={"temperature": temperature, "max_tokens": max_tokens},
    )
    chain = PROMPT | llm | StrOutputParser()

    try:
        return chain.invoke({
            "client_id": client_id,
            "clause": clause,
            "context": context,
            "clause_instructions": _clause_instructions(clause),
        })
    except Exception as e:
        return f"(LLM error for {client_id} / '{clause}': {type(e).__name__}: {e})"

# =============== Main: iterate clients & clauses, save Excel ===============
def main():
    clients = list_clients()
    if not clients:
        raise SystemExit(f"No clients found under {FAISS_INDEX_DIR}")

    rows: List[Dict[str, str]] = []
    for client_id in clients:
        print(f"=== {client_id} ===")
        for clause in CLAUSES:
            print(f"  - {clause} ...", end="", flush=True)
            content = answer_for_clause(client_id, clause)
            rows.append({"Client": client_id, "Clause": clause, "Content": content})
            print(" done.")

    df = pd.DataFrame(rows, columns=["Client", "Clause", "Content"])
    OUTPUT_XLSX.parent.mkdir(parents=True, exist_ok=True)
    df.to_excel(OUTPUT_XLSX, index=False)
    print(f"\nSaved: {OUTPUT_XLSX}")

if __name__ == "__main__":
    main()
