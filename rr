# ================== NETWORK CALLS ==================
def post_json(url: str, payload: Dict[str, Any]) -> Dict[str, Any]:
    try:
        with httpx.Client(timeout=40) as c:
            r = c.post(url, json=payload)
            r.raise_for_status()
            return r.json()
    except Exception as e:
        return {"error": f"{type(e).__name__}: {e}"}

def call_route_query(query: str, *, targets: Optional[List[str]] = None, target: Optional[str] = None, extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    payload: Dict[str, Any] = {"query": query, "session_id": st.session_state.sid}
    if targets: payload["targets"] = targets
    if target:  payload["target"]  = target
    if extra:   payload["extra"]   = extra
    return post_json(ROUTE_URL, payload)

def call_agent_query(query: str, *, extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    payload: Dict[str, Any] = {
        "query": query,
        "session_id": st.session_state.sid,
        "max_iters": 2,
        "parallel_cap": 2,
        "autonomy": True,
    }
    if extra: payload["extra"] = extra
    return post_json(AGENT_URL, payload)

# ================== FILTER RENDERER (conditionally shown) ==================
def render_filters(block_key: str):
    f = st.session_state.filters

    st.subheader("🔎 Filters")
    col1, col2, col3 = st.columns([1,1,1])
    with col1:
        origin_code = st.selectbox(
            "Origin", options=ORIGIN_OPTIONS, index=_idx(f["ond"]["origin"], ORIGIN_OPTIONS, 0),
            format_func=label_for, key=f"{block_key}_origin",
        )
    with col2:
        dest_code = st.selectbox(
            "Destination", options=DESTINATION_OPTIONS, index=_idx(f["ond"]["destination"], DESTINATION_OPTIONS, 0),
            format_func=label_for, key=f"{block_key}_dest",
        )
    with col3:
        policy = st.selectbox(
            "Policy status", options=POLICY_OPTIONS, index=_idx(f.get("policy_status","Any"), POLICY_OPTIONS, 0),
            key=f"{block_key}_policy",
        )

    d1, d2 = st.columns(2)
    with d1:
        start_default = _snap_to_allowed(_as_date(f.get("start_date"), START_WHITELIST[0]), START_WHITELIST, direction="nearest")
        start_pick = st.date_input(
            "Start date", value=start_default, min_value=START_WHITELIST[0], max_value=START_WHITELIST[-1],
            format="YYYY-MM-DD", key=f"{block_key}_start",
        )
    with d2:
        end_default = _snap_to_allowed(_as_date(f.get("end_date"), END_WHITELIST[0]), END_WHITELIST, direction="up", min_after=start_pick)
        end_pick = st.date_input(
            "End date", value=end_default, min_value=END_WHITELIST[0], max_value=END_WHITELIST[-1],
            format="YYYY-MM-DD", key=f"{block_key}_end",
        )

    a1, a2 = st.columns(2)
    with a1:
        apply_filters = st.button("Apply", use_container_width=True, key=f"{block_key}_apply")
    with a2:
        clear_filters = st.button("Clear", use_container_width=True, key=f"{block_key}_clear")

    if apply_filters:
        # Snap/validate
        snapped_start = _snap_to_allowed(start_pick, START_WHITELIST, direction="nearest")
        snapped_end   = _snap_to_allowed(end_pick, END_WHITELIST, direction="up", min_after=snapped_start)
        if origin_code == dest_code:
            st.warning("Origin and Destination cannot be the same.")
        else:
            st.session_state.filters = {
                "ond": {"origin": origin_code, "destination": dest_code},
                "start_date": snapped_start.isoformat(),
                "end_date": snapped_end.isoformat(),
                "policy_status": policy,
            }

            # Build the orchestrator query text
            qtext = build_orchestrator_query_text(st.session_state.filters)
            st.session_state.last_query = qtext

            # Call orchestrator with all three targets; pass filters as `extra`
            extra = {
                "filters": {
                    "origin": origin_code,
                    "destination": dest_code,
                    "start_date": snapped_start.isoformat(),
                    "end_date": snapped_end.isoformat(),
                    "policy_status": policy,
                },
                "source": "streamlit_ui",
                "ui_version": "v1"
            }
            data = call_route_query(qtext, targets=["air","hotel","tdna"], extra=extra)
            st.session_state.orchestrator_response = data
            st.session_state.booking_started = False
            st.success("Filters applied and orchestrator queried.")

    if clear_filters:
        st.session_state.filters = DEFAULT_FILTERS.copy()
        st.session_state.last_query = ""
        st.session_state.orchestrator_response = None
        st.session_state.booking_started = False
        st.info("Filters reset.")

    fil = st.session_state.filters
    st.caption(
        f"Active → {label_for(fil['ond']['origin'])} → {label_for(fil['ond']['destination'])} | "
        f"Start: {fil['start_date']} | End: {fil['end_date']} | Policy: {fil['policy_status']}"
    )

# ================== RENDER ORCHESTRATOR RESULTS ==================
def render_results():
    data = st.session_state.orchestrator_response or {}
    if not data:
        return

    if "error" in data:
        st.error(f"Orchestrator error: {data['error']}")
        return

    st.markdown("#### ✅ Results")
    # Top-level composed answer
    if data.get("answer"):
        st.markdown(data["answer"])

    # Per-target raw payloads (if present)
    if data.get("answers_by_target"):
        with st.expander("Per-bot details", expanded=False):
            st.json(data["answers_by_target"])

    # Routing meta
    meta_bits = []
    if data.get("targets"): meta_bits.append(f"targets={data['targets']}")
    if data.get("routed_by"): meta_bits.append(f"routed_by={data['routed_by']}")
    if meta_bits:
        st.caption(" • ".join(meta_bits))

    # Actions
    c1, c2 = st.columns([1,1])
    with c1:
        if st.button("✈️ Book it?", use_container_width=True):
            st.session_state.booking_started = True
            st.success("Proceeding to booking flow… (wire this to your booking handler)")
            st.rerun()
    with c2:
        if st.button("💬 Chat with us", use_container_width=True):
            st.session_state.chat_mode = True
            st.toast("Chat mode enabled — filters hidden in chat.")
            st.rerun()

