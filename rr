def _invoke_bedrock(body: dict) -> dict:
    resp = bedrock.invoke_model(modelId=CLAUDE_MODEL_ID, body=json.dumps(body))
    return json.loads(resp["body"].read().decode("utf-8"))

# ---- JSON helpers ----
_JSON_BLOCK = re.compile(r"\{[\s\S]*\}")

def extract_json(text: str) -> Any:
    if isinstance(text, dict):
        return text
    if not isinstance(text, str):
        return text
    try:
        return json.loads(text)
    except Exception:
        m = _JSON_BLOCK.search(text)
        if m:
            try:
                return json.loads(m.group(0))
            except Exception:
                pass
    raise ValueError("Could not parse JSON from LLM output")

def claude_json(system: str, user_obj: dict, max_tokens=256, temperature=0) -> dict:
    payload = _invoke_bedrock({
        "anthropic_version": ANTHROPIC_VERSION,
        "max_tokens": max_tokens,
        "temperature": temperature,
        "system": system,
        "messages": [{"role":"user","content":[{"type":"text","text": json.dumps(user_obj)}]}],
    })
    return extract_json(payload["content"][0]["text"])

def claude_text(system: str, user_obj: dict, max_tokens=512, temperature=0) -> str:
    payload = _invoke_bedrock({
        "anthropic_version": ANTHROPIC_VERSION,
        "max_tokens": max_tokens,
        "temperature": temperature,
        "system": system,
        "messages": [{"role":"user","content":[{"type":"text","text": json.dumps(user_obj)}]}],
    })
    return payload["content"][0]["text"].strip()

# ==================== MCP Client ====================
class MCPHTTPClient:
    def __init__(self, base_url: str, timeout: float = 30.0, headers: Optional[Dict[str, str]] = None):
        self.base_url = base_url.rstrip("/")
        self.timeout = timeout
        self._id = 0
        self.headers = {
            "content-type": "application/json",
            "accept": "application/json",
            "cache-control": "no-cache",
            "connection": "keep-alive",
        }
        if headers:
            merged = {**self.headers, **headers}
            merged["accept"] = "application/json"
            self.headers = merged

    def _next_id(self) -> str:
        self._id += 1
        return str(self._id)

    async def _rpc(self, method: str, params: Dict[str, Any]) -> Any:
        payload = {"jsonrpc": "2.0", "id": self._next_id(), "method": method, "params": params}
        last_ex = None
        for attempt in range(3):
            try:
                async with httpx.AsyncClient(timeout=self.timeout) as client:
                    r = await client.post(self.base_url, json=payload, headers=self.headers)
                    r.raise_for_status()
                    data = r.json()
                if "error" in data:
                    raise RuntimeError(f"RPC error: {data['error']}")
                return data.get("result")
            except Exception as e:
                last_ex = e
                await asyncio.sleep(0.2 * (2 ** attempt) + random.random() * 0.1)
        raise last_ex

    async def tools_list(self) -> Dict[str, Any]:
        return await self._rpc("tools/list", {})

    async def tools_call(self, name: str, arguments: Dict[str, Any]) -> Any:
        return await self._rpc("tools/call", {"name": name, "arguments": arguments})

MCP_CLIENTS: Dict[str, MCPHTTPClient] = {svc: MCPHTTPClient(info["url"]) for svc, info in SERVICES.items()}
TOOL_CAPS: Dict[str, Dict[str, Any]] = defaultdict(dict)  # discovered tool metadata per service

# ==================== Memory & Cache ====================
MEMORY: Dict[str, Dict[str, Any]] = defaultdict(lambda: {"history": deque(maxlen=50), "created": time()})

def mem_append(sid: str, role: str, content: Any):
    MEMORY[sid]["history"].append({"role": role, "content": content, "ts": time()})

def mem_get(sid: str, k: int = 12) -> List[Dict[str, Any]]:
    hist = list(MEMORY[sid]["history"])
    return hist[-k:] if k else hist

def mem_clear(sid: str):
    MEMORY.pop(sid, None)

def compress_history_if_needed(sid: str, keep: int = 16):
    hist = MEMORY[sid]["history"]
    if len(hist) <= keep:
        return
    summary = claude_text(
        "Summarize earlier chat for future context (routes, dates, constraints, user prefs). 6 lines max.",
        {"history": list(hist)[:-keep]}
    )
    MEMORY[sid]["history"] = deque([{"role":"system","content":{"summary": summary},"ts": time()}] + list(hist)[-keep:], maxlen=50)

CACHE_TTL_SEC = int(os.getenv("CACHE_TTL_SEC", "300"))
_CACHE: Dict[str, Tuple[float, Any]] = {}

def _h(obj: Any) -> str:
    try:
        s = json.dumps(obj, sort_keys=True, default=str)
    except Exception:
        s = str(obj)
    return hashlib.sha256(s.encode()).hexdigest()[:16]

def cache_get(k: str):
    rec = _CACHE.get(k)
    if not rec:
        return None
    exp, val = rec
    if exp < time():
        _CACHE.pop(k, None)
        return None
    return val

def cache_set(k: str, v: Any, ttl: int = CACHE_TTL_SEC):
    _CACHE[k] = (time() + ttl, v)

# ==================== Answer sanitization & helpers ====================
_GREET = re.compile(r"(?mi)^\s*(?:hello|hi|hey|greetings)\b[\s\S]*?(?:\n|$)")
_TOOL_PREFIX = re.compile(r"(?mi)^(?:air|hotel|tdna)\s*:\s*")

def sanitize_answer(text: Any) -> str:
    s = text if isinstance(text, str) else str(text)
    s = _TOOL_PREFIX.sub("", s)
    for _ in range(2):
        s2 = _GREET.sub("", s)
        if s2 == s:
            break
        s = s2
    s = re.sub(r"\n{3,}", "\n\n", s).strip()
    return s

def sanitize_map(m: Dict[str, Any]) -> Dict[str, str]:
    return {k: sanitize_answer(v) for k, v in m.items()}

