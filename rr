# ========= ABSOLUTE PATHS YOU ALREADY USE =========
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()
CONFIGS_PATH    = Path("/ABS/PATH/TO/configs/clients.yaml").resolve()

# ========= AWS / Bedrock / S3 =========
REGION = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

SESSION = boto3.Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)
RUNTIME = SESSION.client("bedrock-runtime", config=Config(retries={"max_attempts": 8, "mode": "adaptive"}))
S3      = SESSION.client("s3", config=Config(signature_version="s3v4"))

EMB = BedrockEmbeddings(model_id=EMBED_MODEL, client=RUNTIME)

GLOBAL_DEFAULTS = {"k": 4, "temperature": 0.20, "max_tokens": 1200}
MAX_COMBINED_K  = 12

_VS_CACHE: Dict[str, Any] = {}
_STEP = 0
MAX_LOADED = 5

app = FastAPI(title="Contract RAG Backend")

# ========= Models =========
class AskRequest(BaseModel):
    question: str
    client_ids: Optional[List[str]] = None

class AskResponse(BaseModel):
    answer: str
    used_clients: List[str]
    sources: List[Dict[str, Any]]

# ========= YAML / overrides =========
def _load_overrides() -> Dict[str, Dict[str, Any]]:
    if not CONFIGS_PATH.exists():
        return {}
    raw = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for k, v in raw.items():
        if not isinstance(v, dict):
            continue
        ck = str(k).strip().lower()
        out[ck] = {
            "k": int(v.get("k", GLOBAL_DEFAULTS["k"])),
            "temperature": float(v.get("temperature", GLOBAL_DEFAULTS["temperature"])),
            "max_tokens": int(v.get("max_tokens", GLOBAL_DEFAULTS["max_tokens"])),
            "aliases": [str(a).strip().lower() for a in v.get("aliases", [])],
        }
        # Optional index-time overrides present in YAML are used by the indexer only
    return out

CLIENT_OVERRIDES = _load_overrides()

def list_clients() -> List[str]:
    if not FAISS_INDEX_DIR.exists():
        return []
    out = []
    for p in FAISS_INDEX_DIR.iterdir():
        if not p.is_dir() or p.name.startswith("."):
            continue
        if (p / "index.faiss").exists() and (p / "index.pkl").exists():
            out.append(p.name)
    return sorted(out)

def _load_index(client_id: str) -> FAISS:
    global _STEP
    _STEP += 1
    cid = client_id.strip().lower()
    if cid in _VS_CACHE:
        vs, _ = _VS_CACHE[cid]
        _VS_CACHE[cid] = (vs, _STEP)
        return vs
    vs = FAISS.load_local(str(FAISS_INDEX_DIR / cid), EMB, allow_dangerous_deserialization=True)
    _VS_CACHE[cid] = (vs, _STEP)
    if len(_VS_CACHE) > MAX_LOADED:
        oldest = min(_VS_CACHE.items(), key=lambda kv: kv[1][1])[0]
        _VS_CACHE.pop(oldest, None)
    return vs

def choose_params(client_id: str) -> Dict[str, Any]:
    return CLIENT_OVERRIDES.get(client_id.strip().lower(), GLOBAL_DEFAULTS.copy())

# ========= Client detection (robust) =========
def _normalize_text(s: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9 &]+", " ", s.lower())).strip()

def _canon_compact(s: str) -> str:
    s = s.lower().replace("&", " and ")
    return re.sub(r"[^a-z0-9]+", "", s)

def _build_alias_map(available: List[str]) -> Dict[str, Dict[str, set]]:
    out = {}
    for cid in available:
        c = cid.strip().lower()
        base = [c] + [str(a).strip().lower() for a in CLIENT_OVERRIDES.get(c, {}).get("aliases", [])]
        more = []
        for a in list(base):
            if " & " in a:   more.append(a.replace(" & ", " and "))
            if " and " in a: more.append(a.replace(" and ", " & "))
        base += more
        out[c] = {
            "aliases_norm": {_normalize_text(a) for a in base},
            "aliases_compact": {_canon_compact(a) for a in base},
        }
    return out

def detect_clients_from_text(text: str, available: List[str]) -> List[str]:
    norm = f" {_normalize_text(text)} "
    compact = _canon_compact(text)
    amap = _build_alias_map(available)
    detected = []
    for cid, packs in amap.items():
        if any(f" {a} " in norm for a in packs["aliases_norm"] if a):
            detected.append(cid)
    for cid, packs in amap.items():
        if cid in detected: continue
        if any(a and a in compact for a in packs["aliases_compact"]):
            detected.append(cid)
    try:
        from rapidfuzz import fuzz
        for cid, packs in amap.items():
            if cid in detected: continue
            score = max((fuzz.partial_ratio(a, compact) for a in packs["aliases_compact"] if a), default=0)
            if score >= 90:
                detected.append(cid)
    except Exception:
        pass
    return detected

# ========= Prompt =========
prompt = ChatPromptTemplate.from_messages([
    ("system",
     "You are a precise, client-scoped contract assistant. Use ONLY the Provided Context. "
     "Provide complete information related to the query—do not skip any part. "
     "Cover relevant clauses, definitions, conditions, exceptions, limits, timelines, "
     "eligibility, required documents, steps, and edge cases found in the context. "
     "If the context is insufficient, say what is missing and that you don't know. "
     "No citations or bracket labels."),
    ("human",
     "Question: {question}\n\nProvided Context:\n{context}\n\nWrite the best possible answer now.")
])

def _format_docs(docs) -> str:
    return "\n\n".join(
        f"(client: {d.metadata.get('client_id')}, policy: {d.metadata.get('policy_id')}, page: {d.metadata.get('page','?')})\n{d.page_content}"
        for d in docs
    )

# ========= S3 helpers =========
def presign(bucket: str, key: str, ttl: int = 3600) -> str:
    return S3.generate_presigned_url(
        "get_object",
        Params={"Bucket": bucket, "Key": key},
        ExpiresIn=ttl,
    )

def _download_s3_to_tmp(bucket: str, key: str) -> str:
    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".pdf")
    tmp.close()
    S3.download_file(bucket, key, tmp.name)
    return tmp.name

# ========= Highlight helpers =========
from difflib import SequenceMatcher

def _norm(s: str) -> str:
    return re.sub(r"\s+", " ", (s or "")).strip()

def _pick_phrases(answer: str, chunk_text: str, max_phrases: int = 3) -> list[str]:
    ans = _norm(answer).lower()
    phrases = []
    sentences = re.split(r"[.\n]+", chunk_text or "")
    for s in sentences:
        s2 = _norm(s)
        if len(s2) >= 30 and s2.lower() in ans:
            phrases.append(s2[:180])
            if len(phrases) >= max_phrases: return phrases
    for s in sentences:
        s2 = _norm(s)
        if len(s2) >= 40 and SequenceMatcher(None, s2.lower(), ans).quick_ratio() >= 0.65:
            phrases.append(s2[:180])
            if len(phrases) >= max_phrases: return phrases
    return phrases

def _ann_from_pymupdf_file(local_pdf_path: str, page_num: int, phrases: list[str]) -> list[dict]:
    ann = []
    try:
        with fitz.open(local_pdf_path) as doc:
            if page_num < 1 or page_num > doc.page_count:
                return ann
            page = doc.load_page(page_num - 1)
            seen = set()
            for phrase in phrases:
                if len(_norm(phrase)) < 8:
                    continue
                for r in page.search_for(phrase):
                    key = (round(r.x0,1), round(r.y0,1), round(r.width,1), round(r.height,1))
                    if key in seen:
                        continue
                    seen.add(key)
                    ann.append({
                        "page": page_num,
                        "x": float(r.x0), "y": float(r.y0),
                        "width": float(r.width), "height": float(r.height),
                        "color": "yellow",
                    })
                    if len(ann) >= 30:
                        return ann
    except Exception:
        pass
    return ann

# ========= Routes =========
@app.get("/clients")
def api_list_clients() -> List[str]:
    return list_clients()

@app.get("/clients/{client_id}/documents")
def api_client_documents(client_id: str):
    cid = client_id.strip().lower()
    manifest = (FAISS_INDEX_DIR / cid / "manifest.json")
    docs = []
    if manifest.exists():
        data = json.loads(manifest.read_text())
        for d in data.get("docs", []):
            b = d.get("s3_bucket"); k = d.get("s3_key")
            url = presign(b, k) if (b and k) else None
            docs.append({
                "policy_id": d.get("policy_id"),
                "source_url": url,
                "s3_bucket": b,
                "s3_key": k,
                "pages": d.get("pages"),
                "client_id": cid,
                "modified_time": d.get("modified_time"),
            })
    return sorted(docs, key=lambda x: x["policy_id"])

class _AskReq(BaseModel):
    question: str
    client_ids: Optional[List[str]] = None

@app.post("/ask", response_model=AskResponse)
def ask(payload: _AskReq):
    available = list_clients()
    if not available:
        raise HTTPException(404, "No client indexes available. Build indexes first.")

    if payload.client_ids:
        requested = sorted({c.strip().lower() for c in payload.client_ids})
    else:
        requested = detect_clients_from_text(payload.question, available)
    if not requested:
        raise HTTPException(400, f"No client detected. Mention a client name (e.g., {', '.join(available[:5])} …)")

    invalid = [c for c in requested if c not in available]
    if invalid:
        raise HTTPException(404, f"Unknown client id(s): {invalid}. Available: {available}")

    per_client_params = {c: choose_params(c) for c in requested}
    temperature = min(p["temperature"] for p in per_client_params.values())
    max_tokens  = max(p["max_tokens"]  for p in per_client_params.values())
    n_clients   = len(requested)
    per_cap     = max(1, math.ceil(MAX_COMBINED_K / n_clients))

    combined_docs = []
    for cid in requested:
        vs = _load_index(cid)
        k_yaml      = per_client_params[cid]["k"]
        k_effective = min(k_yaml, per_cap)
        retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k_effective})
        docs = retriever.get_relevant_documents(payload.question)
        docs = [d for d in docs if str(d.metadata.get("client_id", "")).strip().lower() == cid]
        combined_docs.extend(docs)

    if not combined_docs:
        raise HTTPException(404, f"No matching content for clients {requested}.")
    if len(combined_docs) > MAX_COMBINED_K:
        combined_docs = combined_docs[:MAX_COMBINED_K]

    context = _format_docs(combined_docs)
    llm = ChatBedrockConverse(model_id=LLM_MODEL, client=RUNTIME,
                              temperature=temperature, max_tokens=max_tokens)
    answer = (prompt | llm | StrOutputParser()).invoke({"question": payload.question, "context": context})

    sources = []
    for d in combined_docs:
        meta = d.metadata
        page_num = int(meta.get("page") or 1)
        b = meta.get("source_s3_bucket"); k = meta.get("source_s3_key")
        url = presign(b, k) if (b and k) else None

        anns = []
        # Try highlighting for text PDFs by downloading a temp copy
        if b and k and url:
            try:
                local_tmp = _download_s3_to_tmp(b, k)
                phrases = _pick_phrases(answer, d.page_content, max_phrases=3)
                anns = _ann_from_pymupdf_file(local_tmp, page_num, phrases)
                try: os.unlink(local_tmp)
                except Exception: pass
            except Exception:
                pass

        sources.append({
            "policy_id": meta.get("policy_id"),
            "page": page_num,
            "client_id": meta.get("client_id"),
            "source_url": url,      # <— Streamlit will fetch bytes from this
            "annotations": anns,    # may be empty for Textract-only docs
        })

    return AskResponse(answer=answer, used_clients=requested, sources=sources)
