# ============================== Exception helpers ==============================
def _exc_to_str(e: BaseException) -> str:
    try:
        from traceback import TracebackException
        te = TracebackException.from_exception(e)
        return "".join(te.format()).strip().splitlines()[-1]
    except Exception:
        return f"{type(e).__name__}: {e}"

def _flatten_exc(e: BaseException) -> str:
    if getattr(e, "__class__", None) and e.__class__.__name__ == "ExceptionGroup":
        parts = []
        for sub in getattr(e, "exceptions", []) or []:
            parts.append(_flatten_exc(sub))
        return " | ".join(p for p in parts if p)
    if hasattr(e, "exceptions"):
        parts = []
        for sub in getattr(e, "exceptions", []) or []:
            parts.append(_flatten_exc(sub))
        return " | ".join(p for p in parts if p)
    return _exc_to_str(e)


# ============================== HYBRID MCP CLIENT ==============================
class _MCPStdIOTool:
    """Façade for a stdio tool; mirrors ainvoke() pattern."""
    def __init__(self, sess: ClientSession, name: str, description: str = ""):
        self._sess = sess
        self.name = name
        self.description = description

    async def ainvoke(self, payload: dict):
        res = await self._sess.call_tool(self.name, payload or {})
        # Normalize to the formats the orchestrator already handles.
        if res and res.content:
            # If only text parts, return a single string
            texts = [getattr(c, "text", None) for c in res.content if getattr(c, "type", "") == "text"]
            texts = [t for t in texts if t is not None]
            if texts:
                return "\n".join(texts)
            # Otherwise return raw-ish dict content
            return {"content": [c.__dict__ for c in res.content]}
        return {"content": []}

class _MCPStdIOSession:
    """Session wrapper exposing get_tools/get_all_tools for stdio servers."""
    def __init__(self, sess: ClientSession):
        self.sess = sess

    async def get_tools(self):
        tool_list = await self.sess.list_tools()
        out = []
        for t in tool_list.tools:
            name = getattr(t, "name", "")
            desc = getattr(t, "description", "")
            out.append(_MCPStdIOTool(self.sess, name, desc))
        return out

    async def get_all_tools(self):
        tools = await self.get_tools()
        return {"tools": tools}

class HybridMCP:
    """
    stdio servers -> official MCP client
    http-ish servers -> langchain_mcp_adapters MultiServerMCPClient
    """
    def __init__(self, cfg: Dict[str, dict]):
        self.cfg = cfg
        http_cfg = {k:v for k,v in cfg.items() if v.get("transport",{}).get("type") != "stdio"}
        self.http_client = MultiServerMCPClient(http_cfg) if http_cfg else None

    async def aclose(self):
        if self.http_client:
            await self.http_client.aclose()

    @asynccontextmanager
    async def session(self, server: str) -> AsyncIterator[object]:
        tinfo = self.cfg[server]["transport"]
        ttype = tinfo.get("type")
        if ttype == "stdio":
            cmd = tinfo.get("command")
            if not isinstance(cmd, list) or not cmd:
                raise ValueError(f"Server '{server}' stdio transport requires a non-empty 'command' list")
            if TRACE_MCP:
                log.debug("[HybridMCP] starting stdio server=%s cmd=%s", server, cmd)
            async with stdio_client(command=cmd[0], args=cmd[1:]) as (read, write):
                sess = ClientSession(read, write)
                await sess.initialize()
                try:
                    yield _MCPStdIOSession(sess)
                finally:
                    await sess.close()
        else:
            if not self.http_client:
                raise RuntimeError("No HTTP-capable client configured")
            if TRACE_MCP:
                log.debug("[HybridMCP] delegating HTTP session for server=%s", server)
            async with self.http_client.session(server) as s:
                yield s


def normalize_servers(cfg: dict) -> dict:
    """Validate config entries."""
    out = {}
    for name, val in cfg.items():
        if not isinstance(val, dict) or "transport" not in val:
            raise ValueError(f"Server '{name}' missing 'transport'")
        t = val["transport"].get("type")
        if t not in ("stdio", "sse", "websocket", "streamable_http"):
            raise ValueError(f"Invalid transport '{t}' for '{name}'")
        if t == "stdio":
            cmd = val["transport"].get("command")
            if not isinstance(cmd, list) or not cmd:
                raise ValueError(f"Server '{name}' stdio transport requires a non-empty 'command' list")
        out[name] = val
    return out

