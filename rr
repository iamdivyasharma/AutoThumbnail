
# 1) List clients
curl -s "http://localhost:8000/clients" | jq

# 2) List a client’s documents
curl -s "http://localhost:8000/clients/CLIENT_ID/documents" | jq

# 3) Ask a question- Generic Q/A on contracts (auto-detect client from text)
curl -s -X POST "http://localhost:8000/ask" \
  -H 'Content-Type: application/json' \
  -d '{
    "question": "what is the obligations related to data privacy for bmw us?"
  }' | jq

# 4) SUmmary of contracts (chat on EXcels)
curl -s -X POST "http://localhost:8000/excel/chat" \
  -H 'Content-Type: application/json' \
  -d '{
    "question": "tell me all the clients with technology clause",
    "session_id": "demo-123",
    "k": 6
  }' | jq

# 5) Refresh (re-read workbook + rebuild FAISS)
curl -s -X POST "http://localhost:8000/excel/refresh" | jq

# 6) Get session history
curl -s "http://localhost:8000/excel/history/demo-123" | jq

# 7) Clear session history
curl -s -X DELETE "http://localhost:8000/excel/history/demo-123" | jq




