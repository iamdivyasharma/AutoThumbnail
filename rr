from __future__ import annotations

import json
import os
import re
from pathlib import Path
from typing import Any, Dict, Optional


def normalize_text(s: str) -> str:
    s = (s or "").lower().strip()
    s = re.sub(r"[^a-z0-9]+", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def safe_json_load(path: Path) -> Optional[Dict[str, Any]]:
    try:
        return json.loads(path.read_text(encoding="utf-8", errors="ignore"))
    except Exception:
        return None


def find_pdf_metadata_file(pdf_path: Path) -> Optional[Path]:
    """Supports `file.pdf.metadata` and `file.pdf.metadata.json`."""
    candidates = [
        pdf_path.with_name(pdf_path.name + ".metadata"),
        pdf_path.with_name(pdf_path.name + ".metadata.json"),
    ]
    for c in candidates:
        if c.exists():
            return c
    return None


def env(name: str, default: str = "") -> str:
    return os.getenv(name, default)




