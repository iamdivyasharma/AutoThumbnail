from datetime import datetime

def _list_client_pdfs(client_id: str) -> List[Dict[str, Any]]:
    """Return all PDF docs for a client with last-modified info (epoch + ISO)."""
    client = client_id.strip().lower()
    pdfs: List[Dict[str, Any]] = []
    for p in PDF_ROOT.glob("*.pdf"):  # use rglob("*.pdf") if you have subfolders
        if not p.is_file() or p.suffix.lower() != ".pdf" or p.name.startswith((".", "~$")):
            continue
        if _get_client_id_from_filename(p.name) == client:
            stat = p.stat()
            pages = get_pdf_page_count(str(p))
            mtime_epoch = int(stat.st_mtime)
            mtime_iso   = datetime.fromtimestamp(stat.st_mtime).isoformat(timespec="seconds")
            pdfs.append({
                "policy_id": p.name,
                "source_file": str(p.resolve()),  # absolute path (or keep your source_url too)
                "pages": pages,
                "client_id": client,
                "modified_time": mtime_epoch,      # <-- new
                "modified_iso": mtime_iso,         # <-- new (server local time)
            })
    return sorted(pdfs, key=lambda x: x["policy_id"])
