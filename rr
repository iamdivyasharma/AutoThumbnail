# services/rag_search_service.py
from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from dotenv import load_dotenv

# Reuse your existing logic/helpers from MetadataService
from services.metadata_service import MetadataService, canonicalize_name, normalize_country

from langchain_core.output_parsers import StrOutputParser
from langchain_core.prompts import ChatPromptTemplate
from langchain_aws import ChatBedrockConverse

# Vectorstore + embeddings (LangChain)
try:
    from langchain_community.vectorstores import FAISS  # type: ignore
except Exception:
    from langchain.vectorstores import FAISS  # type: ignore

try:
    from langchain_aws import BedrockEmbeddings  # type: ignore
except Exception as e:
    raise ImportError("BedrockEmbeddings not available. Install/enable langchain-aws.") from e


# -----------------------------
# RAG Answer Prompt
# -----------------------------
_RAG_ANSWER_PROMPT = ChatPromptTemplate.from_messages(
    [
        (
            "system",
            "You are a RAG assistant. Answer ONLY using the provided context chunks. "
            "If the answer is not in the context, say: 'Not found in available documents.' "
            "Keep the response short and direct.",
        ),
        ("human", "Question: {query}\n\nContext:\n{context}\n\nAnswer:"),
    ]
)


@dataclass
class RagChunk:
    # Keep rank/score internally for ordering + context headers (but OMIT them from API output)
    rank: int
    score: float
    text: str
    metadata: Dict[str, Any]


class RagSearchService:
    """
    RAG Search API behavior (as per your requirements):

    Input:
      - query (only)

    Routing (category fixed to 'finance'):
      - Detect client + optional country from query (LLM intent + fallback token extract + alias mapping).
      - Try mapping client to master CSV:
          * If found => use canonical client name from CSV.
          * If NOT found => DO NOT FAIL; try to locate FAISS index folders directly using detected client string.

      - If country present:
          * Try /faiss_indices/finance/<client>/<country>/
          * If not found => fallback to /faiss_indices/finance/<client>/Ultimate Parent/ and /Corporate Family/
      - If country NOT present:
          * Use ONLY /faiss_indices/finance/<client>/Ultimate Parent/ and /Corporate Family/

    Retrieval:
      - Uses MMR (max marginal relevance) to reduce duplicate/near-identical chunks.

    Output JSON (ORDER matters):
      1) answer
      2) sources
      3) top_chunks   (ONLY text + metadata; NO rank/score in response)
    """

    def __init__(
        self,
        metadata_svc: MetadataService,
        faiss_index_dir: str,
        bedrock_region: str = "us-east-1",
        llm_model_id: Optional[str] = None,
        embedding_model_id: Optional[str] = None,
        top_k: int = 8,
        category_fixed: str = "finance",
        mmr_fetch_k: Optional[int] = None,
        mmr_lambda_mult: float = 0.5,
    ):
        load_dotenv()
        self.meta = metadata_svc
        self.faiss_index_dir = Path(faiss_index_dir)
        self.bedrock_region = bedrock_region

        self.llm_model_id = llm_model_id or os.getenv(
            "BEDROCK_LLM_MODEL",
            "anthropic.claude-3-5-sonnet-20240620-v1:0",
        )
        self.embedding_model_id = embedding_model_id or os.getenv(
            "BEDROCK_EMBEDDING_MODEL",
            "amazon.titan-embed-text-v1",
        )

        self.top_k = int(top_k)
        self.category_fixed = (category_fixed or "finance").strip().lower() or "finance"
        if self.category_fixed not in {"finance", "legal"}:
            self.category_fixed = "finance"

        # MMR settings
        self.mmr_fetch_k = int(mmr_fetch_k) if mmr_fetch_k is not None else max(self.top_k * 5, 25)
        self.mmr_lambda_mult = float(mmr_lambda_mult)

        self._embeddings = None

    # -----------------------------
    # Bedrock clients
    # -----------------------------
    def _emb(self):
        if self._embeddings is not None:
            return self._embeddings
        import boto3

        brt = boto3.client("bedrock-runtime", region_name=self.bedrock_region)
        self._embeddings = BedrockEmbeddings(model_id=self.embedding_model_id, client=brt)
        return self._embeddings

    def _llm(self) -> ChatBedrockConverse:
        import boto3

        client = boto3.client("bedrock-runtime", region_name=self.bedrock_region)
        return ChatBedrockConverse(
            model_id=self.llm_model_id,
            client=client,
            temperature=0.0,
            max_tokens=700,
        )

    # -----------------------------
    # Client + country detection
    # -----------------------------
    def _detect_client_and_country_guess(self, query: str, use_llm_intent: bool = True) -> Tuple[str, Optional[str]]:
        """
        Step 1: detect client mention + country (best-effort).
        - Uses MetadataService LLM intent parsing if enabled.
        - Falls back to deterministic token extraction.
        - Applies alias mapping (dictionary) so client can be anywhere in query.
        This DOES NOT require master CSV success.
        """
        self.meta.ensure_loaded()

        client_mention = ""
        country = None

        if use_llm_intent:
            intent = self.meta._parse_intent_llm(query)  # reuse your prompt+parser
            client_mention = (intent.get("client_mention") or "").strip()
            country = normalize_country(intent.get("country"))
        else:
            country = self.meta._resolve_country_from_query(query)

        if not client_mention:
            client_mention = self.meta._extract_client_guess(query)

        # Apply alias map even if CSV mapping fails later
        client_mention = self.meta._apply_client_alias_map(client_mention, query)

        return client_mention, normalize_country(country)

    def _detect_client_canonical_via_csv(
        self,
        client_guess: str,
        country: Optional[str],
    ) -> Optional[str]:
        """
        Step 2: attempt to map detected client to master CSV canonical client name.
        Returns canonical client name if found, else None.
        """
        row = self.meta._resolve_client_row(client_guess, country=country)
        if row is None:
            return None
        return str(row[self.meta.client_name_col]).strip()

    # -----------------------------
    # Index folder selection
    # -----------------------------
    def _match_client_dirs(self, category_dir: Path, client_name: str) -> List[Path]:
        """
        Find all client directories under /<category>/ that match the client name (canonical/contains).
        Works for both CSV canonical name and best-effort client guess.
        """
        if not category_dir.exists():
            return []

        target = canonicalize_name(client_name)
        if not target:
            return []

        out: List[Path] = []
        for d in category_dir.iterdir():
            if not d.is_dir():
                continue
            dc = canonicalize_name(d.name)
            if dc == target or target in dc or dc in target:
                out.append(d)
        return out

    def _find_subfolder(self, base: Path, want_subfolder: str) -> Optional[Path]:
        """
        Match subfolder by canonicalized name (handles casing/spacing differences).
        """
        if not base.exists() or not base.is_dir():
            return None

        want = canonicalize_name(want_subfolder)
        for d in base.iterdir():
            if not d.is_dir():
                continue
            if canonicalize_name(d.name) == want:
                return d
        return None

    def _possible_index_dirs(
        self,
        client_name: str,
        country: Optional[str],
    ) -> List[Path]:
        """
        Apply your routing rules to find FAISS folders.
        Expected FAISS save_local format inside folder:
          - index.faiss
          - index.pkl
        """
        cat_dir = self.faiss_index_dir / self.category_fixed
        client_dirs = self._match_client_dirs(cat_dir, client_name)
        if not client_dirs:
            return []

        ctry = normalize_country(country)

        # If country provided: try <client>/<country> first
        if ctry:
            candidates = [cd / ctry for cd in client_dirs]
            existing = [p for p in candidates if p.exists() and p.is_dir()]
            if existing:
                return existing

            # Country folder not present => fallback to Ultimate Parent / Corporate Family
            fallback: List[Path] = []
            for cd in client_dirs:
                up = self._find_subfolder(cd, "Ultimate Parent")
                cf = self._find_subfolder(cd, "Corporate Family")
                if up:
                    fallback.append(up)
                if cf:
                    fallback.append(cf)
            return fallback

        # No country provided: ONLY Ultimate Parent / Corporate Family
        out: List[Path] = []
        for cd in client_dirs:
            up = self._find_subfolder(cd, "Ultimate Parent")
            cf = self._find_subfolder(cd, "Corporate Family")
            if up:
                out.append(up)
            if cf:
                out.append(cf)
        return out

    # -----------------------------
    # FAISS loading + retrieval
    # -----------------------------
    def _load_faiss_store(self, folder: Path):
        """
        Expects LangChain FAISS save_local format:
          folder/index.faiss and folder/index.pkl
        """
        try:
            return FAISS.load_local(
                str(folder),
                self._emb(),
                allow_dangerous_deserialization=True,  # index.pkl is pickle
            )
        except TypeError:
            return FAISS.load_local(str(folder), self._emb())

    def _extract_source_link(self, md: Dict[str, Any]) -> Optional[str]:
        """
        Return best effort "source link".
        Prefer URL-like fields; else file/path.
        """
        if not md:
            return None

        candidates = [
            md.get("url"),
            md.get("link"),
            md.get("document_url"),
            md.get("source"),
            md.get("source_file"),
            md.get("path"),
            md.get("file"),
        ]
        for c in candidates:
            if not c:
                continue
            s = str(c).strip()
            if s:
                return s
        return None

    def _build_context_from_chunks(self, chunks: List[RagChunk], max_chars: int = 14000) -> str:
        """
        Build context string for LLM.
        We keep rank/score internally for ordering and include them in the context header (helpful for debugging),
        but they are NOT returned in the API output.
        """
        parts: List[str] = []
        total = 0

        for ch in chunks:
            src = self._extract_source_link(ch.metadata) or ""
            pid = ch.metadata.get("policy_id") or ch.metadata.get("policyId") or ""
            header = f"[Rank {ch.rank} | score={ch.score:.4f} | policy_id={pid} | source={src}]"
            block = header + "\n" + (ch.text or "").strip()

            if total + len(block) > max_chars:
                break
            parts.append(block)
            total += len(block)

        return "\n\n---\n\n".join(parts).strip()

    def _json_sanitize(self, obj: Any) -> Any:
        """
        Ensure metadata is JSON serializable (avoid Path/datetime/numpy types).
        """
        if obj is None:
            return None
        if isinstance(obj, (str, int, float, bool)):
            return obj
        if isinstance(obj, Path):
            return str(obj)
        if isinstance(obj, dict):
            return {str(k): self._json_sanitize(v) for k, v in obj.items()}
        if isinstance(obj, (list, tuple, set)):
            return [self._json_sanitize(v) for v in obj]
        return str(obj)

    # -----------------------------
    # Public API
    # -----------------------------
    def search_and_answer(
        self,
        query: str,
        session_id: Optional[str] = None,  # kept for API compatibility; not used here
        use_llm_intent: bool = True,
    ) -> Dict[str, Any]:
        """
        Returns (ORDERED):
          - answer: str
          - sources: list[str]
          - top_chunks: list[ {text, metadata} ]   (rank/score omitted from output)
        """
        q = (query or "").strip()
        if not q:
            raise ValueError("query is required")

        # 1) detect client+country guess from query
        client_guess, user_country = self._detect_client_and_country_guess(q, use_llm_intent=use_llm_intent)

        # 2) try mapping via master CSV; if it fails keep guess (do not fail)
        client_canonical = self._detect_client_canonical_via_csv(client_guess, user_country)
        client_for_index = client_canonical or client_guess

        # 3) choose index dirs with your routing rules
        index_dirs = self._possible_index_dirs(client_for_index, user_country)

        # If canonical name didn't find, try with raw guess as well
        if not index_dirs and client_canonical and canonicalize_name(client_guess) != canonicalize_name(client_canonical):
            index_dirs = self._possible_index_dirs(client_guess, user_country)

        if not index_dirs:
            if user_country:
                raise FileNotFoundError(
                    f"No FAISS index folder found for client '{client_for_index}' under "
                    f"{self.faiss_index_dir}/{self.category_fixed}/<client>/{user_country}/ "
                    f"and no fallback Ultimate Parent/Corporate Family folders found."
                )
            raise FileNotFoundError(
                f"No FAISS index folder found for client '{client_for_index}' under "
                f"{self.faiss_index_dir}/{self.category_fixed}/<client>/Ultimate Parent/ or Corporate Family/."
            )

        # 4) retrieve with MMR from each folder, merge
        merged: List[RagChunk] = []

        for folder in index_dirs:
            store = self._load_faiss_store(folder)

            fetch_k = self.mmr_fetch_k
            lambda_mult = self.mmr_lambda_mult

            # 1) MMR-selected docs (no scores)
            mmr_docs = store.max_marginal_relevance_search(
                q,
                k=self.top_k,
                fetch_k=fetch_k,
                lambda_mult=lambda_mult,
            )

            # 2) Scored pool for score mapping
            scored = store.similarity_search_with_score(q, k=fetch_k)

            def _doc_key(d) -> str:
                md = getattr(d, "metadata", {}) or {}
                md_items = sorted((str(k), str(v)) for k, v in md.items())
                return (getattr(d, "page_content", "") or "") + "||" + "||".join([f"{k}={v}" for k, v in md_items])

            score_map: Dict[str, float] = {}
            for d, s in scored:
                key = _doc_key(d)
                if key not in score_map or float(s) < score_map[key]:
                    score_map[key] = float(s)

            # 3) add mmr docs with best-effort scores
            for d in mmr_docs:
                text = (d.page_content or "").strip()
                md = dict(d.metadata or {})
                md.setdefault("_index_folder", str(folder))
                score = score_map.get(_doc_key(d), 0.0)
                merged.append(RagChunk(rank=0, score=float(score), text=text, metadata=md))

        if not merged:
            return {
                "answer": "Not found in available documents.",
                "sources": [],
                "top_chunks": [],
            }

        # FAISS often returns L2 distance: lower is better
        merged.sort(key=lambda x: x.score)

        # de-duplicate by text+source+policy to reduce repeats across folders
        deduped: List[RagChunk] = []
        seen = set()
        for ch in merged:
            sig = (ch.text[:400], self._extract_source_link(ch.metadata) or "", ch.metadata.get("policy_id") or "")
            if sig in seen:
                continue
            seen.add(sig)
            deduped.append(ch)

        top = deduped[: self.top_k]
        for i, ch in enumerate(top, start=1):
            ch.rank = i

        # 5) sources (dedupe, keep order)
        sources: List[str] = []
        seen_src = set()
        for ch in top:
            s = self._extract_source_link(ch.metadata)
            if not s or s in seen_src:
                continue
            seen_src.add(s)
            sources.append(s)

        # 6) LLM answer
        context = self._build_context_from_chunks(top)
        chain = _RAG_ANSWER_PROMPT | self._llm() | StrOutputParser()
        answer = (chain.invoke({"query": q, "context": context}) or "").strip()

        # 7) return ordered: answer, sources, top_chunks (omit rank/score)
        return {
            "answer": answer,
            "sources": sources,
            "top_chunks": [
                {
                    "text": ch.text,
                    "metadata": self._json_sanitize(ch.metadata),
                }
                for ch in top
            ],
        }
