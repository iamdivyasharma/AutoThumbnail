@app.get("/clients")
def api_list_clients(category: Optional[str] = None) -> List[str]:
    """
    Return list of normalized ids:
      "legal/clienta"
      "finance/clientx/us"
    Optionally filter by category query param.
    """
    if category:
        category = category.strip().lower()
        if category not in CATEGORIES:
            raise HTTPException(400, f"Unknown category {category}. Expected one of {CATEGORIES}.")
    return list_clients(category=category)

@app.get("/clients/{client_full_id:path}/documents")
def api_client_documents(client_full_id: str):
    """
    Reads the per-client manifest.json written by the indexer and maps docs to local PDFs.
    client_full_id is like "legal/clienta" or "finance/clientx/us".
    """
    cid_norm = _normalize_id(client_full_id)
    if cid_norm not in _ID_TO_DIR:
        _refresh_id_to_dir()
    if cid_norm not in _ID_TO_DIR:
        return []

    manifest = _ID_TO_DIR[cid_norm] / "manifest.json"
    if not manifest.exists():
        return []

    data = json.loads(manifest.read_text())
    docs = []
    for d in data.get("docs", []):
        orig = d.get("source_file")
        local = _map_to_local_pdf(orig)
        doc_item = {
            "policy_id": d.get("policy_id"),
            "source_file": (str(local) if local else None),
            "pages": d.get("pages"),
            "client_id": cid_norm,
            "category": data.get("category"),
            "modified_time": d.get("modified_time"),
            "modified_iso": (None if not d.get("modified_time")
                             else __import__("datetime").datetime.fromtimestamp(d["modified_time"]).isoformat(timespec="seconds")),
        }
        docs.append(doc_item)

    docs = [x for x in docs if x["source_file"]]
    return sorted(docs, key=lambda x: x["policy_id"] or "")

# ========= Highlights (PyMuPDF exact search, local only) =========

from difflib import SequenceMatcher

def _norm(s: str) -> str:
    return re.sub(r"\s+", " ", (s or "")).strip()

def _pick_phrases(answer: str, chunk_text: str, max_phrases: int = 3) -> list[str]:
    ans = _norm(answer).lower()
    phrases = []
    sentences = re.split(r"[.\n]+", chunk_text or "")
    for s in sentences:
        s2 = _norm(s)
        if len(s2) >= 30 and s2.lower() in ans:
            phrases.append(s2[:180])
            if len(phrases) >= max_phrases:
                return phrases
    for s in sentences:
        s2 = _norm(s)
        if len(s2) >= 40 and SequenceMatcher(None, s2.lower(), ans).quick_ratio() >= 0.65:
            phrases.append(s2[:180])
            if len(phrases) >= max_phrases:
                return phrases
    return phrases

def _ann_from_local_pdf(local_path: Path, page_num: int, phrases: list[str]) -> list[dict]:
    ann = []
    try:
        pdf_bytes = _read_pdf_bytes_local(local_path)
        if not pdf_bytes:
            return ann
        with fitz.open(stream=pdf_bytes, filetype="pdf") as doc:
            if page_num < 1 or page_num > doc.page_count:
                return ann
            page = doc.load_page(page_num - 1)
            seen = set()
            for phrase in phrases:
                if len(_norm(phrase)) < 8:
                    continue
                for r in page.search_for(phrase):
                    key = (round(r.x0, 1), round(r.y0, 1), round(r.width, 1), round(r.height, 1))
                    if key in seen:
                        continue
                    seen.add(key)
                    ann.append({
                        "page": page_num,
                        "x": float(r.x0), "y": float(r.y0),
                        "width": float(r.width), "height": float(r.height),
                        "color": "yellow",
                    })
                    if len(ann) >= 30:
                        return ann
    except Exception:
        pass
    return ann

def _ann_from_ocr_words(meta: dict, phrases: list[str]) -> list[dict]:
    ann = []
    words = meta.get("ocr_words") or []
    if not words:
        return ann
    want = [re.sub(r"\s+", " ", (p or "").lower()).strip() for p in phrases if p]
    if not want:
        return ann
    for w in words:
        t = str(w.get("text", "")).lower().strip()
        if not t:
            continue
        if any(t in ph for ph in want) and all(k in w for k in ("x", "y", "width", "height")):
            ann.append({
                "page": int(meta.get("page") or 1),
                "x": float(w["x"]), "y": float(w["y"]),
                "width": float(w["width"]), "height": float(w["height"]),
                "color": "yellow",
            })
        if len(ann) >= 60:
            break
    return ann

# ========= Helpers for parsing IDs =========

def parse_scoped_id(id_str: str) -> ClientScope:
    """
    id_str: normalized id, e.g. "legal/clienta" or "finance/clientx/us"
    """
    nid = _normalize_id(id_str)
    parts = nid.split("/")
    category = parts[0] if parts else None
    client_name: Optional[str] = None
    country: Optional[str] = None

    if category in {"legal", "finance"}:
        if len(parts) >= 2:
            client_name = parts[1]
        if category == "finance" and len(parts) >= 3:
            country = parts[2]

    return ClientScope(id=nid, category=category, client_name=client_name, country=country)

# ========= Ask (PDF RAG) =========

def _format_context(docs):
    return _format_docs(docs)

@app.post("/ask", response_model=AskResponse)
def ask(payload: AskRequest):
    # Determine which client indexes are even available, optionally scoped by category
    category = payload.category.strip().lower() if payload.category else None
    if category and category not in CATEGORIES:
        raise HTTPException(400, f"Unknown category {category}. Expected one of {CATEGORIES}.")

    available = list_clients(category=category)
    if not available:
        raise HTTPException(404, "No client indexes available. Build indexes first.")

    # Determine which client ids we're using
    if payload.client_ids:
        requested = sorted({_normalize_id(c) for c in payload.client_ids})
    else:
        requested = detect_clients_from_text(payload.question, available)

    if not requested:
        raise HTTPException(
            400,
            f"No client detected in the question. "
            f"Either specify category/client_ids explicitly or mention a client + country name."
        )

    invalid = [c for c in requested if c not in available]
    if invalid:
        raise HTTPException(
            404,
            f"Unknown client id(s): {invalid}. Available: {available}"
        )

    # Merge retrieval + generation params per client
    per_client_params = {c: choose_params(c) for c in requested}
    temperature = min(p["temperature"] for p in per_client_params.values())
    max_tokens  = max(p["max_tokens"]  for p in per_client_params.values())
    n_clients   = len(requested)
    per_cap     = max(1, math.ceil(MAX_COMBINED_K / n_clients))

    # Retrieve from each client's FAISS index
    combined_docs = []
    for cid in requested:
        vs = _load_index(cid)
        k_yaml      = per_client_params[cid]["k"]
        k_effective = min(k_yaml, per_cap)
        retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k_effective})

        docs = retriever.get_relevant_documents(payload.question)
        # Hard guard: only keep docs from this client + category
        filtered = []
        for d in docs:
            cat = _normalize_id(d.metadata.get("category", ""))
            client_meta = _normalize_id(d.metadata.get("client_id", ""))
            full_meta_id = f"{cat}/{client_meta}" if cat and client_meta else None
            if full_meta_id == cid:
                filtered.append(d)
        combined_docs.extend(filtered)

    if not combined_docs:
        raise HTTPException(404, f"No matching content for clients {requested}.")

    if len(combined_docs) > MAX_COMBINED_K:
        combined_docs = combined_docs[:MAX_COMBINED_K]

    context = _format_context(combined_docs)
    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=temperature,
        max_tokens=max_tokens,
    )
    chain = prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": payload.question, "context": context})

    # Build sources + annotations (LOCAL PDFs only)
    sources = []
    for d in combined_docs:
        meta = d.metadata
        page_num = int(meta.get("page") or meta.get("page_start") or 1)

        orig_source = meta.get("source_file") or meta.get("source") or ""
        local_path = _map_to_local_pdf(orig_source)
        if not local_path:
            pol = str(meta.get("policy_id") or "").strip()
            if pol:
                candidate = PDFS_DIR / f"{pol}.pdf"
                if candidate.exists():
                    local_path = candidate

        phrases = _pick_phrases(answer, d.page_content, max_phrases=3)

        anns = []
        if local_path:
            anns = _ann_from_local_pdf(local_path, page_num, phrases)
        if not anns and meta.get("ocr_words"):
            anns = _ann_from_ocr_words(meta, phrases)

        sources.append({
            "policy_id": meta.get("policy_id"),
            "page": page_num,
            "client_id": meta.get("client_id"),
            "category": meta.get("category"),
            "source_file": (str(local_path) if local_path else None),
            "annotations": anns,
        })

    sources = [s for s in sources if s["source_file"]]

    client_scopes = [parse_scoped_id(cid) for cid in requested]

    return AskResponse(
        answer=answer,
        used_clients=requested,
        client_scopes=client_scopes,
        sources=sources,
    )

