# ============================== Memory & Cache ==============================
MEMORY: Dict[str, Dict[str, Any]] = defaultdict(lambda: {"history": deque(maxlen=20), "created": now()})
def mem_append(sid: str, role: str, content: Any): MEMORY[sid]["history"].append({"role": role, "content": content, "ts": now()})
def mem_get(sid: str, k: int = 10) -> List[Dict[str, Any]]:
    hist = list(MEMORY[sid]["history"]); return hist[-k:] if k else hist
def mem_clear(sid: str): MEMORY.pop(sid, None)

CACHE_TTL_SEC = int(os.getenv("CACHE_TTL_SEC", "300"))
_CACHE: Dict[str, Tuple[float, Any]] = {}
def _h(obj: Any) -> str: return hashlib.sha256(json.dumps(obj, sort_keys=True, default=str).encode()).hexdigest()[:16]
def cache_get(k: str):
    rec = _CACHE.get(k)
    if not rec: return None
    exp, val = rec
    if exp < now(): _CACHE.pop(k, None); return None
    return val
def cache_set(k: str, v: Any, ttl: int = CACHE_TTL_SEC): _CACHE[k] = (now()+ttl, v)


# ============================== LLM Helpers ==============================
def _invoke_bedrock(body: dict) -> dict:
    t0 = time.perf_counter()
    try:
        resp = bedrock.invoke_model(modelId=CLAUDE_MODEL_ID, body=json.dumps(body))
        payload = json.loads(resp["body"].read().decode("utf-8"))
        if TRACE_MCP:
            _log_json("[LLM] invoke_model response", payload, level=logging.DEBUG)
        return payload
    except Exception as e:
        log.error("[LLM] invoke_model error: %s\n%s", e, _exc_full(e))
        raise
    finally:
        dt = (time.perf_counter()-t0)*1000
        log.debug("[LLM] invoke_model took %.2f ms", dt)

def claude_json(system: str, user_obj: dict, max_tokens=512, temperature=0):
    body = {
        "anthropic_version": ANTHROPIC_VERSION,
        "max_tokens": max_tokens,
        "temperature": temperature,
        "system": system,
        "messages": [{"role":"user","content":[{"type":"text","text": json.dumps(user_obj)}]}],
    }
    if TRACE_MCP and LOG_PAYLOADS:
        _log_json("[LLM] claude_json request", body)
    payload = _invoke_bedrock(body)
    try:
        text = payload["content"][0]["text"]
        return json.loads(text)
    except Exception as e:
        log.error("[LLM] claude_json parse error: %s\nResponse=%s\nTrace=%s", e, _redact(payload), _exc_full(e))
        raise

def claude_text(system: str, user_obj: dict, max_tokens=512, temperature=0) -> str:
    body = {
        "anthropic_version": ANTHROPIC_VERSION,
        "max_tokens": max_tokens,
        "temperature": temperature,
        "system": system,
        "messages": [{"role":"user","content":[{"type":"text","text": json.dumps(user_obj)}]}],
    }
    if TRACE_MCP and LOG_PAYLOADS:
        _log_json("[LLM] claude_text request", body)
    payload = _invoke_bedrock(body)
    try:
        return payload["content"][0]["text"].strip()
    except Exception as e:
        log.error("[LLM] claude_text parse error: %s\nResponse=%s\nTrace=%s", e, _redact(payload), _exc_full(e))
        raise


