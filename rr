# ========= Local PDF helpers =========

def _basename_from_any(path_or_uri: Optional[str]) -> Optional[str]:
    if not path_or_uri:
        return None
    s = str(path_or_uri)
    if "://" in s:
        try:
            tail = s.split("://", 1)[1]
            name = Path(tail).name
            return name
        except Exception:
            return Path(s).name
    return Path(s).name

def _map_to_local_pdf(path_or_uri: Optional[str]) -> Optional[Path]:
    name = _basename_from_any(path_or_uri)
    if not name:
        return None
    local = PDFS_DIR / name
    return local if local.exists() else None

def _read_pdf_bytes_local(local_path: Path) -> Optional[bytes]:
    try:
        return local_path.read_bytes()
    except Exception:
        return None

