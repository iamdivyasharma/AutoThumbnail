import pandas as pd

INPUT = "client_clause_matrix.xlsx"
OUTPUT = "ahaooob_clause_subclause_content.xlsx"

df = pd.read_excel(INPUT)

def club(group: pd.DataFrame) -> str:
    parts, seen = [], set()
    for _, r in group.sort_values(["Client Name"]).iterrows():
        c = (r.get("Content") or "").strip()
        if not c: 
            continue
        bullet = f"- {r['Client Name']}: {c}"
        if bullet not in seen:
            parts.append(bullet); seen.add(bullet)
    return "\n".join(parts)

out = (
    df.groupby(["Clauses","Sub Clauses"], as_index=False)
      .apply(club)
      .rename(columns={None: "Content"})[["Clauses","Sub Clauses","Content"]]
)

out.to_excel(OUTPUT, index=False)
print(f"Saved: {OUTPUT}")
