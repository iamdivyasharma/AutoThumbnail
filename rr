# app.py

from __future__ import annotations

from typing import List, Optional, Sequence

import pandas as pd
import boto3

from langchain_aws import ChatBedrockConverse, BedrockEmbeddings
from langchain_community.vectorstores import FAISS
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain.chains import RetrievalQA
from langchain_core.documents import Document
from langchain_core.prompts import PromptTemplate

# -------------------------------------------------------------------
# 🔑 AWS CREDENTIALS (replace with your real keys for local testing)
# -------------------------------------------------------------------
AWS_ACCESS_KEY_ID = "YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION = "us-east-1"  # or whatever region you use for Bedrock

# Create a dedicated boto3 Session + Bedrock runtime client
bedrock_session = boto3.Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=AWS_REGION,
)

bedrock_runtime_client = bedrock_session.client("bedrock-runtime")

# -------------------------------------------------------------------
# App constants
# -------------------------------------------------------------------

# Path to the Excel file that will be read by default
EXCEL_PATH = "data/dashboard.xlsx"

UPDATED_LLM_COL = "Updated LLM insight"

RAG_TEMPLATE = """
You are a helpful RAG assistant working over an Excel dashboard.
Each document chunk is one or more rows from the Excel file, with columns such as
"Lanyon ID", "City" and "LLM insight".

Use ONLY the information in the provided context to answer.
If the user asks to change anything in the "LLM insight" column, tell them what
the updated value should be for each affected row, clearly referencing the
Lanyon ID / City / any other key columns.

Context:
{context}

Question:
{question}

Answer:
"""


# ---------- Core helpers ----------

def load_dashboard_df(path: str = EXCEL_PATH) -> pd.DataFrame:
    """
    Load the dashboard Excel file as a pandas DataFrame.
    """
    return pd.read_excel(path)


def df_to_documents(df: pd.DataFrame, source: str) -> List[Document]:
    """
    Convert a DataFrame into a list of LangChain Documents.
    Each row becomes one Document.

    Example:
        docs_dashboard = df_to_documents(df, "dashboard")
    """
    docs: List[Document] = []

    for idx, row in df.iterrows():
        text_lines = [f"{col}: {row[col]}" for col in df.columns]
        text = "\n".join(text_lines)
        metadata = {
            "source": source,
            "row_index": int(idx),
        }
        docs.append(Document(page_content=text, metadata=metadata))

    return docs


def chunk_documents(
    docs: List[Document],
    chunk_size: int = 1000,
    chunk_overlap: int = 150,
) -> List[Document]:
    """
    Split documents into smaller chunks using RecursiveCharacterTextSplitter.
    """
    splitter = RecursiveCharacterTextSplitter(
        chunk_size=chunk_size,
        chunk_overlap=chunk_overlap,
    )
    return splitter.split_documents(docs)


def build_qa_chain_from_df(df: pd.DataFrame) -> RetrievalQA:
    """
    Build a RetrievalQA chain on top of a DataFrame using:

    - df_to_documents(df, "dashboard")
    - RecursiveCharacterTextSplitter
    - BedrockEmbeddings (Titan embed)
    - FAISS vector store
    - ChatBedrockConverse (Claude 3.5 on Bedrock)
    """
    # 1) DataFrame -> Documents
    all_docs = df_to_documents(df, source="dashboard")

    # 2) Chunk documents
    split_docs = chunk_documents(all_docs, chunk_size=1000)

    # 3) Embeddings (Titan via Amazon Bedrock)
    embeddings = BedrockEmbeddings(
        model_id="amazon.titan-embed-text-v2:0",  # adjust to your Titan text embed model
        client=bedrock_runtime_client,
    )

    # 4) Vector store (FAISS)
    vectorstore = FAISS.from_documents(split_docs, embedding=embeddings)
    retriever = vectorstore.as_retriever(
        search_type="similarity",
        search_kwargs={"k": 4},
    )

    # 5) LLM (Claude 3.5 Sonnet on Bedrock)
    llm = ChatBedrockConverse(
        model_id="anthropic.claude-3-5-sonnet-20240620-v1:0",
        client=bedrock_runtime_client,
        temperature=0.1,
        max_tokens=512,
    )

    # 6) Prompt
    prompt = PromptTemplate(
        template=RAG_TEMPLATE,
        input_variables=["context", "question"],
    )

    # 7) RetrievalQA chain
    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        chain_type="stuff",
        retriever=retriever,
        chain_type_kwargs={"prompt": prompt},
        return_source_documents=False,
    )

    return qa_chain


def run_rag_query(
    query: str,
    df: pd.DataFrame,
    extra_instruction: Optional[str] = None,
) -> str:
    """
    Simple one-shot RAG query over the whole df.
    (Kept in case you still want direct Q&A.)
    """
    qa_chain = build_qa_chain_from_df(df)

    full_question = query
    if extra_instruction:
        full_question = f"{query}\n\nAdditional instructions from the user:\n{extra_instruction}"

    result = qa_chain.invoke({"query": full_question})

    if isinstance(result, dict) and "result" in result:
        return result["result"]

    return str(result)


# ---------- Row-wise "Updated LLM insight" generation ----------

def update_llm_insights_for_filtered_df(
    df_filtered: pd.DataFrame,
    user_instruction: str,
    filter_col: Optional[str] = None,
    filter_values: Optional[Sequence[str]] = None,
    updated_col_name: str = UPDATED_LLM_COL,
) -> pd.DataFrame:
    """
    Run the RAG chain row-wise on a FILTERED DataFrame and fill a new column
    (default: 'Updated LLM insight') with the model's answer for each row.

    - df_filtered: subset of the original df after user filters.
    - user_instruction: the text the user typed in Streamlit describing what
      should change in LLM insight.
    - filter_col / filter_values: optional metadata so the model knows what filter
      was applied.

    Returns a NEW DataFrame (does not modify df_filtered in-place).
    """
    if df_filtered.empty:
        return df_filtered.copy()

    qa_chain = build_qa_chain_from_df(df_filtered)
    updated_df = df_filtered.copy()

    for idx, row in updated_df.iterrows():
        row_text = "\n".join(f"{col}: {row[col]}" for col in updated_df.columns)

        question = f"""
You are updating the '{updated_col_name}' for ONE row of an Excel dashboard.

Filter info (for context only):
- Filter column: {filter_col or "none"}
- Filter values: {list(filter_values) if filter_values else "none"}

Here is the row data:
{row_text}

User's instructions for how the LLM insight should be changed:
{user_instruction}

Return ONLY the text that should go into the '{updated_col_name}' column
for THIS row. Do not talk about any other rows or give extra explanations.
"""

        result = qa_chain.invoke({"query": question})
        if isinstance(result, dict) and "result" in result:
            insight_text = str(result["result"]).strip()
        else:
            insight_text = str(result).strip()

        updated_df.at[idx, updated_col_name] = insight_text

    return updated_df




# streamlit.py

import os
from io import BytesIO

import pandas as pd
import streamlit as st

from app import (
    load_dashboard_df,
    update_llm_insights_for_filtered_df,
    UPDATED_LLM_COL,
)

st.set_page_config(page_title="Excel RAG Chatbot", layout="wide")

# ---------- Logo config ----------
LOGO_PATH = "logo.jpg"  # put your JPG logo here (same folder as this file)


# ---------- Utilities ----------

@st.cache_data
def get_dashboard_df() -> pd.DataFrame:
    """
    Load the Excel dashboard once and cache it for Streamlit.
    """
    return load_dashboard_df()


@st.cache_data
def df_to_excel_bytes(df: pd.DataFrame, sheet_name: str = "dashboard") -> bytes:
    """
    Convert a DataFrame to an in-memory Excel file for download.
    """
    output = BytesIO()
    with pd.ExcelWriter(output, engine="xlsxwriter") as writer:
        df.to_excel(writer, index=False, sheet_name=sheet_name)
    output.seek(0)
    return output.read()


# ---------- Init session state ----------

if "df_full" not in st.session_state:
    st.session_state.df_full = get_dashboard_df()
    st.session_state.df_filtered = st.session_state.df_full.copy()
    st.session_state.df_updated_filtered = None
    st.session_state.filter_col = None
    st.session_state.filter_values = []

if "chat_history" not in st.session_state:
    st.session_state.chat_history = []

df_full = st.session_state.df_full

# ---------- HEADER with LOGO ----------

header_cols = st.columns([1, 5])

with header_cols[0]:
    if os.path.exists(LOGO_PATH):
        st.image(LOGO_PATH, use_container_width=True)
    else:
        st.write(" ")  # empty space if logo is missing

with header_cols[1]:
    st.title("📊 RAG-based Excel Chatbot")
    st.caption("Conversational updates to your dashboard with Bedrock + FAISS + Excel")


st.markdown(
    """
This app uses a **RAG pipeline** in `app.py` (Bedrock + FAISS) over an Excel sheet.

You can:

1. **Download** the default Excel sheet used in the backend.  
2. **Filter** the DataFrame by any column (e.g. **Lanyon ID** or **City**).  
3. Tell the bot what changes you want in the **LLM insight** column.  
4. It will create a new column **`Updated LLM insight`** for each row in the
   **filtered DataFrame** using RAG **row-wise**.  
5. Confirm if you’re happy, or ask for more changes, or download the updated file.
"""
)

# ---------- 1) Download default Excel ----------

st.subheader("1️⃣ Download the default Excel sheet")

excel_bytes_full = df_to_excel_bytes(df_full, sheet_name="dashboard")

st.download_button(
    label="⬇️ Download current Excel dashboard",
    data=excel_bytes_full,
    file_name="dashboard.xlsx",
    mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
)

# ---------- 2) Filter the data ----------

st.subheader("2️⃣ Filter the data (e.g. by Lanyon ID or City)")

cols = list(df_full.columns)
if not cols:
    st.error("The DataFrame has no columns – please check your Excel file.")
else:
    # Prefer Lanyon ID or City if available
    default_index = 0
    if "Lanyon ID" in cols:
        default_index = cols.index("Lanyon ID")
    elif "City" in cols:
        default_index = cols.index("City")

    filter_col = st.selectbox(
        "Choose a column to filter on (for example **Lanyon ID** or **City**):",
        options=cols,
        index=default_index,
        key="filter_col",
    )

    if filter_col:
        possible_values = (
            df_full[filter_col]
            .dropna()
            .astype(str)
            .unique()
            .tolist()
        )
        possible_values = sorted(possible_values)
    else:
        possible_values = []

    filter_values = st.multiselect(
        f"Select one or more values from **{filter_col}** to keep in the filtered DataFrame:",
        options=possible_values,
        key="filter_values",
    )

    # Apply filter
    if filter_values:
        df_filtered = df_full[df_full[filter_col].astype(str).isin(filter_values)].copy()
    else:
        df_filtered = df_full.copy()

    st.session_state.df_filtered = df_filtered
    st.session_state.filter_col = filter_col
    st.session_state.filter_values = filter_values

    st.write("### Filtered DataFrame")
    st.dataframe(df_filtered, use_container_width=True)

    st.info(
        "Okay – have a look at the filtered DataFrame above.\n\n"
        f"Now tell me in the chat what changes you want to make in the "
        f"**'{UPDATED_LLM_COL}'** / **'LLM insight'** column (and which rows, "
        "by Lanyon ID / City / other identifiers)."
    )

# ---------- 3) Chat with the RAG bot (row-wise updates) ----------

st.subheader("3️⃣ Chat with the RAG bot about the filtered data")

# Existing chat history
for role, content in st.session_state.chat_history:
    with st.chat_message(role):
        st.markdown(content)

user_msg = st.chat_input(
    f"Describe the changes you want in the '{UPDATED_LLM_COL}' column, or ask a question about the filtered data..."
)

if user_msg:
    # Show user message
    st.session_state.chat_history.append(("user", user_msg))
    with st.chat_message("user"):
        st.markdown(user_msg)

    df_filtered = st.session_state.df_filtered
    filter_col = st.session_state.filter_col
    filter_values = st.session_state.filter_values

    with st.chat_message("assistant"):
        if df_filtered.empty:
            msg = (
                "Your filtered DataFrame currently has **0 rows**. "
                "Please adjust the filters above and try again."
            )
            st.markdown(msg)
            st.session_state.chat_history.append(("assistant", msg))
        else:
            with st.spinner(
                "Running RAG row-wise over the filtered DataFrame to update "
                f"'{UPDATED_LLM_COL}'..."
            ):
                try:
                    updated_df = update_llm_insights_for_filtered_df(
                        df_filtered=df_filtered,
                        user_instruction=user_msg,
                        filter_col=filter_col,
                        filter_values=filter_values,
                    )
                    st.session_state.df_updated_filtered = updated_df
                    n_rows = len(updated_df)

                    reply = (
                        f"I've generated **{UPDATED_LLM_COL}** values for "
                        f"**{n_rows} row(s)** in the current filtered DataFrame.\n\n"
                        "Scroll down to review the updated table. You can then either:\n"
                        "1. Ask for **more changes** (adjust filters or give another instruction), or\n"
                        "2. Choose **end and download file** to export the filtered rows "
                        f"with the new **'{UPDATED_LLM_COL}'** column."
                    )
                except Exception as e:
                    reply = f"Error while calling the RAG backend: `{e}`"

            st.markdown(reply)
            st.session_state.chat_history.append(("assistant", reply))

# ---------- 4) Review updated DF + confirm / more changes / download ----------

if st.session_state.get("df_updated_filtered") is not None:
    st.subheader("4️⃣ Review and finish")

    updated_df = st.session_state.df_updated_filtered

    st.write(
        f"#### Filtered DataFrame with new **'{UPDATED_LLM_COL}'** column (row-wise RAG output)"
    )
    st.dataframe(updated_df, use_container_width=True)

    next_action = st.radio(
        "Are you fine with these updates, or do you need more changes?",
        options=[
            "I need more changes (go back to filters / give another instruction)",
            "End this and download the updated filtered file",
        ],
        index=0,
        key="next_action_after_update",
    )

    if next_action.startswith("I need more"):
        st.info(
            "No problem. You can change the filters in step **2** above or type a new "
            "instruction in the chat in step **3**. The app will regenerate "
            f"the **'{UPDATED_LLM_COL}'** column for the new filtered DataFrame."
        )
    else:
        st.success(
            "Great! Click the button below to download the updated file containing "
            "only the **filtered rows** plus the new "
            f"**'{UPDATED_LLM_COL}'** column."
        )

        excel_bytes_updated = df_to_excel_bytes(
            updated_df, sheet_name="filtered_with_updated_llm"
        )

        st.download_button(
            label="⬇️ Download updated filtered Excel",
            data=excel_bytes_updated,
            file_name="dashboard_filtered_updated_llm_insight.xlsx",
            mime=(
                "application/vnd.openxmlformats-officedocument."
                "spreadsheetml.sheet"
            ),
        )
