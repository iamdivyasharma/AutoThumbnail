def _call_agent_once(payload: dict, response_key: str = "final_answer"):
    with st.status("Agent is planning your trip…", expanded=False) as s:
        status, data = post(AGENT_URL, payload)
        raw_answer = data.get(response_key, "") if isinstance(data, dict) else str(data)
        s.update(label="Done", state="complete")
    sig = answer_sig(str(raw_answer), payload)
    if st.session_state.last_answer_hash != sig:
        st.session_state.messages.append({"role": "assistant", "content": str(raw_answer)})
        st.session_state.last_answer_hash = sig
        st.rerun()

# ========= Filters for "Home" branch (Destination + Dates only) =========
def _filters_home_branch():
    st.markdown("### 🔎 Filters\nChoose destination and dates you want to travel.")
    dest_code = st.selectbox(
        "Destination",
        options=[x for x in DESTINATION_OPTIONS if x != st.session_state.tdna_home_code],
        index=0,
        format_func=label_for,
        key="dest_home_branch",
    )
    start_default = _snap_to_allowed(START_WHITELIST[0], START_WHITELIST, direction="nearest")
    end_default = _snap_to_allowed(END_WHITELIST[-1], END_WHITELIST, direction="up", min_after=start_default)
    start_input = st.date_input("Start date", value=start_default, min_value=START_WHITELIST[0], max_value=START_WHITELIST[-1], format="YYYY-MM-DD", key="start_home_branch")
    end_input   = st.date_input("End date",   value=end_default,   min_value=END_WHITELIST[0],   max_value=END_WHITELIST[-1],   format="YYYY-MM-DD", key="end_home_branch")

    c1, _ = st.columns(2)
    go = c1.button("Apply", use_container_width=True, key="apply_home_branch")
    if go:
        chosen_start = start_input if isinstance(start_input, date) else START_WHITELIST[0]
        snapped_start = _snap_to_allowed(chosen_start, START_WHITELIST, direction="nearest")
        chosen_end = end_input if isinstance(end_input, date) else END_WHITELIST[-1]
        snapped_end = _snap_to_allowed(chosen_end, END_WHITELIST, direction="up", min_after=snapped_start)

        st.session_state.filters = {
            "ond": {"origin": st.session_state.tdna_home_code, "destination": dest_code},
            "start_date": snapped_start.isoformat(),
            "end_date": snapped_end.isoformat(),
        }

        qtext = main_trip_query(st.session_state.filters)
        payload = {
            "query": qtext,
            "session_id": st.session_state.session_id,
            "autonomy": st.session_state.autonomy,
            "max_iters": st.session_state.max_iters,
            "extra": {
                "user_name": st.session_state.user_name.strip(),
                "user_email": st.session_state.user_email.strip(),
                "filters": st.session_state.filters,
                "ui_version": "new-ui-v3",
                "source": "home_branch_apply",
                "llm_hints": "Use conversation history; avoid repetition.",
            },
        }
        _call_agent_once(payload, response_key="final_answer")

# ========= Filters for "Other" branch (Origin + Destination + Dates) =========
def _filters_other_branch():
    st.markdown("### 🔎 Filters\nChoose origin, destination, and dates you want to travel.")
    origin_code = st.selectbox(
        "Origin",
        options=ORIGIN_OPTIONS,
        index=ORIGIN_OPTIONS.index(st.session_state.tdna_home_code) if st.session_state.tdna_home_code in ORIGIN_OPTIONS else 0,
        format_func=label_for,
        key="origin_other_branch",
    )
    dest_code = st.selectbox(
        "Destination",
        options=[x for x in DESTINATION_OPTIONS if x != origin_code],
        index=0,
        format_func=label_for,
        key="dest_other_branch",
    )
    start_default = _snap_to_allowed(START_WHITELIST[0], START_WHITELIST, direction="nearest")
    end_default = _snap_to_allowed(END_WHITELIST[-1], END_WHITELIST, direction="up", min_after=start_default)
    start_input = st.date_input("Start date", value=start_default, min_value=START_WHITELIST[0], max_value=START_WHITELIST[-1], format="YYYY-MM-DD", key="start_other_branch")
    end_input   = st.date_input("End date",   value=end_default,   min_value=END_WHITELIST[0],   max_value=END_WHITELIST[-1],   format="YYYY-MM-DD", key="end_other_branch")

    c1, _ = st.columns(2)
    go = c1.button("Apply", use_container_width=True, key="apply_other_branch")
    if go:
        if origin_code == dest_code:
            st.error("Origin and Destination cannot be the same. Please change one and click Apply again.")
            return
        chosen_start = start_input if isinstance(start_input, date) else START_WHITELIST[0]
        snapped_start = _snap_to_allowed(chosen_start, START_WHITELIST, direction="nearest")
        chosen_end = end_input if isinstance(end_input, date) else END_WHITELIST[-1]
        snapped_end = _snap_to_allowed(chosen_end, END_WHITELIST, direction="up", min_after=snapped_start)

        st.session_state.filters = {
            "ond": {"origin": origin_code, "destination": dest_code},
            "start_date": snapped_start.isoformat(),
            "end_date": snapped_end.isoformat(),
        }

        qtext = main_trip_query(st.session_state.filters)
        payload = {
            "query": qtext,
            "session_id": st.session_state.session_id,
            "autonomy": st.session_state.autonomy,
            "max_iters": st.session_state.max_iters,
            "extra": {
                "user_name": st.session_state.user_name.strip(),
                "user_email": st.session_state.user_email.strip(),
                "filters": st.session_state.filters,
                "ui_version": "new-ui-v3",
                "source": "other_branch_apply",
                "llm_hints": "Use conversation history; avoid repetition.",
            },
        }
        _call_agent_once(payload, response_key="final_answer")

# ================== Flow rendering ==================
if st.session_state.user_confirmed and st.session_state.boot_tdna_home:
    # Mode switch: only show filters in Form mode
    if st.session_state.plan_mode == "Form (origin/destination/date pickers)":
        home_code = st.session_state.tdna_home_code
        home_label = st.session_state.tdna_home_label
        if home_code and home_label:
            if st.session_state.home_choice is None:
                _home_welcome_block()
            elif st.session_state.home_choice == "home":
                st.success(f"Using Home location: **{home_label}**")
                _filters_home_branch()
            else:
                st.info("Choose your origin, destination, and dates below.")
                _filters_other_branch()
        else:
            st.warning("Could not map a Home airport to your allowed origins. Please choose another origin.")
            st.session_state.home_choice = "other"
            _filters_other_branch()
    else:
        st.markdown("### ✍️ Type your request below")
        st.info("Example: “plan my trip from London to Phoenix 2025-09-10 to 2025-09-15”. Filters are hidden in this mode.")

elif not st.session_state.user_confirmed:
    st.info("Click **Start planning** in the sidebar after entering a user to begin. This prevents TDNA from running on first load.")

# ================== Chat transcript ==================
for m in st.session_state.messages:
    with st.chat_message(m["role"]):
        st.markdown(m["content"])

# ================== Chat input (Agentic mode only) ==================
prompt = st.chat_input("Type a message and press Enter…")
if prompt:
    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    extra = {
        "user_name": st.session_state.user_name.strip(),
        "user_email": st.session_state.user_email.strip(),
        # pass current filters if available; orchestrator can still parse free text
        "filters": {
            "ond": {
                "origin": st.session_state.filters["ond"]["origin"],
                "destination": st.session_state.filters["ond"]["destination"],
            },
            "start_date": st.session_state.filters["start_date"],
            "end_date": st.session_state.filters["end_date"],
        },
        "ui_version": "new-ui-v3"
    }

    try:
        payload = {
            "query": prompt.strip(),
            "session_id": st.session_state.session_id,
            "autonomy": st.session_state.autonomy,
            "max_iters": st.session_state.max_iters,
            "extra": extra,
        }
        with st.chat_message("assistant"):
            with st.spinner("Processing…"):
                status, data = post(AGENT_URL, payload)
            final_answer = data.get("final_answer", "") if isinstance(data, dict) else str(data)
            st.markdown(final_answer)

        sig = answer_sig(final_answer, payload)
        if st.session_state.last_answer_hash != sig:
            st.session_state.messages.append({"role": "assistant", "content": final_answer})
            st.session_state.last_answer_hash = sig

    except Exception as e:
        err = f"Request error: {e}"
        with st.chat_message("assistant"):
            st.error(err)
        st.session_state.messages.append({"role": "assistant", "content": err})

