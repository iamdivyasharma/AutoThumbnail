# app.py
# Streamlit Chatbot UI with per-user memory and minimal payload to backend
# Run: streamlit run app.py

import os
import json
from pathlib import Path
from typing import List, Dict, Any

import streamlit as st

# ----------------------------
# Static user list (email auto-fills on selection)
# ----------------------------
USERS = [
    {"name": "Alice Singh",  "email": "alice@example.com"},
    {"name": "Bob Kumar",    "email": "bob@example.com"},
    {"name": "Charlie Rao",  "email": "charlie@example.com"},
]

NAME_TO_EMAIL = {u["name"]: u["email"] for u in USERS}

# ----------------------------
# Utility: per-user memory as JSON files
# ----------------------------
MEM_DIR = Path("memory")
MEM_DIR.mkdir(parents=True, exist_ok=True)

def _safe_key(email: str) -> str:
    return email.replace("@", "_at_").replace(".", "_dot_")

def memory_path(email: str) -> Path:
    return MEM_DIR / f"{_safe_key(email)}.json"

def load_memory(email: str) -> List[Dict[str, str]]:
    p = memory_path(email)
    if p.exists():
        try:
            return json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            return []
    return []

def save_memory(email: str, messages: List[Dict[str, str]]) -> None:
    p = memory_path(email)
    p.write_text(json.dumps(messages, ensure_ascii=False, indent=2), encoding="utf-8")

def clear_memory(email: str) -> None:
    p = memory_path(email)
    if p.exists():
        p.unlink(missing_ok=True)

# ----------------------------
# Backend adapter: local Ragbot.py OR HTTP endpoint via RAGBOT_URL
# Must return a string answer.
# ----------------------------
def query_backend(payload: Dict[str, Any]) -> str:
    """
    Tries local Ragbot.py first:
      - Ragbot.get_answer(payload) or Ragbot.answer(payload) or Ragbot.query(payload)
    Else, if env RAGBOT_URL is set, POSTs JSON and expects {"answer": "..."}.
    Fallback returns a stub message so the UI stays functional.
    """
    # Try local python module
    try:
        import Ragbot  # Ragbot.py sitting next to this file
        for fn_name in ("get_answer", "answer", "query"):
            fn = getattr(Ragbot, fn_name, None)
            if callable(fn):
                return str(fn(payload))
    except Exception:
        pass

    # Try HTTP endpoint
    url = os.getenv("RAGBOT_URL", "").strip()
    if url:
        try:
            import requests  # only used if URL provided
            resp = requests.post(url, json=payload, timeout=60)
            resp.raise_for_status()
            data = resp.json()
            return str(data.get("answer", data))
        except Exception as e:
            return f"⚠️ Backend error: {e}"

    # Stub fallback if neither module nor URL is available
    return "🔌 Backend not connected. Provide Ragbot.py or set RAGBOT_URL."

# ----------------------------
# Streamlit page config & small CSS
# ----------------------------
st.set_page_config(page_title="User-Scoped Chatbot", page_icon="💬", layout="centered")

st.markdown(
    """
    <style>
      /* Center the logo wrapper, limit chat width, and make history scrollable */
      .logo-wrap { display:flex; justify-content:center; align-items:center; margin: 0.5rem 0 1rem 0; }
      .chat-wrap { max-width: 820px; margin: 0 auto; }
      .history-box { height: 480px; overflow-y: auto; padding: 0.25rem 0.5rem; border-radius: 0.5rem; border: 1px solid #e6e6e6; background: #fafafa; }
      .pill { display:inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; background:#f0f0f0; font-size: 0.8rem; margin-left: 0.5rem; }
    </style>
    """,
    unsafe_allow_html=True
)

# ----------------------------
# Session state init
# ----------------------------
if "selected_name" not in st.session_state:
    st.session_state.selected_name = USERS[0]["name"]
if "user_name" not in st.session_state:
    st.session_state.user_name = st.session_state.selected_name
if "user_email" not in st.session_state:
    st.session_state.user_email = NAME_TO_EMAIL[st.session_state.user_name]
if "messages_by_user" not in st.session_state:
    st.session_state.messages_by_user = {}  # {email: [{"role": "user"/"assistant", "content": "..."}]}

def ensure_loaded(email: str):
    if email not in st.session_state.messages_by_user:
        st.session_state.messages_by_user[email] = load_memory(email)

# ----------------------------
# Sidebar controls (user switch & memory ops)
# ----------------------------
with st.sidebar:
    st.header("⚙️ Settings")

    # Choose user (email auto-selects)
    st.session_state.selected_name = st.selectbox(
        "Select Username",
        options=[u["name"] for u in USERS],
        index=[u["name"] for u in USERS].index(st.session_state.selected_name),
    )

    # Sync email + user_name when selection changes
    st.session_state.user_name = st.session_state.selected_name
    st.session_state.user_email = NAME_TO_EMAIL[st.session_state.user_name]

    # Load messages for this user
    ensure_loaded(st.session_state.user_email)

    # Memory controls
    if st.button("🧹 Delete Memory for Selected User"):
        clear_memory(st.session_state.user_email)
        st.session_state.messages_by_user[st.session_state.user_email] = []
        st.success("Memory deleted for this user.")

    st.caption("Per-user conversation history is saved to the ./memory folder.")

# ----------------------------
# Header with centered logo
# ----------------------------
with st.container():
    col_logo = st.columns([1, 4, 1])[1]
    with col_logo:
        logo_path = st.text_input("Logo path or URL (optional):", value="", help="Local path or URL to an image")
        st.markdown('<div class="logo-wrap">', unsafe_allow_html=True)
        if logo_path.strip():
            try:
                st.image(logo_path.strip(), width=120)
            except Exception:
                st.warning("Could not load the logo from the provided path/URL.")
        else:
            st.caption("Tip: Add a logo path or URL to display it here.")
        st.markdown('</div>', unsafe_allow_html=True)

# Small header badges
user_badge = f"{st.session_state.user_name} <span class='pill'>{st.session_state.user_email}</span>"
st.markdown(f"<div class='chat-wrap'><h2>💬 Chat with <code>{user_badge}</code></h2></div>", unsafe_allow_html=True)

# ----------------------------
# Chat history (scrollable)
# ----------------------------
history = st.session_state.messages_by_user.get(st.session_state.user_email, [])
with st.container():
    st.markdown("<div class='chat-wrap'>", unsafe_allow_html=True)
    with st.container():
        st.markdown("<div class='history-box'>", unsafe_allow_html=True)
        for msg in history:
            with st.chat_message(msg["role"]):
                st.markdown(msg["content"])
        st.markdown("</div>", unsafe_allow_html=True)
    st.markdown("</div>", unsafe_allow_html=True)

# ----------------------------
# Chat input and send
# ----------------------------
placeholder = f"Ask {st.session_state.user_name} a question…"
query_text = st.chat_input(placeholder=placeholder)

if query_text:
    # Append user message locally
    history.append({"role": "user", "content": query_text})
    st.session_state.messages_by_user[st.session_state.user_email] = history
    save_memory(st.session_state.user_email, history)  # save immediately

    # --- STRICT MINIMAL PAYLOAD (no extra keys) ---
    payload = {
        "query": query_text,
        "user_name": (st.session_state.user_name or "").strip(),
        "user_email": (st.session_state.user_email or "").strip(),
    }

    with st.spinner("Thinking…"):
        answer = query_backend(payload)

    # Append assistant message and persist memory
    history.append({"role": "assistant", "content": answer})
    st.session_state.messages_by_user[st.session_state.user_email] = history
    save_memory(st.session_state.user_email, history)

    # Rerender the last exchange immediately
    with st.chat_message("assistant"):
        st.markdown(answer)

# ----------------------------
# Footer hint
# ----------------------------
st.markdown(
    "<div class='chat-wrap'><hr/><small>"
    "Payload sent to backend is exactly: <code>{'query', 'user_name', 'user_email'}</code>. "
    "Provide <code>Ragbot.py</code> with <code>get_answer/answer/query</code> or set <code>RAGBOT_URL</code> for HTTP.</small></div>",
    unsafe_allow_html=True,
)
