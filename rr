# NEW (no numeric labels; keep a light header for orientation only):
def fmt(docs):
    return "\n\n".join(
        f"(policy: {d.metadata.get('policy_id')}, page: {d.metadata.get('page', '?')})\n{d.page_content}"
        for d in docs
    )
