# index_clients.py
# Build per-client FAISS indexes from PDFs stored in S3.
# - Text PDFs -> PyPDFLoader
# - Scanned PDFs -> Textract (async) on the S3 object, cached locally
# - Saves FAISS locally under faiss_indices/<client>/
# - Writes manifest.json per client for app.py to show "All documents"

import os
import io
import json
import time
import hashlib
import argparse
import re
from pathlib import Path
from collections import defaultdict
from typing import List, Dict, Any

import boto3
import fitz  # PyMuPDF
from langchain_aws import BedrockEmbeddings
from langchain_community.document_loaders import PyPDFLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain_community.vectorstores import FAISS
from langchain.schema import Document

# ========= EDIT THESE =========
REGION      = "us-east-1"
S3_BUCKET   = "YOUR_BUCKET"        # <---- set your bucket
S3_PREFIX   = "contracts/"         # <---- your "folder" in that bucket

# Bedrock models
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

# ⚠️ Dev creds (prefer IAM roles in prod)
AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

# Local outputs
INDEX_DIR  = Path("faiss_indices").resolve(); INDEX_DIR.mkdir(exist_ok=True)
CACHE_DIR  = Path("ocr_cache").resolve();     CACHE_DIR.mkdir(exist_ok=True)
TMP_DIR    = Path("tmp_dl").resolve();        TMP_DIR.mkdir(exist_ok=True)

# Default chunking (can be overridden per client in configs/clients.yaml)
DEFAULT_CHUNK_SIZE    = 1200
DEFAULT_CHUNK_OVERLAP = 180

CONFIGS_PATH = Path("configs/clients.yaml").resolve()
# =============================

SESSION  = boto3.Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)
S3       = SESSION.client("s3")
TEXTRACT = SESSION.client("textract")
EMB      = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))

def load_yaml_overrides() -> Dict[str, Any]:
    if not CONFIGS_PATH.exists():
        return {}
    import yaml
    raw = yaml.safe_load(CONFIGS_PATH.read_text()) or {}
    return {str(k).lower(): (v or {}) for k, v in raw.items()}

OVERRIDES = load_yaml_overrides()

def client_from_filename(name: str) -> str:
    """
    Derive client_id from filename by taking the first token before space/_/-/.
    'BMW US_policy1.2.pdf'   -> 'bmw'
    'estee lau_plocuy67.pdf' -> 'estee'
    'kpmg-benefits.pdf'      -> 'kpmg'
    'ey_policy.pdf'          -> 'ey'
    """
    base = Path(name).name.lower()
    base = Path(base).stem
    first = re.split(r"[ _\-\.]+", base, maxsplit=1)[0]
    return first.strip()

def list_s3_pdfs() -> List[Dict[str, Any]]:
    """Return [{'key':..., 'size':..., 'last_modified': epoch, 'client_id':..., 'basename':...}]"""
    out = []
    token = None
    while True:
        kwargs = {"Bucket": S3_BUCKET, "Prefix": S3_PREFIX}
        if token: kwargs["ContinuationToken"] = token
        resp = S3.list_objects_v2(**kwargs)
        for obj in resp.get("Contents", []):
            key = obj["Key"]
            if not key.lower().endswith(".pdf"): 
                continue
            base = Path(key).name
            cid  = client_from_filename(base)
            out.append({
                "key": key,
                "basename": base,
                "client_id": cid,
                "size": obj.get("Size"),
                "last_modified": int(obj.get("LastModified").timestamp()) if obj.get("LastModified") else None,
            })
        if resp.get("IsTruncated"):
            token = resp.get("NextContinuationToken")
        else:
            break
    return out

def download_to_tmp(key: str) -> Path:
    local = TMP_DIR / Path(key).name
    with open(local, "wb") as f:
        S3.download_fileobj(S3_BUCKET, key, f)
    return local

def has_text_first_pages(local_pdf: Path, sample_pages: int = 3) -> bool:
    try:
        doc = fitz.open(str(local_pdf))
        n = min(sample_pages, doc.page_count)
        for i in range(n):
            if doc.load_page(i).get_text("text").strip():
                return True
        return False
    except Exception:
        return False

def textract_cache_key(key: str) -> Path:
    h = hashlib.sha1(key.encode()).hexdigest()[:10]
    base = Path(key).name
    return CACHE_DIR / f"{base}-{h}.textract.json"

def run_textract_on_s3(key: str) -> Dict[int, Dict[str, Any]]:
    """StartDocumentTextDetection on S3 object, poll GetDocumentTextDetection, return {page:{text,lines[bbox]}}."""
    start = TEXTRACT.start_document_text_detection(
        DocumentLocation={"S3Object": {"Bucket": S3_BUCKET, "Name": key}}
    )
    job_id = start["JobId"]
    pages: Dict[int, Dict[str, Any]] = {}
    next_token = None
    while True:
        args = {"JobId": job_id}
        if next_token: args["NextToken"] = next_token
        resp = TEXTRACT.get_document_text_detection(**args)
        status = resp["JobStatus"]
        for b in resp.get("Blocks", []):
            if b["BlockType"] == "LINE":
                p = b.get("Page", 1)
                pages.setdefault(p, {"text": [], "lines": []})
                pages[p]["text"].append(b.get("Text", ""))
                bb = b.get("Geometry", {}).get("BoundingBox", {})
                pages[p]["lines"].append({
                    "text": b.get("Text", ""),
                    "bbox": [bb.get("Left",0.0), bb.get("Top",0.0), bb.get("Width",0.0), bb.get("Height",0.0)]
                })
        next_token = resp.get("NextToken")
        if status in ("SUCCEEDED", "FAILED", "PARTIAL_SUCCESS") and not next_token:
            break
        time.sleep(2)

    return {p: {"text": "\n".join(v["text"]), "lines": v["lines"]} for p, v in pages.items()}

def load_or_cache_textract(key: str) -> Dict[int, Dict[str, Any]]:
    cache = textract_cache_key(key)
    if cache.exists():
        return json.loads(cache.read_text(encoding="utf-8"))
    data = run_textract_on_s3(key)
    cache.write_text(json.dumps(data), encoding="utf-8")
    return data

def per_page_documents_from_textract(local_pdf: Path, s3_key: str, client_id: str, policy_id: str) -> List[Document]:
    """Build per-page Documents using Textract; include line boxes + page size for highlights."""
    data = load_or_cache_textract(s3_key)
    docs: List[Document] = []
    try:
        doc = fitz.open(str(local_pdf))
        for pnum, payload in sorted(data.items()):
            text = (payload.get("text") or "").strip()
            if not text: 
                continue
            page = doc.load_page(pnum - 1)
            docs.append(Document(
                page_content=text,
                metadata={
                    "client_id": client_id,
                    "policy_id": policy_id,
                    "page": int(pnum),
                    "source_s3_bucket": S3_BUCKET,
                    "source_s3_key": s3_key,
                    "textract_lines": payload.get("lines", []),
                    "page_width": float(page.rect.width),
                    "page_height": float(page.rect.height),
                }
            ))
        return docs
    except Exception:
        # fallback if we couldn't open PDF for sizes
        return [Document(
            page_content=(payload.get("text") or ""),
            metadata={
                "client_id": client_id,
                "policy_id": policy_id,
                "page": int(pnum),
                "source_s3_bucket": S3_BUCKET,
                "source_s3_key": s3_key,
                "textract_lines": payload.get("lines", []),
            }
        ) for pnum, payload in sorted(data.items())]

def per_page_documents_from_textpdf(local_pdf: Path, s3_key: str, client_id: str, policy_id: str) -> List[Document]:
    """Use PyPDFLoader (keeps page numbers). Tag S3 info for viewer."""
    raw_docs = PyPDFLoader(str(local_pdf)).load()
    docs: List[Document] = []
    for d in raw_docs:
        md = dict(d.metadata)
        md.update({
            "client_id": client_id,
            "policy_id": policy_id,
            "page": int(md.get("page", 0)) + 1,   # 1-based
            "source_s3_bucket": S3_BUCKET,
            "source_s3_key": s3_key,
        })
        docs.append(Document(page_content=d.page_content, metadata=md))
    return docs

def build_client(client_id: str, s3_items: List[Dict[str, Any]]):
    # chunking (can be per-client in YAML)
    cfg = OVERRIDES.get(client_id, {})
    chunk_size    = int(cfg.get("chunk_size", DEFAULT_CHUNK_SIZE))
    chunk_overlap = int(cfg.get("chunk_overlap", DEFAULT_CHUNK_OVERLAP))
    splitter = RecursiveCharacterTextSplitter(chunk_size=chunk_size, chunk_overlap=chunk_overlap, add_start_index=True)

    all_chunks = []
    manifest_docs = []

    for it in s3_items:
        key       = it["key"]
        basename  = it["basename"]
        local_pdf = download_to_tmp(key)

        # choose text vs OCR
        if has_text_first_pages(local_pdf):
            page_docs = per_page_documents_from_textpdf(local_pdf, key, client_id, basename)
        else:
            page_docs = per_page_documents_from_textract(local_pdf, key, client_id, basename)

        # split + propagate metadata
        for d in page_docs:
            parts = splitter.split_documents([d])
            for c in parts:
                md = dict(c.metadata)
                md.setdefault("client_id", client_id)
                md.setdefault("policy_id", basename)
                md.setdefault("page", d.metadata.get("page"))
                md.setdefault("source_s3_bucket", S3_BUCKET)
                md.setdefault("source_s3_key", key)
                if "textract_lines" in d.metadata: md["textract_lines"] = d.metadata["textract_lines"]
                if "page_width" in d.metadata:     md["page_width"]     = d.metadata["page_width"]
                if "page_height" in d.metadata:    md["page_height"]    = d.metadata["page_height"]
                c.metadata = md
                all_chunks.append(c)

        # collect manifest info (page count & mtime)
        try:
            pc = fitz.open(str(local_pdf)).page_count
        except Exception:
            pc = None
        manifest_docs.append({
            "policy_id": basename,
            "s3_bucket": S3_BUCKET,
            "s3_key": key,
            "pages": pc,
            "modified_time": it.get("last_modified"),
            "size": it.get("size"),
        })

    if not all_chunks:
        print(f"[warn] {client_id}: no chunks")
        return

    vs = FAISS.from_documents(all_chunks, EMB)
    outdir = INDEX_DIR / client_id
    outdir.mkdir(parents=True, exist_ok=True)
    vs.save_local(str(outdir))
    # write manifest
    (outdir / "manifest.json").write_text(json.dumps({
        "client_id": client_id,
        "region": REGION,
        "embed_model": EMBED_MODEL,
        "chunk_size": chunk_size,
        "chunk_overlap": chunk_overlap,
        "docs": manifest_docs,
        "updated_at": int(time.time()),
    }, indent=2))
    print(f"[ok] {client_id}: {len(all_chunks)} chunks → {outdir}")

def main():
    s3pdfs = list_s3_pdfs()
    if not s3pdfs:
        print("No PDFs in S3. Check bucket/prefix.")
        return
    by_client = defaultdict(list)
    for it in s3pdfs:
        by_client[it["client_id"]].append(it)

    parser = argparse.ArgumentParser()
    parser.add_argument("--client", help="build only this client id")
    args = parser.parse_args()

    if args.client:
        cid = args.client.lower().strip()
        if cid not in by_client:
            print(f"No items for client '{cid}'")
            return
        build_client(cid, by_client[cid])
    else:
        for cid, items in by_client.items():
            build_client(cid, items)

if __name__ == "__main__":
    main()
