# ================== Helpers ==================
def post(url: str, payload: dict):
    r = requests.post(url, json=payload, timeout=TIMEOUT)
    if r.headers.get("content-type","").startswith("application/json"):
        return r.status_code, r.json()
    return r.status_code, r.text

def answer_sig(text: str, payload: dict) -> str:
    blob = json.dumps({"t": text, "p": payload}, sort_keys=True, default=str)
    return hashlib.sha256(blob.encode()).hexdigest()[:16]

def ensure_state():
    ss = st.session_state
    # transcript
    if "messages" not in ss: ss.messages = []  # [{"role":"user"|"assistant","content":str}]
    # identity / session
    if "session_id" not in ss: ss.session_id = "user123"
    if "user_name" not in ss: ss.user_name = ""
    if "user_email" not in ss: ss.user_email = ""
    # agent loop
    if "autonomy" not in ss: ss.autonomy = True
    if "max_iters" not in ss: ss.max_iters = 3
    # filters
    if "filters" not in ss:
        ss.filters = {
            "ond": {"origin": ORIGIN_OPTIONS[0], "destination": DESTINATION_OPTIONS[0]},
            "start_date": START_WHITELIST[0].isoformat(),
            "end_date": END_WHITELIST[-1].isoformat(),
        }
    # boot flags
    if "boot_tdna_home" not in ss: ss.boot_tdna_home = False
    if "tdna_home_code" not in ss: ss.tdna_home_code = None
    if "tdna_home_label" not in ss: ss.tdna_home_label = None
    if "home_choice" not in ss: ss.home_choice = None  # "home"|"other"|None
    if "last_boot_user_key" not in ss: ss.last_boot_user_key = ""
    if "last_answer_hash" not in ss: ss.last_answer_hash = None
    # planning mode: sidebar toggle plus chat branching
    if "plan_mode" not in ss: ss.plan_mode = "Use filters"
    # explicit user-start guard so TDNA doesn't run on first page load
    if "started" not in ss: ss.started = False

ensure_state()

# ===== Query text builders =====
def build_trip_query(fil: dict) -> str:
    return f"plan me a trip from {fil['ond']['origin']} to {fil['ond']['destination']} on {fil['start_date']} to {fil['end_date']}"

def build_agent_payload(query_text: str, *, source: str):
    return {
        "query": query_text,
        "session_id": st.session_state.session_id,
        "autonomy": st.session_state.autonomy,
        "max_iters": st.session_state.max_iters,
        "extra": {
            "user_name": st.session_state.user_name.strip(),
            "user_email": st.session_state.user_email.strip(),
            "filters": st.session_state.filters,
            "ui_version": "chat+filters-v1",
            "source": source,
        },
    }

