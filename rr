app = FastAPI(title=APP_TITLE, version="1.0.0")


# ============================
# Request / Response models
# ============================

class MetadataLookupRequest(BaseModel):
    query: str = Field(..., description="Natural language query")
    session_id: Optional[str] = Field(None, description="Optional conversational session id")
    category: Optional[str] = Field(None, description="finance or legal")
    top_k: int = Field(5, ge=1, le=20, description="How many client matches to consider")
    include_manifest: bool = Field(True, description="Include manifest.json metadata")
    include_pdf_metadata: bool = Field(False, description="Load *.pdf.metadata JSON per document (slower)")
    max_docs: int = Field(20, ge=1, le=200, description="Limit documents returned per scope")


class MetadataLookupResponse(BaseModel):
    resolved: Dict[str, Any]
    excel_rows: List[Dict[str, Any]]
    scopes: List[Dict[str, Any]]
    manifest: Optional[Dict[str, Any]] = None
    memory: Optional[Dict[str, Any]] = None


# ============================
# Routes
# ============================

@app.get("/health")
def health() -> Dict[str, str]:
    return {"status": "ok"}


@app.get("/schema")
def schema() -> Dict[str, Any]:
    """Returns Excel columns + a few examples of manifest/pdf-metadata keys."""
    return service.get_schema()


@app.post("/lookup", response_model=MetadataLookupResponse)
def lookup(payload: MetadataLookupRequest):
    if not payload.query or not payload.query.strip():
        raise HTTPException(400, "query is required")

    res = service.lookup(
        query=payload.query.strip(),
        session_id=payload.session_id,
        category=payload.category,
        top_k=payload.top_k,
        include_manifest=payload.include_manifest,
        include_pdf_metadata=payload.include_pdf_metadata,
        max_docs=payload.max_docs,
    )
    return MetadataLookupResponse(**res)


@app.get("/session/{session_id}")
def get_session(session_id: str):
    return {"session_id": session_id, "memory": service.get_session_memory(session_id)}


@app.delete("/session/{session_id}")
def clear_session(session_id: str):
    service.clear_session_memory(session_id)
    return {"status": "ok", "session_id": session_id, "cleared": True}

