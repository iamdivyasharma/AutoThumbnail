# utils.py
from typing import Dict, Any, Tuple, Optional, NamedTuple

class HotelInputs(NamedTuple):
    """
    Rich, structured inputs parsed from an orchestrator call.
    - query: the search/query text (checks 'qquery' then 'query')
    - user_name / user_email: from nested 'extra' first, then top-level
    - filters: { ond: {origin, destination}, start_date, end_date, policy_status }
    - session_id, target: from 'context' if present (or top-level fallbacks)
    - ui_version: from 'extra' or top-level
    - extra: the raw nested 'extra' dict ({} if missing)
    """
    query: str
    user_name: Optional[str]
    user_email: Optional[str]
    filters: Dict[str, Any]
    session_id: Optional[str]
    target: Optional[str]
    ui_version: Optional[str]
    extra: Dict[str, Any]

def _upper3(code: Optional[str]) -> Optional[str]:
    if not code or not isinstance(code, str): return None
    c = code.strip().upper()
    return c if len(c) == 3 and c.isalpha() else None

def _iso(val: Optional[str]) -> Optional[str]:
    # Accept ISO "YYYY-MM-DD" (leave strict validation to caller if needed)
    if not val or not isinstance(val, str): return None
    s = val.strip()
    return s

def parse_hotel_payload(payload: Dict[str, Any]) -> Tuple[str, Optional[str], Optional[str]]:
    """
    BACKWARD-COMPATIBLE parser (original return shape).
    Supports both nested extra and flat keys, and 'query'/'qquery'.
    """
    query = str(payload.get("qquery", "") or payload.get("query", "")).strip()
    extra = payload.get("extra") if isinstance(payload.get("extra"), dict) else {}
    user_name = payload.get("user_name") or extra.get("user_name")
    user_email = payload.get("user_email") or extra.get("user_email")
    return query, user_name, user_email

def parse_hotel_payload_v2(payload: Dict[str, Any]) -> HotelInputs:
    """
    Rich parser (recommended):
    - reads filters incl. end_date
    - normalizes IATA codes
    - ensures end_date >= start_date if both present
    """
    extra   = payload.get("extra") if isinstance(payload.get("extra"), dict) else {}
    context = payload.get("context") if isinstance(payload.get("context"), dict) else {}

    query = str(payload.get("qquery", "") or payload.get("query", "")).strip()

    user_name  = payload.get("user_name") or extra.get("user_name")
    user_email = payload.get("user_email") or extra.get("user_email")

    # filters: prefer nested, fallback to top-level
    raw_filters = extra.get("filters") if isinstance(extra.get("filters"), dict) else (payload.get("filters") or {})
    ond = raw_filters.get("ond") if isinstance(raw_filters.get("ond"), dict) else {}

    origin       = _upper3(ond.get("origin"))
    destination  = _upper3(ond.get("destination"))
    start_date   = _iso(raw_filters.get("start_date"))
    end_date     = _iso(raw_filters.get("end_date"))
    policy       = raw_filters.get("policy_status")

    # Keep ISO strings; ensure order if both present
    if isinstance(start_date, str) and isinstance(end_date, str) and start_date > end_date:
        end_date = start_date

    filters_norm: Dict[str, Any] = {
        "ond": {"origin": origin, "destination": destination},
        "start_date": start_date,
        "end_date": end_date,                 # <-- now included
        "policy_status": policy,
    }

    ui_version = payload.get("ui_version") or extra.get("ui_version")
    session_id = context.get("session_id") or payload.get("session_id")
    target     = context.get("target") or payload.get("target")

    return HotelInputs(
        query=query,
        user_name=user_name,
        user_email=user_email,
        filters=filters_norm,
        session_id=session_id,
        target=target,
        ui_version=ui_version,
        extra=extra or {},
    )

def extract_filter_values(filters: Dict[str, Any]) -> Tuple[
    Optional[str], Optional[str], Optional[str], Optional[str], Optional[str]
]:
    """
    Returns (origin, destination, start_date, end_date, policy_status).
    Works whether filters came nested or flat.
    """
    ond = filters.get("ond") if isinstance(filters.get("ond"), dict) else {}
    origin = ond.get("origin")
    destination = ond.get("destination")
    start_date = filters.get("start_date")
    end_date   = filters.get("end_date")          # <-- include end_date
    policy     = filters.get("policy_status")
    return origin, destination, start_date, end_date, policy


