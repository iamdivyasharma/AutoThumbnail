
def answer_all_queries_for_file(
    session: Session,
    client_id: str,
    policy_id: str,
    retrieval_queries: List[str],
) -> Tuple[Dict[str, str], str, str]:
    """
    For a given client_id + policy_id (single file) and a list of retrieval_queries:
      1) Retrieve context separately for each retrieval query, restricted to this file.
      2) Union all retrieved chunks as a single context for the LLM.
      3) Make ONE Claude call that fills all fields + semicolon string.
      4) Return:
           - values_by_field: { field_name -> value string }
           - flat_string: 'v1;v2;...;vN'
           - sources_summary: newline-separated sources summary
    """
    print(f"[INFO] Building context for client='{client_id}', policy='{policy_id}'")
    vs = load_vs_for_client(client_id, session)
    retriever = vs.as_retriever(
        search_type="similarity",
        search_kwargs={"k": K_PER_CLIENT},
    )

    cid_norm = client_id.strip().lower()
    pol_norm = policy_id.strip().lower()

    all_docs = []

    # ====== RAG: each field name (or description) used as retrieval query ======
    for q in retrieval_queries:
        print(f"[DEBUG] Retrieval query for this file: {q}")
        docs = retriever.get_relevant_documents(q)
        print(f"[DEBUG] Retrieved {len(docs)} docs for client='{client_id}', policy='{policy_id}', query='{q}'")

        filtered = []
        for d in docs:
            m = d.metadata or {}
            meta_cid = str(m.get("client_id", "")).strip().lower()
            meta_cat = str(m.get("category", "")).strip().lower()
            meta_pol = str(m.get("policy_id", "")).strip().lower()
            print(
                f"[DEBUG] doc meta: client_id='{meta_cid}', "
                f"category='{meta_cat}', policy='{meta_pol}'"
            )

            if meta_cid == cid_norm and meta_cat == "finance" and meta_pol == pol_norm:
                filtered.append(d)

        if not filtered:
            print(
                f"[WARN] No docs passed metadata filter for client='{client_id}', "
                f"policy='{policy_id}', query='{q}'. Using all {len(docs)} retrieved docs."
            )
            filtered = docs

        all_docs.extend(filtered)

    # Deduplicate docs in context
    seen = set()
    unique_docs = []
    for d in all_docs:
        m = d.metadata or {}
        key = (
            m.get("policy_id"),
            m.get("page"),
            m.get("page_start"),
            m.get("page_end"),
            m.get("source_file"),
        )
        if key in seen:
            continue
        seen.add(key)
        unique_docs.append(d)

    if not unique_docs:
        print(f"[WARN] No usable context docs for client='{client_id}', policy='{policy_id}'.")
        values_by_field = {field: "" for field in FIELD_NAMES}
        flat_string = ";".join("" for _ in FIELD_NAMES)
        sources_summary = ""
        return values_by_field, flat_string, sources_summary

    context_text = format_docs_for_llm(unique_docs)

    num_fields = len(FIELD_NAMES)
    questions_block = "\n".join(f"- {name}" for name in FIELD_NAMES)
    json_schema_example = build_json_schema_example()

    llm = ChatBedrock(
        client=session.client("bedrock-runtime"),
        model_id=LLM_MODEL,
        model_kwargs={
            "temperature": float(TEMPERATURE),
            "max_tokens": int(MAX_TOKENS),
        },
    )

    chain = PROMPT_MULTI | llm | StrOutputParser()

    try:
        llm_output = chain.invoke({
            "client_id": client_id,
            "policy_id": policy_id,
            "questions_block": questions_block,
            "context": context_text,
            "num_fields": num_fields,
            "json_schema_example": json_schema_example,
        })
    except Exception as e:
        print(f"[WARN] LLM error for client='{client_id}', policy='{policy_id}': {type(e).__name__}: {e}")
        llm_output = ""

    # ====== DEBUG: save raw LLM output for this file ======
    debug_dir = OUTPUT_DIR / "llm_raw"
    debug_dir.mkdir(parents=True, exist_ok=True)
    debug_file = debug_dir / f"{sanitize_filename(client_id)}__{sanitize_filename(policy_id)}.txt"
    try:
        debug_file.write_text(llm_output or "", encoding="utf-8")
        print(f"[DEBUG] Saved raw LLM output to {debug_file}")
    except Exception as e:
        print(f"[WARN] Could not save raw LLM output: {e}")

    # ====== Robust JSON + flat string extraction ======
    llm_output = llm_output or ""
    # Strip any code fences like ```json ... ```
    llm_output_clean = llm_output.replace("```json", "```").replace("```JSON", "```")
    if "```" in llm_output_clean:
        parts = llm_output_clean.split("```")
        # Heuristic: JSON likely in the first fenced block
        for part in parts:
            part = part.strip()
            if part.startswith("{") and "}" in part:
                llm_output_clean = part + "\n" + llm_output_clean.split(part, 1)[-1]
                break

    # Get JSON substring between first '{' and last '}'
    start = llm_output_clean.find("{")
    end = llm_output_clean.rfind("}")
    if start != -1 and end != -1 and end > start:
        json_str = llm_output_clean[start:end+1].strip()
        remainder = llm_output_clean[end+1:].strip()
    else:
        print(f"[WARN] Could not find JSON braces in LLM output for client='{client_id}', policy='{policy_id}'")
        json_str = "{}"
        remainder = ""

    # Flat string: first non-empty line after JSON
    flat_string = ""
    if remainder:
        for ln in remainder.splitlines():
            ln = ln.strip()
            if ln:
                flat_string = ln
                break

    # ====== Parse JSON and log key mismatches ======
    try:
        parsed = json.loads(json_str)
    except Exception as e:
        print(f"[WARN] Failed to parse JSON for client='{client_id}', policy='{policy_id}': {e}")
        print(f"[DEBUG] JSON candidate was:\n{json_str}")
        parsed = {}

    if isinstance(parsed, dict):
        expected = set(FIELD_NAMES)
        actual = set(parsed.keys())
        missing = expected - actual
        extra   = actual - expected
        if missing:
            print(f"[WARN] Missing keys in LLM JSON for {client_id}/{policy_id}: {missing}")
        if extra:
            print(f"[WARN] Unexpected keys in LLM JSON for {client_id}/{policy_id}: {extra}")
    else:
        print(f"[WARN] Parsed JSON is not an object for {client_id}/{policy_id}, type={type(parsed)}")
        parsed = {}

    # Whatever types came back, stringify for Excel
    values_by_field = {
        field: str(parsed.get(field, "") or "") for field in FIELD_NAMES
    }

    # If flat_string missing or obviously wrong length, reconstruct
    if not flat_string or flat_string.count(";") + 1 != len(FIELD_NAMES):
        flat_values = [values_by_field.get(field, "") for field in FIELD_NAMES]
        flat_string = ";".join(flat_values)

    sources_summary = build_sources_summary(unique_docs, client_id=client_id, max_lines=MAX_SOURCE_LINES)

    return values_by_field, flat_string, sources_summary
