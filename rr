import shlex

def normalize_servers(cfg: dict) -> dict:
    """
    Accepts:
      - {"name": {"transport": {"type":"stdio","command":[...]}}}
      - {"name": {"transport": {"type":"stdio","command":"python -m foo"}}}
      - {"name": {"transport": "stdio", "command": "..."}}
      - {"name": "python -m foo"}  # shortcut -> stdio
    Produces:
      {"name": {"transport": {"type":"stdio","command":[...]}}, ...}
    """
    out = {}
    for name, val in cfg.items():
        # Shortcut: plain string -> stdio command
        if isinstance(val, str):
            out[name] = {"transport": {"type": "stdio", "command": shlex.split(val)}}
            continue

        if not isinstance(val, dict):
            raise ValueError(f"Server '{name}' must be dict or str, got {type(val).__name__}")

        tinfo = val.get("transport")
        # allow "transport": "stdio"
        if isinstance(tinfo, str):
            tinfo = {"type": tinfo}
        elif not isinstance(tinfo, dict):
            raise ValueError(f"Server '{name}' missing/invalid 'transport'")

        ttype = tinfo.get("type")
        if ttype not in ("stdio", "sse", "websocket", "streamable_http"):
            raise ValueError(f"Server '{name}' invalid transport type: {ttype!r}")

        if ttype == "stdio":
            cmd = tinfo.get("command", val.get("command"))
            if isinstance(cmd, str):
                cmd = shlex.split(cmd)
            elif isinstance(cmd, tuple):
                cmd = list(cmd)
            if not isinstance(cmd, list) or not cmd:
                raise ValueError(f"Server '{name}' stdio requires 'command' as list[str] or str; got {cmd!r}")
            tinfo["command"] = cmd
        else:
            url = tinfo.get("url", val.get("url"))
            if not isinstance(url, str) or not url:
                raise ValueError(f"Server '{name}' transport '{ttype}' requires 'url'")
            tinfo["url"] = url

        out[name] = {"transport": tinfo}
    return out



from mcp.client.session import ClientSession
from mcp.client.stdio import stdio_client

async def _open_stdio_session(cmd_list: list[str]):
    # Try older single-string signature, then newer multi-arg
    cmd_str = " ".join(shlex.quote(p) for p in cmd_list)
    try:
        return stdio_client(cmd_str)      # older SDK
    except TypeError:
        return stdio_client(*cmd_list)    # newer SDK
from contextlib import asynccontextmanager

class HybridMCP:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        # Only build HTTP client for non-stdio servers
        http_cfg = {k: v for k, v in cfg.items() if v.get("transport", {}).get("type") != "stdio"}
        self.http_client = MultiServerMCPClient(http_cfg) if http_cfg else None

    @asynccontextmanager
    async def session(self, server: str):
        import os
        tentry = self.cfg.get(server)
        if not isinstance(tentry, dict):
            raise ValueError(f"[HybridMCP] cfg[{server!r}] must be dict; got {type(tentry).__name__}: {tentry!r}")

        tinfo = tentry.get("transport")
        if isinstance(tinfo, str):
            tinfo = {"type": tinfo}
        if not isinstance(tinfo, dict):
            raise ValueError(f"[HybridMCP] cfg[{server!r}]['transport'] invalid: {tinfo!r}")

        ttype = tinfo.get("type")
        if ttype == "stdio":
            cmd = tinfo.get("command")
            # cmd is already normalized by normalize_servers, but be safe
            if isinstance(cmd, str):
                cmd = shlex.split(cmd)
            elif isinstance(cmd, tuple):
                cmd = list(cmd)
            if not isinstance(cmd, list) or not cmd:
                raise ValueError(f"[HybridMCP] cfg[{server!r}] stdio 'command' must be list[str]; got: {cmd!r}")

