from __future__ import annotations

import json
import os
from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd
from rapidfuzz import process, fuzz


def _norm_text(s: str) -> str:
    return str(s or "").strip().lower()


class MetadataService:
    """
    Metadata Lookup Service:
    - Loads Client Master CSV (huge file)
    - Uses schema JSON for allowed fields
    - Fuzzy matches client names
    - Returns available FAISS scopes
    - Reads manifest.json for doc-level metadataAttributes
    """

    def __init__(
        self,
        client_master_csv_path: str,
        schema_json_path: str,
        faiss_index_dir: str,
        client_name_col: str,
        country_col: str,
        cid_col: str,
    ):
        self.client_master_csv_path = Path(client_master_csv_path).resolve()
        self.schema_json_path = Path(schema_json_path).resolve()
        self.faiss_index_dir = Path(faiss_index_dir).resolve()

        self.client_name_col = client_name_col
        self.country_col = country_col
        self.cid_col = cid_col

        self.df: Optional[pd.DataFrame] = None
        self.schema_fields: List[str] = []
        self.client_name_list: List[str] = []

        self.available_scopes: List[str] = []  # finance/abb/us etc

    # --------------------------
    # Loaders
    # --------------------------

    def ensure_loaded(self) -> None:
        if self.df is not None:
            return

        if not self.client_master_csv_path.exists():
            raise FileNotFoundError(f"Client master CSV not found: {self.client_master_csv_path}")

        # ✅ Load schema json (optional)
        if self.schema_json_path.exists():
            try:
                self.schema_fields = json.loads(self.schema_json_path.read_text(encoding="utf-8"))
            except Exception:
                self.schema_fields = []

        # ✅ Read CSV deterministically
        df = pd.read_csv(
            self.client_master_csv_path,
            dtype=str,
            keep_default_na=False,
            low_memory=False,
            encoding="utf-8",
        )

        # Normalize column names
        df.columns = [str(c).strip() for c in df.columns]

        # Validate required columns
        for col in [self.client_name_col, self.country_col, self.cid_col]:
            if col not in df.columns:
                raise ValueError(f"Missing required column '{col}' in CSV")

        # Add normalized helper columns (fast filters)
        df["_client_norm"] = df[self.client_name_col].apply(_norm_text)
        df["_country_norm"] = df[self.country_col].apply(_norm_text)
        df["_cid_norm"] = df[self.cid_col].apply(_norm_text)

        self.df = df
        self.client_name_list = sorted(list(set(df["_client_norm"].tolist())))

        # scan faiss scopes once
        self.available_scopes = self._scan_faiss_scopes()

    def get_available_fields(self) -> List[str]:
        self.ensure_loaded()
        if self.schema_fields:
            return self.schema_fields
        assert self.df is not None
        return [c for c in self.df.columns if not c.startswith("_")]

    # --------------------------
    # FAISS scopes / manifests
    # --------------------------

    def _scan_faiss_scopes(self) -> List[str]:
        scopes: List[str] = []
        if not self.faiss_index_dir.exists():
            return scopes

        for dirpath, _, filenames in os.walk(self.faiss_index_dir):
            dirpath = Path(dirpath)
            if "manifest.json" in filenames:
                rel = dirpath.relative_to(self.faiss_index_dir).as_posix()
                scopes.append(rel.lower())

        return sorted(scopes)

    def _manifest_for_scope(self, scope: str) -> Optional[Dict[str, Any]]:
        """
        scope example: finance/abb/us
        """
        manifest_path = self.faiss_index_dir / scope / "manifest.json"
        if not manifest_path.exists():
            return None
        try:
            return json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception:
            return None

    # --------------------------
    # Fuzzy matching
    # --------------------------

    def fuzzy_find_client(
        self,
        query_client_name: str,
        country: Optional[str] = None,
        limit: int = 5,
        score_cutoff: int = 75,
    ) -> List[Dict[str, Any]]:
        self.ensure_loaded()
        assert self.df is not None

        q = _norm_text(query_client_name)
        if not q:
            return []

        # optional country filter
        candidates = self.client_name_list
        if country:
            ctry = _norm_text(country)
            filtered = self.df[self.df["_country_norm"] == ctry]["_client_norm"].unique().tolist()
            candidates = sorted(filtered) if filtered else candidates

        matches = process.extract(
            q,
            candidates,
            scorer=fuzz.WRatio,
            limit=limit,
        )

        out = []
        for name, score, _ in matches:
            if score < score_cutoff:
                continue
            out.append({"client_norm": name, "score": int(score)})
        return out

    # --------------------------
    # Main lookup
    # --------------------------

    def lookup(
        self,
        query: str,
        country: Optional[str] = None,
        limit: int = 10,
        score_cutoff: int = 75,
        include_scopes: bool = True,
        include_manifest_docs: bool = True,
    ) -> Dict[str, Any]:
        """
        Input: Natural language query (e.g. 'capid for google us' or 'ABB Denmark client id')
        Output: best matching client rows + scopes + manifest docs
        """
        self.ensure_loaded()
        assert self.df is not None

        q = _norm_text(query)

        # Step 1: fuzzy resolve client name
        fuzzy = self.fuzzy_find_client(
            query_client_name=q,
            country=country,
            limit=5,
            score_cutoff=score_cutoff,
        )

        if not fuzzy:
            return {"matches": [], "message": "No client match found"}

        best_client = fuzzy[0]["client_norm"]

        # Step 2: filter rows
        rows = self.df[self.df["_client_norm"] == best_client]
        if country:
            rows = rows[rows["_country_norm"] == _norm_text(country)]

        rows = rows.head(limit)

        result_rows = []
        for _, r in rows.iterrows():
            result_rows.append({
                "cid": r.get(self.cid_col),
                "client_name": r.get(self.client_name_col),
                "country": r.get(self.country_col),
            })

        out: Dict[str, Any] = {
            "resolved_client_norm": best_client,
            "fuzzy_candidates": fuzzy,
            "rows": result_rows,
        }

        # Step 3: return scopes (finance/client/country OR ultimateparent)
        if include_scopes:
            scopes = [s for s in self.available_scopes if best_client in s]
            out["scopes"] = scopes[:30]

        # Step 4: include manifest docs metadata if requested
        if include_manifest_docs and include_scopes:
            docs_out = []
            for scope in out.get("scopes", [])[:5]:
                manifest = self._manifest_for_scope(scope)
                if not manifest:
                    continue
                for d in manifest.get("docs", [])[:10]:
                    docs_out.append({
                        "scope": scope,
                        "policy_id": d.get("policy_id"),
                        "source_file": d.get("source_file"),
                        "metadataAttributes": (d.get("metadata") or {}),
                    })
            out["manifest_docs_preview"] = docs_out

        return out
