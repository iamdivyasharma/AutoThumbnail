from langchain_community.document_loaders import AmazonTextractPDFLoader

def _yield_textract_chunks_with_loader(
    pdf_path: Path,
    category: str,
    client_id: str,
    policy_id: str,
) -> Iterable[Document]:
    """Use AmazonTextractPDFLoader on S3 object and yield chunked Documents."""
    s3_key = local_path_to_s3_key(pdf_path)
    if not s3_key:
        print(f"[WARN] Could not map {pdf_path} to S3 key; skipping Textract loader.")
        return

    s3_uri = f"s3://{S3_DOC_BUCKET}/{s3_key}"
    print(f"[TEXTRACT] Using AmazonTextractPDFLoader for {s3_uri}")

    try:
        loader = AmazonTextractPDFLoader(
            file_path=s3_uri,        # IMPORTANT: single file_path, no bucket/key kwargs
            client=TEXTRACT_CLIENT,  # your existing boto3 textract client (optional)
            # textract_features=["TABLES", "FORMS", "LAYOUT"],  # optional
        )
        tex_docs = loader.load()    # List[Document]
    except Exception as e:
        print(f"[WARN] AmazonTextractPDFLoader failed for {pdf_path}: {e}")
        return

    if not tex_docs:
        print(f"[WARN] AmazonTextractPDFLoader returned no docs for {pdf_path}")
        return

    concatenated = ""
    page_ranges: List[Tuple[int, int, int]] = []  # (start_char, end_char, page_num)
    cursor = 0

    for d in tex_docs:
        txt = clean_text(d.page_content or "")
        if not txt:
            continue

        page_num = 1
        if isinstance(d.metadata, dict) and "page" in d.metadata:
            try:
                page_num = int(d.metadata["page"])
            except Exception:
                pass

        start = cursor
        concatenated += txt + "\n"
        cursor = len(concatenated)
        page_ranges.append((start, cursor, page_num))

    if not concatenated.strip():
        print(f("[WARN] Empty text after Textract loader for {pdf_path}"))
        return

    # Chunk across pages, preserving your page_start / page_end metadata
    for c_start, c_end, chunk in chunk_text(concatenated):
        pages = sorted({
            page_num
            for p_start, p_end, page_num in page_ranges
            if not (p_end <= c_start or p_start >= c_end)
        })
        if not pages:
            continue

        meta = {
            "category": category,
            "client_id": client_id,
            "policy_id": policy_id,
            "page_start": pages[0],
            "page_end": pages[-1],
            "source_file": str(pdf_path.resolve()),
            "extracted_by": "amazon_textract_loader",
        }
        yield Document(page_content=chunk, metadata=meta)


def make_chunks_for_pdf(pdf_path: Path, category: str, client_id: str) -> Iterable[Document]:
    policy_id = pdf_path.name
    scanned = is_scanned_pdf(pdf_path)

    # ===== CASE 1: detected as scanned → go straight to Textract loader =====
    if scanned:
        yield from _yield_textract_chunks_with_loader(pdf_path, category, client_id, policy_id)
        return

    # ===== CASE 2: non-scanned → try PyMuPDF, but fall back to Textract on error =====
    try:
        with fitz.open(str(pdf_path)) as doc:
            page_count = doc.page_count
            for pnum in range(page_count):
                try:
                    page = doc.load_page(pnum)
                    text = clean_text(page.get_text("text") or "")
                except Exception as e:
                    # This is where "mupdf: object out of range" will usually hit
                    print(
                        f"[WARN] PyMuPDF failed on page {pnum+1}/{page_count} of {pdf_path}: {e}. "
                        f"Falling back to Textract loader for entire file."
                    )
                    # Fallback: use Textract for the whole PDF
                    yield from _yield_textract_chunks_with_loader(pdf_path, category, client_id, policy_id)
                    return

                if not text.strip():
                    continue

                for _, _, chunk in chunk_text(text):
                    meta = {
                        "category": category,
                        "client_id": client_id,
                        "policy_id": policy_id,
                        "page": pnum + 1,
                        "source_file": str(pdf_path.resolve()),
                        "extracted_by": "pymupdf",
                    }
                    yield Document(page_content=chunk, metadata=meta)
    except Exception as e:
        print(
            f"[WARN] PyMuPDF could not open/process {pdf_path} at all: {e}. "
            f"Falling back to Textract loader."
        )
        yield from _yield_textract_chunks_with_loader(pdf_path, category, client_id, policy_id)
