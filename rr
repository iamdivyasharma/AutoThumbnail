import pandas as pd
from datetime import datetime
from threading import RLock

EXCEL_FILE = Path(os.getenv("LOCAL_EXCEL_PATH", "data/workbook.xlsx")).resolve()
EXCEL_INDEX_DIR = Path(os.getenv("LOCAL_EXCEL_INDEX_DIR", "excel_faiss")).resolve()
EXCEL_INDEX_DIR.mkdir(parents=True, exist_ok=True)

EXCEL_HISTORY_DIR = Path(os.getenv("LOCAL_EXCEL_HISTORY_DIR", "excel_history")).resolve()
EXCEL_HISTORY_DIR.mkdir(parents=True, exist_ok=True)

_HISTORY_LOCK = RLock()

_EXCEL = {
    "df_by_sheet": {},     # {sheet_name: DataFrame}
    "meta": {},            # {"sheets": [...], "rows": {...}, "mtime": "...", "path": "..."}
    "vs": None,            # FAISS vectorstore for Excel chunks
    "chunk_meta": [],      # [{sheet, start_row, end_row}]
    "last_loaded_at": None,
}
_EXCEL_HISTORY: Dict[str, List[Dict[str, Any]]] = {}   # session_id -> [{"role": "...", "text": "...", "time": iso}]

# ---------- tiny disk persistence for history ----------
def _hist_path(session_id: str) -> Path:
    return EXCEL_HISTORY_DIR / f"{session_id}.jsonl"

def _load_history(session_id: str) -> List[Dict[str, Any]]:
    with _HISTORY_LOCK:
        if session_id in _EXCEL_HISTORY:
            return _EXCEL_HISTORY[session_id]
        p = _hist_path(session_id)
        if not p.exists():
            _EXCEL_HISTORY[session_id] = []
            return []
