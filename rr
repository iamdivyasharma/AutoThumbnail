#!/usr/bin/env python3
"""
rag_export_clauses_raw.py  (FINANCE-only, COLA-focused, NO LLM)

Export *raw* RAG chunks per FINANCE client & clause into an Excel file (.xlsx)
using FAISS, WITHOUT calling an LLM.

- Uses FINANCE indexes only: FAISS_INDEX_DIR / "finance"
- Clauses are COLA-related and hardcoded below in CLAUSES.
- Scans FINANCE_INDEX_ROOT recursively for all client indexes.
- Each index directory that contains index.faiss + index.pkl is treated as a client.
  Example client_ids (relative paths under finance/):
    - "clienta/us"
    - "clienta/denmark"
    - "clientb/corporatefamily"

- Writes Excel with columns:
    Client | Clause | ExtractedContent | Sources

Where:
  ExtractedContent = concatenation of relevant page chunks for that clause
  Sources         = newline-separated list of "policy ; pages ; source_file"

Deps:
  pip install -U pandas "langchain-aws>=0.2.5" "langchain-community" "boto3>=1.34"
"""

from __future__ import annotations

import os
from pathlib import Path
from typing import List, Dict, Any, Tuple

import pandas as pd
from boto3 import Session
from langchain_aws import BedrockEmbeddings
from langchain_community.vectorstores import FAISS

# ===================== EDIT THESE =====================
FAISS_INDEX_DIR = Path("/ABS/PATH/TO/faiss_indices").resolve()    # root used by indexer
FINANCE_INDEX_ROOT = FAISS_INDEX_DIR / "finance"                  # finance-only indexes

OUTPUT_XLSX     = Path("./finance_cola_clauses_raw.xlsx").resolve()   # output file

# Optional: run for a SINGLE client id (relative under finance/), e.g. "clientA/us"
# Leave as "" or None to run for all finance clients.
TARGET_CLIENT_ID = "clientA/us"   # e.g. "ABB - SWITZZERLNA/us" or "" for all

# AWS (for embeddings; FAISS uses Bedrock embeddings)
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID     = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

# Models
EMBED_MODEL = "amazon.titan-embed-text-v2:0"

# Retrieval
K_PER_CLIENT = 8   # how many chunks to pull per clause

# ===================== COLA CLAUSES =====================
# Hardcoded COLA-related clauses (your new predefined set)
CLAUSES = [
    "Is there a COLA clause?",
    "How does the COLA rule apply?",
    "What is the COLA source data to be used?",
    # you can add more COLA-related questions here
]

# ===================== Helpers =====================
def list_finance_clients(root: Path) -> List[str]:
    """
    Recursively scan FINANCE_INDEX_ROOT for all client index directories.

    A directory is considered a client index if it contains:
      - index.faiss
      - index.pkl

    Returns client_ids as relative paths under finance/, e.g.:
      "clienta/us"
      "clientb/denmark"
      "clientc/corporatefamily"
    """
    if not root.exists():
        return []

    clients: List[str] = []

    for dirpath, dirnames, filenames in os.walk(root):
        filenames_set = set(filenames)
        if "index.faiss" in filenames_set and "index.pkl" in filenames_set:
            p = Path(dirpath)
            rel = p.relative_to(root)           # relative to finance root
            client_id = rel.as_posix()          # e.g. "clienta/us"
            clients.append(client_id)

    clients = sorted(set(clients))
    return clients


def load_vs_for_client(client_id: str, session: Session) -> FAISS:
    """
    Load FAISS for a given finance client_id (relative under FINANCE_INDEX_ROOT).

    Example:
      client_id = "clienta/us"
      path      = FINANCE_INDEX_ROOT / "clienta/us"
    """
    emb = BedrockEmbeddings(
        model_id=EMBED_MODEL,
        client=session.client("bedrock-runtime"),
    )
    index_dir = FINANCE_INDEX_ROOT / client_id
    return FAISS.load_local(str(index_dir), emb, allow_dangerous_deserialization=True)


def build_sources_summary(docs) -> str:
    """
    Build a human-readable summary of all sources used for this clause:

    One line per source:
      policy: <policy_id> ; pages: X or X-Y ; source: <source_file path>
    """
    seen = set()
    lines = []

    for d in docs:
        m = d.metadata or {}
        policy_id = m.get("policy_id") or Path(m.get("source_file", "")).name or "UNKNOWN_POLICY"
        source_file = m.get("source_file", "")

        page = m.get("page")
        page_start = m.get("page_start")
        page_end = m.get("page_end")

        # derive page string
        if page is not None:
            page_str = str(page)
        elif page_start is not None and page_end is not None:
            page_str = f"{page_start}-{page_end}" if page_start != page_end else str(page_start)
        elif page_start is not None:
            page_str = str(page_start)
        else:
            page_str = "?"

        key = (policy_id, page_str, source_file)
        if key in seen:
            continue
        seen.add(key)

        line = f"policy: {policy_id} ; pages: {page_str} ; source: {source_file}"
        lines.append(line)

    return "\n".join(lines)


def build_extracted_content(docs) -> str:
    """
    Concatenate the raw page_content from all relevant docs into one big
    string, with simple headers per source for readability.

    Example:
      === policy: FILE.pdf | page: 10 ===
      <chunk text>

      === policy: OTHER.pdf | pages: 3-4 ===
      <chunk text>
    """
    parts = []

    for d in docs:
        m = d.metadata or {}
        policy_id = m.get("policy_id") or Path(m.get("source_file", "")).name or "UNKNOWN_POLICY"
        page = m.get("page")
        page_start = m.get("page_start")
        page_end = m.get("page_end")

        if page is not None:
            page_str = str(page)
        elif page_start is not None and page_end is not None:
            page_str = f"{page_start}-{page_end}" if page_start != page_end else str(page_start)
        elif page_start is not None:
            page_str = str(page_start)
        else:
            page_str = "?"

        header = f"=== policy: {policy_id} | page(s): {page_str} ==="
        body = d.page_content or ""
        parts.append(f"{header}\n{body}")

    return "\n\n".join(parts)


def extract_for_clause(session: Session, client_id: str, clause: str) -> Tuple[str, str]:
    """
    For a given finance client_id (e.g. 'clienta/us') and a COLA clause question,
    retrieve relevant chunks and return:
      - ExtractedContent: concatenated raw texts from those chunks
      - Sources: newline-separated file+page+source info
    """
    vs = load_vs_for_client(client_id, session)
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": K_PER_CLIENT})

    query = (
        f"For client '{client_id}', extract all contract/policy content relevant to the COLA topic: '{clause}'. "
        f"Include any sections that discuss existence of COLA, how COLA applies, or COLA source data."
    )
    docs = retriever.get_relevant_documents(query)

    # Hard filter: keep only finance docs that match this client_id in metadata
    cid_norm = client_id.strip().lower()
    filtered_docs = []
    for d in docs:
        m = d.metadata or {}
        meta_cid = str(m.get("client_id", "")).strip().lower()
        meta_cat = str(m.get("category", "")).strip().lower()
        if meta_cid == cid_norm and meta_cat == "finance":
            filtered_docs.append(d)

    if not filtered_docs:
        msg = f"(No matching context found in finance index for client '{client_id}' and clause '{clause}'.)"
        return msg, ""

    extracted_content = build_extracted_content(filtered_docs)
    sources_summary   = build_sources_summary(filtered_docs)
    return extracted_content, sources_summary

# ===================== Main =====================
def main():
    # Discover ONLY finance clients automatically
    all_clients = list_finance_clients(FINANCE_INDEX_ROOT)
    if not all_clients:
        raise SystemExit(f"No finance clients found under {FINANCE_INDEX_ROOT}")

    print("All finance client index(es) found:")
    for c in all_clients:
        print(f"  - {c}")

    # Optional: restrict to a single client id
    if TARGET_CLIENT_ID:
        clients = [c for c in all_clients if c == TARGET_CLIENT_ID]
        if not clients:
            raise SystemExit(
                f"\nTARGET_CLIENT_ID='{TARGET_CLIENT_ID}' not found.\n"
                f"Make sure there is a folder: {FINANCE_INDEX_ROOT / TARGET_CLIENT_ID} "
                f"with index.faiss and index.pkl."
            )
        print(f"\nRunning ONLY for client: {TARGET_CLIENT_ID}")
    else:
        clients = all_clients
        print("\nRunning for ALL finance clients.")

    # AWS session (for embeddings, not LLM)
    session = Session(
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        region_name=AWS_REGION,
    )

    rows: List[Dict[str, Any]] = []
    for client_id in clients:
        print(f"\n=== Client: {client_id} ===")
        for clause in CLAUSES:
            print(f"  - Clause: {clause} ...", end="", flush=True)
            extracted_content, sources = extract_for_clause(session, client_id, clause)
            rows.append({
                "Client": client_id,
                "Clause": clause,
                "ExtractedContent": extracted_content,
                "Sources": sources,
            })
            print(" done.")

    df = pd.DataFrame(rows, columns=["Client", "Clause", "ExtractedContent", "Sources"])
    OUTPUT_XLSX.parent.mkdir(parents=True, exist_ok=True)
    df.to_excel(OUTPUT_XLSX, index=False)
    print(f"\nSaved: {OUTPUT_XLSX}")

if __name__ == "__main__":
    main()
