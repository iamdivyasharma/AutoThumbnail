# -------------------- Helpers --------------------
def _is_s3_uri(path_or_none: Optional[str]) -> bool:
    return bool(path_or_none) and str(path_or_none).lower().startswith("s3://")

def _parse_s3_uri(uri: str) -> tuple[str, str]:
    # s3://bucket/key...
    _, rest = uri.split("://", 1)
    bucket, key = rest.split("/", 1)
    return bucket, key

def _resolve_src_for_label(path_or_none: str) -> Optional[str]:
    """
    For display only. Do NOT convert s3:// to local paths.
    (We no longer show S3 paths in the UI; kept for optional debugging.)
    """
    if not path_or_none:
        return None
    if _is_s3_uri(path_or_none):
        return Path(path_or_none).name  # only show filename, not full URI
    p = Path(path_or_none)
    return str(p if p.is_absolute() else (Path.cwd() / p))

def _fmt_ist(ts: int | None) -> Optional[str]:
    if not ts: return None
    try: return datetime.fromtimestamp(int(ts), IST).strftime("%Y-%m-%d %H:%M")
    except Exception: return None

def _fetch_all_docs_for_client(client_id: str):
    """
    Pulls the client's manifest-derived doc list from the backend.
    """
    try:
        resp = requests.get(f"{API_URL}/clients/{client_id}/documents", timeout=20)
        resp.raise_for_status()
        return resp.json()
    except Exception as e:
        st.warning(f"Could not fetch docs for {client_id}: {e}")
        return []

def _first_matching_column(df_cols: List[str], candidates: List[str]) -> Optional[str]:
    normalized = {c.strip().lower(): c for c in df_cols}
    for alias in candidates:
        key = alias.strip().lower()
        if key in normalized:
            return normalized[key]
    for c in df_cols:
        for alias in candidates:
            if alias.strip().lower() in c.strip().lower():
                return c
    return None

@st.cache_data(show_spinner=False)
def load_excel(path: str) -> Tuple[pd.DataFrame, str, str, str]:
    df = pd.read_excel(path)
    df.columns = [str(c).strip() for c in df.columns]
    client_col = _first_matching_column(df.columns.tolist(), COLUMN_ALIASES["client"])
    cat_col    = _first_matching_column(df.columns.tolist(), COLUMN_ALIASES["category"])
    cont_col   = _first_matching_column(df.columns.tolist(), COLUMN_ALIASES["content"])

    if not client_col or not cat_col or not cont_col:
        missing = []
        if not client_col: missing.append("Client Name")
        if not cat_col:    missing.append("Category/categrpy")
        if not cont_col:   missing.append("Client Content")
        raise ValueError(
            "Missing expected column(s) in Excel. "
            f"Required (or aliases): {missing}. "
            f"Found columns: {list(df.columns)}"
        )

    for col in [client_col, cat_col]:
        df[col] = df[col].astype(str).str.strip()
    return df, client_col, cat_col, cont_col

# ---- Local-PDF index & mapping (viewer only) -----------------------
@st.cache_data(show_spinner=False)
def _index_local_pdfs(pdf_dir: str) -> dict:
    """
    Build a mapping from lowercase basename -> absolute path for all PDFs in pdf_dir.
    Example: 'clienta__policy1.pdf' -> '/abs/path/pdfs/clienta__policy1.pdf'
    """
    base = Path(pdf_dir)
    mapping = {}
    if base.exists():
        for p in base.rglob("*.pdf"):
            mapping[p.name.lower()] = str(p.resolve())
    return mapping

def _map_to_local_if_available(src: Optional[str]) -> tuple[Optional[str], Optional[str]]:
    """
    If src is an S3 URI and a local file with the same basename exists in PDF_LOCAL_DIR,
    return (local_path, original_s3). Otherwise return (src, None).
    NOTE: We no longer display the original S3 path in the UI; the second tuple value is ignored.
    """
    if not src:
        return None, None
    local_index = _index_local_pdfs(PDF_LOCAL_DIR)
    if _is_s3_uri(src):
        try:
            _, key = _parse_s3_uri(src)
            fname = Path(key).name.lower()
            local_path = local_index.get(fname)
            if local_path:
                return local_path, src  # use local for viewer
        except Exception:
            pass
    return src, None

# ---- Fingerprinted cache (no manual clears needed) ------------------
def _fingerprint_local(path: str) -> str:
    p = Path(path)
    st_ = p.stat()
    return f"{int(st_.st_mtime)}:{st_.st_size}"

def _fingerprint_s3(bucket: str, key: str) -> str:
    head = S3_CLIENT.head_object(Bucket=bucket, Key=key)
    etag = head.get("ETag", "").strip('"')
    lm   = head.get("LastModified")
    lm_ts = int(lm.timestamp()) if lm else 0
    size = head.get("ContentLength", 0)
    return f"{etag}:{lm_ts}:{size}"

@st.cache_data(show_spinner=False, ttl=1800, max_entries=512)  # 30 min TTL, up to 512 docs
def _cached_fetch_pdf(src: str, fingerprint: str) -> bytes:
    """
    Cache key is (src, fingerprint). If the file changes, the fingerprint changes
    and Streamlit builds a fresh cache entry automatically.
    """
    if _is_s3_uri(src):
        bucket, key = _parse_s3_uri(src)
        obj = S3_CLIENT.get_object(Bucket=bucket, Key=key)
        return obj["Body"].read()
    else:
        return Path(src).read_bytes()

# ---- Open helper: set state only (no cache clears) ------------------
def _open_in_viewer(src: str, label: str | None, page: int | None, anns: list | None):
    st.session_state.selected_label = label
    st.session_state.selected_pdf_src = src
    st.session_state.selected_scroll_page = page
    st.session_state.selected_annotations = anns or []
    st.rerun()

