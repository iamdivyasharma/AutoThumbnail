    st.markdown("---")
    st.subheader("Mode")
    st.session_state.mode = st.radio(
        "How should the next message be handled?",
        ["Agentic AI", "Direct tool"],
        captions=["Let the orchestrator plan and call tools", "Call a specific backend directly"]
    )
    if st.session_state.mode == "Direct tool":
        st.session_state.target = st.segmented_control(
            "Target", options=["air", "hotel", "tdna"], default="air"
        )

    st.markdown("---")
    st.subheader("Agent Settings")
    st.session_state.autonomy = st.checkbox("Enable Autonomy (agent loop)", value=st.session_state.autonomy)
    st.session_state.max_iters = st.slider("Max Iterations", 1, 8, st.session_state.max_iters)

# ================== Filters (show in ALL except TDNA) ==================
show_filters = not (st.session_state.mode == "Direct tool" and st.session_state.target == "tdna")

if show_filters:
    with st.container():
        st.markdown("### 🔎 Filters")
        # Row 1: OND + dates + policy
        f1, f2, f3, f4, f5 = st.columns([1,1,1,1,1])

        with f1:
            origin_code = st.selectbox(
                "Origin",
                options=ORIGIN_OPTIONS,
                index=(ORIGIN_OPTIONS.index(st.session_state.filters["ond"]["origin"])
                       if st.session_state.filters["ond"]["origin"] in ORIGIN_OPTIONS else 0),
                format_func=label_for,
            )
        with f2:
            dest_code = st.selectbox(
                "Destination",
                options=DESTINATION_OPTIONS,
                index=(DESTINATION_OPTIONS.index(st.session_state.filters["ond"]["destination"])
                       if st.session_state.filters["ond"]["destination"] in DESTINATION_OPTIONS else 0),
                format_func=label_for,
            )
        with f3:
            min_start = START_WHITELIST[0]
            max_start = START_WHITELIST[-1]
            start_default = (
                date.fromisoformat(st.session_state.filters["start_date"])
                if st.session_state.filters["start_date"] else START_WHITELIST[0]
            )
            start_default = _snap_to_allowed(start_default, START_WHITELIST, direction="nearest")
            start_date_input = st.date_input(
                "Start date",
                value=start_default,
                min_value=min_start,
                max_value=max_start,
                format="YYYY-MM-DD",
            )
        with f4:
            min_end = END_WHITELIST[0]
            max_end = END_WHITELIST[-1]
            end_default = (
                date.fromisoformat(st.session_state.filters["end_date"])
                if st.session_state.filters["end_date"] else END_WHITELIST[-1]
            )
            # Snap end upward; we'll also enforce >= start at apply time
            end_default = _snap_to_allowed(end_default, END_WHITELIST, direction="up")
            end_date_input = st.date_input(
                "End date",
                value=end_default,
                min_value=min_end,
                max_value=max_end,
                format="YYYY-MM-DD",
            )
        with f5:
            current_policy = st.session_state.filters["policy_status"]
            if current_policy not in POLICY_OPTIONS:
                current_policy = POLICY_OPTIONS[0]
            policy_input = st.selectbox(
                "Policy status",
                options=POLICY_OPTIONS,
                index=POLICY_OPTIONS.index(current_policy),
            )

        st.caption(
            "Allowed start dates: " + ", ".join(d.isoformat() for d in START_WHITELIST) + "  \n"
            "Allowed end dates: " + ", ".join(d.isoformat() for d in END_WHITELIST)
        )

        # Row 2: buttons
        b1, b2 = st.columns(2)
        with b1:
            apply = st.button("Apply", use_container_width=True)
        with b2:
            clear = st.button("Clear", use_container_width=True)

        if apply:
            if origin_code == dest_code:
                st.warning("Origin and Destination cannot be the same.")

            chosen_start = start_date_input if isinstance(start_date_input, date) else START_WHITELIST[0]
            snapped_start = _snap_to_allowed(chosen_start, START_WHITELIST, direction="nearest")

            # End must be >= snapped_start; snap upward with min_after
            chosen_end = end_date_input if isinstance(end_date_input, date) else END_WHITELIST[-1]
            snapped_end = _snap_to_allowed(chosen_end, END_WHITELIST, direction="up", min_after=snapped_start)

            # Save filters
            st.session_state.filters = {
                "ond": {"origin": origin_code, "destination": dest_code},
                "start_date": snapped_start.isoformat(),
                "end_date": snapped_end.isoformat(),
                "policy_status": policy_input,
            }
            st.success("Filters applied.")
            if snapped_start != chosen_start:
                st.info(f"Start date adjusted to allowed date: {snapped_start.isoformat()}")
            if snapped_end != chosen_end or snapped_end < snapped_start:
                st.info(f"End date adjusted to allowed date: {snapped_end.isoformat()}")

            # ---- Build per-mode query (not shown in chat) ----
            if st.session_state.mode == "Agentic AI":
                qtext = build_query_combined(st.session_state.filters)
                url = ROUTE_URL
                payload = {
                    "query": qtext,
                    "session_id": st.session_state.session_id,
                    "targets": ["air", "hotel", "tdna"],   # combined fan-out
                    "extra": {
                        "user_name": st.session_state.user_name.strip(),
                        "user_email": st.session_state.user_email.strip(),
                        "filters": st.session_state.filters,
                        "ui_version": "new-ui-v1",
                        "source": "filters_apply",
                    },
                }
            else:
                if st.session_state.target == "hotel":
                    qtext = build_query_hotels_only(st.session_state.filters)
                    url = ROUTE_URL
                    payload = {
                        "query": qtext,
                        "session_id": st.session_state.session_id,
                        "target": "hotel",
                        "extra": {
                            "user_name": st.session_state.user_name.strip(),
                            "user_email": st.session_state.user_email.strip(),
                            "filters": st.session_state.filters,
                            "ui_version": "new-ui-v1",
                            "source": "filters_apply",
                        },
                    }
                elif st.session_state.target == "air":
                    qtext = build_query_flights_only(st.session_state.filters)
                    url = ROUTE_URL
                    payload = {
                        "query": qtext,
                        "session_id": st.session_state.session_id,
                        "target": "air",
                        "extra": {
                            "user_name": st.session_state.user_name.strip(),
                            "user_email": st.session_state.user_email.strip(),
                            "filters": st.session_state.filters,
                            "ui_version": "new-ui-v1",
                            "source": "filters_apply",
                        },
                    }
                else:
                    st.info("TDNA does not use filters. Please type directly in chat.")
                    url, payload = None, None

            # ---- Send + single bubble that updates from 'planning' → answer ----
            if url and payload:
                with st.chat_message("assistant"):
                    placeholder = st.empty()
                    placeholder.markdown("**Great! Agent is planning your trip…**")
                    with st.spinner("Processing…"):
                        status, data = post(url, payload)
                    final_answer = data.get("answer", "") if isinstance(data, dict) else str(data)
                    placeholder.markdown(final_answer)
                # Append only once to transcript (avoid duplicates on rerun)
                if not st.session_state.messages or st.session_state.messages[-1].get("content") != final_answer or st.session_state.messages[-1].get("role") != "assistant":
                    st.session_state.messages.append({"role": "assistant", "content": final_answer, "meta": None})

        if clear:
            st.session_state.filters = {
                "ond": {"origin": None, "destination": None},
                "start_date": None,
                "end_date": None,
                "policy_status": POLICY_OPTIONS[0],
            }
            st.info("Filters cleared.")

        # Compact visual summary
        fil = st.session_state.filters
        st.caption(
            f"Active filters → "
            f"OND: {fil['ond']['origin'] or '—'}→{fil['ond']['destination'] or '—'} | "
            f"Start: {fil['start_date'] or '—'} | "
            f"End: {fil['end_date'] or '—'} | "
            f"Policy: {fil['policy_status']}"
        )
else:
    st.info("Filters are not available when using TDNA directly. Switch to Agentic AI or a different tool to apply filters.")

# ================== Chat transcript (no debug) ==================
for m in st.session_state.messages:
    with st.chat_message(m["role"]):
        st.markdown(m["content"])

# ================== Chat input ==================
prompt = st.chat_input("Type a message and press Enter…")
if prompt:
    st.session_state.messages.append({"role": "user", "content": prompt, "meta": None})
    with st.chat_message("user"):
        st.markdown(prompt)

    extra = {
        "user_name": st.session_state.user_name.strip(),
        "user_email": st.session_state.user_email.strip(),
        "filters": {
            "ond": {
                "origin": st.session_state.filters["ond"]["origin"],
                "destination": st.session_state.filters["ond"]["destination"],
            },
            "start_date": st.session_state.filters["start_date"],
            "end_date": st.session_state.filters["end_date"],
            "policy_status": st.session_state.filters["policy_status"],
        },
        "ui_version": "new-ui-v1"
    }

    try:
        if st.session_state.mode == "Agentic AI":
            payload = {
                "query": prompt.strip(),
                "session_id": st.session_state.session_id,
                "autonomy": st.session_state.autonomy,
                "max_iters": st.session_state.max_iters,
                "extra": extra,
            }
            status, data = post(AGENT_URL, payload)
            final_answer = data.get("final_answer", "") if isinstance(data, dict) else str(data)
        else:
            target = st.session_state.target
            payload = {
                "query": prompt.strip(),
                "target": target,
                "extra": extra,
                "session_id": f"{st.session_state.session_id}::{target}",
            }
            status, data = post(ROUTE_URL, payload)
            final_answer = data.get("answer", "") if isinstance(data, dict) else str(data)
    except Exception as e:
        final_answer = f"Request error: {e}"

    with st.chat_message("assistant"):
        st.markdown(final_answer)
    # Append only once if not identical to last assistant message
    if not st.session_state.messages or st.session_state.messages[-1].get("content") != final_answer or st.session_state.messages[-1].get("role") != "assistant":
        st.session_state.messages.append({"role": "assistant", "content": final_answer, "meta": None})

# footer
st.markdown("---")
st.caption("This chat uses the orchestrator’s HTTP endpoints and preserves conversational state via session_id.")
