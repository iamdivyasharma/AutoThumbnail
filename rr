import pandas as pd
from datetime import datetime

# Point directly to ONE .xlsx workbook (no clients, no filtering)
EXCEL_FILE = Path(os.getenv("LOCAL_EXCEL_PATH", "data/workbook.xlsx")).resolve()
EXCEL_INDEX_DIR = Path(os.getenv("LOCAL_EXCEL_INDEX_DIR", "excel_faiss")).resolve()
EXCEL_INDEX_DIR.mkdir(parents=True, exist_ok=True)

_EXCEL = {
    "df_by_sheet": {},     # {sheet_name: DataFrame}
    "meta": {},            # {"sheets": [...], "rows": {...}, "mtime": "...", "path": "..."}
    "vs": None,            # FAISS vectorstore for Excel chunks
    "chunk_meta": [],      # [{sheet, start_row, end_row}]
    "last_loaded_at": None,
}
_EXCEL_HISTORY: Dict[str, List[Dict[str, Any]]] = {}   # session_id -> [{"role": "...", "text": "...", "time": iso}]

def _load_excel_into_frames() -> Dict[str, pd.DataFrame]:
    """
    Load ALL sheets from a SINGLE XLSX workbook into dataframes.
    No client logic. No filter. Just the file.
    """
    if not EXCEL_FILE.exists():
        raise HTTPException(404, f"Excel file not found at {EXCEL_FILE}")
    # Force engine to openpyxl for .xlsx; read everything as string so the LLM sees consistent text
    frames = pd.read_excel(EXCEL_FILE, sheet_name=None, engine="openpyxl", dtype=str)
    norm: Dict[str, pd.DataFrame] = {}
    for sh, df in (frames or {}).items():
        df = df.copy()
        # Replace NaN with empty strings to avoid 'nan' showing up in context
        df = df.fillna("")
        # Normalize column names to strings
        df.columns = [str(c) for c in df.columns]
        norm[str(sh)] = df
    return norm

def _df_rows_to_text(df: pd.DataFrame, sheet: str, start: int, end: int) -> str:
    """
    Convert a block of rows into a compact, searchable text chunk
    annotated with the sheet and row range (1-based inclusive).
    """
    lines = [f"[sheet: {sheet}] rows {start+1}-{end}"]
    cols = list(df.columns)
    for i in range(start, end):
        row = df.iloc[i]
        kv = ", ".join(f"{col}={repr(row[col])}" for col in cols)
        lines.append(f"r{i+1}: {kv}")
    return "\n".join(lines)

def _build_excel_faiss() -> None:
    """
    Build (or rebuild) a FAISS index over ALL sheets of the single XLSX.
    """
    df_by_sheet = _load_excel_into_frames()
    sheets = list(df_by_sheet.keys())
    rows = {s: int(len(df_by_sheet[s])) for s in sheets}
    mtime = datetime.fromtimestamp(EXCEL_FILE.stat().st_mtime).isoformat(timespec="seconds")

    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))

    texts: List[str] = []
    chunk_meta: List[Dict[str, Any]] = []
    CHUNK_SIZE = 40  # rows per chunk
    for sh in sheets:
        df = df_by_sheet[sh]
        n = len(df)
        if n == 0:
            continue
        for start in range(0, n, CHUNK_SIZE):
            end = min(start + CHUNK_SIZE, n)
            texts.append(_df_rows_to_text(df, sh, start, end))
            chunk_meta.append({"sheet": sh, "start_row": start+1, "end_row": end})

    if not texts:
        raise HTTPException(400, "Excel workbook has no rows to index.")

    vs = FAISS.from_texts(texts=texts, embedding=emb)
    vs.save_local(str(EXCEL_INDEX_DIR))

    _EXCEL["df_by_sheet"] = df_by_sheet
    _EXCEL["meta"] = {"sheets": sheets, "rows": rows, "mtime": mtime, "path": str(EXCEL_FILE)}
    _EXCEL["vs"] = vs
    _EXCEL["chunk_meta"] = chunk_meta
    _EXCEL["last_loaded_at"] = datetime.utcnow().isoformat(timespec="seconds") + "Z"

def _ensure_excel_loaded():
    """
    Keep index + frames ready. If the index is missing or stale, rebuild.
    Zero client filtering anywhere.
    """
    # try to load saved index
    if _EXCEL.get("vs") is None:
        try:
            emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
            _EXCEL["vs"] = FAISS.load_local(str(EXCEL_INDEX_DIR), emb, allow_dangerous_deserialization=True)
        except Exception:
            _EXCEL["vs"] = None

    # (re)load frames every time we boot or refresh so we reflect disk state
    try:
        _EXCEL["df_by_sheet"] = _load_excel_into_frames()
        sheets = list(_EXCEL["df_by_sheet"].keys())
        _EXCEL["meta"].update({
            "sheets": sheets,
            "rows": {s: int(len(_EXCEL["df_by_sheet"][s])) for s in sheets},
            "mtime": datetime.fromtimestamp(EXCEL_FILE.stat().st_mtime).isoformat(timespec="seconds"),
            "path": str(EXCEL_FILE),
        })
    except Exception:
        _EXCEL["df_by_sheet"] = {}

    if _EXCEL["vs"] is None or not _EXCEL.get("df_by_sheet"):
        _build_excel_faiss()

def _excel_answer(question: str, k: int = 6, session_id: Optional[str] = None) -> Dict[str, Any]:
    """
    Retrieve RAG over the XLSX (all sheets), produce context previews, and LLM answer.
    """
    _ensure_excel_loaded()
    vs = _EXCEL["vs"]
    retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k})
    docs = retriever.get_relevant_documents(question)

    previews: List[str] = []
    # chunk_meta aligns with texts creation order
    for idx, d in enumerate(docs):
        if idx >= len(_EXCEL["chunk_meta"]):
            break
        meta = _EXCEL["chunk_meta"][idx]
        sh = meta.get("sheet")
        s = int(meta.get("start_row", 1)) - 1
        e = int(meta.get("end_row", s+1))
        df = _EXCEL["df_by_sheet"].get(sh)
        if df is None:
            continue
        # Show at most ~8 rows for readability
        df_slice = df.iloc[max(0, s):min(e, s+8)]
        preview = df_slice.to_string(index=False)
        previews.append(f"(sheet: {sh}, rows {s+1}-{min(e, s+8)})\n{preview}")

    context = "\n\n---\n\n".join(previews) if previews else "(no preview)"
    history = _EXCEL_HISTORY.get(session_id or "", [])[-6:] if session_id else []

    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=0.15,
        max_tokens=900
    )

    excel_prompt = ChatPromptTemplate.from_messages([
        ("system",
         "You are a precise data analyst. Answer ONLY using the Provided Context from the Excel sheets. "
         "Be specific with rows/columns where possible. If the data needed isn't in the context, say you don't know."),
        *[("human" if t["role"]=="user" else "assistant", t["text"]) for t in history],
        ("human", "Question: {question}\n\nProvided Context:\n{context}\n\nAnswer now with specifics.")
    ])
    chain = excel_prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": question, "context": context})

    if session_id:
        sess = _EXCEL_HISTORY.setdefault(session_id, [])
        now = datetime.utcnow().isoformat(timespec="seconds") + "Z"
        sess.append({"role": "user", "text": question, "time": now})
        sess.append({"role": "assistant", "text": answer, "time": now})
        if len(sess) > 40:
            _EXCEL_HISTORY[session_id] = sess[-40:]

    srcs: List[Dict[str, Any]] = []
    for idx, d in enumerate(docs):
        if idx >= len(_EXCEL["chunk_meta"]):
            break
        meta = _EXCEL["chunk_meta"][idx]
        srcs.append({
            "sheet": meta.get("sheet"),
            "start_row": meta.get("start_row"),
            "end_row": meta.get("end_row"),
            "snippet": d.page_content[:300]
        })

    return {"answer": answer, "sources": srcs, "history": _EXCEL_HISTORY.get(session_id or "", [])}

