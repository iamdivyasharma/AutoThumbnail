import re  # <-- add this at top with other imports

# Replace your normalize_answer with this:
HEADER_RE = re.compile(
    r'^\s*(?:[*_]{0,2})\s*(air(?:\s*bot)?|hotel(?:\s*bot)?|tdna(?:\s*bot)?)\s*(?:[:\-–—|]+\s*)?(?:[*_]{0,2})\s*$',
    re.IGNORECASE,
)
PREFIX_RE = re.compile(
    r'^\s*(?:[*_]{0,2})\s*(air(?:\s*bot)?|hotel(?:\s*bot)?|tdna(?:\s*bot)?)\s*(?:[:\-–—|]+\s*)',
    re.IGNORECASE,
)

def normalize_answer(text: str) -> str:
    """
    1) Drop stand-alone headers like 'Air:', 'Hotel:', 'TDNA:' lines (with optional **bold** / _italics_ and punctuation).
    2) Strip those same headers when they appear at the START of a line that also has content (e.g., '**Air:** Best fare …').
    3) Collapse accidental duplicate lines and multiple blank lines.
    """
    if not isinstance(text, str):
        text = str(text)

    lines = [ln.rstrip() for ln in text.splitlines()]
    out = []
    prev_norm = ""

    for ln in lines:
        s = ln.strip()
        if not s:
            if out and out[-1] != "":
                out.append("")
            continue

        # 1) Remove pure header lines like "Air:" / "**Hotel —**"
        if HEADER_RE.match(s):
            continue

        # 2) Remove header prefix at the very start of the line (e.g., "Air: Best …")
        s = PREFIX_RE.sub("", s)

        # 3) De-dupe near-identical consecutive lines
        norm = " ".join(s.split()).rstrip(" .|").lower()
        if norm == prev_norm:
            continue
        if out and " ".join(out[-1].split()).rstrip(" .|").lower() == norm:
            continue

        out.append(s)
        prev_norm = norm

    # 4) Collapse multiple blank lines
    cleaned = []
    for s in out:
        if s == "" and (not cleaned or cleaned[-1] == ""):
            continue
        cleaned.append(s)

    return "\n".join(cleaned).strip()
