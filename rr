        "type": "free_text",
    },
    "can fee be applied to all countries": {
        "query": "Does the fee or COLA apply to all countries covered by this contract? Answer Yes/No/NA and explain briefly.",
        "type": "yes_no",
    },
    "extracted_clauses": {
        "query": (
            "Extract all clauses related to COLA or material price adjustments. "
            "For each clause, provide: clause_type (e.g. 'COLA material'), "
            "clause_text (exact text from the contract), and section_reference "
            "if available. Return as a JSON array of objects."
        ),
        "type": "list_of_dict",
    },
    # 🔻 Add the rest of your ~42 fields here in the SAME pattern:
    # "field_6": {"query": "Question for field_6", "type": "free_text"},
