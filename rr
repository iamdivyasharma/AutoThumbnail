#new UI

import json
import uuid
import requests
import streamlit as st
from pathlib import Path

# ================== Orchestrator endpoints ==================
ORCH_BASE = "http://localhost:9000"  # change if deployed
ROUTE_URL = f"{ORCH_BASE}/route_query"
AGENT_URL = f"{ORCH_BASE}/agent_query"
MEM_SHOW  = f"{ORCH_BASE}/memory/show"
MEM_CLEAR = f"{ORCH_BASE}/memory/clear"
TIMEOUT   = 30

# ================== Example users ==================
USERS = [
    {"name": "Alice Singh",  "email": "alice@example.com"},
    {"name": "Bob Kumar",    "email": "bob@example.com"},
    {"name": "Charlie Rao",  "email": "charlie@example.com"},
]

# ================== Page config ==================
st.set_page_config(page_title="Orchestrator Chat", page_icon="💬", layout="centered")

# Optional logo
LOGO_PATH = Path("assets/logo.png")
if LOGO_PATH.exists():
    c1, c2, c3 = st.columns([1, 2, 1])
    with c2:
        st.image(str(LOGO_PATH), use_container_width=False)

st.markdown("<h1 style='text-align:center'>💬 Orchestrator — Conversational Chat</h1>", unsafe_allow_html=True)

# ================== Helpers ==================
def post(url: str, payload: dict):
    r = requests.post(url, json=payload, timeout=TIMEOUT)
    if r.headers.get("content-type","").startswith("application/json"):
        return r.status_code, r.json()
    return r.status_code, r.text

def ensure_state():
    if "messages" not in st.session_state:
        st.session_state.messages = []  # list[{"role":"user"|"assistant","content":str,"meta":dict}]
    if "session_id" not in st.session_state:
        st.session_state.session_id = "user123"
    if "mode" not in st.session_state:
        st.session_state.mode = "Agentic AI"
    if "target" not in st.session_state:
        st.session_state.target = "air"
    if "user_name" not in st.session_state:
        st.session_state.user_name = ""
    if "user_email" not in st.session_state:
        st.session_state.user_email = ""
    if "autonomy" not in st.session_state:
        st.session_state.autonomy = True
    if "max_iters" not in st.session_state:
        st.session_state.max_iters = 3

ensure_state()

# ================== Sidebar ==================
with st.sidebar:
    st.subheader("User")
    user_labels = [f"{u['name']} <{u['email']}>" for u in USERS] + ["Other…"]
    picked = st.selectbox("Choose a user", user_labels, index=0)
    if picked != "Other…":
        idx = user_labels.index(picked)
        chosen = USERS[idx]
        user_name_default = chosen["name"]
        user_email_default = chosen["email"]
    else:
        user_name_default = ""
        user_email_default = ""

    st.session_state.user_name = st.text_input("Name", value=user_name_default, placeholder="e.g., Priya Sharma")
    st.session_state.user_email = st.text_input("Email", value=user_email_default, placeholder="e.g., priya@company.com")

    st.markdown("---")
    st.subheader("Session")
    # session id: default to email if present
    default_session = st.session_state.user_email or st.session_state.session_id
    new_session_id = st.text_input("Session ID", value=default_session, key="sid_input")
    if new_session_id != st.session_state.session_id:
        st.session_state.session_id = new_session_id

    col_a, col_b = st.columns(2)
    if col_a.button("🆕 New Chat"):
        # give a fresh session id and clear UI transcript (server memory optional)
        sid = f"{(st.session_state.user_email or 'user')}-{uuid.uuid4().hex[:8]}"
        st.session_state.session_id = sid
        st.session_state.messages = []
        st.success(f"New session id: {sid}")

    if col_b.button("🧹 Clear Server Memory"):
        try:
            r = requests.post(MEM_CLEAR, json={"session_id": st.session_state.session_id}, timeout=TIMEOUT)
            if r.status_code == 200:
                st.success("Server memory cleared.")
            else:
                st.error(r.text)
        except Exception as e:
            st.error(f"Clear error: {e}")

    if st.button("👀 Show Server Memory"):
        try:
            r = requests.get(MEM_SHOW, params={"session_id": st.session_state.session_id}, timeout=TIMEOUT)
            st.json(r.json())
        except Exception as e:
            st.error(f"Show error: {e}")

    st.markdown("---")
    st.subheader("Mode")
    st.session_state.mode = st.radio(
        "How should the next message be handled?",
        ["Agentic AI", "Direct tool"],
        captions=["Let the orchestrator plan and call tools", "Call a specific backend directly"]
    )
    if st.session_state.mode == "Direct tool":
        st.session_state.target = st.segmented_control(
            "Target", options=["air", "hotel", "tdna"], default="air"
        )

    st.markdown("---")
    st.subheader("Agent Settings")
    st.session_state.autonomy = st.checkbox("Enable Autonomy (agent loop)", value=st.session_state.autonomy)
    st.session_state.max_iters = st.slider("Max Iterations", 1, 8, st.session_state.max_iters)

# ================== Chat transcript ==================
# render prior messages
for m in st.session_state.messages:
    with st.chat_message(m["role"]):
        st.markdown(m["content"])
        if meta := m.get("meta"):
            with st.expander("Details"):
                st.json(meta)

# ================== Chat input ==================
prompt = st.chat_input("Type a message and press Enter…")
if prompt:
    # 1) show the user message immediately
    st.session_state.messages.append({"role": "user", "content": prompt, "meta": None})
    with st.chat_message("user"):
        st.markdown(prompt)

    # 2) build identity extra
    extra = {"user_name": st.session_state.user_name.strip(), "user_email": st.session_state.user_email.strip()}

    # 3) call orchestrator based on mode
    try:
        if st.session_state.mode == "Agentic AI":
            payload = {
                "query": prompt.strip(),
                "session_id": st.session_state.session_id,
                "autonomy": st.session_state.autonomy,
                "max_iters": st.session_state.max_iters,
                "extra": extra,
            }
            status, data = post(AGENT_URL, payload)
            # render assistant message
            if isinstance(data, dict):
                final_answer = data.get("final_answer", "")
                meta = {"status": status, "observations": data.get("observations", []), "raw": data}
            else:
                final_answer = str(data)
                meta = {"status": status}

        else:
            target = st.session_state.target
            payload = {
                "query": prompt.strip(),
                "target": target,
                "extra": extra,
                # keep per-target conversational state if you like:
                "session_id": f"{st.session_state.session_id}::{target}",
            }
            status, data = post(ROUTE_URL, payload)
            if isinstance(data, dict):
                final_answer = data.get("answer", "")
                meta = {
                    "status": status,
                    "answers_by_target": data.get("answers_by_target"),
                    "errors": data.get("errors"),
                    "raw": data,
                }
            else:
                final_answer = str(data)
                meta = {"status": status}

    except Exception as e:
        final_answer = f"Request error: {e}"
        meta = None

    # 4) show assistant message + persist to transcript
    with st.chat_message("assistant"):
        st.markdown(final_answer)
        if meta:
            with st.expander("Details"):
                st.json(meta)

    st.session_state.messages.append({"role": "assistant", "content": final_answer, "meta": meta})

# footer
st.markdown("---")
st.caption("This chat uses the orchestrator’s HTTP endpoints and preserves conversational state via session_id.")
