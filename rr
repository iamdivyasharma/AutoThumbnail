def extract_pdf_pages(pdf_path: Path) -> tuple[List[str], Dict[int, List[dict]], List[int], Dict[int, int]]:
    """
    Returns:
      page_texts               : list of final text per page
      ocr_words_by_page        : {page_num -> [word-boxes]} (empty if native kept)
      ocr_used_pages           : [page_nums that used OCR]
      ocr_dpi_by_page          : {page_num -> dpi}
    Also prints ONE LINE per page to show if OCR or native text was used.
    Format:
      [page] <file> p<no>: <MODE> native=<len> ocr=<len> words=<native_words> dpi=<dpi or ->
    """
    page_texts: List[str] = []
    ocr_words_by_page: Dict[int, List[dict]] = {}
    ocr_used_pages: List[int] = []
    ocr_dpi_by_page: Dict[int, int] = {}

    with fitz.open(str(pdf_path)) as doc:
        for pnum in range(doc.page_count):
            page = doc.load_page(pnum)
            native_text = clean_text(page.get_text("text") or "")
            try:
                native_words_cnt = len(page.get_text("words") or [])
            except Exception:
                native_words_cnt = 0

            # Heuristic: does this look like real machine text?
            use_native = page_has_machine_text(page) and len(native_text) >= TEXT_MIN_LEN

            txt = native_text
            words = []
            used_dpi = None
            ocr_len = 0

            if not use_native and USE_TEXTRACT_OCR:
                ocr_text, o_words, used_dpi = ocr_page_with_textract_adaptive(page)
                ocr_text = clean_text(ocr_text)
                ocr_len = len(ocr_text)
                if ocr_len > len(native_text):
                    txt = ocr_text
                    words = o_words
                    ocr_used_pages.append(pnum + 1)
                    if used_dpi:
                        ocr_dpi_by_page[pnum + 1] = used_dpi

            page_texts.append(txt)
            if words:
                ocr_words_by_page[pnum + 1] = words

            # ---- ONE-LINE DEBUG PRINT FOR THIS PAGE ----
            mode = "OCR" if (pnum + 1) in ocr_used_pages else ("NATIVE" if use_native else "NATIVE-empty")
            print(f"[page] {pdf_path.name} p{pnum+1}: {mode} native={len(native_text)} ocr={ocr_len} words={native_words_cnt} dpi={used_dpi or '-'}")

    return page_texts, ocr_words_by_page, ocr_used_pages, ocr_dpi_by_page
