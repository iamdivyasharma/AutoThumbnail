# ----- Schemas -----
class RouteIn(BaseModel):
    query: str
    extra: Optional[Dict[str, Any]] = None
    target: Optional[str] = None
    targets: Optional[List[str]] = None
    session_id: str = "default"

class RouteOut(BaseModel):
    tool: str = "route_query_tool"
    targets: List[str]
    routed_by: str
    answer: Any
    answers_by_target: Optional[Dict[str, Any]] = None
    errors: Optional[Dict[str, str]] = None

class AgentIn(BaseModel):
    query: str
    extra: Optional[Dict[str, Any]] = None
    session_id: str = "default"
    max_iters: int = 3
    parallel_cap: int = 2
    autonomy: bool = True
    answer_schema: Optional[Dict[str, Any]] = None  # if provided, composer returns strict JSON

class AgentOut(BaseModel):
    tool: str = "agent_query_tool"
    session_id: str
    iterations: int
    final_answer: Any
    observations: List[Dict[str, Any]]
    autonomy: bool
    trace_id: str

# ==================== Route Endpoint ====================
@app.post("/route_query", operation_id="route_query_tool", response_model=RouteOut)
async def route_query(inp: RouteIn = Body(...)):
    q_orig, extra, sid = inp.query, inp.extra, inp.session_id
    mem_append(sid, "user", q_orig)
    compress_history_if_needed(sid)

    # Rewrite with history + sticky filters
    q = rewrite_with_history(sid, q_orig, extra)

    # include a small conversation window for tools
    extra_aug = dict(extra or {})
    extra_aug["conversation_window"] = mem_get(sid, 6)

    # Target selection
    if inp.targets:
        targets, routed_by = [t for t in inp.targets if t in SERVICES], "hint:list"
    elif inp.target in SERVICES:
        targets, routed_by = [inp.target], "hint:single"
    elif inp.target == "both":
        targets, routed_by = ["hotel", "air"], "hint:both"
    else:
        targets, routed_by = llm_decide_targets(q, sid), "llm+history"
        if not targets:
            ht = heuristic_targets_from_filters(extra_aug)
            if ht:
                targets, routed_by = ht, "heuristic:ond_present"

    # If still nothing, return early instead of defaulting to "hotel"
    if not targets:
        answer = "Sorry — I couldn’t identify a relevant tool for this request."
        mem_append(sid, "assistant", answer)
        return RouteOut(targets=[], routed_by="none", answer=answer)

    results: Dict[str, Any] = {}
    errors: Dict[str, str] = {}

    if len(targets) <= 1:
        tgt = targets[0]
        out = await call_backend(tgt, q, extra_aug, sid)
        results[tgt] = out
    else:
        coros = [call_backend(t, q, extra_aug, sid) for t in targets]
        outs = await asyncio.gather(*coros, return_exceptions=True)
        for t, out in zip(targets, outs):
            if isinstance(out, Exception):
                errors[t] = f"{type(out).__name__}: {out}"
            else:
                results[t] = out

    # Cross-tool validation before composing (only when multiple tools are called)
    if len(results) > 1:
        verdict = validate_consistency(q, results, (extra_aug or {}).get("filters"))
        if not verdict.get("ok"):
            answer = INCOHERENT_MSG
            answers_by_target = sanitize_map(results)
            mem_append(sid, "assistant", answer)
            return RouteOut(
                targets=targets, routed_by=routed_by, answer=answer,
                answers_by_target=answers_by_target or None,
                errors=(errors or None)
            )

    # Compose or return single
    if len(results) > 1:
        answer = compose_final(q, results, answer_schema=None)
        answers_by_target = sanitize_map(results)
    else:
        answer = sanitize_answer(next(iter(results.values()), ""))
        answers_by_target = None

    mem_append(sid, "assistant", answer)

    return RouteOut(
        targets=targets, routed_by=routed_by, answer=answer,
        answers_by_target=answers_by_target or None,
        errors=(errors or None)
    )

# ==================== Agent Endpoint ====================
@app.post("/agent_query", operation_id="agent_query_tool", response_model=AgentOut)
async def agent_query(inp: AgentIn = Body(...)):
    q_raw, extra, sid = inp.query, inp.extra, inp.session_id
    trace_id = _h({"sid": sid, "t": time(), "nonce": random.random()})

    mem_append(sid, "user", q_raw)
    compress_history_if_needed(sid)

    # Rewrite vague follow-ups with history + sticky filters
    q = rewrite_with_history(sid, q_raw, extra)

    extra_aug = dict(extra or {})
    extra_aug["conversation_window"] = mem_get(sid, 6)

    observations: List[Dict[str, Any]] = []
    final_answer: Optional[str] = None

    # ---- Planning loop ----
    for _iter in range(max(1, min(inp.max_iters, 6))):
        # Ask the planner for a DAG of minimal steps
        try:
            plan_raw = claude_json(
                PLANNER_SYSTEM,
                {"user_query": q, "memory": mem_get(sid, 6), "observations": observations[-4:], "tool_caps": TOOL_CAPS, "hints": PLANNING_HINTS, "filters": (extra_aug or {}).get("filters", {})},
                max_tokens=300
            )
            plan = Plan(**plan_raw)
        except Exception:
            # fallback to router + heuristic if planner fails
            targets = llm_decide_targets(q, sid)
            if not targets:
                targets = heuristic_targets_from_filters(extra_aug)
            if targets:
                plan = Plan(steps=[Step(target=t, input=q) for t in targets])
            else:
                final_answer = "Sorry — I couldn’t identify a relevant tool for this request."
                break

        if plan.finish and plan.final_answer:
            final_answer = plan.final_answer
            break

        # Execute plan DAG
        batch_obs = await execute_steps(plan.steps, q, extra_aug, sid, inp.parallel_cap)
        observations.extend(batch_obs)

        if not inp.autonomy:
            latest = score_observations(q, observations)
            # Validate multi-tool coherence before composing
            if len(latest) > 1:
                verdict = validate_consistency(q, latest, (extra_aug or {}).get("filters"))
                if not verdict.get("ok"):
                    final_answer = INCOHERENT_MSG
                else:
                    final_answer = compose_final(q, latest, inp.answer_schema)
            else:
                final_answer = compose_final(q, latest, inp.answer_schema) if latest else "No result."
            break

        # Decide whether we can finish after this wave
        try:
            fin_raw = claude_json(
                FINISHER_SYSTEM,
                {"user_query": q, "memory": mem_get(sid, 6), "observations": batch_obs}, max_tokens=180
            )
            fin = FinishDecision(**fin_raw)
        except Exception:
            fin = FinishDecision(finish=False)
        if fin.finish:
            final_answer = fin.final_answer or ""
            break

    # If still no final answer, compose from best observed results
    if final_answer is None:
        latest = score_observations(q, observations)
        if latest:
            if len(latest) > 1:
                verdict = validate_consistency(q, latest, (extra_aug or {}).get("filters"))
                if not verdict.get("ok"):
                    final_answer = INCOHERENT_MSG
                else:
                    final_answer = compose_final(q, latest, inp.answer_schema)
            else:
                final_answer = compose_final(q, latest, inp.answer_schema)
        else:
            final_answer = "No result."

    # Critic pass (single attempt) for safety/consistency
    try:
        critic = claude_json(CRITIC_SYSTEM, {"user_query": q, "final_answer": final_answer, "observations": observations[-6:]}, max_tokens=220)
        if not critic.get("ok") and critic.get("revise"):
            final_answer = critic.get("revise")
    except Exception:
        pass

    final_answer = sanitize_answer(final_answer)
    mem_append(sid, "assistant", final_answer)

    return AgentOut(
        session_id=sid,
        iterations=len([ob for ob in observations if "result" in ob or "error" in ob]),
        final_answer=final_answer,
        observations=observations[-8:],
        autonomy=inp.autonomy,
        trace_id=trace_id,
    )

