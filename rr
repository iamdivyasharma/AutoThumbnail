FAISS_INDEX_DIR = Path("/ABSOLUTE/PATH/TO/faiss_indices").resolve()
CONFIGS_PATH    = Path("/ABSOLUTE/PATH/TO/configs/clients.yaml").resolve()
PDF_ROOT        = Path("/ABSOLUTE/PATH/TO/pdfs").resolve()

# =========================
# Bedrock / model config
# =========================
REGION = "us-east-1"
EMBED_MODEL = "amazon.titan-embed-text-v2:0"
LLM_MODEL   = "anthropic.claude-3-5-sonnet-20240620-v1:0"

# ⚠️ Inline credentials for local/dev only (prefer IAM roles or env vars in prod)
AWS_ACCESS_KEY_ID = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"

# Defaults if client missing in YAML
GLOBAL_DEFAULTS = {"k": 4, "temperature": 0.20, "max_tokens": 1200}

# Cap total retrieved chunks across ALL selected clients
MAX_COMBINED_K = 12

# Shared boto3 session
SESSION = boto3.Session(
    aws_access_key_id=AWS_ACCESS_KEY_ID,
    aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    region_name=REGION,
)

# Cache FAISS handles to avoid reloading on each call
_VS_CACHE: Dict[str, FAISS] = {}

app = FastAPI(title="Multi-Client Contract Assistant")

# =========================
# Models
# =========================
class AskRequest(BaseModel):
    question: str
    client_ids: Optional[List[str]] = None  # optional override

class AskResponse(BaseModel):
    answer: str
    used_clients: List[str]
    sources: List[Dict[str, Any]]  # policy_id, page, source_file, client_id


# =========================
# YAML / clients helpers
# =========================
def _load_overrides() -> Dict[str, Dict[str, Any]]:
    """Load clients.yaml and normalize keys; support optional 'aliases'."""
    if not CONFIGS_PATH.exists():
        return {}
    with open(CONFIGS_PATH, "r") as f:
        raw = yaml.safe_load(f) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for k, v in raw.items():
        if not isinstance(v, dict):
            continue
        ck = str(k).strip().lower()
        out[ck] = {
            "k": int(v.get("k", GLOBAL_DEFAULTS["k"])),
            "temperature": float(v.get("temperature", GLOBAL_DEFAULTS["temperature"])),
            "max_tokens": int(v.get("max_tokens", GLOBAL_DEFAULTS["max_tokens"])),
            "aliases": [str(a).strip().lower() for a in v.get("aliases", [])],
        }
    return out

CLIENT_OVERRIDES = _load_overrides()

def list_clients() -> List[str]:
    """Discover available clients from FAISS_INDEX_DIR, skipping hidden/system dirs and missing artifacts."""
    if not FAISS_INDEX_DIR.exists():
        return []
    clients = []
    for p in FAISS_INDEX_DIR.iterdir():
        if not p.is_dir():
            continue
        name = p.name
        if name.startswith("."):  # e.g., .ipynb_checkpoints
            continue
        if not (p / "index.faiss").exists() or not (p / "index.pkl").exists():
            continue
        clients.append(name)
    return sorted(clients)

def _load_index(client_id: str) -> FAISS:
    """Load/cached FAISS index for a client."""
    cid = client_id.strip().lower()
    if cid in _VS_CACHE:
        return _VS_CACHE[cid]
    emb = BedrockEmbeddings(model_id=EMBED_MODEL, client=SESSION.client("bedrock-runtime"))
    vs = FAISS.load_local(str(FAISS_INDEX_DIR / cid), emb, allow_dangerous_deserialization=True)
    _VS_CACHE[cid] = vs
    return vs

def choose_params(client_id: str) -> Dict[str, Any]:
    return CLIENT_OVERRIDES.get(client_id.strip().lower(), GLOBAL_DEFAULTS.copy())


# =========================
# Free-form client detection
# =========================
def _normalize_text(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()

def _build_alias_map(available: List[str]) -> Dict[str, str]:
    """Map alias -> canonical client_id, including the client_id itself."""
    alias_map: Dict[str, str] = {}
    for cid in available:
        c = cid.lower().strip()
        alias_map[_normalize_text(c)] = c
        aliases = CLIENT_OVERRIDES.get(c, {}).get("aliases", [])
        for a in aliases:
            alias_map[_normalize_text(a)] = c
    return alias_map

def detect_clients_from_text(text: str, available: List[str]) -> List[str]:
    norm_text = f" {_normalize_text(text)} "
    alias_map = _build_alias_map(available)
    detected: List[str] = []
    for alias_norm, cid in sorted(alias_map.items(), key=lambda kv: len(kv[0]), reverse=True):
        if alias_norm and f" {alias_norm} " in norm_text:
            if cid not in detected:
                detected.append(cid)
    return detected


# =========================
# Prompt (contract assistant)
# =========================
prompt = ChatPromptTemplate.from_messages([
    (
        "system",
        "You are a precise, client-scoped contract assistant. "
        "Use ONLY the Provided Context. Do not add outside knowledge. "
        "Provide complete information related to the query—do not skip any part. "
        "Cover relevant clauses, definitions, conditions, exceptions, limits, deadlines, "
        "eligibility criteria, required documents, steps, and edge cases found in the context. "
        "If multiple scenarios apply, handle them separately and clearly. "
        "If the context is insufficient or conflicting, state what is missing and say you don't know. "
        "Organize the answer with short headings and bullet points where helpful. "
        "Do NOT include citations or bracket labels."
    ),
    (
        "human",
        "Question: {question}\n\nProvided Context:\n{context}\n\nWrite the best possible answer now."
    ),
])

def _format_docs(docs) -> str:
    # Minimal orientation; no [1]/[2] labels, no citations.
    return "\n\n".join(
        f"(client: {d.metadata.get('client_id')}, policy: {d.metadata.get('policy_id')}, page: {d.metadata.get('page','?')})\n{d.page_content}"
        for d in docs
    )


# =========================
# PDF listing utils (for UI "All documents")
# =========================
def _get_client_id_from_filename(filename: str) -> str:
    name = filename.lower()
    if "_" in name:
        return name.split("_")[0]
    if "-" in name:
        return name.split("-")[0]
    return Path(name).stem

def get_pdf_page_count(path: str):
    """Try multiple libs; return None if unavailable."""
    try:
        from pypdf import PdfReader
        return len(PdfReader(path).pages)
    except Exception:
        pass
    try:
        from PyPDF2 import PdfReader as P2Reader
        return len(P2Reader(path).pages)
    except Exception:
        pass
    try:
        import fitz
        with fitz.open(path) as doc:
            return doc.page_count
    except Exception:
        pass
    return None

def _list_client_pdfs(client_id: str) -> List[Dict[str, Any]]:
    """Return all PDF docs for a client (absolute paths), ignoring hidden/temp/non-PDF."""
    client = client_id.strip().lower()
    pdfs: List[Dict[str, Any]] = []
    # change to rglob("*.pdf") if you need recursion
    for p in PDF_ROOT.glob("*.pdf"):
        if not p.is_file():
            continue
        if p.name.startswith((".", "~$")):
            continue
        if p.suffix.lower() != ".pdf":
            continue
        if _get_client_id_from_filename(p.name) == client:
            pages = get_pdf_page_count(str(p))
            pdfs.append({
                "policy_id": p.name,
                "source_file": str(p.resolve()),  # ABSOLUTE path returned
                "pages": pages,
                "client_id": client,
            })
    return sorted(pdfs, key=lambda x: x["policy_id"])


# =========================
# Routes
# =========================
@app.get("/clients")
def api_list_clients() -> List[str]:
    return list_clients()

@app.get("/clients/{client_id}/documents")
def api_client_documents(client_id: str):
    available = list_clients()
    cid = client_id.strip().lower()
    if cid not in available:
        raise HTTPException(404, f"Unknown client_id '{client_id}'")
    return _list_client_pdfs(cid)

@app.post("/ask", response_model=AskResponse)
def ask(payload: AskRequest):
    available = list_clients()
    if not available:
        raise HTTPException(404, "No client indexes available. Build indexes first.")

    # Determine which clients to use
    if payload.client_ids:
        requested = sorted({c.strip().lower() for c in payload.client_ids})
    else:
        requested = detect_clients_from_text(payload.question, available)

    if not requested:
        raise HTTPException(
            400,
            f"No client detected in the question. Mention a client name (e.g., {', '.join(available[:5])} ...)."
        )

    # Validate clients
    invalid = [c for c in requested if c not in available]
    if invalid:
        raise HTTPException(404, f"Unknown client id(s): {invalid}. Available: {available}")

    # Aggregate per-client params
    per_client_params = {c: choose_params(c) for c in requested}
    temperature = min(p["temperature"] for p in per_client_params.values())
    max_tokens  = max(p["max_tokens"]  for p in per_client_params.values())

    # Distribute k across multiple clients
    n_clients = len(requested)
    per_cap = max(1, math.ceil(MAX_COMBINED_K / n_clients))

    # Retrieve from each client and combine (hard-guard by client_id)
    combined_docs = []
    for cid in requested:
        vs = _load_index(cid)
        k_yaml = per_client_params[cid]["k"]
        k_effective = min(k_yaml, per_cap)
        retriever = vs.as_retriever(search_type="similarity", search_kwargs={"k": k_effective})
        docs = retriever.get_relevant_documents(payload.question)
        docs = [d for d in docs if str(d.metadata.get("client_id", "")).strip().lower() == cid]
        combined_docs.extend(docs)

    if not combined_docs:
        raise HTTPException(404, f"No matching content for clients {requested}.")

    if len(combined_docs) > MAX_COMBINED_K:
        combined_docs = combined_docs[:MAX_COMBINED_K]

    context = _format_docs(combined_docs)

    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=temperature,
        max_tokens=max_tokens,
    )
    chain = prompt | llm | StrOutputParser()
    answer = chain.invoke({"question": payload.question, "context": context})

    # Return absolute paths for source_file for easy viewing in Streamlit
    sources = [{
        "policy_id": d.metadata.get("policy_id"),
        "page": d.metadata.get("page"),
        "source_file": str(Path(d.metadata.get("source_file", "")).resolve()) if d.metadata.get("source_file") else None,
        "client_id": d.metadata.get("client_id"),
    } for d in combined_docs]

    return AskResponse(answer=answer, used_clients=requested, sources=sources)
