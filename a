import shlex
from mcp.client.session import ClientSession
from mcp.client.stdio import stdio_client

async def _open_stdio_session(cmd_list):
    """
    Supports both mcp SDK signatures:
      - stdio_client("python -m hotel_mcp")
      - (newer) stdio_client("/path/to/bin", "--flag")  <-- if present
    We try 1-arg first (older), then fall back to multi-arg.
    """
    # 1) Older API: single string command
    cmd_str = " ".join(shlex.quote(p) for p in cmd_list)
    try:
        return stdio_client(cmd_str)
    except TypeError:
        # 2) Newer API: multiple positional args
        return stdio_client(*cmd_list)



