import shlex

def normalize_servers(cfg: dict) -> dict:
    """Normalize RAW_MCP_CONFIG into a strict structure.

    Accepts:
      - {"name": {"transport": {"type":"stdio","command":[...]}}}
      - {"name": {"transport": {"type":"stdio","command":"python -m foo"}}}
      - {"name": {"transport": "stdio", "command": "..."}}
      - {"name": "python -m foo"}  # shortcut -> stdio
    """
    out = {}
    for name, val in cfg.items():
        # Shortcut: plain string -> stdio command
        if isinstance(val, str):
            cmd = shlex.split(val)
            out[name] = {"transport": {"type": "stdio", "command": cmd}}
            continue

        if not isinstance(val, dict):
            raise ValueError(f"Server '{name}' must be dict or str, got {type(val).__name__}")

        tinfo = val.get("transport")
        # allow "transport": "stdio"
        if isinstance(tinfo, str):
            tinfo = {"type": tinfo}
        elif not isinstance(tinfo, dict):
            raise ValueError(f"Server '{name}' missing/invalid 'transport'")

        ttype = tinfo.get("type")
        if ttype not in ("stdio", "sse", "websocket", "streamable_http"):
            raise ValueError(f"Server '{name}' invalid transport type: {ttype!r}")

        if ttype == "stdio":
            cmd = tinfo.get("command", val.get("command"))
            if isinstance(cmd, str):
                cmd = shlex.split(cmd)
            elif isinstance(cmd, tuple):
                cmd = list(cmd)
            if not isinstance(cmd, list) or not cmd:
                raise ValueError(f"Server '{name}' stdio requires 'command' as list[str] or str; got {cmd!r}")
            tinfo["command"] = cmd
        else:
            url = tinfo.get("url", val.get("url"))
            if not isinstance(url, str) or not url:
                raise ValueError(f"Server '{name}' transport '{ttype}' requires 'url'")
            tinfo["url"] = url

        out[name] = {"transport": tinfo}
    return out



