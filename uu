# services/metadata_service.py
from __future__ import annotations

import json
import re
from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd


def _norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()


def _make_acronym(name: str) -> str:
    """
    Example: "A.P. Moller Maersk" -> "APMM"
    """
    parts = re.split(r"[^A-Za-z0-9]+", name or "")
    parts = [p for p in parts if p]
    return "".join(p[0].upper() for p in parts if p and p[0].isalnum())


class MetadataService:
    """
    Metadata Lookup Service
    - Reads client master CSV (your Excel exported csv)
    - Uses schema json (prebuilt once) to know column list/types
    - Resolves client from natural language (supports acronym match like APMM)
    """

    def __init__(
        self,
        client_master_csv_path: str,
        schema_json_path: Optional[str] = None,
        client_name_col: str = "parent_hq",
        country_col: str = "country__c",
        cid_col: str = "cid",
    ):
        self.client_master_csv_path = str(client_master_csv_path)
        self.schema_json_path = str(schema_json_path) if schema_json_path else None

        self.client_name_col = client_name_col
        self.country_col = country_col
        self.cid_col = cid_col

        self.df: Optional[pd.DataFrame] = None
        self.schema: Dict[str, Any] = {}

    # ----------------------------
    # Loading
    # ----------------------------
    def ensure_loaded(self) -> None:
        if self.df is not None:
            return

        csv_path = Path(self.client_master_csv_path)
        if not csv_path.exists():
            raise FileNotFoundError(f"Client master CSV not found: {csv_path}")

        # Robust CSV read (works for large files too)
        self.df = pd.read_csv(
            csv_path,
            dtype=str,
            keep_default_na=False,
            encoding="utf-8",
            on_bad_lines="skip",
        )

        # normalize column names (keep original too)
        self.df.columns = [str(c).strip() for c in self.df.columns]

        # load schema json (optional)
        if self.schema_json_path:
            sp = Path(self.schema_json_path)
            if sp.exists():
                try:
                    self.schema = json.loads(sp.read_text(encoding="utf-8"))
                except Exception:
                    self.schema = {}
            else:
                self.schema = {}

    # ----------------------------
    # Client resolve (name + acronym)
    # ----------------------------
    def _resolve_client_from_query(self, query: str) -> Optional[Dict[str, str]]:
        assert self.df is not None

        q = (query or "").strip()
        q_norm = _norm(q)

        # tokens from query
        raw_tokens = re.split(r"[^A-Za-z0-9]+", q)
        raw_tokens_upper = {t.upper() for t in raw_tokens if t}

        best_row = None
        best_score = -1

        for _, row in self.df.iterrows():
            name = str(row.get(self.client_name_col, "")).strip()
            if not name:
                continue

            name_norm = _norm(name)
            if not name_norm:
                continue

            # 1) ACRONYM MATCH (strong)
            acr = _make_acronym(name)
            if acr and acr in raw_tokens_upper:
                score = 1000

            # 2) CONTAINS match
            elif name_norm in q_norm or q_norm in name_norm:
                score = 500 + min(len(name_norm), 200)

            else:
                score = 0

            if score > best_score:
                best_score = score
                best_row = row

        if best_row is None or best_score <= 0:
            return None

        return {
            "client_name": str(best_row.get(self.client_name_col, "")).strip(),
            "cid": str(best_row.get(self.cid_col, "")).strip(),
            "country": str(best_row.get(self.country_col, "")).strip(),
        }

    # ----------------------------
    # Public API used by FastAPI
    # ----------------------------
    def lookup(
        self,
        query: str,
        country: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Deterministic metadata lookup (no LLM here).
        Returns resolved client details + matched rows preview.
        """
        self.ensure_loaded()
        assert self.df is not None

        resolved = self._resolve_client_from_query(query)
        if not resolved:
            return {
                "found": False,
                "message": "Client not found in master CSV (try a clearer name).",
                "resolved_client": None,
                "rows_preview": [],
            }

        # Optional country filter
        df2 = self.df.copy()
        if country:
            country_norm = str(country).strip().lower()
            df2 = df2[df2[self.country_col].astype(str).str.strip().str.lower() == country_norm]

        # Filter by resolved client name (exact)
        cname = resolved["client_name"]
        df2 = df2[df2[self.client_name_col].astype(str).str.strip() == cname]

        preview = df2.head(10).to_dict(orient="records")

        return {
            "found": True,
            "resolved_client": resolved,
            "rows_preview": preview,
        }
