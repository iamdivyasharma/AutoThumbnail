    def _resolve_scope_dir(self, client_name: str, country: Optional[str], category: str) -> Optional[Tuple[str, Path]]:
        """
        Find the scope folder that matches:
          finance/<client>/<country>
        in a case-safe way using the _id_to_dir map.
        """
        c = (client_name or "").strip()
        if not c:
            return None

        # try direct scope first
        if country:
            scope_id = f"{category}/{c}/{country}".lower()
            if scope_id in self._id_to_dir:
                return scope_id, self._id_to_dir[scope_id]

        # fallback scopes if no country match
        for fallback in ["corporatefamily", "ultimateparent"]:
            scope_id = f"{category}/{c}/{fallback}".lower()
            if scope_id in self._id_to_dir:
                return scope_id, self._id_to_dir[scope_id]

        return None

    def _load_manifest_docs(self, scope_dir: Path) -> List[Dict[str, Any]]:
        manifest_path = scope_dir / "manifest.json"
        if not manifest_path.exists():
            return []
        try:
            data = json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception:
            return []
        return data.get("docs", []) or []

    def lookup_agreement_types(self, query: str, category: str = "finance", country: Optional[str] = None) -> Dict[str, Any]:
        """
        Hard-coded useful metadata lookup:
        agreement type values from manifest.json docs[].metadata
        """
        self.ensure_loaded()

        # Step 1: resolve client from query
        resolved = self._resolve_client_from_query(query)
        if not resolved:
            return {"answer_text": "Client not found in client master sheet."}

        client_name = resolved["client_name"]
        cid = resolved["cid"]
        effective_country = country or resolved.get("country")

        # Step 2: resolve scope dir
        resolved_scope = self._resolve_scope_dir(client_name, effective_country, category)
        if not resolved_scope:
            return {"answer_text": f"No matching scope folder found for {client_name} ({effective_country})."}

        scope_id, scope_dir = resolved_scope

        # Step 3: read manifest.json docs
        docs = self._load_manifest_docs(scope_dir)
        if not docs:
            return {"answer_text": f"manifest.json found but docs[] is empty for {scope_id}."}

        # Step 4: identify correct metadata key for agreement type
        all_keys = set()
        for d in docs:
            md = d.get("metadata") or {}
            for k in md.keys():
                all_keys.add(k)

        match_key = _best_key_match("agreement type", sorted(all_keys))
        if not match_key:
            return {"answer_text": f"No agreement type field found in manifest metadata for {scope_id}."}

        # Step 5: extract values per file
        rows = []
        for d in docs:
            policy = d.get("policy_id")
            md = d.get("metadata") or {}
            val = md.get(match_key)
            if val is not None and str(val).strip():
                rows.append((policy, str(val).strip()))

        if not rows:
            return {"answer_text": f"Agreement type key exists ({match_key}) but no values found in docs metadata."}

        # Step 6: produce response text
        uniq = sorted(set(v for _, v in rows))
        lines = [
            f"Agreement Types found for {client_name} ({effective_country}) [CID={cid}] in scope {scope_id}:",
            f"Detected field key: {match_key}",
            "",
        ]
        for policy, v in rows[:50]:
            lines.append(f"- {policy}: {v}")

        if len(rows) > 50:
            lines.append(f"... and {len(rows)-50} more files")

        lines.append("")
        lines.append(f"Unique agreement types: {', '.join(uniq)}")

        return {"answer_text": "\n".join(lines)}
