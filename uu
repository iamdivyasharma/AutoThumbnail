def make_chunks_for_docx(doc_path: Path, category: str, client_id: str) -> Iterable[Document]:
    """
    Extract text from DOC/DOCX using UnstructuredWordDocumentLoader, then chunk.
    Works for .doc and .docx (e.g. 'docx.docx' is totally fine).
    """
    if not _HAS_WORD_LOADER:
        print(f"[WARN] UnstructuredWordDocumentLoader not available; skipping {doc_path}")
        return

    policy_id = doc_path.name
    print(f"[DEBUG] Starting DOC/DOCX extraction (UnstructuredWordDocumentLoader) for {doc_path}")

    try:
        loader = UnstructuredWordDocumentLoader(str(doc_path))
        docs = loader.load()
        print(f"[DEBUG] UnstructuredWordDocumentLoader loaded {len(docs)} Document(s) for {doc_path}")
    except Exception as e:
        print(f"[WARN] Failed to load DOC/DOCX {doc_path} with UnstructuredWordDocumentLoader: {e}")
        return

    if not docs:
        print(f"[DEBUG] No Document objects returned for {doc_path}")
        return

    for i, d in enumerate(docs, start=1):
        text = clean_text(d.page_content or "")
        if not text.strip():
            print(f"[DEBUG] Empty text for {doc_path} (doc index {i}), skipping.")
            continue

        chunks = chunk_text(text)  # [(start, end, chunk_text), ...]
        print(f"[DEBUG] Generated {len(chunks)} chunks for {doc_path} (doc index {i})")

        for logical_page, (_, _, chunk) in enumerate(chunks, start=1):
            meta = {
                "category": category,
                "client_id": client_id,
                "policy_id": policy_id,
                "page": logical_page,
                "source_file": str(doc_path.resolve()),
                "extracted_by": "unstructured_word",
            }
            yield Document(page_content=chunk, metadata=meta)
