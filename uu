import os
import re
import json
from pathlib import Path
from typing import Dict, Any, List, Optional, Tuple

import pandas as pd

def _make_acronym(name: str) -> str:
    """
    Build acronym from a client name.
    Example: "A.P. Moller Maersk" -> "APMM"
    """
    words = re.split(r"[^A-Za-z0-9]+", name or "")
    words = [w for w in words if w]
    if not words:
        return ""
    return "".join(w[0].upper() for w in words if w[0].isalnum())

def _norm(s: str) -> str:
    """Normalize for fuzzy compare: keep only alphanumeric, lowercase."""
    return re.sub(r"[^a-z0-9]+", "", (s or "").lower())


def _best_key_match(target: str, keys: List[str]) -> Optional[str]:
    """
    Find best matching metadata key for something like "agreement type".
    Example:
      target="agreement type"
      key="APXT_readl...agreement_type_C"
    """
    t = _norm(target)
    if not t:
        return None

    # try exact contains match
    for k in keys:
        if t in _norm(k):
            return k

    # fallback: if agreementtype not found, check partial tokens
    tokens = re.split(r"\s+", target.lower().strip())
    tokens = [x for x in tokens if x]
    for k in keys:
        kn = _norm(k)
        if all(_norm(tok) in kn for tok in tokens):
            return k

    return None


class MetadataService:
    """
    Metadata lookup service:
    - client master CSV (cid, country__c, parent_hq)
    - FAISS index folder contains manifest.json for each scope
    """

    def __init__(
        self,
        client_master_csv_path: str,
        faiss_index_dir: str,
        client_name_col: str = "parent_hq",
        country_col: str = "country__c",
        cid_col: str = "cid",
    ):
        self.client_master_csv_path = Path(client_master_csv_path)
        self.faiss_index_dir = Path(faiss_index_dir)

        self.client_name_col = client_name_col
        self.country_col = country_col
        self.cid_col = cid_col

        self.df: Optional[pd.DataFrame] = None
        self._id_to_dir: Dict[str, Path] = {}

    def ensure_loaded(self):
        if self.df is None:
            if not self.client_master_csv_path.exists():
                raise FileNotFoundError(f"Client master CSV not found: {self.client_master_csv_path}")

            self.df = pd.read_csv(self.client_master_csv_path)
            # normalize for safe searching
            self.df[self.client_name_col] = self.df[self.client_name_col].astype(str)
            self.df[self.country_col] = self.df[self.country_col].astype(str)
            self.df[self.cid_col] = self.df[self.cid_col].astype(str)

        if not self._id_to_dir:
            self._refresh_id_map()

    def _refresh_id_map(self):
        """
        Build normalized scope-id -> actual folder path mapping
        Handles case-sensitive folders like AMGEN/US, Amgen/us, etc.
        """
        self._id_to_dir = {}
        if not self.faiss_index_dir.exists():
            return

        for dirpath, dirnames, filenames in os.walk(self.faiss_index_dir):
            dirpath = Path(dirpath)
            if "manifest.json" in filenames:
                rel = dirpath.relative_to(self.faiss_index_dir).as_posix()  # finance/AMGEN/US
                nid = rel.lower()
                self._id_to_dir[nid] = dirpath
    def _resolve_client_from_query(self, query: str) -> Optional[Dict[str, str]]:
        """
        Resolve client from query using:
        1) Acronym match (APMM)
        2) Fuzzy contains match on parent_hq name
        """
        q = (query or "").strip()
        q_norm = _norm(q)

        # tokens from query (supports APMM typed alone)
        raw_tokens = re.split(r"[^A-Za-z0-9]+", q)
        raw_tokens_upper = {t.upper() for t in raw_tokens if t}

        best_row = None
        best_score = -1

        for _, row in self.df.iterrows():
            name = str(row.get(self.client_name_col, "")).strip()
            if not name:
                continue

            name_norm = _norm(name)
            if not name_norm:
                continue

            # --------- 1) ACRONYM MATCH (strongest) ----------
            acr = _make_acronym(name)
            if acr and acr in raw_tokens_upper:
                # immediate strong match
                score = 1000
            else:
                # --------- 2) FUZZY CONTAINS ----------
                # Very tolerant:
                # - query contains name
                # - name contains query
                if name_norm in q_norm or q_norm in name_norm:
                    score = 500 + min(len(name_norm), 200)
                else:
                    # fallback: weak similarity based on shared chunks
                    score = 0

            if score > best_score:
                best_score = score
                best_row = row

        if best_row is None or best_score <= 0:
            return None

        return {
            "client_name": str(best_row.get(self.client_name_col, "")).strip(),
            "cid": str(best_row.get(self.cid_col, "")).strip(),
            "country": str(best_row.get(self.country_col, "")).strip(),
        }

