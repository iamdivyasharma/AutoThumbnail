# services/metadata_llm.py
from __future__ import annotations

import os
import json
from typing import Any, Dict

from boto3 import Session
from langchain_aws import ChatBedrockConverse
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser


REGION = os.getenv("AWS_REGION", "us-east-1")
LLM_MODEL = os.getenv("BEDROCK_LLM_MODEL", "anthropic.claude-3-5-sonnet-20240620-v1:0")

# Uses IAM role if keys not present
SESSION = Session(region_name=REGION)


def llm_format_metadata_answer(user_query: str, lookup_result: Dict[str, Any]) -> str:
    

   
    safe_context = {
        "query": lookup_result.get("query"),
        "category": lookup_result.get("category"),
        "resolved": lookup_result.get("resolved", []),
        "scopes": lookup_result.get("scopes", [])[:10],
        "docs_preview": lookup_result.get("docs_preview", [])[:15],
        "manifest_count": lookup_result.get("manifest_count"),
    }

    prompt = ChatPromptTemplate.from_messages(
        [
            (
                "system",
                """
You are a metadata assistant for contract repositories.
You MUST answer ONLY using the Provided Context JSON.
Do NOT guess anything. If a field is missing, say: "Not available in metadata".

Rules:
- If user asks "file names", list policy_id from docs_preview.
- If user asks "how many files", count docs_preview or say it's a preview.
- If user asks for attributes (ContentDocumentId, ID, Modified Time), extract from metadata_attributes.
- If user asks CAPID / Client ID, use resolved[].cid if present.
- Output must be short, clear, and user friendly.
""".strip(),
            ),
            (
                "human",
                "User Query:\n{user_query}\n\nProvided Context (JSON):\n{context_json}",
            ),
        ]
    )

    llm = ChatBedrockConverse(
        model_id=LLM_MODEL,
        client=SESSION.client("bedrock-runtime"),
        temperature=0.0,     
        max_tokens=700,
    )

    chain = prompt | llm | StrOutputParser()
    answer = chain.invoke(
        {
            "user_query": user_query.strip(),
            "context_json": json.dumps(safe_context, indent=2),
        }
    )
    return answer.strip()





from pydantic import BaseModel
from typing import Optional, Dict, Any

class MetadataLookupRequest(BaseModel):
    query: str
    category: Optional[str] = "finance"
    country: Optional[str] = None
    use_llm: Optional[bool] = True  



from fastapi import FastAPI, HTTPException
from services.metadata_service import MetadataService
from services.metadata_llm import llm_format_metadata_answer

app = FastAPI(title="Metadata Lookup API")

svc = MetadataService(
    client_master_csv_path="Excel/Contractextraction list1.csv",
    schema_json_path="data/client_master_schema.json",
    faiss_index_dir="/opt/ml/faiss_indices",
    client_name_col="parent_hq",
    country_col="country__c",
    cid_col="cid",
)
svc.ensure_loaded()


@app.post("/api/metadata/lookup")
def metadata_lookup(payload: MetadataLookupRequest):
    if not payload.query.strip():
        raise HTTPException(400, "query is required")

    lookup_result = svc.lookup(
        query=payload.query,
        category=payload.category or "finance",
        country=payload.country,
    )

    # ✅ optional LLM formatting layer
    if payload.use_llm:
        answer_text = llm_format_metadata_answer(payload.query, lookup_result)
        lookup_result["answer_text"] = answer_text

    return lookup_result
